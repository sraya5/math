\begin_inset Formula
$\left[a,b\right]$


\end_inset
 וגזירות בקטע 
\begin_inset Formula
$\left(a,b\right)$


\end_inset
 כך ש-
\begin_inset Formula
$g'\left(t\right)\neq0$


\end_inset
 לכל 
\begin_inset Formula
