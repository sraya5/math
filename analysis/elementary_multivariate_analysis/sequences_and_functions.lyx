\end_inset
 מסילה המוגדרת ע"י (לכל 
\begin_inset Formula
$t\in\left[a,b\right]$


\end_inset
):
\begin_inset Formula
\[
\gamma\left(t\right):=\begin{pmatrix}g\left(t\right)\\
f\left(t\right)
\end{pmatrix}
\]




\end_inset
קיימת נקודה 
\begin_inset Formula
$c\in\left(a,b\right)$


\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
\frac{g\left(b\right)-g\left(a\right)}{g'\left(c\right)}\cdot\gamma'\left(c\right)=\gamma\left(b\right)-\gamma\left(a\right)
\]




\end_inset

