\begin_layout Definition
ישנה סדרה קלאסית של מטריקות על המרחב האוקלידי 
\begin_inset Formula $\MKreal^{n}$
\end_inset

 המסומנת ב-
\begin_inset Formula $\left(d_{k}\right)_{k=1}^{\infty}$
\end_inset

 ומוגדרת ע"י (לכל 
\begin_inset Formula $x,y\in\MKreal^{n}$
\end_inset

):
\begin_inset Formula 
\[
d_{k}\left(x,y\right):=\sqrt[k]{\sum_{i=1}^{n}\left|x_{i}-y_{i}\right|^{k}}
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 עבור 
