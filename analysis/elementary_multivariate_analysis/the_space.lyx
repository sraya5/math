\begin_inset Formula $a\neq0$
\end_inset

 ו/או 
\begin_inset Formula $b\neq0$
\end_inset

 שהרי 
\begin_inset Formula $L$
\end_inset

 הוא ישר.
\end_layout

\end_inset

 ובנוסף 
\begin_inset Formula $x_{0}:=ta$
\end_inset

 ו-
\begin_inset Formula $y_{0}:=tb$
\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
וכך יתקיים 
\begin_inset Formula $-\left(ax_{0}+bx_{0}\right)=c$
\end_inset

.
\end_layout

\end_inset

 וא"כ מתקיים:
\begin_inset Formula 
\[
L=\left\{ \begin{array}{c|c}
\begin{pmatrix}x\\
y
\end{pmatrix}\in\MKreal^{2} & \begin{bmatrix}x-x_{0}\\
y-y_{0}
\end{bmatrix}\cdot\begin{bmatrix}a\\
b
\end{bmatrix}=0\end{array}\right\} 
\]

\end_inset


\end_layout

