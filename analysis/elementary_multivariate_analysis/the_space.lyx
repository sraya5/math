\begin_layout Theorem

\series bold
שקילות אלגברית להגדרה הגאומטרית של המכפלה הסקלרית
\series default

\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $\vec{x},\vec{y}\in\MKreal^{n}$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\vec{x}\cdot\vec{y}=\sum_{i=1}^{n}x_{i}\cdot y_{i}
\]

\end_inset


\end_layout

\begin_layout Corollary
יהיו 
\begin_inset Formula $\vec{0}\neq\vec{x},\vec{y}\in\MKreal^{n}$
\end_inset

 ונסמן ב-
\begin_inset Formula $\theta$
\end_inset

 את הזווית הקטנה מבין השתיים הנוצרות ביניהם,
 מתקיים:
\begin_inset Formula 
\[
\theta=\arccos\left(\frac{\vec{x}\cdot\vec{y}}{\left\Vert \vec{x}\right\Vert \cdot\left\Vert \vec{y}\right\Vert }\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset


\end_layout

\begin_layout Claim
תכונות של המכפלה הסקלרית:
\end_layout

\begin_deeper
\begin_layout Enumerate
חיוביות (או חיוביות בהחלט) - לכל 
\begin_inset Formula $\vec{v}\in\MKreal^{n}$
\end_inset

 מתקיים 
\begin_inset Formula $\vec{v}\cdot\vec{v}\geq0$
\end_inset

 ובנוסף 
\begin_inset Formula $\vec{v}\cdot\vec{v}=0$
\end_inset

 אם"ם 
\begin_inset Formula $\vec{v}=\vec{0}$
\end_inset

.
\end_layout

\begin_layout Enumerate
סימטריה - לכל 
\begin_inset Formula $\vec{v},\vec{w}\in\MKreal^{n}$
\end_inset

 מתקיים 
\begin_inset Formula $\vec{v}\cdot\vec{w}=\vec{w}\cdot\vec{v}$
\end_inset

.
\end_layout

\begin_layout Enumerate
בי-ליניאריות (ליניאריות בכל רכיב) - לכל 
\begin_inset Formula $\vec{v},\vec{w},\vec{u}\in\MKreal^{n}$
\end_inset

 ולכל 
\begin_inset Formula $c\in\MKreal$
\end_inset

 מתקיים
\begin_inset Formula 
\begin{align*}
\vec{v}\cdot\left(\vec{w}+\vec{u}\right) & =\vec{v}\cdot\vec{w}+\vec{v}\cdot\vec{u}\\
\vec{v}\cdot\left(c\cdot\vec{w}\right) & =c\cdot\left(\vec{v}\cdot\vec{w}\right)\\
\left(\vec{v}+\vec{u}\right)\cdot\vec{w} & =\vec{v}\cdot\vec{w}+\vec{u}\cdot\vec{w}\\
\left(c\cdot\vec{v}\right)\cdot\vec{w} & =c\cdot\left(\vec{v}\cdot\vec{w}\right)
\end{align*}

\end_inset


\end_layout

\end_deeper
