\end_inset

 אך עבור ממדים גבוהים יותר 
\begin_inset Formula $d_{2}$
\end_inset

 תהיה 
\bar under
המטריקה האוקלידית
\bar default
 המבוססת על הכללת משפט פיתגורס לממדים גבוהים יותר ואילו 
\begin_inset Formula $d_{1}$
\end_inset

 תהיה "
\begin_inset CommandInset href
LatexCommand href
name "מטריקת נהגי המוניות של מנהטן"
target "https://he.wikipedia.org/wiki/%D7%92%D7%90%D7%95%D7%9E%D7%98%D7%A8%D7%99%D7%99%D7%AA_%D7%A0%D7%94%D7%92%D7%99_%D7%94%D7%9E%D7%95%D7%A0%D7%99%D7%95%D7%AA#%D7%9E%D7%98%D7%A8%D7%99%D7%A7%D7%AA_%D7%9E%D7%A0%D7%94%D7%98%D7%9F"
literal "false"

\end_inset

".
