\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 ההצגה הזו כבר קרובה מאד להצגה סתומה של המישור,
 צריך רק להפריד בין המשתנים לאיבר הקבוע (למען האמת הייתי עושה זאת למעלה לו היה לי מקום),
 כלומר אם נגדיר:
\begin_inset Formula 
\begin{align*}
n & :=a_{2}b_{3}-a_{3}b_{2}\\
m & :=a_{3}b_{1}-a_{1}b_{3}\\
k & :=a_{1}b_{2}-a_{2}b_{1}\\
l & :=-\left(nx_{0}+my_{0}+kz_{0}\right)
\end{align*}

\end_inset

נקבל שאחת ההצגות הסתומות של המישור 
\begin_inset Formula $M$
\end_inset

 היא:
\begin_inset Formula 
\[
M=\left\{ \begin{pmatrix}x\\
y\\
z
\end{pmatrix}\in\MKreal^{3}\mid nx+my+kz+l=0\right\} 
\]

\end_inset


