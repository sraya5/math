\[
d_{\infty}\left(x,y\right):=\max\left\{ \left|x_{i}-y_{i}\right|:n\geq i\in\MKnatural\right\} 
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

