\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 למעשה לכל 
\begin_inset Formula $P,\vec{v_{1}},\vec{v_{2}},\ldots,\vec{v_{r}},Q,\vec{w_{1}},\vec{w_{2}},\ldots,\vec{w_{r}}\in\MKreal^{n}$
\end_inset

 המקיימים 
\begin_inset Formula $\MKspan\left(\vec{v_{1}},\vec{v_{2}},\ldots,\vec{v_{r}}\right)=\MKspan\left(\vec{w_{1}},\vec{w_{2}},\ldots,\vec{w_{r}}\right)$
\end_inset


\begin_inset Newline newline
\end_inset

ו-
\begin_inset Formula $Q\in\left\{ P+\sum_{i=1}^{r}a_{i}\cdot v_{i}\mid a_{1},a_{2},\ldots,a_{r}\in\MKreal\right\} $
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\left\{ Q\right\} +\MKspan\left(\vec{w_{1}},\vec{w_{2}},\ldots,\vec{w_{r}}\right) & =\left\{ Q+\sum_{i=1}^{r}b_{i}\cdot w_{i}\mid b_{1},b_{2},\ldots,b_{r}\in\MKreal\right\} \\
 & =\left\{ P+\sum_{i=1}^{r}a_{i}\cdot v_{i}\mid a_{1},a_{2},\ldots,a_{r}\in\MKreal\right\} \\
 & =\left\{ P\right\} +\MKspan\left(\vec{v_{1}},\vec{v_{2}},\ldots,\vec{v_{r}}\right)
\end{align*}

\end_inset


