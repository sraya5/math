\begin_layout Claim
יהא 
\begin_inset Formula $L\subseteq\MKreal^{2}$
\end_inset

 ישר ויהיו 
\begin_inset Formula $a,b,c\in\MKreal$
\end_inset

 כך ש-
\begin_inset Formula $L=\left\{ \begin{pmatrix}x\\
y
\end{pmatrix}\in\MKreal^{2}\mid ax+by+c=0\right\} $
\end_inset

,
 נסמן 
\begin_inset Formula $t:=-\frac{c}{a^{2}+b^{2}}$
\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
ניתן לחלק ב-
\begin_inset Formula $a^{2}+b^{2}$
