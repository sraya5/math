\begin_layout Standard
תהא 
\begin_inset Formula
$h:\left[0,\infty\right)\times\left[0,2\pi\right)\rightarrow\MKreal^{2}$


\end_inset
 הפונקציה המעבירה מהצגה קוטבית להצגה קרטזית
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
למעשה יש להגביל את התחום ל-
\begin_inset Formula
$\left(0,\infty\right)\times\left[0,2\pi\right)$


\end_inset
 איחוד עם 
\begin_inset Formula
$\left\{ \left(0,0\right)\right\} $


\end_inset
 כדי ש-
\begin_inset Formula
$h$


\end_inset
 תהיה חח"ע.
\end_layout

\end_inset
, כלומר לכל 
\begin_inset Formula
$\left(r,\theta\right)\in\left[0,\infty\right)\times\left[0,2\pi\right)$


\end_inset
 מתקיים:
\begin_inset Formula
\[
h\begin{pmatrix}r\\
\theta
\end{pmatrix}=\begin{bmatrix}r\cos\theta\\
r\sin\theta
\end{bmatrix}
\]




\end_inset
מהגדרה לכל 
\begin_inset Formula
$\left(r,\theta\right)\in\left[0,\infty\right)\times\left[0,2\pi\right)$


\end_inset
 מתקיים:
\begin_inset Formula
\[
J_{h}\begin{pmatrix}r\\
\theta
\end{pmatrix}=\left[\begin{array}{cc}
\cos\theta & -r\sin\theta\\
\sin\theta & r\cos\theta
\end{array}\right]
\]




\end_inset
ולכן גם:
\begin_inset Formula
\[
\left|J_{h}\left(r,\theta\right)\right|=r\cos^{2}\theta-\left(-r\sin^{2}\theta\right)=r\cdot\left(\cos^{2}\theta+\sin^{2}\theta\right)=r
\]




\end_inset

\end_layout

\begin_layout Corollary
\series bold
מעבר להצגה קוטבית
\series default

\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$D\subseteq\MKreal^{2}$


\end_inset
 קבוצה נורמלית בהצגה קוטבית, יהי 
\begin_inset Formula
$\left[\theta_{1},\theta_{2}\right]\subseteq\left[0,2\pi\right]$


\end_inset
 קטע סגור ותהיינה 
\begin_inset Formula
$s_{1},s_{2}:\left[\theta_{1},\theta_{2}\right]\rightarrow\MKreal$


\end_inset
 שתי פונקציות כך שמתקיים:
\begin_inset Formula
\[
D=\left\{ \left(r\cos\theta,r\sin\theta\right)\in\MKreal^{2}\mid\theta\in\left[\theta_{1},\theta_{2}\right],\ 0\leq s_{1}\left(\theta\right)\leq r\leq s_{2}\left(\theta\right)\right\} 
\]




\end_inset
תהא 
\begin_inset Formula
$f:D\rightarrow\MKreal$


\end_inset
 פונקציה רציפה, מתקיים:
\begin_inset Formula
\[
\iintop_{D}f\ dA=\intop_{\theta_{1}}^{\theta_{2}}\left(\intop_{s_{1}\left(\theta\right)}^{s_{2}\left(\theta\right)}f\begin{pmatrix}r\cos\theta\\
r\sin\theta
\end{pmatrix}\cdot r\ dr\right)d\theta
\]




\end_inset

