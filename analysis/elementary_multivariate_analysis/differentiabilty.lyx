\begin_layout Example*
ָהקבוצה 
\begin_inset Formula
$C:=\left\{ \left(x,y\right)\in\MKreal^{2}\mid x^{2}+y^{2}=1\right\} $


\end_inset
 המהווה את מעגל היחידה אינה יכולה להיות גרף של פונקציה אך עדיין היינו רוצים לדבר על המשיק לקבוצה בנקודה על המעגל; הרעיון הוא להגדיר פונקציה 
\begin_inset Formula
$F:\MKreal^{2}\rightarrow\MKreal$


\end_inset
 ע"י 
\begin_inset Formula
$f\left(x,y\right)=x^{2}+y^{2}-1$


\end_inset
 ואז לכל 
\begin_inset Formula
$\left(x,y\right)\in C$


\end_inset
 מתקיים 
\begin_inset Formula
$f\left(x,y\right)=0$


\end_inset
, כלומר 
\begin_inset Formula
$C$


\end_inset
 היא קו הגובה 
\begin_inset Formula
$0$


\end_inset
 של 
\begin_inset Formula
$f$


\end_inset
, כעת לכל נקודה 
\begin_inset Formula
$c:=\left(x_{0},y_{0}\right)\in C$


\end_inset
 קיימת סביבה מלאה שלה כך שקיימת פונקציה 
\begin_inset Formula
$y:B_{r}\left(c\right)\rightarrow\MKreal$


\end_inset
 המוגדרת ע"י 
\begin_inset Formula
$y\left(x\right):=\MKsign\left(y_{0}\right)\cdot\sqrt{1-x^{2}}$


\end_inset
. א"כ בסביבה זו מתקיים 
\begin_inset Formula
$f\left(x,y\right)=f\left(x,y\left(x\right)\right)$


\end_inset
 ואחרי שנגדיר 
\begin_inset Formula
$g\left(x\right):=f\left(x,y\left(x\right)\right)$


\end_inset
 בסביבה זו (נשים לב שמהגדרה 
\begin_inset Formula
$g$


\end_inset
 היא פונקציית האפס) נקבל מכלל השרשרת שמתקיים:
\begin_inset Formula
\[
0=g'\left(x\right)=f_{x}'\begin{pmatrix}x_{0}\\
y\left(x_{0}\right)
\end{pmatrix}\cdot1+f_{y}'\begin{pmatrix}x_{0}\\
y\left(x_{0}\right)
\end{pmatrix}\cdot y'\left(x_{0}\right)
\]




\end_inset
וסוף סוף מופיע הביטוי המיוחל 
\begin_inset Formula
$y'\left(x_{0}\right)$


\end_inset
 במשוואה שממנה ניתן לחלץ אותו שכן אם 
\begin_inset Formula
$f_{y}'\left(x_{0},y\left(x_{0}\right)\right)\neq0$


\end_inset
 אז מתקיים:
\begin_inset Formula
\[
y'\left(x_{0}\right)=-\frac{f_{x}'\left(x_{0},y\left(x_{0}\right)\right)}{f_{y}'\left(x_{0},y\left(x_{0}\right)\right)}
\]




\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
