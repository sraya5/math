\begin_inset Formula
\[
T_{2,f,P_{0}}\begin{pmatrix}x\\
y
\end{pmatrix}=f\left(P_{0}\right)+\frac{1}{2}\cdot\left(A\left(x-x_{0}\right)^{2}+2B\left(x-x_{0}\right)\left(y-y_{0}\right)+C\left(y-y_{0}\right)^{2}\right)
