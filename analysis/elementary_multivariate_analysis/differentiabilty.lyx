\begin_layout Theorem
\series bold
דרך שקולה לבטא את משפט כופלי לגראנז'
\series default

\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$f,g:D\rightarrow\MKreal$


\end_inset
 (כאשר 
\begin_inset Formula
$D\subseteq\MKreal^{n}$


\end_inset
 קבוצה פתוחה) פונקציות בעלות נגזרות חלקיות רציפות ב-
\begin_inset Formula
$D$


\end_inset
, אם 
\begin_inset Formula
$P_{0}\in D$


\end_inset
 היא נקודת קיצון כללית של 
\begin_inset Formula
$f$


\end_inset
 כשהיא מצומצמת לקבוצה 
\begin_inset Formula
$\left\{ P\in D\mid g\left(P\right)=0\right\} $


\end_inset
וגם 
\begin_inset Formula
$\overrightarrow{\nabla}g\left(P_{0}\right)\neq0$


\end_inset
 אז 
\begin_inset Formula
$P_{0}$


\end_inset
 היא נקודה קריטית של הפונקציה 
\begin_inset Formula
$h:D\times\MKreal\rightarrow\MKreal$


\end_inset
 המוגדרת ע"י 
\begin_inset Formula
$h\left(x_{1},x_{2},\ldots,x_{n},\lambda\right):=f\left(x_{1},x_{2},\ldots,x_{n}\right)+\lambda\cdot g\left(x_{1},x_{2},\ldots,x_{n}\right)$


\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$


\end_inset
 העובדה ש-
\begin_inset Formula
$P_{0}$


\end_inset
 היא נקודה קריטית של 
\begin_inset Formula
$h$


\end_inset
 אומרת שלכל 
\begin_inset Formula
$n\geq i\in\MKnatural$


\end_inset
 מתקיים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
ה-
\begin_inset Formula
$\lambda$


\end_inset
 פה היא הנגדית של ה-
\begin_inset Formula
$\lambda$


\end_inset
 מהניסוח הקודם.
\end_layout

\end_inset
:
\begin_inset Formula
\begin{align*}
0 & =D_{i}h\left(P_{0}\right)=D_{i}f\left(P_{0}\right)+\lambda\cdot D_{i}g\left(P_{0}\right)\\
\Longleftrightarrow & D_{i}f\left(P_{0}\right)=-\lambda\cdot D_{i}g\left(P_{0}\right)
\end{align*}




\end_inset
נשאר רק לחלק ב-
\begin_inset Formula
$-D_{i}g\left(P_{0}\right)$


\end_inset
.
