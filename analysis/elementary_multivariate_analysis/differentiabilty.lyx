\begin_layout Theorem
\series bold
הכללה של משפט כופלי לגראנז'
\series default

\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$f,g_{1},g_{2},\ldots,g_{k}:D\rightarrow\MKreal$


\end_inset
 (כאשר 
\begin_inset Formula
$D\subseteq\MKreal^{n}$


\end_inset
 קבוצה פתוחה) פונקציות בעלות נגזרות חלקיות רציפות ב-
\begin_inset Formula
$D$


\end_inset
, אם ש-
\begin_inset Formula
$P_{0}\in D$


\end_inset
 היא נקודת קיצון כללית של 
\begin_inset Formula
$f$


\end_inset
 כשהיא מצומצמת לקבוצה
\begin_inset Formula
\[
\left\{ \begin{array}{c|c}
P\in D & \begin{cases}
g_{1}\left(P\right)=0\\
g_{2}\left(P\right)=0\\
\vdots\\
g_{1}\left(P\right)=0
\end{cases}\end{array}\right\} 
\]




\end_inset

\end_layout

\begin_deeper
\begin_layout Standard
אז 
\begin_inset Formula
$P_{0}$


\end_inset
 היא נקודה קריטית של הפונקציה 
\begin_inset Formula
$h:D\times\MKreal^{k}\rightarrow\MKreal$


\end_inset
 המוגדרת ע"י:
\begin_inset Formula
\[
h\left(x_{1},x_{2},\ldots,x_{n},\lambda_{1},\lambda_{2},\ldots\lambda_{k}\right):=f\left(x_{1},x_{2},\ldots,x_{n}\right)+\sum_{j=1}^{k}\lambda_{j}\cdot g_{j}\left(x_{1},x_{2},\ldots,x_{n}\right)
\]




\end_inset
ובתנאי שלמערכת המשוואות הליניארית הבאה יש פתרון
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
צריך לבדוק אם זה באמת התנאי הדרוש.
\end_layout

\end_inset
:
\begin_inset Formula
\[
\begin{bmatrix}D_{1}f\left(P_{0}\right)\\
D_{2}f\left(P_{0}\right)\\
\vdots\\
D_{n}f\left(P_{0}\right)
\end{bmatrix}+\left[\begin{array}{cccc}
D_{1}g_{1}\left(P_{0}\right) & D_{1}g_{2}\left(P_{0}\right) & \ldots & D_{1}g_{k}\left(P_{0}\right)\\
D_{2}g_{1}\left(P_{0}\right) & D_{2}g_{2}\left(P_{0}\right) & \ldots & D_{2}g_{k}\left(P_{0}\right)\\
\vdots & \vdots & \ddots & \vdots\\
D_{n}g_{1}\left(P_{0}\right) & D_{n}g_{2}\left(P_{0}\right) & \ldots & D_{n}g_{k}\left(P_{0}\right)
\end{array}\right]\cdot\begin{bmatrix}\lambda_{1}\\
\lambda_{2}\\
\vdots\\
\lambda_{k}
\end{bmatrix}=\begin{bmatrix}0\\
0\\
\vdots\\
0
\end{bmatrix}
\]




\end_inset

\begin_inset Formula
\[
\Longleftrightarrow\left[\begin{array}{cccc}
D_{1}g_{1}\left(P_{0}\right) & D_{1}g_{2}\left(P_{0}\right) & \ldots & D_{1}g_{k}\left(P_{0}\right)\\
D_{2}g_{1}\left(P_{0}\right) & D_{2}g_{2}\left(P_{0}\right) & \ldots & D_{2}g_{k}\left(P_{0}\right)\\
\vdots & \vdots & \ddots & \vdots\\
D_{n}g_{1}\left(P_{0}\right) & D_{n}g_{2}\left(P_{0}\right) & \ldots & D_{n}g_{k}\left(P_{0}\right)
\end{array}\right]\cdot\begin{bmatrix}\lambda_{1}\\
\lambda_{2}\\
\vdots\\
\lambda_{k}
\end{bmatrix}=\begin{bmatrix}-D_{1}f\left(P_{0}\right)\\
-D_{2}f\left(P_{0}\right)\\
\vdots\\
-D_{n}f\left(P_{0}\right)
\end{bmatrix}
\]




\end_inset

\end_layout

\end_deeper

