\begin_inset Formula 
\[
\frac{x}{y^{n}}<1+n\cdot\left(-\varepsilon\right)\leq\left(1-\varepsilon\right)^{n}
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow x<y^{n}\cdot\left(1-\varepsilon\right)^{n}=\left[y\cdot\left(1-\varepsilon\right)\right]^{n}
\]

\end_inset

