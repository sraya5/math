\begin_inset Formula $q\in\MKrational$
\end_inset

 כך ש-
\begin_inset Formula $q^{2}=2$
\end_inset

,
 נשים לב לכך ש-
\begin_inset Formula $q^{2}=2$
\end_inset

 אם"ם 
\begin_inset Formula $\left(-q\right)^{2}=2$
\end_inset

