\begin_inset Formula 
\begin{align*}
 & \Rightarrow\frac{m^{2}}{n^{2}}=\left(\frac{m}{n}\right)^{2}=q^{2}=2\\
 & \Rightarrow m^{2}=2n^{2}\\
 & \Rightarrow m^{2}\in\MKeven\\
 & \Rightarrow m\in\MKeven
\end{align*}

