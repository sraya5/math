\[
a^{x}:=\begin{cases}
\sup\left\{ a^{r}:r\in\MKrational,\ r<x\right\}  & 1<a\\
1 & a=1\\
\left(\frac{1}{a}\right)^{-x} & a<1
\end{cases}
\]

