\begin_layout Theorem
לכל 
\begin_inset Formula $a,b\in\MKfield$
\end_inset

 ולכל 
\begin_inset Formula $n\in\MKnatural_{0}$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
a^{n}-b^{n}=\left(a-b\right)\cdot\sum_{k=0}^{n-1}a^{n-1-k}\cdot b^{k}
\]

\end_inset


