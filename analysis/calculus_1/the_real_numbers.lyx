 וממילא 
\begin_inset Formula $0<\frac{x}{1+x}\leq y$
\end_inset

.
\begin_inset Newline newline
\end_inset

נשלול את 
\begin_inset Formula $y^{n}<x$
\end_inset

 ואת 
\begin_inset Formula $y^{n}>x$
\end_inset

 ומטריכוטומיה נקבל ש-
\begin_inset Formula $y^{n}=x$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Itemize
נניח בשלילה ש-
\begin_inset Formula $y^{n}<x$
\end_inset

,
 מכאן ש-
\begin_inset Formula $0<\frac{y^{n}}{x}<1$
\end_inset

 ולכן גם:
\begin_inset Formula 
\[
0<\frac{1-\frac{y^{n}}{x}}{n}
\]

\end_inset

יהי 
\begin_inset Formula $0<\varepsilon\in\MKreal$
\end_inset

 כך שמתקיים:
\begin_inset Formula 
\[
\varepsilon<1,\ \varepsilon<\frac{1-\frac{y^{n}}{x}}{n}
\]

\end_inset


\begin_inset Formula 
\begin{align*}
 & \Rightarrow n\varepsilon<1-\frac{y^{n}}{x}\\
 & \Rightarrow\frac{y^{n}}{x}<1+n\cdot\left(-\varepsilon\right)
\end{align*}

\end_inset

נשים לב לכך ש-
\begin_inset Formula $-1<-\varepsilon$
\end_inset

 (וגם 
\begin_inset Formula $0<1-\varepsilon$
\end_inset

) ולכן מא"ש ברנולי נובע שמתקיים:
\begin_inset Formula 
\[
\frac{y^{n}}{x}<1+n\cdot\left(-\varepsilon\right)\leq\left(1-\varepsilon\right)^{n}
\]

\end_inset


\begin_inset Formula 
\begin{align*}
 & \Rightarrow0\leq\left(\frac{y}{1-\varepsilon}\right)^{n}=\frac{y^{n}}{\left(1-\varepsilon\right)^{n}}<x\\
 & \Rightarrow\frac{y}{1-\varepsilon}\in S
\end{align*}

\end_inset

אבל 
\begin_inset Formula $\frac{y}{1-\varepsilon}>y$
\end_inset

 בסתירה להיות 
\begin_inset Formula $y$
\end_inset

 חסם מלעיל של 
\begin_inset Formula $S$
\end_inset

,
 מכאן שהנחת השלילה אינה נכונה ו-
\begin_inset Formula $y^{n}\geq x$
\end_inset

.
\end_layout

\begin_layout Itemize
כעת נניח בשלילה ש-
\begin_inset Formula $y^{n}>x$
\end_inset

,
 מכאן ש-
\begin_inset Formula $0<\frac{x}{y^{n}}<1$
\end_inset

