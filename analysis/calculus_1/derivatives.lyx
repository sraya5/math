 פונקציה המוגדרת ע"י 
\begin_inset Formula $g\left(x\right):=x^{-m}$
\end_inset

 לכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

,
 מהטענה הקודמת (
\begin_inset CommandInset ref
LatexCommand ref
reference "claim 3.2"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) נובע שלכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 מתקיים 
\begin_inset Formula $g'\left(x\right)=-m\cdot x^{-m-1}$
\end_inset

.
\begin_inset Newline newline
\end_inset

מכלל הגזירה למנה (או ממשפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 2.7"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) נובע כי לכל 
\begin_inset Formula $0\neq x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
f'\left(x\right)=\left(\frac{1}{g}\right)'\left(x\right)=-\frac{g'\left(x\right)}{g^{2}\left(x\right)}=-\frac{-m\cdot x^{-m-1}}{x^{-2m}}=m\cdot x^{m-1}
\]

\end_inset


\end_layout

\begin_layout Claim
יהי 
\begin_inset Formula $n\in\MKnatural$
\end_inset

 ותהא 
\begin_inset Formula $f:\left(0,\infty\right)\rightarrow\MKreal$
\end_inset

 פונקציה המוגדרת ע"י 
\begin_inset Formula $f\left(x\right):=x^{\frac{1}{n}}=\sqrt[n]{x}$
\end_inset

 לכל 
\begin_inset Formula $x\in\left(0,\infty\right)$
\end_inset

,
 מתקיים (לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

):
\begin_inset Formula 
\[
f'\left(x\right)=\frac{1}{n}\cdot x^{\left(\frac{1}{n}-1\right)}=\frac{1}{n}\cdot x^{-\left(\frac{n-1}{n}\right)}
\]

\end_inset


\end_layout

\begin_layout Proof
תהא 
\begin_inset Formula $g:\left(0,\infty\right)\rightarrow\MKreal$
\end_inset

 פונקציה המוגדרת ע"י 
\begin_inset Formula $g\left(x\right):=x^{n}$
\end_inset

,
 ראינו בטענה 
\begin_inset CommandInset ref
LatexCommand ref
reference "claim 3.2"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 שלכל 
\begin_inset Formula $x\in\left(0,\infty\right)$
\end_inset

 מתקיים 
\begin_inset Formula $g'\left(x\right)=n\cdot x^{n-1}\neq0$
\end_inset

.
\begin_inset Newline newline
\end_inset

נשים לב לכך שלכל 
\begin_inset Formula $x\in\left(0,\infty\right)$
\end_inset

 מתקיים 
\begin_inset Formula $g\left(f\left(x\right)\right)=f\left(g\left(x\right)\right)=x$
\end_inset

,
 כלומר 
\begin_inset Formula $f$
\end_inset

 ו-
\begin_inset Formula $g$
\end_inset

 הופכיות זו לזו,
 מכאן שע"פ כלל הגזירה לפונקציה הופכית לכל 
\begin_inset Formula $x\in\left(0,\infty\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
f'\left(x\right)=\frac{1}{g'\left(f\left(x\right)\right)}=\frac{1}{n\cdot\left(x^{\frac{1}{n}}\right)^{n-1}}=\frac{1}{n\cdot x^{\frac{n-1}{n}}}=\frac{1}{n}\cdot x^{-\left(\frac{n-1}{n}\right)}=\frac{1}{n}\cdot x^{\left(\frac{1}{n}-1\right)}
\]

\end_inset


\end_layout

\begin_layout Corollary
יהי 
\begin_inset Formula $q\in\MKrational$
\end_inset

 ותהא 
\begin_inset Formula $f:\left(0,\infty\right)\rightarrow\MKreal$
\end_inset

 פונקציה המוגדרת ע"י 
\begin_inset Formula $f\left(x\right):=x^{q}$
\end_inset

 לכל 
\begin_inset Formula $x\in\left(0,\infty\right)$
\end_inset

,
 מתקיים (לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

):
\begin_inset Formula 
\[
f'\left(x\right)=q\cdot x^{q-1}
\]

\end_inset


\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula $n\in\MKnatural$
\end_inset

 ו-
\begin_inset Formula $m\in\MKinteger$
\end_inset

 כך ש-
\begin_inset Formula $\frac{m}{n}=q$
\end_inset

,
 א"כ לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

 מתקיים 
\begin_inset Formula $f\left(x\right)=x^{\frac{m}{n}}=\left(x^{\frac{1}{n}}\right)^{m}$
\end_inset

 ולכן מכלל השרשרת נובע שלכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
f'\left(x\right)=m\cdot\left(x^{\frac{1}{n}}\right)^{m-1}\cdot\frac{1}{n}\cdot x^{-\left(\frac{n-1}{n}\right)}=\frac{m}{n}\cdot x^{\frac{m-1}{n}}\cdot x^{-\left(\frac{n-1}{n}\right)}=\frac{m}{n}\cdot x^{\frac{m-n}{n}}=q\cdot x^{q-1}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset


\end_layout

\begin_layout Subsection
נגזרות במעריך ממשי,
 של פונקציות מעריכיות ושל לוגריתמים
\end_layout

\begin_layout Lemma
לכל 
\begin_inset Formula $x\in\left(-\frac{1}{2},\frac{1}{2}\right)$
\end_inset

 מתקיים 
\begin_inset Formula $1+x-2x^{2}\leq\exp\left(x\right)\leq1+x+2x^{2}$
\end_inset

.
\end_layout

\begin_layout Proof
מהבינום של ניוטון נובע שלכל 
\begin_inset Formula $x\in\left(-\frac{1}{2},\frac{1}{2}\right)$
\end_inset

 ולכל 
\begin_inset Formula $n\in\MKnatural$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\left(1+\frac{x}{n}\right)^{n} & =\sum_{k=0}^{n}\begin{pmatrix}n\\
k
\end{pmatrix}\cdot\frac{x^{k}}{n^{k}}=1+x+\sum_{k=2}^{n}\begin{pmatrix}n\\
k
\end{pmatrix}\cdot\frac{x^{k}}{n^{k}}\leq1+x+\sum_{k=2}^{n}\frac{x^{2}}{k!}\\
 & \leq1+x+\sum_{k=2}^{n}\frac{x^{2}}{2^{k}}=1+x+x^{2}\cdot\left(\sum_{k=2}^{n}\left(\frac{1}{2}\right)^{k}\right)\leq1+x+2x^{2}
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\left(1+\frac{x}{n}\right)^{n} & =\sum_{k=0}^{n}\begin{pmatrix}n\\
k
\end{pmatrix}\cdot\frac{x^{k}}{n^{k}}=1+x+\sum_{k=2}^{n}\begin{pmatrix}n\\
k
\end{pmatrix}\cdot\frac{x^{k}}{n^{k}}\geq1+x-\left|\sum_{k=2}^{n}\begin{pmatrix}n\\
k
\end{pmatrix}\cdot\frac{x^{k}}{n^{k}}\right|\\
 & \geq1+x-\sum_{k=2}^{n}\begin{pmatrix}n\\
k
\end{pmatrix}\cdot\frac{\left|x\right|^{k}}{n^{k}}\geq1+x-\sum_{k=2}^{n}\begin{pmatrix}n\\
k
\end{pmatrix}\cdot\frac{x^{2}}{k!}\\
 & \geq1+x-\sum_{k=2}^{n}\frac{x^{2}}{2^{k}}=1+x-x^{2}\cdot\left(\sum_{k=2}^{n}\left(\frac{1}{2}\right)^{k}\right)\geq1+x-2x^{2}
\end{align*}

\end_inset

מכאן שמתקיים:
\begin_inset Formula 
\[
1+x-2x^{2}\leq\lim_{n\rightarrow\infty}\left(1+\frac{x}{n}\right)^{n}\leq1+x+2x^{2}
\]

\end_inset

כלומר:
\begin_inset Formula 
\[
1+x-2x^{2}\leq\exp\left(x\right)\leq1+x+2x^{2}
\]

\end_inset


\end_layout

\begin_layout Claim
\begin_inset Formula $\exp$
\end_inset

 גזירה ב-
\begin_inset Formula $0$
\end_inset

 ומתקיים 
\begin_inset Formula $\exp'\left(0\right)=1$
\end_inset

.
\end_layout

\begin_layout Proof
לכל 
\begin_inset Formula $0\neq x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\frac{\exp\left(x\right)-\exp\left(0\right)}{x-0}=\frac{\exp\left(x\right)-1}{x}
\]

\end_inset

ולכן לכל 
\begin_inset Formula $0\neq x\in\left(-\frac{1}{2},\frac{1}{2}\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
1\mp2x=\frac{1+x\mp2x^{2}-1}{x}\leq\frac{\exp\left(x\right)-\exp\left(0\right)}{x-0}\leq\frac{1+x\pm2x^{2}-1}{x}=1\pm2x
\]

\end_inset

וממשפט הכריך נובע כי:
\begin_inset Formula 
\[
\exp'\left(0\right)=\lim_{x\rightarrow0}\frac{\exp\left(x\right)-\exp\left(0\right)}{x-0}=1
\]

\end_inset


\end_layout

\begin_layout Claim
\begin_inset Formula $\exp$
\end_inset

 גזירה בכל מקום ולכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 מתקיים 
\begin_inset Formula $\exp'\left(x\right)=\exp\left(x\right)$
\end_inset

.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula $x\in\MKreal$
\end_inset

,
 לכל 
\begin_inset Formula $x\neq t\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\frac{\exp\left(t\right)-\exp\left(x\right)}{t-x}=\exp\left(x\right)\cdot\frac{\exp\left(t-x\right)-1}{t-x}
\]

\end_inset

מאריתמטיקה של גבולות נובע כי:
\begin_inset Formula 
\begin{align*}
\exp'\left(x\right) & =\lim_{t\rightarrow x}\frac{\exp\left(t\right)-\exp\left(x\right)}{t-x}=\exp\left(x\right)\cdot\lim_{t\rightarrow x}\frac{\exp\left(t-x\right)-1}{t-x}\\
 & =\exp\left(x\right)\cdot\lim_{t\rightarrow0}\frac{\exp\left(t\right)-1}{t}=\exp\left(x\right)\cdot1=\exp\left(x\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Corollary
יהי 
\begin_inset Formula $0<a\in\MKreal$
\end_inset

 ותהא 
\begin_inset Formula $f:\MKreal\rightarrow\MKreal$
\end_inset

 פונקציה המוגדרת ע"י 
\begin_inset Formula $f\left(x\right):=a^{x}$
\end_inset

,
 מתקיים (לכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

):
\begin_inset Formula 
\[
f'\left(x\right)=\ln\left(a\right)\cdot a^{x}
\]

\end_inset


\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

 מתקיים 
\begin_inset Formula $\ln'\left(x\right)=\frac{1}{x}$
\end_inset

.
\end_layout

\begin_layout Proof
מכלל כגזירה לפונקציה הופכית נובע כי לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\ln'\left(x\right)=\frac{1}{\exp'\left(\ln\left(x\right)\right)}=\frac{1}{\exp\left(\ln\left(x\right)\right)}=\frac{1}{x}
\]

\end_inset


\end_layout

\begin_layout Corollary
לכל 
\begin_inset Formula $0<a\in\MKreal$
\end_inset

 השונה מ-
\begin_inset Formula $1$
\end_inset

 ולכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\log_{a}'\left(x\right)=\frac{1}{x\cdot\ln\left(a\right)}
\]

\end_inset


\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula $0<a\in\MKreal$
\end_inset

 השונה מ-
\begin_inset Formula $1$
\end_inset

.
\begin_inset Newline newline
\end_inset

ראינו שלכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\log_{a}\left(x\right)=\frac{\ln\left(x\right)}{\ln\left(a\right)}
\]

\end_inset

מכאן שלכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\log_{a}'\left(x\right)=\frac{\ln'\left(x\right)}{\ln\left(a\right)}=\frac{1}{x\cdot\ln\left(a\right)}
\]

\end_inset


\end_layout

\begin_layout Corollary
יהי 
\begin_inset Formula $\alpha\in\MKreal$
\end_inset

 ותהא 
\begin_inset Formula $f:\left(0,\infty\right)\rightarrow\MKreal$
\end_inset

 פונקציה המוגדרת ע"י 
\begin_inset Formula $f\left(x\right):=x^{\alpha}$
\end_inset

 לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

,
 מתקיים (לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

):
\begin_inset Formula 
\[
f'\left(x\right)=\alpha\cdot x^{\alpha-1}
\]

\end_inset


\end_layout

\begin_layout Proof
אם 
\begin_inset Formula $\alpha=1$
\end_inset

 אז הטענה טריוויאלית,
 על כן נעסוק במקרה שבו 
\begin_inset Formula $\alpha\neq1$
\end_inset

.
\begin_inset Newline newline
\end_inset

מהגדרה,
 לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
f\left(x\right)=\exp\left(\alpha\cdot\ln\left(x\right)\right)
\]

\end_inset

ומכאן שע"פ כלל השרשרת לכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
f'\left(x\right) & =\exp'\left(\alpha\cdot\ln\left(x\right)\right)\cdot\alpha\cdot\frac{1}{x}=\alpha\cdot\frac{1}{x}\cdot\exp\left(\alpha\cdot\ln\left(x\right)\right)\\
 & =\alpha\cdot\frac{1}{x}\cdot x^{\alpha}=\alpha\cdot x^{\alpha-1}
\end{align*}

\end_inset


\end_layout

