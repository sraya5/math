\begin_layout Claim
תהא 
\begin_inset Formula $f$
\end_inset

 פונקציה,
 אם 
\begin_inset Formula $x\in\MKreal$
\end_inset

 היא נקודת קיצון של 
\begin_inset Formula $f$
\end_inset

 ו-
\begin_inset Formula $f$
\end_inset

 גזירה ב-
\begin_inset Formula $x$
\end_inset

 אז 
\begin_inset Formula $f'\left(x\right)=0$
\end_inset

.
\end_layout

\begin_layout Proof
נניח בהג"כ ש-
\begin_inset Formula $x$
\end_inset

 היא נקודת מינימום של 
\begin_inset Formula $f$
\end_inset

 וש-
\begin_inset Formula $f$
\end_inset

 גזירה ב-
\begin_inset Formula $x$
\end_inset

,
 א"כ 
\begin_inset Formula $f$
\end_inset

 מוגדרת בסביבה 
\begin_inset Formula $U$
\end_inset

 של 
\begin_inset Formula $x$
\end_inset

.
\begin_inset Newline newline
\end_inset

מהגדרה,
 לכל 
\begin_inset Formula $x>t\in U$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\frac{f\left(t\right)-f\left(x\right)}{t-x}\leq0
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow\lim_{t\rightarrow x^{-}}\frac{f\left(t\right)-f\left(x\right)}{t-x}\leq0
\]

\end_inset

כמו כן,
 לכל 
\begin_inset Formula $x<t\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\frac{f\left(t\right)-f\left(x\right)}{t-x}\geq0
\]

\end_inset


\begin_inset Formula 
\[
