\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "claim 3.2"

\end_inset

יהי 
\begin_inset Formula $n\in\MKnatural$
\end_inset

 ותהא 
\begin_inset Formula $f:\MKreal\rightarrow\MKreal$
\end_inset

 פונקציה המוגדרת ע"י 
\begin_inset Formula $f\left(x\right):=x^{n}$
\end_inset

 לכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

,
 מתקיים 
\begin_inset Formula $f'\left(x\right)=n\cdot x^{n-1}$
\end_inset

 לכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

.
\end_layout

\begin_layout Proof

\bar under
הוכחה 
\numeric on
1
\numeric off
 - באמצעות נוסחת הכפל המקוצר
\bar default

\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $x\neq t\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\frac{{\color{red}t^{n}-x^{n}}}{{\color{blue}t-x}}={\color{blue}\frac{1}{t-x}}\cdot{\color{red}\left(t-x\right)\cdot\sum_{k=0}^{n-1}t^{k}\cdot x^{n-1-k}}=\sum_{k=0}^{n-1}t^{k}\cdot x^{n-1-k}
\]

\end_inset

מרציפות של כל פולינום נובע שמתקיים:
\begin_inset Formula 
\[
f'\left(x\right)=\lim_{t\rightarrow x}\frac{t^{n}-x^{n}}{t-x}=\lim_{t\rightarrow x}\sum_{k=0}^{n-1}t^{k}\cdot x^{n-1-k}=\sum_{k=0}^{n-1}x^{k}\cdot x^{n-1-k}=\sum_{k=0}^{n-1}x^{n-1}=n\cdot x^{n-1}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Proof

\bar under
הוכחה 
\numeric on
2
\numeric off
 - באמצעות כלל לייבניץ ואינדוקציה
\bar default

\begin_inset Newline newline
\end_inset

בסיס האינדוקציה (עבור 
\begin_inset Formula $n=1$
\end_inset

) הוכח כבר בטענה הקודמת (
\begin_inset CommandInset ref
LatexCommand ref
reference "claim 3.1"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) ולכן נעבור ישירות לצעד האינדוקציה.
\begin_inset Newline newline
\end_inset

נניח שהטענה אכן מתקיימת עבור 
\begin_inset Formula $n-1$
\end_inset

,
 לכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 מתקיים 
\begin_inset Formula $f\left(x\right)=x^{n-1}\cdot x$
\end_inset

 ולכן מכלל לייבניץ ומבסיס האינדוקציה נובע שגם:
\begin_inset Formula 
\[
f'\left(x\right)=\left(n-1\right)\cdot x^{n-2}\cdot x+1\cdot x^{n-1}=n\cdot x^{n-1}
\]

\end_inset


\end_layout

\begin_layout Corollary
לכל פולינום 
\begin_inset Formula $p\left(x\right)=\sum_{k=0}^{n}a_{k}\cdot x^{k}\in\MKreal\left[x\right]$
\end_inset

 ולכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
p'\left(x\right)=\sum_{k=1}^{n}a_{k}\cdot k\cdot x^{k-1}
\]

\end_inset


