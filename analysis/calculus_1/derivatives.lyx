\series bold
חישוב של 
\begin_inset Formula $\sin\left(1\right)$
\end_inset

 עד כדי דיוק של אלפית
\series default

\begin_inset Newline newline
\end_inset

פולינום טיילור של 
\begin_inset Formula $\sin$
\end_inset

 מסדר 
\begin_inset Formula $n$
\end_inset

 סביב 
\begin_inset Formula $0$
\end_inset

 הוא:
\begin_inset Formula 
\[
\sum_{k=0}^{\left\lfloor \frac{n}{2}\right\rfloor }\frac{\left(-1\right)^{k}}{\left(2k+1\right)!}\cdot x^{2k+1}
\]

\end_inset

אנחנו יודעים שלכל 
\begin_inset Formula $n\in\MKnatural$
\end_inset

 ולכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 מתקיים 
\begin_inset Formula $\left|\sin^{\left(n\right)}\left(x\right)\right|\leq1$
\end_inset

 ולכן לכל 
\begin_inset Formula $n\in\MKnatural$
\end_inset

 ולכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 מתקיים (עבור 
\begin_inset Formula $\xi$
\end_inset

 כלשהו בקטע הפתוח המתאים):
\begin_inset Formula 
\[
\left|R_{n,\sin,0}\left(x\right)\right|=\left|\frac{\sin^{\left(n+1\right)}\left(\xi\right)}{\left(n+1\right)!}\cdot\left(x-0\right)^{n+1}\right|\leq\frac{\left|x^{n+1}\right|}{\left(n+1\right)!}=\frac{\left|x\right|^{n+1}}{\left(n+1\right)!}
\]

\end_inset

לכן אם נרצה לחשב את הערך שמקבלת 
\begin_inset Formula $\sin$
\end_inset

 ב-
\begin_inset Formula $x$
\end_inset

 עד כדי 
\begin_inset Formula $10^{-m}$
\end_inset

 עלינו למצוא 
\begin_inset Formula $n\in\MKnatural$
\end_inset

 שעבורו מתקיים:
\begin_inset Formula 
\[
\frac{\left|x\right|^{n+1}}{\left(n+1\right)!}\leq10^{-m}
\]

\end_inset

לדוגמה,
 נרצה לחשב את 
\begin_inset Formula $\sin\left(1\right)$
\end_inset

 (זה מזכיר לכם משהו?) עד כדי 
\begin_inset Formula $10^{-3}$
\end_inset

,
 אנחנו יודעים שלכל 
\begin_inset Formula $n\in\MKnatural$
\end_inset

 מתקיים 
\begin_inset Formula $\left|1\right|^{n+1}=1$
\end_inset

.
\begin_inset Newline newline
\end_inset

נשים לב שמתקיים 
\begin_inset Formula $7!=5,040$
\end_inset

 וא"כ נקבל:
\begin_inset Formula 
\[
\frac{\left|1\right|^{7}}{7!}\leq\frac{1}{5,040}<10^{-3}
\]

\end_inset

ולכן יספיק לנו 
\begin_inset Formula $n=6$
\end_inset

.
\begin_inset Formula 
\[
\Rightarrow\left|\sin\left(1\right)-\sum_{k=0}^{3}\frac{\left(-1\right)^{k}}{\left(2k+1\right)!}\right|=\left|\sin\left(1\right)-\sum_{k=0}^{\left\lfloor \frac{6+1}{2}\right\rfloor }\frac{\left(-1\right)^{k}}{\left(2k+1\right)!}\cdot\left(1\right)^{2k+1}\right|<10^{-3}
\]

\end_inset


\begin_inset Formula 
\begin{align*}
\Rightarrow\sin\left(1\right) & \approx\sum_{k=0}^{3}\frac{\left(-1\right)^{k}}{\left(2k+1\right)!}=\frac{\left(-1\right)^{0}}{\left(2\cdot0+1\right)!}+\frac{\left(-1\right)^{1}}{\left(2\cdot1+1\right)!}+\frac{\left(-1\right)^{2}}{\left(2\cdot2+1\right)!}+\frac{\left(-1\right)^{3}}{\left(2\cdot3+1\right)!}\\
 & =\frac{1}{1!}-\frac{1}{3!}+\frac{1}{5!}-\frac{1}{7!}=\frac{7!-4\cdot5\cdot6\cdot7+6\cdot7-1}{7!}\\
 & =\frac{5,040-840+42-1}{5,040}=\frac{4,200+41}{5,040}=\frac{4,241}{5,040}
\end{align*}

\end_inset


