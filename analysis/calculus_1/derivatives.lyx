\begin_layout Proof
יהיו 
\begin_inset Formula $a_{0},a_{1},\ldots,a_{n}\in\MKreal$
\end_inset

 כך שמתקיים:
\begin_inset Formula 
\[
P_{n,g,f\left(a\right)}\left(x\right)=\sum_{k=0}^{n}a_{k}\cdot\left(x-f\left(a\right)\right)^{k}
\]

\end_inset

ונסמן 
\begin_inset Formula $F:=P_{n,f,a}$
\end_inset

 ו-
\begin_inset Formula $G:=P_{n,g,f\left(a\right)}$
\end_inset

.
 לכל 
\begin_inset Formula $x\in U$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
