\begin_inset Formula 
\begin{align*}
p\left(x\right) & =a_{n}\cdot x^{n}+a_{n-1}\cdot x^{n-1}+\ldots+a_{1}\cdot x+a_{0}\\
q\left(x\right) & =b_{m}\cdot x^{m}+b_{m-1}\cdot x^{m-1}+\ldots+b_{1}\cdot x+b_{0}
\end{align*}

\end_inset

נסמן 
\begin_inset Formula $j:=\min\left\{ n\geq i\in\MKnatural_{0}\mid a_{i}\neq0\right\} $
\end_inset

 ו-
\begin_inset Formula $k:=\min\left\{ m\geq i\in\MKnatural_{0}\mid b_{i}\neq0\right\} $
\end_inset

,
 מתקיימים כל הפסוקים הבאים:
\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula $k<j$
\end_inset

 אז 
\begin_inset Formula $\begin{alignedat}{1}\lim_{x\rightarrow0}\frac{p\left(x\right)}{q\left(x\right)}=0\end{alignedat}
$
\end_inset

.
\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula $k=j$
\end_inset

 אז 
\begin_inset Formula $\begin{alignedat}{1}\lim_{x\rightarrow0}\frac{p\left(x\right)}{q\left(x\right)}=\frac{a_{k}}{b_{k}}\end{alignedat}
$
\end_inset

.
\end_layout

\begin_layout Itemize
נניח ש-
\begin_inset Formula $k>j$
\end_inset

,
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula $\MKsign\left(a_{k}\right)=\MKsign\left(b_{j}\right)$
\end_inset

 אז 
\begin_inset Formula $\begin{alignedat}{1}\lim_{x\rightarrow0}\frac{p\left(x\right)}{q\left(x\right)}=\infty\end{alignedat}
$
\end_inset

.
\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula $\MKsign\left(a_{k}\right)\neq\MKsign\left(b_{j}\right)$
\end_inset

 אז 
\begin_inset Formula $\begin{alignedat}{1}\lim_{x\rightarrow0}\frac{p\left(x\right)}{q\left(x\right)}=-\infty\end{alignedat}
$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Proof
כדי להוכיח את שני הסעיפים הראשונים יש לגזור את שני הפולינומים 
\begin_inset Formula $k$
\end_inset

 פעמים ואז מהמסקנה האחרונה (
