\begin_layout Theorem

\series bold
כלל לופיטל לגבול של פונקציה בנקודה
\series default

\begin_inset Newline newline
\end_inset

תהיינה 
\begin_inset Formula $f,g:A\rightarrow B$
\end_inset

 שתי פונקציות כך ש-
\begin_inset Formula $A$
\end_inset

 מכילה סביבה מנוקבת של נקודה 
\begin_inset Formula $a\in\MKreal$
\end_inset

 ובנוסף 
\begin_inset Formula $f$
\end_inset

 ו-
\begin_inset Formula $g$
\end_inset

 גזירות בסביבה זו.
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula $\begin{alignedat}{1}\lim_{x\rightarrow a}f\left(x\right)=\lim_{x\rightarrow a}g\left(x\right)=0\end{alignedat}
$
\end_inset

 וגם הגבול 
\begin_inset Formula $\begin{alignedat}{1}\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}\end{alignedat}
$
\end_inset

 קיים (במובן הרחב) אז מתקיים:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{f\left(x\right)}{g\left(x\right)}=\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}
\]

\end_inset


\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula $\begin{alignedat}{1}\lim_{x\rightarrow a}f\left(x\right)=\lim_{x\rightarrow a}g\left(x\right)=\pm\infty\end{alignedat}
$
\end_inset

 וגם הגבול 
\begin_inset Formula $\begin{alignedat}{1}\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}\end{alignedat}
$
\end_inset

 קיים (במובן הרחב
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
לא ייתכן שהגבול של מנת הנגזרות הוא 
\begin_inset Formula $-\infty$
\end_inset

,
 הוכחה לכך נמצאת בקובץ ההוכחות (בהוכחה של סעיף זה).
\end_layout

\end_inset

) אז מתקיים:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{f\left(x\right)}{g\left(x\right)}=\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}
\]

\end_inset


\end_layout

\end_deeper
\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 כלל לופיטל לגבול של פונקציה בנקודה נכון גם עבור גבולות חד-צדדיים (ואז ניתן להסתפק בסביבה חד-צדדית של 
\begin_inset Formula $a$
\end_inset

 שבה 
\begin_inset Formula $f$
\end_inset

 ו-
\begin_inset Formula $g$
\end_inset

 גזירות).
\end_layout

\begin_layout Proof
נניח שהגבול 
\begin_inset Formula $L:=\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}$
\end_inset

 קיים במובן הרחב,
 מכאן נובע שקיימת סביבה מנוקבת של 
\begin_inset Formula $a$
\end_inset

 שבה 
\begin_inset Formula $g'$
\end_inset

 אינה מתאפסת ולכן ע"פ משפט רול גם 
\begin_inset Formula $g$
\end_inset

 אינה מתאפסת בסביבה זו.
\begin_inset Newline newline
\end_inset

נעסוק תחילה במקרה שבו 
\begin_inset Formula $\lim_{x\rightarrow a}f\left(x\right)=\lim_{x\rightarrow a}g\left(x\right)=0$
\end_inset

.
\begin_inset Newline newline
\end_inset

נשים לב שניתן להניח כי 
\begin_inset Formula $f$
\end_inset

 ו-
\begin_inset Formula $g$
\end_inset

 מוגדרות ב-
\begin_inset Formula $a$
\end_inset

 ורציפות בה (כלומר 
\begin_inset Formula $f\left(a\right)=g\left(a\right)=0$
\end_inset

),
 תהיינה 
\begin_inset Formula $F,G:A\cup\left\{ a\right\} \rightarrow B\cup\left\{ 0\right\} $
\end_inset

 שתי פונקציות המוגדרות ע"י (לכל 
\begin_inset Formula $x\in A\cup\left\{ a\right\} $
\end_inset

):
\begin_inset Formula 
\[
\tilde{f}\left(x\right)=\begin{cases}
f\left(x\right) & x\neq a\\
0 & x=a
\end{cases},\ \tilde{g}\left(x\right)=\begin{cases}
g\left(x\right) & x\neq a\\
0 & x=a
\end{cases}
\]

\end_inset

ונניח שהצלחנו להוכיח כי:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{\tilde{f}\left(x\right)}{\tilde{g}\left(x\right)}=\lim_{x\rightarrow a}\frac{\tilde{f}'\left(x\right)}{\tilde{g}'\left(x\right)}
\]

\end_inset

ובפרט קיימת סביבה מנוקבת של 
\begin_inset Formula $a$
\end_inset

 שבה 
\begin_inset Formula $G$
\end_inset

 ו-
\begin_inset Formula $G'$
\end_inset

 אינן מתאפסות,
 נשים לב שלכל 
\begin_inset Formula $a\neq x\in A$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\frac{f\left(x\right)}{g\left(x\right)}=\frac{\tilde{f}\left(x\right)}{\tilde{g}\left(x\right)},\ \frac{f'\left(x\right)}{g'\left(x\right)}=\frac{\tilde{f}'\left(x\right)}{\tilde{g}'\left(x\right)}
\]

\end_inset

ולכן גם:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{f\left(x\right)}{g\left(x\right)}=\lim_{x\rightarrow a}\frac{\tilde{f}\left(x\right)}{\tilde{g}\left(x\right)}=\lim_{x\rightarrow a}\frac{\tilde{f}'\left(x\right)}{\tilde{g}'\left(x\right)}=\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}
\]

\end_inset

שכן הגבול אינו מושפע כלל מערך הפונקציה בנקודה.
 א"כ נניח כי 
\begin_inset Formula $f$
\end_inset

 ו-
\begin_inset Formula $g$
\end_inset

 רציפות ב-
\begin_inset Formula $a$
\end_inset

,
 כלומר 
\begin_inset Formula $f$
\end_inset

 ו-
\begin_inset Formula $g$
\end_inset

 מוגדרות ב-
\begin_inset Formula $a$
\end_inset

 ומתקיים 
\begin_inset Formula $f\left(a\right)=g\left(a\right)=0$
\end_inset

.
\end_layout

\begin_deeper
\begin_layout Itemize
נניח ש-
\begin_inset Formula $L\in\MKreal$
\end_inset

 ויהי 
\begin_inset Formula $0<\varepsilon\in\MKreal$
\end_inset

.
\begin_inset Newline newline
\end_inset

מהגדרת הגבול קיימת 
\begin_inset Formula $0<\delta\in\MKreal$
\end_inset

 כך שלכל 
\begin_inset Formula $x\in B_{\delta}^{\circ}\left(a\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left|\frac{f'\left(x\right)}{g'\left(x\right)}-L\right|<\varepsilon
\]

\end_inset

תהא 
\begin_inset Formula $\delta$
\end_inset

 כנ"ל.
 ממשפט הערך הממוצע של קושי נובע שלכל 
\begin_inset Formula $x\in B_{\delta}^{\circ}\left(a\right)$
\end_inset

 קיימת נקודה 
\begin_inset Formula $c_{x}\in B_{\delta}^{\circ}\left(a\right)$
\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
ליתר דיוק המשפט קובע ש-
\begin_inset Formula $c_{x}$
\end_inset

 שייך לאותה סביבה חד-צדדית של 
\begin_inset Formula $a$
\end_inset

 שאליה שייך 
\begin_inset Formula $x$
\end_inset

 ולכן כלל לופיטל עובד גם עבור גבולות חד-צדדיים.
\end_layout

\end_inset

 כך שמתקיים:
\begin_inset Formula 
\[
\frac{f\left(x\right)}{g\left(x\right)}=\frac{f\left(x\right)-f\left(a\right)}{g\left(x\right)-g\left(a\right)}=\frac{f'\left(c_{x}\right)}{g'\left(c_{x}\right)}
\]

\end_inset

ומכאן שלכל 
\begin_inset Formula $x\in B_{\delta}^{\circ}\left(a\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left|\frac{f\left(x\right)}{g\left(x\right)}-L\right|<\varepsilon
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow\lim_{x\rightarrow a}\frac{f\left(x\right)}{g\left(x\right)}=L=\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}
\]

\end_inset


\end_layout

\begin_layout Itemize
נניח ש-
\begin_inset Formula $L=\infty$
\end_inset

,
 כפי שראינו לעיל נובע מזה שלכל 
\begin_inset Formula $M\in\MKreal$
\end_inset

 קיימת 
\begin_inset Formula $0<\delta\in\MKreal$
\end_inset

 כך שלכל 
\begin_inset Formula $x\in B_{\delta}^{\circ}\left(a\right)$
\end_inset

 קיים 
\begin_inset Formula $c_{x}\in B_{\delta}^{\circ}\left(a\right)$
\end_inset

 המקיים:
\begin_inset Formula 
\[
\frac{f\left(x\right)}{g\left(x\right)}=\frac{f\left(x\right)-f\left(a\right)}{g\left(x\right)-g\left(a\right)}=\frac{f'\left(c_{x}\right)}{g'\left(c_{x}\right)}>M
\]

\end_inset

ולכן מתקיים:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{f\left(x\right)}{g\left(x\right)}=\infty=\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}
\]

\end_inset


\end_layout

\begin_layout Itemize
ההוכחה עבור 
\begin_inset Formula $L=-\infty$
\end_inset

 זהה עד כדי החלפת כיווני האי-שוויון שלעיל.
\end_layout

\begin_layout Standard
כעת נעבור לעסוק במקרה שבו 
\begin_inset Formula $\lim_{x\rightarrow a}f\left(x\right)=\lim_{x\rightarrow a}g\left(x\right)=\pm\infty$
\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
הוכחה זו נלמדה אצל יורם.
\end_layout

\end_inset

.
\end_layout

\begin_layout Itemize
נניח כי 
\begin_inset Formula $L\in\MKreal$
\end_inset

 ויהי 
\begin_inset Formula $0<\varepsilon\in\MKreal$
\end_inset

.
\begin_inset Newline newline
\end_inset

מהגדרת הגבול קיימת 
\begin_inset Formula $0<\eta\in\MKreal$
\end_inset

 כך שלכל 
\begin_inset Formula $x\in B_{\eta}^{\circ}\left(a\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left|\frac{f'\left(x\right)}{g'\left(x\right)}-L\right|<\frac{\varepsilon}{2}
\]

\end_inset

תהא 
\begin_inset Formula $\eta$
\end_inset

 כנ"ל ומכאן שע"פ משפט הערך הממוצע של קושי לכל 
\begin_inset Formula $x\in B_{\eta}^{\circ}\left(a\right)$
\end_inset

 קיימת נקודה 
\begin_inset Formula $c_{x}\in B_{\eta}^{\circ}\left(a\right)$
\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
ושוב:
 המשפט קובע ש-
\begin_inset Formula $c_{x}$
\end_inset

 שייך לאותה סביבה חד-צדדית של 
\begin_inset Formula $a$
\end_inset

 שאליה שייך 
\begin_inset Formula $x$
\end_inset

 ולכן כלל לופיטל עובד גם עבור גבולות חד-צדדיים.
\end_layout

\end_inset

 כך שמתקיים:
\begin_inset Formula 
\[
\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}=\frac{f'\left(c_{x}\right)}{g'\left(c_{x}\right)}
\]

\end_inset

ולכן לכל 
\begin_inset Formula $x\in B_{\eta}^{\circ}\left(a\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left|\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}-L\right|<\frac{\varepsilon}{2}
\]

\end_inset

ובנוסף:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}=L
\]

\end_inset

כעת נשים לב לכך שלכל 
\begin_inset Formula $x\in B_{\eta}^{\circ}\left(a\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\frac{f\left(a+\eta\right)}{g\left(x\right)}-\frac{g\left(a+\eta\right)}{g\left(x\right)}\cdot\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)} & =\frac{f\left(a+\eta\right)\cdot\left(g\left(x\right){\color{red}-g\left(a+\eta\right)}\right)-g\left(a+\eta\right)\left(f\left(x\right){\color{red}-f\left(a+\eta\right)}\right)}{g\left(x\right)\cdot\left(g\left(x\right)-g\left(a+\eta\right)\right)}\\
 & =\frac{f\left(a+\eta\right)\cdot g\left(x\right)-g\left(a+\eta\right)f\left(x\right)}{g\left(x\right)\cdot\left(g\left(x\right)-g\left(a+\eta\right)\right)}\\
 & =\frac{f\left(a+\eta\right)\cdot g\left(x\right)-f\left(x\right)\cdot g\left(x\right)+f\left(x\right)\cdot g\left(x\right)-g\left(a+\eta\right)\cdot f\left(x\right)}{g\left(x\right)\cdot\left(g\left(x\right)-g\left(a+\eta\right)\right)}\\
 & =\frac{\left(f\left(a+\eta\right)-f\left(x\right)\right)\cdot g\left(x\right)+f\left(x\right)\cdot\left(g\left(x\right)-g\left(a+\eta\right)\right)}{g\left(x\right)\cdot\left(g\left(x\right)-g\left(a+\eta\right)\right)}\\
 & =\frac{f\left(a+\eta\right)-f\left(x\right)}{g\left(x\right)-g\left(a+\eta\right)}+\frac{f\left(x\right)}{g\left(x\right)}\\
 & =\frac{f\left(x\right)}{g\left(x\right)}-\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}
\end{align*}

\end_inset

מהעובדה ש-
\begin_inset Formula $\lim_{x\rightarrow a}g\left(x\right)=\pm\infty$
\end_inset

 נובע שמתקיים:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{f\left(a+\eta\right)}{g\left(x\right)}=\lim_{x\rightarrow a}\frac{g\left(a+\eta\right)}{g\left(x\right)}=0
\]

\end_inset

ולכן מאריתמטיקה של גבולות נובע כי:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\left(\frac{f\left(x\right)}{g\left(x\right)}-\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}\right)=\lim_{x\rightarrow a}\left(\frac{f\left(a+\eta\right)}{g\left(x\right)}-\frac{g\left(a+\eta\right)}{g\left(x\right)}\cdot\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}\right)=0-0\cdot L=0
\]

\end_inset

ומכאן שקיימת 
\begin_inset Formula $0<\delta\in\MKreal$
\end_inset

 כך ש-
\begin_inset Formula $\delta\leq\eta$
\end_inset

 ולכל 
\begin_inset Formula $x\in B_{\delta}^{\circ}\left(a\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left|\frac{f\left(x\right)}{g\left(x\right)}-\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}\right|<\frac{\varepsilon}{2}
\]

\end_inset

תהא 
\begin_inset Formula $\delta$
\end_inset

 כנ"ל ומכאן שלכל 
\begin_inset Formula $x\in B_{\delta}^{\circ}\left(a\right)$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\varepsilon & >\left|\frac{f\left(x\right)}{g\left(x\right)}-\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}\right|+\left|\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}-L\right|\\
 & \geq\left|\frac{f\left(x\right)}{g\left(x\right)}-\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}+\frac{f\left(x\right)-f\left(a+\eta\right)}{g\left(x\right)-g\left(a+\eta\right)}-L\right|\\
 & =\left|\frac{f\left(x\right)}{g\left(x\right)}-L\right|
\end{align*}

\end_inset


\begin_inset Formula 
\[
\Rightarrow\lim_{x\rightarrow a}\frac{f\left(x\right)}{g\left(x\right)}=L=\lim_{x\rightarrow a}\frac{f'\left(x\right)}{g'\left(x\right)}
\]

\end_inset


\end_layout

\begin_layout Itemize
נניח ש-
\begin_inset Formula $L=\pm\infty$
\end_inset

,
 בפרט קיימת סביבה של 
\begin_inset Formula $a$
\end_inset

 שבה 
\begin_inset Formula $f'$
\end_inset

 אינה מתאפסת ומכאן שמתקיים:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{g'\left(x\right)}{f'\left(x\right)}=0
\]

\end_inset

ולפי המקרה הקודם נובע מכאן שמתקיים:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\frac{g\left(x\right)}{f\left(x\right)}=0
\]

\end_inset

ולכן גם:
\begin_inset Formula 
\[
\lim_{x\rightarrow a}\left|\frac{f\left(x\right)}{g\left(x\right)}\right|=\infty
\]

\end_inset

