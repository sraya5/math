\begin_inset Formula 
\[
F'\left(x\right)=-\frac{1}{x^{2}}\cdot f'\left(\frac{1}{x}\right),\ G'\left(x\right)=-\frac{1}{x^{2}}\cdot g'\left(\frac{1}{x}\right)
\]

