\begin_inset Formula 
\[
\sin^{\left(n\right)}\left(0\right)=\begin{cases}
\sin0 & n\equiv0\mod 4\\
\cos0 & n\equiv1\mod 4\\
-\sin0 & n\equiv2\mod 4\\
-\cos0 & n\equiv3\mod 4
\end{cases}=\begin{cases}
0 & n\equiv0\mod 4\\
1 & n\equiv1\mod 4\\
0 & n\equiv2\mod 4\\
-1 & n\equiv3\mod 4
\end{cases}
\]

\end_inset

