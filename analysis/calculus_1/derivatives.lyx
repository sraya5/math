\begin_layout Theorem

\series bold
פולינומי טיילור של פונקציות אלמנטריות
\series default

\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

 ולכל 
\begin_inset Formula $n\in\MKnatural_{0}$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
P_{n,\exp,0}\left(x\right) & =\sum_{k=0}^{n}\frac{x^{k}}{k!} & P_{n,\sin,a}\left(x\right) & =\sum_{k=0}^{\left\lfloor \frac{n-1}{2}\right\rfloor }\left(-1\right)^{k}\cdot\frac{x^{2k+1}}{\left(2k+1\right)!}\\
P_{n,\ln,1}\left(x\right) & =\sum_{k=1}^{n}\left(-1\right)^{k-1}\cdot\frac{\left(x-1\right)^{k}}{k} & P_{n,\cos,0}\left(x\right) & =\sum_{k=0}^{\left\lfloor \frac{n}{2}\right\rfloor }\left(-1\right)^{k}\cdot\frac{x^{2k}}{\left(2k\right)!}
\end{align*}

\end_inset


\end_layout

\begin_layout Proof
\begin_inset space \space{}
\end_inset


\end_layout

\begin_deeper
\begin_layout Enumerate
מהגדרה לכל 
\begin_inset Formula $n\in\MKnatural_{0}$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
P_{n,\exp,0}\left(x\right)=\sum_{k=0}^{n}\frac{\exp^{\left(k\right)}\left(0\right)}{k!}\cdot x^{k}=\sum_{k=0}^{n}\frac{\exp\left(0\right)}{k!}\cdot x^{k}=\sum_{k=0}^{n}\frac{1}{k!}\cdot x^{k}=\sum_{k=0}^{n}\frac{x^{k}}{k!}
\]

\end_inset


\end_layout

\begin_layout Enumerate
מכללי גזירה לכל 
\begin_inset Formula $n\in\MKnatural_{0}$
\end_inset

 ולכל 
\begin_inset Formula $0<x\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\ln^{\left(n\right)}\left(x\right)=\begin{cases}
\ln\left(x\right) & n=0\\
\left(n-1\right)!\cdot x^{-n} & n\in\MKodd\\
-\left(n-1\right)!\cdot x^{-n} & n\in\MKeven
\end{cases}
\]

\end_inset

מכאן שב-
\begin_inset Formula $x=1$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\ln^{\left(n\right)}\left(x\right)=\begin{cases}
\ln\left(1\right) & n=0\\
\left(n-1\right)!\cdot1^{-n} & n\in\MKodd\\
-\left(n-1\right)!\cdot1^{-n} & n\in\MKeven
\end{cases}=\begin{cases}
0 & n=0\\
\left(n-1\right)! & n\in\MKodd\\
-\left(n-1\right)! & n\in\MKeven
\end{cases}
\]

\end_inset

ולכן פולינום טיילור של 
\begin_inset Formula $\ln$
\end_inset

 מסדר 
\begin_inset Formula $n$
\end_inset

 ב-
\begin_inset Formula $1$
\end_inset

 הוא:
\begin_inset Formula 
\[
P_{n,\ln,1}\left(x\right)=\sum_{k=1}^{n}\frac{\left(-1\right)^{k-1}\cdot\left(k-1\right)!}{k!}\cdot\left(x-1\right)^{k}=\sum_{k=1}^{n}\left(-1\right)^{k-1}\cdot\frac{\left(x-1\right)^{k}}{k}
\]

\end_inset


\end_layout

\begin_layout Enumerate
לכל 
\begin_inset Formula $n\in\MKnatural_{0}$
\end_inset

 ולכל 
\begin_inset Formula $x\in\MKreal$
\end_inset

