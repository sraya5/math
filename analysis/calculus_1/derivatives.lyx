\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 הרעיון מאחורי הפירמול הוא שגרף הפונקציה נמצא מעל/מתחת לישר המחבר בין 
\begin_inset Formula $f\left(a\right)$
\end_inset

 ל-
\begin_inset Formula $f\left(b\right)$
\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
בניגוד למה שהיה ניתן לצפות,
 פונקציה היא 
\series bold
\color blue
קמורה
\series default
\color inherit
 אם גרף הפונקציה נמצא 
\series bold
\color blue
מתחת
\series default
\color inherit
 לישר המחבר בין הנקודה 
\begin_inset Formula $\left(a,f\left(a\right)\right)$
\end_inset

 (במישור הקרטזי) לנקודה 
\begin_inset Formula $\left(b,f\left(b\right)\right)$
\end_inset

 ו
\series bold
\color blue
קעורה
\series default
\color inherit
 אם הוא נמצא 
\series bold
\color blue
מעל
\series default
\color inherit
 לישר,
 הסיבה לכך היא שמה שמעניין מתמטיקאים הוא האם קבוצת הנקודות ש
\series bold
\color blue
מעל
\series default
\color inherit
 הגרף היא קבוצה קמורה/קעורה.
\end_layout

\end_inset

.
\begin_inset Newline newline
\end_inset

נסמן 
\begin_inset Formula $x=b+t\cdot\left(a-b\right)$
\end_inset

 נשים לב שמתקיים:
\begin_inset Formula 
\begin{align*}
t\cdot f\left(a\right)+\left(1-t\right)\cdot f\left(b\right) & =f\left(b\right)+\left(f\left(a\right)-f\left(b\right)\right)\cdot t\\
 & =f\left(b\right)+\frac{f\left(a\right)-f\left(b\right)}{a-b}\cdot\left(x-b\right)
\end{align*}

\end_inset

 ולכן זוהי המשוואה של הישר המחבר,
 ומתקיים:
\begin_inset Formula 
\begin{align*}
f\left(t\cdot a+\left(1-t\right)\cdot b\right) & =f\left(b+\left(a-b\right)\cdot t\right)\\
 & =f\left(x\right)
\end{align*}

\end_inset

ולכן זהו גרף הפונקציה בנקודה המתאימה.
\end_layout

