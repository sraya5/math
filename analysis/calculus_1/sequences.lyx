\begin_layout Lemma
יהיו 
\begin_inset Formula
$\alpha,\beta\in\MKreal$
\end_inset
, יהי 
\begin_inset Formula
$0<r\in\MKreal$
\end_inset
 ויהיו 
\begin_inset Formula
$x\in B_{r}\left(\alpha\right),\ y\in B_{r}\left(\beta\right)$
\end_inset
, מתקיים 
\begin_inset Formula
$x+y\in B_{2r}\left(\alpha+\beta\right)$
\end_inset
.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

\end_layout

\begin_layout Lemma
יהי 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
 ויהיו 
\begin_inset Formula
$\alpha,\beta,x,y\in\MKreal$
\end_inset
, אם 
\begin_inset Formula
$\begin{alignedat}{1}\left|x-\alpha\right|<\frac{\varepsilon}{2\left(\left|\beta\right|+1\right)}\end{alignedat}
$

\end_inset
 וגם 
\begin_inset Formula
$\begin{alignedat}{1}\left|y-\beta\right|<\min\left\{ 1,\frac{\varepsilon}{2\left(\left|\alpha\right|+1\right)}\right\} \end{alignedat}
$

\end_inset
 אז
\begin_inset Newline newline
\end_inset

\begin_inset Formula
$\left|x\cdot y-\alpha\cdot\beta\right|<\varepsilon$
\end_inset
.
\end_layout

\begin_layout Proof
מא"ש המשולש ההפוך נובע ש-
\begin_inset Formula
$\left|\left|y\right|-\left|\beta\right|\right|\leq\left|y-\beta\right|<1$
\end_inset
, ומכאן ש-
\begin_inset Formula
$\left|y\right|<\left|\beta\right|+1$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\left|x\cdot y-\alpha\cdot\beta\right| & =\left|x\cdot y-y\cdot\alpha+y\cdot\alpha-\alpha\cdot\beta\right|\\
 & =\left|y\cdot\left(x-\alpha\right)+\left(y-\beta\right)\cdot\alpha\right|\\
 & \leq\left|y\cdot\left(x-\alpha\right)\right|+\left|\left(y-\beta\right)\cdot\alpha\right|\\
 & =\left|y\right|\cdot\left|x-\alpha\right|+\left|y-\beta\right|\cdot\left|\alpha\right|\\
 & <\left|y\right|\cdot\frac{\varepsilon}{2\left(\left|\beta\right|+1\right)}+\frac{\varepsilon}{2\left(\left|\alpha\right|+1\right)}\cdot\left|\alpha\right|\\
 & <\left(\left|\beta\right|+1\right)\cdot\frac{\varepsilon}{2\left(\left|\beta\right|+1\right)}+\frac{\varepsilon}{2\left(\left|\alpha\right|+1\right)}\cdot\left|\alpha\right|\\
 & <\frac{\varepsilon}{2}+\frac{\varepsilon}{2}=\varepsilon
\end{align*}


\end_inset

\end_layout

\begin_layout Lemma
יהיו 
\begin_inset Formula
$0\neq\beta\in\MKreal$
\end_inset
, 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
 ו-
\begin_inset Formula
$y\in\MKreal$
\end_inset
, אם:
\begin_inset Formula
\[
\left|y-\beta\right|<\min\left\{ \frac{\left|\beta\right|}{2},\frac{\left|\beta\right|^{2}\cdot\varepsilon}{2}\right\} 
\]


\end_inset
אז 
\begin_inset Formula
$y\neq0$
\end_inset
 וגם:
\begin_inset Formula
\[
\left|\frac{1}{y}-\frac{1}{\beta}\right|<\varepsilon
\]


\end_inset

\end_layout

\begin_layout Proof
מההנחה נקבל שמתקיים:
\begin_inset Formula
\begin{align*}
\left|\beta\right|-\left|y\right| & \leq\left|\left|\beta\right|-\left|y\right|\right|=\left|\left|y\right|-\left|\beta\right|\right|\leq\left|y-\beta\right|\leq\frac{\left|\beta\right|}{2}\\
\Rightarrow & 0<\frac{\left|\beta\right|}{2}=\left|\beta\right|-\frac{\left|\beta\right|}{2}\leq\left|y\right|\\
\Rightarrow & y\neq0
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\left|\frac{1}{y}-\frac{1}{\beta}\right| & =\left|\frac{\beta-y}{y\cdot\beta}\right|=\frac{\left|y-\beta\right|}{\left|y\right|\cdot\left|\beta\right|}\\
 & <\frac{\left|\beta\right|^{2}\cdot\varepsilon}{2\cdot\left|y\right|\cdot\left|\beta\right|}=\frac{\left|\beta\right|\cdot\varepsilon}{2\cdot\left|y\right|}\\
 & \leq\frac{\left|\beta\right|\cdot\varepsilon}{2\cdot\frac{\left|\beta\right|}{2}}=\varepsilon
\end{align*}


\end_inset

\end_layout

