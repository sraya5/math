\begin_inset Formula
\[
\left(\frac{1}{n}\cdot\sum_{k=1}^{n}\frac{1}{a_{k}}\right)^{-1}\leq\sqrt[n]{\prod_{k=1}^{n}a_{k}}\leq\frac{1}{n}\cdot\sum_{k=1}^{n}a_{k}
\]


\end_inset
כלומר: לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
