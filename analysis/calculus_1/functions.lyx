\end_inset
, ולכן:
\begin_inset Formula
\[
\frac{1}{\exp\left(x\right)}=\exp\left(-x\right)\geq1-x
\]


\end_inset
כלומר:
\begin_inset Formula
\[
\exp\left(x\right)\leq\frac{1}{1-x}
\]


\end_inset

\end_layout

