\begin_layout Proof
תהא 
\begin_inset Formula
$\theta\in\left(0,\frac{\pi}{2}\right)$
\end_inset
 ונסמן את הנקודות הבאות במישור (ראו באיור):
\begin_inset Formula
\begin{align*}
O & :=\left(0,0\right)\\
A & :=\left(\cos\theta,\sin\theta\right)\\
B & :=\left(1,0\right)\\
C & :=\left(1,\frac{\sin\theta}{\cos\theta}\right)
\end{align*}


\end_inset
א"כ שטח המשולש 
\begin_inset Formula
$\Delta AOB$
\end_inset
 הוא:
\begin_inset Formula
\[
S_{\Delta AOB}=\frac{1}{2}\cdot\sin\theta
\]


\end_inset
השטח של הגזרה 
\begin_inset Formula
$\angle AOB$
\end_inset

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
החלק בעיגול ("משולש הפיצה") התחום בין הרדיוס העובר ב-
\begin_inset Formula
$A$
\end_inset
 לרדיוס העובר ב-
\begin_inset Formula
$B$
\end_inset
.
\end_layout

\end_inset
 הוא:
\begin_inset Formula
\[
S_{\angle AOB}=\frac{1}{2}\cdot\theta
\]


\end_inset
כמו כן, שטח המשולש 
\begin_inset Formula
$\Delta COB$
\end_inset
 הוא:
\begin_inset Formula
\[
S_{\Delta COB}=\frac{1}{2}\cdot\frac{\sin\theta}{\cos\theta}=\frac{1}{2}\cdot\frac{\sin\theta}{\cos\theta}
\]


\end_inset
מהעובדה שהמשולש 
\begin_inset Formula
$\Delta COB$
\end_inset
 מכיל את הגזרה 
\begin_inset Formula
$\angle AOB$
\end_inset
 שמכילה את המשולש 
\begin_inset Formula
$\Delta COB$
\end_inset
 נובע שמתקיים:
\begin_inset Formula
\[
\frac{1}{2}\cdot\sin\theta\leq\frac{1}{2}\cdot\theta\leq\frac{1}{2}\cdot\frac{\sin\theta}{\cos\theta}
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow1\leq\frac{\theta}{\sin\theta}\leq\frac{1}{\cos\theta}
\]


\end_inset
מהעובדה ש-
\begin_inset Formula
$\sin$
\end_inset
 אי-זוגית ו-
\begin_inset Formula
$\sin$
\end_inset
 זוגית נובע שמתקיים:
\begin_inset Formula
\[
\frac{-\theta}{\sin\left(-\theta\right)}=\frac{-\theta}{-\sin\theta}=\frac{\theta}{\sin\theta},\ \frac{1}{\cos\left(-\theta\right)}=\frac{1}{\cos\theta}
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow1\leq\frac{-x}{\sin\left(-x\right)}\leq\frac{1}{\cos\left(-x\right)}
\]


\end_inset

\begin_inset Formula
$\theta$
\end_inset
 הנ"ל היתה שרירותית ולכן הנ"ל נכון לכל 
\begin_inset Formula
$x\in\left(0,\frac{\pi}{2}\right)$
\end_inset
, כלומר לכל 
\begin_inset Formula
$0\neq x\in\left(-\frac{\pi}{2},\frac{\pi}{2}\right)$
\end_inset
 מתקיים:
\begin_inset Formula
\[
1\leq\frac{x}{\sin x}\leq\frac{1}{\cos x}
\]


\end_inset
מהרציפות של 
\begin_inset Formula
$\cos$
\end_inset
 נובע שמתקיים:
\begin_inset Formula
\[
\lim_{x\rightarrow0}\frac{1}{\cos x}=1
\]


\end_inset
ומכאן שע"פ משפט הכריך מתקיים:
\begin_inset Formula
\[
\lim_{x\rightarrow0}\frac{x}{\sin x}=1
\]


\end_inset
ולכן מאריתמטיקה של גבולות נובע כי:
\begin_inset Formula
\[
\lim_{x\rightarrow0}\frac{\sin x}{x}=1
\]


\end_inset

