\begin_layout Proof
יהי 
\begin_inset Formula
$1\leq M\in\MKreal$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
M>\sum_{k=0}^{n-1}\left|a_{k}\right|
\]


\end_inset
יהי 
\begin_inset Formula
$M\leq x\in\MKreal$
\end_inset
, א"כ מתקיים 
\begin_inset Formula
$1\leq x$
\end_inset
 וגם:
\begin_inset Formula
\[
x>\sum_{k=0}^{n-1}\left|a_{k}\right|
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow x^{n}>x^{n-1}\cdot\sum_{k=0}^{n-1}\left|a_{k}\right|\geq\sum_{k=0}^{n-1}\left|a_{k}\right|\cdot x^{k}=\sum_{k=0}^{n-1}\left|a_{k}\cdot x^{k}\right|
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow0<x^{n}-\sum_{k=0}^{n-1}\left|a_{k}\cdot x^{k}\right|\leq x^{n}+\sum_{k=0}^{n-1}a_{k}\cdot x^{k}=p\left(x\right)
\]


\end_inset
יהי 
\begin_inset Formula
$-M\geq y\in\MKreal$
\end_inset
, א"כ מתקיים 
\begin_inset Formula
$1\leq-y$
\end_inset
 וגם:
\begin_inset Formula
\[
-y>\sum_{k=0}^{n-1}\left|a_{k}\right|
\]


\end_inset
ולכן גם:
\begin_inset Formula
\[
\left(-y\right)^{n}>\sum_{k=0}^{n-1}\left|a_{k}\cdot\left(-y\right)^{k}\right|=\sum_{k=0}^{n-1}\left|a_{k}\cdot y^{k}\right|
\]


\end_inset
כעת נחלק למקרים:
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula
$n\in\MKeven$
\end_inset
 אז 
\begin_inset Formula
$\left(-y\right)^{n}=y^{n}$
\end_inset
 ומכאן שמתקיים:
\begin_inset Formula
\[
0<y^{n}-\sum_{k=0}^{n-1}\left|a_{k}\cdot y^{k}\right|\leq y^{n}+\sum_{k=0}^{n-1}a_{k}\cdot y^{k}=p\left(y\right)
\]


\end_inset

\end_layout

\begin_layout Itemize
ואם 
\begin_inset Formula
$n\in\MKodd$
\end_inset
 אז 
\begin_inset Formula
$\left(-y\right)^{n}=-y^{n}$
\end_inset
 ומכאן שמתקיים:
\begin_inset Formula
\[
0>y^{n}+\sum_{k=0}^{n-1}\left|a_{k}\cdot y^{k}\right|\geq y^{n}+\sum_{k=0}^{n-1}a_{k}\cdot y^{k}=p\left(y\right)
\]


\end_inset

\end_layout

\end_deeper

