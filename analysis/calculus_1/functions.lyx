\begin_layout Standard
יהי 
\begin_inset Formula
$\alpha\in\MKreal$
\end_inset
 ותהא 
\begin_inset Formula
$\left(a_{n}\right)_{n=1}^{\infty}$
\end_inset
 סדרה המוגדרת ע"י 
\begin_inset Formula
$\begin{alignedat}{1}a_{n}:=\left(1+\frac{\alpha}{n}\right)^{n}\end{alignedat}
$

\end_inset
 (לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
), נרצה להוכיח שהגבול 
\begin_inset Formula
$\begin{alignedat}{1}\lim_{n\rightarrow\infty}a_{n}\end{alignedat}
$

\end_inset
 קיים.
\end_layout

\begin_layout Claim
קיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך שהסדרה 
\begin_inset Formula
$\left(a_{n}\right)_{n=N}^{\infty}$
\end_inset
 מונוטונית עולה.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$N\geq\left|\alpha\right|$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$N\leq n\in\MKnatural$
\end_inset
,
\begin_inset Formula
\begin{align*}
 & \Rightarrow n>\left|\alpha\right|\\
 & \Rightarrow-n<\alpha<n\\
 & \Rightarrow-1<\frac{\alpha}{n}<1\\
 & \Rightarrow0<1+\frac{\alpha}{n}
\end{align*}


\end_inset
נסמן:
\begin_inset Formula
\begin{align*}
b_{1} & :=b_{2}:=\ldots b_{n}:=1+\frac{\alpha}{n}>0\\
 & b_{n+1}:=1>0
\end{align*}


\end_inset
מא"ש הממוצעים נובע שמתקיים:
\begin_inset Formula
\[
\sqrt[n+1]{\left(1+\frac{\alpha}{n}\right)^{n}\cdot1}=\sqrt[n+1]{\prod_{i=1}^{n+1}b_{i}}\leq\frac{1}{n+1}\cdot\sum_{i=1}^{n+1}b_{n}=\frac{n\cdot\left(1+\frac{\alpha}{n}\right)+1}{n+1}
\]


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow\sqrt[n+1]{\left(1+\frac{\alpha}{n}\right)^{n}}\leq\frac{n+\alpha+1}{n+1}=1+\frac{\alpha}{n+1}\\
 & \Rightarrow a_{n}=\left(1+\frac{\alpha}{n}\right)^{n}\leq\left(1+\frac{\alpha}{n+1}\right)^{n+1}=a_{n+1}
\end{align*}


\end_inset

\begin_inset Formula
$n$
\end_inset
 הנ"ל היה שרירותי ומכאן שהנ"ל נכון לכל 
\begin_inset Formula
$N\leq n\in\MKnatural$
\end_inset
, כלומר 
\begin_inset Formula
$\left(a_{n}\right)_{n=N}^{\infty}$
\end_inset
 היא סדרה מונוטונית עולה.
\end_layout

\begin_layout Claim
\begin_inset Formula
$\left(a_{n}\right)_{n=1}^{\infty}$
\end_inset
 חסומה מלעיל.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$N\geq\left|\alpha\right|$
\end_inset
 ויהי 
\begin_inset Formula
$N\leq n\in\MKnatural$
\end_inset
.
\begin_inset Newline newline
\end_inset
נסמן:
\begin_inset Formula
\begin{align*}
 & b_{1}:=b_{2}:=\ldots b_{n}:=1+\frac{\alpha}{n}>0\\
b_{n+1} & :=b_{n+2}:=\ldots b_{n+N+1}:=\frac{1}{N+1}>0
\end{align*}


\end_inset
ושוב מא"ש הממוצעים נובע שמתקיים:
\begin_inset Formula
\begin{align*}
\sqrt[n+N+1]{\left(1+\frac{\alpha}{n}\right)^{n}\cdot\frac{1}{\left(N+1\right)^{N+1}}} & =\sqrt[n+N+1]{\prod_{i=1}^{n+N+1}b_{i}}\leq\frac{1}{n+N+1}\cdot\sum_{i=1}^{n+N+1}b_{i}\\
 & =\frac{n\cdot\left(1+\frac{\alpha}{n}\right)+\left(N+1\right)\cdot\frac{1}{N+1}}{n+N+1}=\frac{n+\alpha+1}{n+N+1}\leq1
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow\left(1+\frac{\alpha}{n}\right)^{n}\cdot\frac{1}{\left(N+1\right)^{N+1}}\leq1\\
 & \Rightarrow a_{n}=\left(1+\frac{x}{n}\right)^{n}\leq\left(N+1\right)^{N+1}
\end{align*}


\end_inset

\begin_inset Formula
$n$
\end_inset
 הנ"ל היה שרירותי ולכן הנ"ל מתקיים לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 ומכיוון שהקבוצה 
\begin_inset Formula
$\left\{ a_{n}\mid n<N\right\} $
\end_inset
 היא קבוצה סופית נדע שהיא חסומה וממילא גם 
\begin_inset Formula
$\left(a_{n}\right)_{n=1}^{\infty}$
\end_inset
 חסומה.
\end_layout

\begin_layout Corollary
\begin_inset Formula
$\left(a_{n}\right)_{n=1}^{\infty}$
\end_inset
 מתכנסת.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

\end_layout

\begin_layout Corollary
הגבול 
\begin_inset Formula
$\begin{alignedat}{1}\lim_{n\rightarrow\infty}\left(1+\frac{x}{n}\right)^{n}\end{alignedat}
$

\end_inset
 קיים לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
.
\end_layout

\begin_layout Subsection
תכונות פונקציית האקספוננט
\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\exp\left(x\right)>0$
\end_inset
.
\end_layout

\begin_layout Proof
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 ולכל 
\begin_inset Formula
$\left|x\right|<n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left(1+\frac{x}{n}\right)^{n}>0
\]


\end_inset
ומכאן שגם:
\begin_inset Formula
\[
\exp\left(x\right)=\lim_{n\rightarrow\infty}\left(1+\frac{x}{n}\right)^{n}>0
\]


\end_inset

\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\exp\left(x\right)\geq1+x$
\end_inset
.
\end_layout

\begin_layout Proof
לכל 
\begin_inset Formula
$\left|x\right|<n\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$\frac{x}{n}>-1$
\end_inset
 ומכאן שע"פ א"ש ברנולי מתקיים גם:
\begin_inset Formula
\[
\left(1+\frac{x}{n}\right)^{n}\geq1+n\cdot\frac{x}{n}=1+x
\]


\end_inset

\end_layout

\begin_layout Lemma
\begin_inset CommandInset label
LatexCommand label
name "lemma 8.7"
\end_inset
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\left(1+\frac{x}{n^{2}}\right)^{n}=1
\]


\end_inset

\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 ותהא 
\begin_inset Formula
$\left(x_{n}\right)_{n=1}^{\infty}$
\end_inset
 הסדרה המוגדרת ע"י 
\begin_inset Formula
$x_{n}:=\left(1+\frac{x}{n}\right)^{n}$
\end_inset
 (לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
).
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left(1+\frac{x}{n^{2}}\right)^{n}=\sqrt[n]{\left(1+\frac{x}{n^{2}}\right)^{n^{2}}}=\sqrt[n]{x_{n^{2}}}
\]


\end_inset
ראינו שהסדרה 
\begin_inset Formula
$\left(x_{n}\right)_{n=1}^{\infty}$
\end_inset
 מתכנסת ל-
\begin_inset Formula
$\exp\left(x\right)$
\end_inset
 שהוא מספר חיובי, א"כ קיימים 
\begin_inset Formula
$0<m,M\in\MKreal$
\end_inset
 כך שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
m\leq x_{n^{2}}\leq M
\]


\end_inset
יהיו 
\begin_inset Formula
$m,M$
\end_inset
 כנ"ל ומכאן שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sqrt[n]{m}\leq\sqrt[n]{x_{n^{2}}}\leq\sqrt[n]{M}
\]


\end_inset
כשעסקנו בסדרות ראינו שלכל 
\begin_inset Formula
$0<q\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\lim_{n\rightarrow\infty}\sqrt[n]{q}=1$
\end_inset
 ומכאן שע"פ משפט הכריך מתקיים:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\left(1+\frac{x}{n^{2}}\right)^{n}=\lim_{n\rightarrow\infty}\sqrt[n]{x_{n^{2}}}=1
\]


\end_inset

\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\exp\left(-x\right)=\frac{1}{\exp\left(x\right)}$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$x\in\MKreal$
\end_inset
, ראינו ש-
\begin_inset Formula
$\exp\left(x\right)>0$
\end_inset
 ולכן הטענה שעלינו להוכיח שקולה לכך ש-
\begin_inset Formula
$\exp\left(-x\right)\cdot\exp\left(x\right)=1$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהלמה (
\begin_inset CommandInset ref
LatexCommand ref
reference "lemma 8.7"
plural false
caps false
noprefix false
nolink false
\end_inset
) ומאריתמטיקה של גבולות נובע שמתקיים:
\begin_inset Formula
\begin{align*}
\exp\left(-x\right)\cdot\exp\left(x\right) & =\lim_{n\rightarrow\infty}\left(1+\frac{x}{n}\right)^{n}\cdot\lim_{n\rightarrow\infty}\left(1-\frac{x}{n}\right)^{n}\\
 & =\lim_{n\rightarrow\infty}\left(\left(1+\frac{x}{n}\right)^{n}\cdot\left(1-\frac{x}{n}\right)^{n}\right)\\
 & =\lim_{n\rightarrow\infty}\left(1-\frac{x^{2}}{n}\right)^{n}=1
\end{align*}


\end_inset

\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$x,y\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\exp\left(x+y\right)=\exp\left(x\right)\cdot\exp\left(y\right)$
\end_inset
.
\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula
$x,y\in\MKreal$
\end_inset
 ונחלק למקרים:
\end_layout

\begin_deeper
\begin_layout Itemize
נניח ש-
\begin_inset Formula
$x,y\geq0$
\end_inset
, מכאן שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
0<1+\frac{x+y}{n}\leq1+\frac{x+y}{n}+\frac{xy}{n^{2}}\leq1+\frac{x+y}{n}+\frac{xy}{n^{2}}+\frac{x+y}{n}\cdot\frac{xy}{n^{2}}
\]


\end_inset
ומכאן שגם:
\begin_inset Formula
\[
0<1+\frac{x+y}{n}\leq\left(1+\frac{x}{n}\right)\cdot\left(1+\frac{y}{n}\right)\leq\left(1+\frac{x+y}{n}\right)\cdot\left(1+\frac{xy}{n^{2}}\right)
\]


\end_inset
וממילא:
\begin_inset Formula
\[
\left(1+\frac{x+y}{n}\right)^{n}\leq\left(1+\frac{x}{n}\right)^{n}\cdot\left(1+\frac{y}{n}\right)^{n}\leq\left(1+\frac{x+y}{n}\right)^{n}\cdot\left(1+\frac{xy}{n^{2}}\right)^{n}
\]


\end_inset
מאריתמטיקה של גבולות נקבל:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\left(1+\frac{x+y}{n}\right)^{n}\leq\lim_{n\rightarrow\infty}\left(1+\frac{x}{n}\right)^{n}\cdot\lim_{n\rightarrow\infty}\left(1+\frac{y}{n}\right)^{n}\leq\lim_{n\rightarrow\infty}\left(1+\frac{x+y}{n}\right)^{n}\cdot\lim_{n\rightarrow\infty}\left(1+\frac{xy}{n^{2}}\right)^{n}
\]


\end_inset
כלומר:
\begin_inset Formula
\[
\exp\left(x+y\right)\leq\exp\left(x\right)\cdot\exp\left(y\right)\leq\exp\left(x+y\right)\cdot1
\]


\end_inset
וממילא 
\begin_inset Formula
$\exp\left(x+y\right)=\exp\left(x\right)\cdot\exp\left(y\right)$
\end_inset
.
\end_layout

\begin_layout Itemize
נניח שאחד מבין 
\begin_inset Formula
$x$
\end_inset
 ו-
\begin_inset Formula
$y$
\end_inset
 שלילי ואילו האחר אי-שלילי, נחלק שוב למקרים ובהג"כ נניח כי 
\begin_inset Formula
$y<0\leq x$
\end_inset
.
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula
$x+y\geq0$
\end_inset
 אז מהמקרה הקודם נובע מתקיים:
\begin_inset Formula
\[
\exp\left(x\right)=\exp\left(\left(x+y\right)+\left(-y\right)\right)=\exp\left(x+y\right)\cdot\exp\left(-y\right)=\frac{\exp\left(x+y\right)}{\exp\left(y\right)}
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow\exp\left(x\right)\cdot\exp\left(y\right)=\exp\left(x+y\right)
\]


\end_inset

\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$x+y\leq0$
\end_inset
 אז 
\begin_inset Formula
$\left(-x\right)+\left(-y\right)\geq0$
\end_inset
 ומכיוון שהסימנים של 
\begin_inset Formula
$-x$
\end_inset
 ו-
\begin_inset Formula
$-y$
\end_inset
 שונים נקבל מהמקרה הקודם שמתקיים:
\begin_inset Formula
\[
\exp\left(-x\right)\cdot\exp\left(-y\right)=\exp\left(-\left(x+y\right)\right)
\]


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow\frac{1}{\exp\left(x\right)\cdot\exp\left(y\right)}=\frac{1}{\exp\left(x+y\right)}\\
 & \Rightarrow\exp\left(x+y\right)=\exp\left(x\right)\cdot\exp\left(y\right)
\end{align*}


\end_inset

\end_layout

\end_deeper

\begin_layout Itemize
נניח כעת ש-
\begin_inset Formula
$x,y\leq0$
\end_inset
, א"כ 
\begin_inset Formula
$-x,-y\geq0$
\end_inset
 ולכן מהמקרה הראשון נובע שמתקיים:
\begin_inset Formula
\[
\exp\left(-\left(x+y\right)\right)=\exp\left(-x\right)\cdot\exp\left(-y\right)
\]


\end_inset
ומאותם נימוקים שבמקרה הקודם נקבל:
\begin_inset Formula
\[
\exp\left(x+y\right)=\exp\left(x\right)\cdot\exp\left(y\right)
\]


\end_inset

\end_layout

\end_deeper

\begin_layout Corollary
לכל 
\begin_inset Formula
$x_{1},x_{2},\ldots,x_{n}\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\exp\left(\sum_{k=1}^{n}x_{k}\right)=\prod_{k=1}^{n}\exp\left(x_{k}\right)
\]


\end_inset

\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$q\in\MKrational$
\end_inset
 מתקיים 
\begin_inset Formula
$\exp\left(q\right)=e^{q}$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$q\in\MKrational$
\end_inset
 ויהיו 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 ו-
\begin_inset Formula
$m\in\MKinteger$
\end_inset
 כך ש-
\begin_inset Formula
$q=\frac{m}{n}$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\exp\left(m\right) & =\exp\left(\sum_{i=1}^{m}1\right)=\prod_{i=1}^{m}\exp\left(1\right)=\prod_{i=1}^{m}e=e^{m}\\
\Rightarrow e=\exp\left(1\right) & =\exp\left(\sum_{i=1}^{n}\frac{1}{n}\right)=\prod_{i=1}^{n}\exp\left(\frac{1}{n}\right)=\left(\exp\left(\frac{1}{n}\right)\right)^{n}
\end{align*}


\end_inset
מיחידות השורש נובע ש-
\begin_inset Formula
$e^{\frac{1}{n}}=\sqrt[n]{e}=\exp\left(\frac{1}{n}\right)$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\exp\left(q\right) & =\exp\left(\frac{m}{n}\right)=\exp\left(\sum_{i=1}^{m}\frac{1}{n}\right)=\prod_{i=1}^{m}\exp\left(\frac{1}{n}\right)\\
 & =\prod_{i=1}^{m}e^{\frac{1}{n}}=\left(e^{\frac{1}{n}}\right)^{m}=e^{\frac{m}{n}}=e^{q}
\end{align*}


\end_inset

\end_layout

\begin_layout Lemma
\begin_inset CommandInset label
LatexCommand label
name "lemma 8.12"
\end_inset
לכל 
