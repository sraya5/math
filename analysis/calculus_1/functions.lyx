\Rightarrow\exp\left(y\right) & =\exp\left(x+\left(y-x\right)\right)=\exp\left(x\right)\cdot\exp\left(y-x\right)\\
 & \geq\exp\left(x\right)\cdot\left(1+y-x\right)>\exp\left(x\right)
\end{align*}


