\begin_layout Lemma
לכל 
\begin_inset Formula
$0<a\in\MKreal$
\end_inset
 וכל 
\begin_inset Formula
$q\in\MKrational$
\end_inset
 מתקיים 
\begin_inset Formula
$\ln\left(a^{q}\right)=q\cdot\ln\left(a\right)$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$0<a\in\MKreal$
\end_inset
.
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$m\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\ln\left(a^{m}\right)=\ln\left(\prod_{i=1}^{m}a\right)=\sum_{i=1}^{m}\ln\left(a\right)=m\cdot\ln\left(a\right)
\]


\end_inset
ומכיוון שלכל 
\begin_inset Formula
$0>m\in\MKinteger$
\end_inset
 מתקיים:
\begin_inset Formula
\[
0=\ln\left(1\right)=\ln\left(a^{m}\cdot a^{-m}\right)=\ln\left(a^{m}\right)+\ln\left(a^{-m}\right)
\]


\end_inset
נדע שמתקיים:
\begin_inset Formula
\[
\ln\left(a^{m}\right)=-\ln\left(a^{-m}\right)=-\left(-m\cdot\ln\left(a\right)\right)=m\cdot\ln\left(a\right)
\]


\end_inset
בנוסף מתקיים:
\begin_inset Formula
\[
\ln\left(a^{0}\right)=\ln\left(1\right)=0=0\cdot\ln\left(a\right)
\]


\end_inset
ולסיכום נוכל לומר שלכל 
\begin_inset Formula
$m\in\MKinteger$
\end_inset
 מתקיים 
\begin_inset Formula
$\ln\left(a^{m}\right)=m\cdot\ln\left(a\right)$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהנ"ל נובע שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\ln\left(a\right)=\ln\left(\left(a^{\frac{1}{n}}\right)^{n}\right)=n\cdot\ln\left(a^{\frac{1}{n}}\right)
\]


\end_inset
ומכאן שגם:
\begin_inset Formula
\[
\ln\left(a^{\frac{1}{n}}\right)=\frac{1}{n}\cdot\ln\left(a\right)
\]


\end_inset
כעת יהי 
\begin_inset Formula
$q\in\MKrational$
\end_inset
 ויהיו 
\begin_inset Formula
$m\in\MKinteger$
\end_inset
 ו-
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$\frac{m}{n}=q$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\ln\left(a^{q}\right) & =\ln\left(a^{\frac{m}{n}}\right)=\ln\left(\left(a^{\frac{1}{n}}\right)^{m}\right)=m\cdot\ln\left(a^{\frac{1}{n}}\right)\\
 & =m\cdot\frac{1}{n}\cdot\ln\left(a\right)=\frac{m}{n}\cdot\ln\left(a\right)=q\cdot\ln\left(a\right)
\end{align*}


\end_inset

\end_layout

\begin_layout Corollary
לכל 
\begin_inset Formula
$0<a\in\MKreal$
\end_inset
 ולכל 
\begin_inset Formula
$q\in\MKrational$
\end_inset
 מתקיים 
\begin_inset Formula
$\exp\left(q\cdot\ln\left(a\right)\right)=a^{q}$
\end_inset
.
\end_layout

