\begin_deeper
\begin_layout Enumerate
\begin_inset Formula
\[
\frac{\log_{a}\left(c\right)}{\log_{a}\left(b\right)}=\left(\frac{\ln c}{\ln a}\right)\cdot\left(\frac{\ln b}{\ln a}\right)^{-1}=\frac{\ln c}{\ln b}=\log_{b}\left(c\right)
\]


\end_inset

\end_layout

\begin_layout Enumerate
\begin_inset Formula
\[
\log_{a}\left(c\right)+\log_{a}\left(d\right)=\frac{\ln c+\ln d}{\ln a}=\frac{\ln\left(c\cdot d\right)}{\ln\left(a\right)}=\log_{a}\left(c\cdot d\right)
\]


\end_inset

\end_layout

\begin_layout Enumerate
\begin_inset Formula
\begin{align*}
\log_{a}\left(c\right)-\log_{a}\left(d\right) & =\log_{a}\left(c\right)+\left(-1\right)\cdot\log_{a}\left(d\right)\\
 & =\frac{\ln c-\ln d}{\ln a}=\frac{\ln c+\ln\left(d^{-1}\right)}{\ln a}\\
 & =\frac{\ln\left(c\cdot d^{-1}\right)}{\ln a}=\frac{\ln\left(\frac{c}{d}\right)}{\ln a}=\log_{a}\left(\frac{c}{d}\right)
\end{align*}


\end_inset

\end_layout

