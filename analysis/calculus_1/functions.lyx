\begin_layout Proof
ממשפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 7.2"
plural false
caps false
noprefix false
nolink false
\end_inset
 נובע ש-
\begin_inset Formula
$f$
\end_inset
 מונוטונית ממש ב-
\begin_inset Formula
$\left[a,b\right]$
\end_inset
, נניח בהג"כ ש-
\begin_inset Formula
$f$
\end_inset
 עולה ממש ומכאן שע"פ משפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 7.3"
plural false
caps false
noprefix false
nolink false
\end_inset
 מתקיים 
\begin_inset Formula
$\MKim f=\left[f\left(a\right),f\left(b\right)\right]$
\end_inset
 ומהגדרה זהו התחום של 
\begin_inset Formula
$f^{-1}$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$y\in\left[f\left(a\right),f\left(b\right)\right]$
\end_inset
, יהי 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
 ונסמן:
\begin_inset Formula
\begin{align*}
x & :=f^{-1}\left(y\right)\\
x_{1} & :=\max\left\{ f^{-1}\left(y\right)-\varepsilon,a\right\} \\
x_{2} & :=\min\left\{ f^{-1}\left(y\right)+\varepsilon,b\right\} 
\end{align*}


\end_inset

\begin_inset Formula
\[
\Rightarrow x\in\left[x_{1},x_{2}\right]\subseteq\left[a,b\right]
\]


\end_inset
מהמונוטוניות של 
\begin_inset Formula
$f$
\end_inset
 נובע שמתקיים:
\begin_inset Formula
\[
f\left(a\right)\leq f\left(x_{1}\right)\leq f\left(x\right)\leq f\left(x_{2}\right)\leq f\left(b\right)
\]


\end_inset
כלומר:
\begin_inset Formula
\[
y=f\left(x\right)\in\left[f\left(x_{1}\right),f\left(x_{2}\right)\right]\subseteq\left[f\left(a\right),f\left(b\right)\right]
\]


\end_inset
ומכאן שקיימת 
\begin_inset Formula
$0<\delta\in\MKreal$
\end_inset
 כך שלכל 
\begin_inset Formula
$y'\in\MKim f$
\end_inset
 המקיים 
\begin_inset Formula
$\left|y-y'\right|<\delta$
\end_inset
 מתקיים 
\begin_inset Formula
$y'\in\left[f\left(x_{1}\right),f\left(x_{2}\right)\right]$
\end_inset
, כלומר הסביבה הדלתאית המתאימה
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
אם 
\begin_inset Formula
$y=f\left(x_{1}\right)$
\end_inset
 אז מדובר בסביבה ימנית ואם 
\begin_inset Formula
$y=f\left(x_{2}\right)$
\end_inset
 מדובר בסביבה שמאלית, אחרת מדובר בסביבה מלאה.
\end_layout

\end_inset
 של 
\begin_inset Formula
$y$
\end_inset
 מוכלת ב-
\begin_inset Formula
$\left[f\left(x_{1}\right),f\left(x_{2}\right)\right]$
\end_inset
, תהא 
\begin_inset Formula
$\delta$
\end_inset
 כנ"ל.
\begin_inset Newline newline
\end_inset
מהעובדה ש-
\begin_inset Formula
$f$
\end_inset
 עולה ממש נובע שלכל 
\begin_inset Formula
$y'\in\left[f\left(a\right),f\left(b\right)\right]$
\end_inset
: אם 
\begin_inset Formula
$f^{-1}\left(y'\right)<x_{1}$
\end_inset
 אז 
\begin_inset Formula
$y'=f\left(f^{-1}\left(y'\right)\right)<f\left(x_{1}\right)$
\end_inset
 ואם 
\begin_inset Formula
$x_{2}<f^{-1}\left(y'\right)$
\end_inset
 אז 
\begin_inset Formula
$f\left(x_{2}\right)<f\left(f^{-1}\left(y'\right)\right)=y'$
\end_inset
;
\begin_inset Newline newline
\end_inset
מכאן שלכל 
\begin_inset Formula
$y'\in\left[f\left(x_{1}\right),f\left(x_{2}\right)\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\[
f^{-1}\left(y\right)-\varepsilon\leq x_{1}\leq f^{-1}\left(y'\right)\leq x_{2}\leq f^{-1}\left(y\right)+\varepsilon
\]


\end_inset
כלומר:
\begin_inset Formula
\[
\left|f^{-1}\left(y'\right)-f^{-1}\left(y\right)\right|<\varepsilon
\]


\end_inset
ובפרט לכל 
\begin_inset Formula
$y'\in\MKim f$
\end_inset
 המקיימת 
\begin_inset Formula
$\left|y-y'\right|<\delta$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|f^{-1}\left(y'\right)-f^{-1}\left(y\right)\right|<\varepsilon$
\end_inset
.
\end_layout

