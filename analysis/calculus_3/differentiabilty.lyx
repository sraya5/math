\begin_layout Proof
תהיינה 
\begin_inset Formula
$r:A\rightarrow B$


\end_inset
 ו-
\begin_inset Formula
$s:B\rightarrow\MKreal^{n}$


\end_inset
 שתי פונקציות המוגדרות ע"י (לכל 
\begin_inset Formula
$x\in A$


\end_inset
 ולכל 
\begin_inset Formula
$y\in B$


\end_inset
):
\begin_inset Formula
\begin{align*}
{\color{blue}r\left(x\right)} & {\color{blue}:=f\left(x\right)-f\left(a\right)-Df_{a}\left(x-a\right)}\\
{\color{green}s\left(y\right)} & {\color{green}:=g\left(y\right)-g\left(f\left(a\right)\right)-Dg_{f\left(a\right)}\left(y-f\left(a\right)\right)}
\end{align*}




\end_inset
מהגדרת 
\begin_inset Formula
$r$


\end_inset
 ו-
\begin_inset Formula
$s$


\end_inset
 נובע שלכל 
\begin_inset Formula
$x\in A$


\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
g\left(f\left(x\right)\right)-g\left(f\left(a\right)\right)-Dg_{f\left(a\right)}\left({\color{blue}Df_{a}\left(x-a\right)}\right) & =g\left(f\left(x\right)\right)-g\left(f\left(a\right)\right)-Dg_{f\left(a\right)}\left({\color{blue}f\left(x\right)-f\left(a\right)-r\left(x\right)}\right)\\
 & ={\color{green}g\left(f\left(x\right)\right)-g\left(f\left(a\right)\right)-Dg_{f\left(a\right)}\left(f\left(x\right)-f\left(a\right)\right)}+Dg_{f\left(a\right)}\left(r\left(x\right)\right)\\
 & ={\color{green}s\left(f\left(x\right)\right)}+Dg_{f\left(a\right)}\left(r\left(x\right)\right)
\end{align*}




\end_inset
ומכאן שגם:
\begin_inset Formula
\begin{align*}
\frac{\left\Vert g\left(f\left(x\right)\right)-g\left(f\left(a\right)\right)-Dg_{f\left(a\right)}\left(Df_{a}\left(x-a\right)\right)\right\Vert }{\left\Vert x-a\right\Vert } & \leq\frac{\left\Vert s\left(f\left(x\right)\right)\right\Vert +\left\Vert Dg_{f\left(a\right)}\left(r\left(x\right)\right)\right\Vert }{\left\Vert x-a\right\Vert }\\
 & =\frac{\left\Vert s\left(f\left(x\right)\right)\right\Vert }{\left\Vert x-a\right\Vert }+\frac{\left\Vert Dg_{f\left(a\right)}\left(r\left(x\right)\right)\right\Vert }{\left\Vert x-a\right\Vert }\\
 & =\frac{\left\Vert s\left(f\left(x\right)\right)\right\Vert }{\left\Vert x-a\right\Vert }+{\color{red}\left\Vert Dg_{f\left(a\right)}\left(\frac{r\left(x\right)}{\left\Vert x-a\right\Vert }\right)\right\Vert }
\end{align*}




\end_inset
מהיות 
\begin_inset Formula
$f$


\end_inset
 ו-
\begin_inset Formula
$g$


\end_inset
 גזירות ב-
\begin_inset Formula
$a$


\end_inset
 וב-
\begin_inset Formula
$f\left(a\right)$


\end_inset
 (בהתאמה) נובע כי:
\begin_inset Formula
\[
\lim_{x\rightarrow a}\frac{\left\Vert r\left(x\right)\right\Vert }{\left\Vert x-a\right\Vert }=\lim_{y\rightarrow f\left(a\right)}\frac{\left\Vert s\left(y\right)\right\Vert }{\left\Vert y-f\left(a\right)\right\Vert }=0
\]




\end_inset
מכאן שהמחובר הימני באגף שימין של השוויון הקודם (מודגש באדום) שואף ל-
\begin_inset Formula
$0$


\end_inset
 כש-
\begin_inset Formula
$x$


\end_inset
 שואף ל-
\begin_inset Formula
$a$


\end_inset
 (
\begin_inset Formula
$Dg_{f\left(a\right)}$


\end_inset
 רציפה ב-
\begin_inset Formula
$0$


\end_inset

\begin_inset Newline newline
\end_inset
ו-
\begin_inset Formula
$Dg_{f\left(a\right)}\left(0\right)=0$


\end_inset
), א"כ נותר לנו להוכיח רק שמתקיים:
\begin_inset Formula
\[
\lim_{x\rightarrow a}\frac{\left\Vert s\left(f\left(x\right)\right)\right\Vert }{\left\Vert x-a\right\Vert }=0
\]




\end_inset
תהא 
\begin_inset Formula
$\psi:B\rightarrow\MKreal$


\end_inset
 פונקציה המוגדרת ע"י (לכל 
\begin_inset Formula
$y\in B$


\end_inset
):
\begin_inset Formula
\[
\psi\left(y\right):=\begin{cases}
\frac{\left\Vert s\left(y\right)\right\Vert }{\left\Vert y-f\left(a\right)\right\Vert } & y\neq f\left(a\right)\\
0 & y=f\left(a\right)
\end{cases}
\]




\end_inset
נשים לב לכך ש-
\begin_inset Formula
$s\left(f\left(a\right)\right)=0$


\end_inset
 ולכן לכל 
\begin_inset Formula
$x\in A$


\end_inset
 מתקיים:
\begin_inset Formula
\[
\psi\left(f\left(x\right)\right)\cdot\frac{\left\Vert f\left(x\right)-f\left(a\right)\right\Vert }{\left\Vert x-a\right\Vert }=\frac{\left\Vert s\left(f\left(x\right)\right)\right\Vert }{\left\Vert x-a\right\Vert }
\]




\end_inset
מאריתמטיקה של גבולות, מרציפות של 
\begin_inset Formula
$\psi$


\end_inset
 ב-
\begin_inset Formula
$f\left(a\right)$


\end_inset
, וממשפט ההצבה בגבולות, נובע כי:
\begin_inset Formula
\[
\lim_{x\rightarrow a}\frac{\left\Vert s\left(f\left(x\right)\right)\right\Vert }{\left\Vert x-a\right\Vert }=\lim_{x\rightarrow a}\psi\left(f\left(x\right)\right)\cdot\lim_{x\rightarrow a}\frac{\left\Vert f\left(x\right)-f\left(a\right)\right\Vert }{\left\Vert x-a\right\Vert }=\psi\left(f\left(a\right)\right)\cdot\left\Vert Df_{a}\right\Vert _{\MKop}=0
\]




\end_inset

\end_layout

\begin_layout Corollary
תהא 
\begin_inset Formula
$f$


\end_inset
 פונקציה גזירה בנקודה 
\begin_inset Formula
