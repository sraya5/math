\begin_layout Labeling
\labelwidthstring 00.00.0000

\series bold
\begin_inset Formula
$\clubsuit$


\end_inset
 
\series default
במקומות אחרים מסמנים את הנגזרות הכיווניות והחלקיות בסימונים אחרים:
\begin_inset Formula
\begin{align*}
\frac{\partial f}{\partial v}\left(a\right):=D_{v}f\left(a\right) & :=\partial_{v}f\left(a\right)\\
\frac{\partial f}{\partial x_{i}}\left(a\right):=D_{i}f\left(a\right) & :=\partial_{i}f\left(a\right)\\
f_{x}\left(a\right):=\partial_{x}f\left(a\right):=\frac{\partial f}{\partial x}\left(a\right):=D_{1}f\left(a\right) & :=\partial_{1}f\left(a\right)\\
f_{y}\left(a\right):=\partial_{y}f\left(a\right):=\frac{\partial f}{\partial y}\left(a\right):=D_{2}f\left(a\right) & :=\partial_{2}f\left(a\right)\\
f_{z}\left(a\right):=\partial_{z}f\left(a\right):=\frac{\partial f}{\partial z}\left(a\right):=D_{3}f\left(a\right) & :=\partial_{3}f\left(a\right)
\end{align*}




\end_inset

