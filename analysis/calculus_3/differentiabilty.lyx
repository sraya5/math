.
\end_layout

\end_inset
; מתקיים:
\begin_inset Formula
\[
\left\Vert f\left(c\right)-f\left(b\right)-Df_{a}\left(c-b\right)\right\Vert \leq\left\Vert c-b\right\Vert \cdot\max_{x\in\left[b,c\right]}\left\Vert Df_{x}-Df_{a}\right\Vert _{\MKop}
\]




\end_inset

\end_layout

\begin_layout Proof
תהא 
\begin_inset Formula
$g:A\rightarrow\MKreal^{m}$


\end_inset
 פונקציה המוגדרת ע"י 
\begin_inset Formula
$g\left(x\right):=f\left(x\right)-Df_{a}\left(x\right)$


\end_inset
 לכל 
\begin_inset Formula
$x\in A$


\end_inset
, מכאן שלכל 
\begin_inset Formula
$x\in A$


\end_inset
 מתקיים:
\begin_inset Formula
\[
\left\Vert Dg_{x}\right\Vert _{\MKop}=\left\Vert Df_{x}-Df_{a}\right\Vert _{\MKop}
\]




\end_inset
ממשפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 3.3"
plural false
caps false
noprefix false
nolink false
\end_inset
 נובע כי:
\begin_inset Formula
\begin{align*}
\left\Vert f\left(c\right)-f\left(b\right)-Df_{a}\left(c-b\right)\right\Vert  & =\left\Vert \left(f\left(c\right)-Df_{a}\left(c\right)\right)-\left(f\left(b\right)-Df_{a}\left(b\right)\right)\right\Vert =\left\Vert g\left(c\right)-g\left(b\right)\right\Vert \\
 & \leq\left\Vert c-b\right\Vert \cdot\sup_{x\in\left[b,c\right]}\left\Vert Dg_{x}\right\Vert _{\MKop}=\left\Vert c-b\right\Vert \cdot\sup_{x\in\left[b,c\right]}\left\Vert Df_{x}-Df_{a}\right\Vert _{\MKop}
\end{align*}




\end_inset

\end_layout

