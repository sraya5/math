\frac{\partial^{2}f}{\partial v^{2}}\left(a\right):=D_{vv}f\left(a\right) & :=\partial_{vv}f\left(a\right) & \frac{\partial^{2}f}{\partial u\partial v}\left(a\right):=\frac{\partial_{v}f}{\partial u}\left(a\right):=D_{vu}f\left(a\right) & :=\partial_{vu}f\left(a\right)\\
\frac{\partial^{2}f}{\partial x_{i}{}^{2}}\left(a\right):=D_{ii}f\left(a\right) & :=\partial_{ii}f\left(a\right) & \frac{\partial^{2}f}{\partial x_{j}\partial x_{i}}\left(a\right):=\frac{\partial_{i}f}{\partial x_{j}}\left(a\right):=D_{ij}f\left(a\right) & :=\partial_{ij}f\left(a\right)\\
f_{xx}\left(a\right):=\partial_{xx}f\left(a\right):=\frac{\partial^{2}f}{\partial x^{2}}\left(a\right):=D_{11}f\left(a\right) & :=\partial_{11}f\left(a\right) & f_{xy}\left(a\right):=\partial_{xy}f\left(a\right):=\frac{\partial^{2}f}{\partial y\partial x}\left(a\right):=\frac{\partial f_{x}}{\partial y}\left(a\right):=D_{12}f\left(a\right) & :=\partial_{12}f\left(a\right)\\
f_{yy}\left(a\right):=\partial_{yy}f\left(a\right):=\frac{\partial^{2}f}{\partial y^{2}}\left(a\right):=D_{22}f\left(a\right) & :=\partial_{22}f\left(a\right) & f_{yx}\left(a\right):=\partial_{yx}f\left(a\right):=\frac{\partial^{2}f}{\partial x\partial y}\left(a\right):=\frac{\partial f_{y}}{\partial x}\left(a\right):=D_{21}f\left(a\right) & :=\partial_{21}f\left(a\right)\\
f_{zz}\left(a\right):=\partial_{zz}f\left(a\right):=\frac{\partial^{2}f}{\partial z^{2}}\left(a\right):=D_{33}f\left(a\right) & :=\partial_{33}f\left(a\right) & f_{xz}\left(a\right):=\partial_{xz}f\left(a\right):=\frac{\partial^{2}f}{\partial z\partial x}\left(a\right):=\frac{\partial f_{x}}{\partial z}\left(a\right):=D_{13}f\left(a\right) & :=\partial_{13}f\left(a\right)\\
 &  & f_{zx}\left(a\right):=\partial_{zx}f\left(a\right):=\frac{\partial^{2}f}{\partial x\partial z}\left(a\right):=\frac{\partial f_{z}}{\partial x}\left(a\right):=D_{31}f\left(a\right) & :=\partial_{31}f\left(a\right)\\
 &  & f_{yz}\left(a\right):=\partial_{yz}f\left(a\right):=\frac{\partial^{2}f}{\partial z\partial y}\left(a\right):=\frac{\partial f_{y}}{\partial z}\left(a\right):=D_{23}f\left(a\right) & :=\partial_{23}f\left(a\right)\\
 &  & f_{zy}\left(a\right):=\partial_{zy}f\left(a\right):=\frac{\partial^{2}f}{\partial y\partial z}\left(a\right):=\frac{\partial f_{z}}{\partial y}\left(a\right):=D_{32}f\left(a\right) & :=\partial_{32}f\left(a\right)
