\begin_layout Theorem
\series bold
כלל השרשרת
\series default

\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$A\subseteq\MKreal^{k}$


\end_inset
 ו-
\begin_inset Formula
$B\subseteq\MKreal^{m}$


\end_inset
 קבוצות פתוחות, ותהיינה 
\begin_inset Formula
$f:A\rightarrow B$


\end_inset
 ו-
\begin_inset Formula
$g:B\rightarrow\MKreal^{n}$


\end_inset
 פונקציות כך ש-
\begin_inset Formula
$f$


\end_inset
 גזירה בנקודה 
\begin_inset Formula
$a\in A$


\end_inset
 ו-
\begin_inset Formula
$g$


\end_inset
 גזירה ב-
\begin_inset Formula
$f\left(a\right)$


\end_inset
. הפונקציה 
\begin_inset Formula
$g\circ f$


\end_inset
 גזירה ב-
\begin_inset Formula
$a$


\end_inset
 ומתקיים:
\begin_inset Formula
\[
D\left(g\circ f\right)_{a}=Dg_{f\left(a\right)}\circ Df_{a}
\]




\end_inset

