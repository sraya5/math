B_{\left(1-\varepsilon\right)r}\left(g\left(a\right)\right)\subseteq g\left(B_{r}\left(a\right)\right)\subseteq B_{\left(1+\varepsilon\right)r}\left(g\left(a\right)\right)
\]




\end_inset

\end_layout

\begin_layout Proof
נניח שקיים 
\begin_inset Formula
$\varepsilon\in\left(0,1\right)$


\end_inset
 כך שלכל 
\begin_inset Formula
$a\in A$


\end_inset
 מתקיים 
\begin_inset Formula
$\left\Vert Dg_{a}-\MKid\right\Vert _{\MKop}\leq\varepsilon$


\end_inset
, ויהי 
\begin_inset Formula
$\varepsilon$


\end_inset
 כנ"ל.
