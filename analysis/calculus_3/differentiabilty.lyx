\begin{align*}
\left\Vert h\left(x\right)-a\right\Vert  & =\left\Vert \left(h\left(x\right)-h\left(a\right)\right)+\left(h\left(a\right)-a\right)\right\Vert \leq\left\Vert h\left(x\right)-h\left(a\right)\right\Vert +\left\Vert h\left(a\right)-a\right\Vert \\
 & \leq\varepsilon\cdot s+\left\Vert \left(-g\left(a\right)+a+y\right)-a\right\Vert =\varepsilon\cdot s+\left\Vert y-g\left(a\right)\right\Vert <\varepsilon\cdot s+\left(1-\varepsilon\right)\cdot s=x
\end{align*}




\end_inset

