\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\left\Vert x\right\Vert _{\infty} & =\sqrt[p]{\left(\left\Vert x\right\Vert _{\infty}\right)^{p}}=\sqrt[p]{\left(\max_{k\geq i\in\MKnatural}\left|x_{i}\right|\right)^{p}}\leq\sqrt[p]{\sum_{i=1}^{k}\left|x_{i}\right|^{p}}=\left\Vert x\right\Vert _{p}\\
\left\Vert x\right\Vert _{p} & =\sqrt[p]{\sum_{i=1}^{k}\left|x_{i}\right|^{p}}\leq\sqrt[p]{k\cdot\left(\max_{k\geq i\in\MKnatural}\left|x_{i}\right|\right)^{p}}=\sqrt[p]{k\cdot\left(\left\Vert x\right\Vert _{\infty}\right)^{p}}=\left\Vert x\right\Vert _{\infty}\cdot\sqrt[p]{k}
\end{align*}


