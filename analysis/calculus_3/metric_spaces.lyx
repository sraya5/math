\begin_layout Example
\series bold
המטריקה הבדידה (הדיסקרטית)
\series default

\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$\MKbbx$
\end_inset
 קבוצה לא ריקה ותהא 
\begin_inset Formula
$d:\MKbbx\times\MKbbx\rightarrow\MKreal$
\end_inset
 מטריקה המוגדרת ע"י (לכל 
\begin_inset Formula
$x,y\in\MKbbx$
\end_inset
):
\begin_inset Formula
\[
d\left(x,y\right):=\begin{cases}
0 & x=y\\
1 & x\neq y
\end{cases}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 זוהי הדוגמה הפשטנית והמנוונת ביותר של מטריקה, והיא מייצרת דוגמאות נגדיות רבות לטענות שמתאימות עבור מרבית המטריקות האחרות.
\end_layout

\begin_layout Example
בהינתן מרחב מטרי 
\begin_inset Formula
$\left(\MKbbx,d\right)$
\end_inset
 ניתן לקבל ממנו מרחב מטרי נוסף ע"י הכפלת 
\begin_inset Formula
$d$
\end_inset
 במספר חיובי.
\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Example
יהיו 
\begin_inset Formula
$\left(\MKbbx_{1},d_{1}\right),\left(\MKbbx_{2},d_{2}\right)\ldots,\left(\MKbbx_{k},d_{k}\right)$
\end_inset
 מרחבים מטריים, ונסמן 
\begin_inset Formula
$\MKbbx:=\MKbbx_{1}\times\MKbbx_{2}\times\ldots\times\MKbbx_{k}$
\end_inset
.
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 נסמן 
\begin_inset Formula
$\left(x_{1},x_{2},\ldots,x_{k}\right):=x$
\end_inset
, כלומר 
\begin_inset Formula
$x_{i}$
\end_inset
 היא הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של 
\begin_inset Formula
$x$
\end_inset
 (לכל 
\begin_inset Formula
$k\geq i\in\MKnatural$
\end_inset
).
\begin_inset Newline newline
\end_inset
הפונקציות 
\begin_inset Formula
$d,\rho:\MKbbx\times\MKbbx\rightarrow\MKreal$
\end_inset
 המוגדרות ע"י (לכל 
\begin_inset Formula
$x,y\in\MKbbx$
\end_inset
):
\begin_inset Formula
\begin{align*}
d\left(x,y\right) & :=\sum_{i=1}^{k}d_{i}\left(x_{i},y_{i}\right)\\
\rho\left(x,y\right) & :=\max\left\{ d_{i}\left(x_{i},y_{i}\right)\mid k\geq i\in\MKnatural\right\} 
\end{align*}


\end_inset
הן מטריקות על 
\begin_inset Formula
$\MKbbx$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כמובן שניתן להגדיר מטריקות נוספות על 
\begin_inset Formula
$\MKbbx_{1}\times\MKbbx_{2}\times\ldots\times\MKbbx_{k}$
\end_inset
, אך כשנכתוב משפטים אודות מרחבי מכפלה כאלה נתייחס למטריקה מהצורה הנ"ל מבלי להגיד זאת במפורש.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מהגדרה מתקיים 
\begin_inset Formula
$d_{i}\left(x_{i},y_{i}\right)\leq\rho\left(x,y\right)\leq d\left(x,y\right)$
\end_inset
 לכל 
\begin_inset Formula
$k\geq i\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$x,y\in\MKbbx$
\end_inset
.
\end_layout

\begin_layout Example
נתבונן במעגל היחידה:
\begin_inset Formula
\[
\mathcal{S}^{1}:=\left\{ \begin{array}{c|c}
\begin{pmatrix}\cos\theta\\
\sin\theta
\end{pmatrix}\in\MKreal^{2} & \theta\in\left[0,2\pi\right)\end{array}\right\} 
\]


\end_inset
תהא 
\begin_inset Formula
$d:\mathcal{S}^{1}\times\mathcal{S}^{1}\rightarrow\MKreal$
\end_inset
 מטריקה המוגדרת ע"י (לכל 
\begin_inset Formula
$\theta_{1},\theta_{2}\in\left[0,2\pi\right)$
\end_inset
 כך ש-
\begin_inset Formula
$\theta_{2}\geq\theta_{1}$
\end_inset
):
\begin_inset Formula
\[
d\left(\begin{pmatrix}\cos\theta_{1}\\
\sin\theta_{1}
\end{pmatrix},\begin{pmatrix}\cos\theta_{2}\\
\sin\theta_{2}
\end{pmatrix}\right):=\min\left\{ \theta_{2}-\theta_{1},\left(\theta_{1}+2\pi\right)-\theta_{2}\right\} 
\]


\end_inset
כלומר 
\begin_inset Formula
$d$
\end_inset
 מחזירה את אורך הקשת הקצרה מבין השתיים שמגדירות שתי הנקודות.
\end_layout

