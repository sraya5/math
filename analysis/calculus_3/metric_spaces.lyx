\series bold
נורמת 
\begin_inset Formula
$\ell_{p}$
\end_inset

\series default

\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$k\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$p\in\MKnatural$
\end_inset
 נגדיר את הנורמה 
\begin_inset Formula
$\left\Vert \cdot\right\Vert _{p}:\MKreal^{k}\rightarrow\MKreal$
\end_inset
 ע"י )לכל 
\begin_inset Formula
$x\in\MKreal^{k}$
\end_inset
(:
\begin_inset Formula
\[
\left\Vert x\right\Vert _{p}:=\left\Vert x\right\Vert _{\ell_{p}}:=\sqrt[p]{\sum_{i=1}^{k}\left|x_{i}\right|^{p}}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 זוהי בעצם סדרה של נורמות, האיבר ה-
\begin_inset Formula
$p$
\end_inset
 בסדרה נקרא "נורמת 
\begin_inset Formula
$\ell_{p}$
\end_inset
", והמטריקה המושרית ע"י האיבר ה-
\begin_inset Formula
$p$
\end_inset
 נקראת "מטריקת 
\begin_inset Formula
$\ell_{p}$
\end_inset
" ומסומנת ב-
\begin_inset Formula
$d_{p}$
\end_inset
 או ב-
\begin_inset Formula
$d_{\ell_{p}}$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 העובדה שנורמת 
\begin_inset Formula
$\ell_{p}$
\end_inset
 חיובית בהחלט והומוגנית היא טריוויאלית. כדי להוכיח שהיא גם מקיימת את אי-שוויון המשולש נשים לב לכמה דברים:
\end_layout

\begin_deeper
\begin_layout Itemize
אם נצליח להוכיח שלכל 
\begin_inset Formula
$x,y\in\MKreal^{k}$
\end_inset
 המקיימים 
\begin_inset Formula
$\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}=1$
\end_inset
 מתקיים 
\begin_inset Formula
$\left\Vert x+y\right\Vert _{p}\leq1$
\end_inset
, נקבל מההומוגניות את א"ש המשולש
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
יהיו 
\begin_inset Formula
$x,y\in\MKreal^{k}$
\end_inset
, אם 
\begin_inset Formula
$x=0$
\end_inset
 או אז א"ש המשולש טריוויאלי, אחרת מתקיים 
\begin_inset Formula
$\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}>0$
\end_inset
.
\begin_inset Newline newline
\end_inset
נסמן 
\begin_inset Formula
$v:=\frac{x}{\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}}$
\end_inset
 ו-
\begin_inset Formula
$w:=\frac{y}{\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}}$
\end_inset
, א"כ מההומוגניות נובע כי:
\begin_inset Formula
\[
\left\Vert v\right\Vert _{p}+\left\Vert w\right\Vert _{p}=\frac{\left\Vert x\right\Vert _{p}}{\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}}+\frac{\left\Vert y\right\Vert _{p}}{\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}}=1
\]


\end_inset
ומההנחה נקבל:
\begin_inset Formula
\begin{align*}
\left\Vert x+y\right\Vert _{p} & =\left\Vert \left(\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}\right)\cdot\left(v+w\right)\right\Vert _{p}=\left(\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}\right)\cdot\left\Vert v+w\right\Vert \\
 & \leq\left(\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}\right)\cdot1=\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}
\end{align*}


\end_inset

\end_layout

\end_inset
.
\end_layout

\begin_layout Itemize
לכל 
\begin_inset Formula
$x\in\MKreal^{k}$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sum_{i=1}^{k}\left(\frac{\left|x_{i}\right|}{\left\Vert x\right\Vert _{p}}\right)^{p}=\frac{1}{\left(\left\Vert x\right\Vert _{p}\right)^{p}}\cdot\sum_{i=1}^{k}\left|x_{i}\right|^{p}=\frac{1}{\left(\left\Vert x\right\Vert _{p}\right)^{p}}\cdot\left(\sqrt[p]{\sum_{i=1}^{k}\left|x_{i}\right|^{p}}\right)^{p}=\frac{1}{\left(\left\Vert x\right\Vert _{p}\right)^{p}}\cdot\left(\left\Vert x\right\Vert _{p}\right)^{p}=1
\]


\end_inset

\end_layout

\begin_layout Itemize
הפונקציה 
\begin_inset Formula
$z\mapsto\left|z\right|^{p}$
\end_inset
 היא פונקציה קמורה על 
\begin_inset Formula
$\left[0,\infty\right)$
\end_inset
, כלומר לכל 
\begin_inset Formula
$0\leq a,b\in\MKreal$
\end_inset
 ולכל 
\begin_inset Formula
$t\in\left[0,1\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|{\color{red}t}\cdot{\color{blue}a}+{\color{red}\left(1-t\right)}\cdot{\color{green}b}\right|^{p}\leq{\color{red}t}\cdot\left|{\color{blue}a}\right|^{p}+{\color{red}\left(1-t\right)}\cdot\left|{\color{green}b}\right|^{p}
\]


\end_inset
ובפרט לכל 
\begin_inset Formula
$x,y\in\MKreal^{k}$
\end_inset
 כך ש-
\begin_inset Formula
${\color{red}\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}=1}$
\end_inset
 מתקיים )לכל 
\begin_inset Formula
$k\geq i\in\MKnatural$
\end_inset
(:
\begin_inset Formula
\begin{align*}
\left(\left|x_{i}\right|+\left|y_{i}\right|\right)^{p} & =\left|{\color{red}\left\Vert x\right\Vert _{p}}\cdot{\color{blue}\frac{\left|x_{i}\right|}{\left\Vert x\right\Vert _{p}}}+{\color{red}\left\Vert y\right\Vert _{p}}\cdot{\color{green}\frac{\left|y_{i}\right|}{\left\Vert y\right\Vert _{p}}}\right|^{p}\\
 & \leq{\color{red}\left\Vert x\right\Vert _{p}}\cdot\left({\color{blue}\frac{\left|x_{i}\right|}{\left\Vert x\right\Vert _{p}}}\right)^{p}+{\color{red}\left\Vert y\right\Vert _{p}}\cdot\left({\color{green}\frac{\left|y_{i}\right|}{\left\Vert y\right\Vert _{p}}}\right)^{p}
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\left(\left\Vert x+y\right\Vert _{p}\right)^{p} & =\sum_{i=1}^{k}\left|x_{i}+y_{i}\right|^{p}\leq\sum_{i=1}^{k}\left(\left|x_{i}\right|+\left|y_{i}\right|\right)^{p}\leq{\color{red}\left\Vert x\right\Vert _{p}}\cdot\sum_{i=1}^{k}\left({\color{blue}\frac{\left|x_{i}\right|}{\left\Vert x\right\Vert _{p}}}\right)^{p}+{\color{red}\left\Vert y\right\Vert _{p}}\cdot\sum_{i=1}^{k}\left({\color{green}\frac{\left|y_{i}\right|}{\left\Vert y\right\Vert _{p}}}\right)^{p}\\
 & ={\color{red}\left\Vert x\right\Vert _{p}}\cdot1+{\color{red}\left\Vert y\right\Vert _{p}}\cdot1=1=1^{p}=\left(\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}\right)^{p}
\end{align*}


\end_inset

\begin_inset Formula
\[
\Rightarrow\left\Vert x+y\right\Vert _{p}\leq\left\Vert x\right\Vert _{p}+\left\Vert y\right\Vert _{p}
\]


\end_inset

\end_layout

\end_deeper

