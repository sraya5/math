(:
\begin_inset Formula
\begin{align*}
\left(\left|f\left(x\right)\right|+\left|g\left(x\right)\right|\right)^{p} & =\left|{\color{red}\left\Vert f\right\Vert _{p}}\cdot{\color{blue}\frac{\left|f\left(x\right)\right|}{\left\Vert f\right\Vert _{p}}}+{\color{red}\left\Vert g\right\Vert _{p}}\cdot{\color{green}\frac{\left|g\left(x\right)\right|}{\left\Vert g\right\Vert _{p}}}\right|^{p}\\
 & \leq{\color{red}\left\Vert f\right\Vert _{p}}\cdot\left({\color{blue}\frac{\left|f\left(x\right)\right|}{\left\Vert f\right\Vert _{p}}}\right)^{p}+{\color{red}\left\Vert y\right\Vert _{p}}\cdot\left({\color{green}\frac{\left|g\left(x\right)\right|}{\left\Vert g\right\Vert _{p}}}\right)^{p}
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\left(\left\Vert f+g\right\Vert _{p}\right)^{p} & =\intop_{a}^{b}\left|f\left(x\right)+g\left(x\right)\right|^{p}dx\leq\intop_{a}^{b}\left(\left|f\left(x\right)\right|+\left|g\left(x\right)\right|\right)^{p}dx\\
 & \leq{\color{red}\left\Vert f\right\Vert _{p}}\cdot\intop_{a}^{b}\left({\color{blue}\frac{\left|f\left(x\right)\right|}{\left\Vert f\right\Vert _{p}}}\right)^{p}dx+{\color{red}\left\Vert g\right\Vert _{p}}\cdot\intop_{a}^{b}\left({\color{green}\frac{\left|g\left(x\right)\right|}{\left\Vert g\right\Vert _{p}}}\right)^{p}dx\\
 & ={\color{red}\left\Vert f\right\Vert _{p}}\cdot1+{\color{red}\left\Vert g\right\Vert _{p}}\cdot1=1=1^{p}=\left(\left\Vert f\right\Vert _{p}+\left\Vert g\right\Vert _{p}\right)^{p}
\end{align*}


\end_inset

\begin_inset Formula
\[
