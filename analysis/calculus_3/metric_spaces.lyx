\end_inset
(, לכל 
\begin_inset Formula
$x\in\MKreal^{n}$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left\Vert x\right\Vert =\left\Vert \sum_{i=1}^{n}x_{i}\cdot e_{i}\right\Vert \leq\sum_{i=1}^{n}\left\Vert x_{i}\cdot e_{i}\right\Vert =\sum_{i=1}^{n}\left|x_{i}\right|\cdot\left\Vert e_{i}\right\Vert \leq\left(\max_{n\geq i\in\MKnatural}\left|x_{i}\right|\right)\cdot\sum_{i=1}^{n}\left\Vert e_{i}\right\Vert =\left\Vert x\right\Vert _{\infty}\cdot\tilde{C}
\]


\end_inset
תהא 
\begin_inset Formula
$f:\MKreal^{n}\rightarrow\MKreal$
\end_inset
