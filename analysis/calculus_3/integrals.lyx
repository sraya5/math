\end_layout

\begin_layout Proof
נסמן:
\begin_inset Formula
\begin{align*}
X_{1} & :=\left\{ \begin{array}{c|c}
\intop_{K}f^{+}\left(x\right)dx & K\subseteq U,\ \text{קומפקטית ובעלת נפח}\ K\end{array}\right\} \\
X_{2} & :=\left\{ \begin{array}{c|c}
\intop_{K}f^{-}\left(x\right)dx & K\subseteq U,\ \text{קומפקטית ובעלת נפח}\ K\end{array}\right\} 
\end{align*}


\end_inset

\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula
$\Leftarrow$
\end_inset

\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$f$
\end_inset
 אינטגרבילית על 
\begin_inset Formula
$U$
\end_inset
, מהגדרה לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\intop_{U}f^{+}\left(x\right)dx & =\sup\left\{ \begin{array}{c|c}
\intop_{K}f^{+}\left(x\right)dx & K\subseteq U,\ \text{קומפקטית ובעלת נפח}\ K\end{array}\right\} \geq\intop_{K_{n}}f^{+}\left(x\right)dx\\
\intop_{U}f^{-}\left(x\right)dx & =\sup\left\{ \begin{array}{c|c}
\intop_{K}f^{-}\left(x\right)dx & K\subseteq U,\ \text{קומפקטית ובעלת נפח}\ K\end{array}\right\} \geq\intop_{K_{n}}f^{-}\left(x\right)dx
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\intop_{U}f^{+}\left(x\right)dx & \geq\lim_{n\rightarrow\infty}\intop_{K_{n}}f^{+}\left(x\right)dx\\
\Rightarrow\intop_{U}f^{-}\left(x\right)dx & \geq\lim_{n\rightarrow\infty}\intop_{K_{n}}f^{-}\left(x\right)dx
\end{align*}


\end_inset
מצד שני לכל קבוצה קומפקטית ובעלת נפח 
\begin_inset Formula
$K\subseteq U$
\end_inset
 קיים 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$K\subseteq K_{n}$
\end_inset
, וממונוטוניות האינטגרל גם:
\begin_inset Formula
\begin{align*}
\intop_{K_{n}}f^{+}\left(x\right)dx & \geq\intop_{K}f^{+}\left(x\right)dx\\
\intop_{K_{n}}f^{-}\left(x\right)dx & \geq\intop_{K}f\left(x\right)dx
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\intop_{U}f^{+}\left(x\right)dx & \leq\lim_{n\rightarrow\infty}\intop_{K_{n}}f^{+}\left(x\right)dx\\
\Rightarrow\intop_{U}f^{-}\left(x\right)dx & \leq\lim_{n\rightarrow\infty}\intop_{K_{n}}f^{-}\left(x\right)dx
\end{align*}


