, כך ש-
\begin_inset Formula
$C\subseteq\tilde{C}$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow V\left(C\right)\leq V\left(\tilde{C}\right)=\left(M\cdot h\right)^{k-1}\cdot d=M^{k-1}\cdot{\color{red}h^{k-1}\cdot d}\leq M^{k-1}\cdot{\color{red}V\left(B\right)}
\]


\end_inset

\end_layout

\begin_layout Corollary
