\begin_inset Formula
\begin{align*}
\Rightarrow\intop_{U}f\left(x\right)dx & =\intop_{U}f^{+}\left(x\right)dx-\intop_{U}f^{-}\left(x\right)dx=\lim_{n\rightarrow\infty}\intop_{K_{n}}f^{+}\left(x\right)dx-\lim_{n\rightarrow\infty}\intop_{K_{n}}f^{-}\left(x\right)dx\\
 & =\lim_{n\rightarrow\infty}\left(\intop_{K_{n}}f^{+}\left(x\right)dx-\intop_{K_{n}}f^{-}\left(x\right)dx\right)=\lim_{n\rightarrow\infty}\intop_{K_{n}}f^{+}\left(x\right)-f^{-}\left(x\right)dx=\lim_{n\rightarrow\infty}\intop_{K_{n}}f\left(x\right)dx
\end{align*}


