\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$A\subseteq\MKreal^{k}$
\end_inset
 ו-
\begin_inset Formula
$B\subseteq\MKreal^{m}$
\end_inset
 תיבות, ותהא 
\begin_inset Formula
$f:A\times B\rightarrow\MKreal$
\end_inset
 פונקציה.
\begin_inset Newline newline
\end_inset
אם 
\begin_inset Formula
$f$
\end_inset
 אינטגרבילית על 
\begin_inset Formula
$A\times B$
\end_inset
 (
\begin_inset Formula
$A\times B\subseteq\MKreal^{k+m}$
\end_inset
) אז האינטגרלים:
\begin_inset Formula
\begin{align*}
 & \intop_{A}\left(\overline{\intop}_{B}f\left(x,y\right)dy\right)dx & \intop_{A}\left(\underline{\intop}_{B}f\left(x,y\right)dy\right)dx\\
 & \intop_{B}\left(\overline{\intop}_{A}f\left(x,y\right)dx\right)dy & \intop_{B}\left(\underline{\intop}_{A}f\left(x,y\right)dx\right)dy
\end{align*}


\end_inset
קיימים ושווים ל-
\begin_inset Formula
${\displaystyle \intop_{A\times B}f\left(x,y\right)dxdy}$
\end_inset
.
\end_layout

\begin_layout Proof
נוכיח את המשפט עבור השורה העליונה, ההוכחה עבור התחתונה כמעט זהה.
\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$f$
\end_inset
 אינטגרבילית על 
\begin_inset Formula
$A\times B$
\end_inset
, ויהי 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
. מכאן שקיימת חלוקה 
\begin_inset Formula
$P$
\end_inset
 של 
\begin_inset Formula
$A\times B$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
\overline{S}\left(f,P\right)-\underline{s}\left(f,P\right)<\varepsilon
\]


\end_inset
תהא 
\begin_inset Formula
$P$
\end_inset
 כנ"ל ותהיינה 
\begin_inset Formula
$P_{A}$
\end_inset
 ו-
\begin_inset Formula
$P_{B}$
\end_inset
 חלוקות של 
\begin_inset Formula
$A$
\end_inset
 ושל 
\begin_inset Formula
$B$
\end_inset
 בהתאמה כך שמתקיים 
\begin_inset Formula
$P=P_{A}\times P_{B}$
\end_inset
.
\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$A_{1},A_{2},\ldots,A_{r}$
\end_inset
 כל התיבות המתאימות לחלוקה 
\begin_inset Formula
$P_{A}$
\end_inset
, ותהיינה 
\begin_inset Formula
$B_{1},B_{2},\ldots,B_{t}$
\end_inset
 כל התיבות המתאימות לחלוקה 
\begin_inset Formula
$P_{A}$
\end_inset
; מכאן שכל תיבה הנוצרת ע"י החלוקה 
\begin_inset Formula
$P$
\end_inset
 היא מהצורה 
\begin_inset Formula
$A_{i}\times A_{j}$
\end_inset
 עבור 
\begin_inset Formula
$r\geq i\in\MKnatural$
\end_inset
 ו-
\begin_inset Formula
$t\geq j\in\MKnatural$
\end_inset
 כלשהם.
\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$g:A\rightarrow\MKreal$
\end_inset
 ו-
\begin_inset Formula
$h:A\rightarrow\MKreal$
\end_inset
 פונקציות המוגדרות ע"י (לכל 
\begin_inset Formula
$x\in A$
\end_inset
):
\begin_inset Formula
\begin{align*}
g\left(x\right) & :=\underline{\intop}_{B}f\left(x,y\right)dy\\
h\left(x\right) & :=\overline{\intop}_{B}f\left(x,y\right)dy
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\underline{s}\left(f,P\right) & =\sum_{i=1}^{r}\sum_{j=1}^{t}V\left(A_{i}\times B_{j}\right)\cdot\inf_{\left(x,y\right)\in A_{i}\times B_{j}}f\left(x,y\right)\\
 & =\sum_{i=1}^{r}\sum_{j=1}^{t}V\left(A_{i}\right)\cdot V\left(B_{j}\right)\cdot\inf_{\left(x,y\right)\in A_{i}\times B_{j}}f\left(x,y\right)\\
 & =\sum_{i=1}^{r}V\left(A_{i}\right)\cdot\left(\sum_{j=1}^{t}V\left(B_{j}\right)\cdot\inf_{\left(x,y\right)\in A_{i}\times B_{j}}f\left(x,y\right)\right)\\
 & \leq\sum_{i=1}^{r}V\left(A_{i}\right)\cdot\inf_{x\in A_{i}}\left(\sum_{j=1}^{t}V\left(B_{j}\right)\cdot\inf_{y\in B_{j}}f\left(x,y\right)\right)\\
 & \leq\sum_{i=1}^{r}V\left(A_{i}\right)\cdot\inf_{x\in A_{i}}\left(\underline{\intop}_{B}f\left(x,y\right)dy\right)\\
 & =\sum_{i=1}^{r}V\left(A_{i}\right)\cdot\inf_{x\in A_{i}}g\left(x\right)=\underline{s}\left(g,P_{A}\right)
\end{align*}


\end_inset
ובאותו אופן נקבל:
\begin_inset Formula
\[
\overline{S}\left(h,P_{A}\right)\leq\overline{S}\left(f,P\right)
\]


\end_inset
ולכן ע"פ הגדרת 
\begin_inset Formula
$P$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\intop_{A\times B}f\left(x,y\right)dxdy-\varepsilon & <\underline{s}\left(f,P\right)\leq{\color{red}\underline{s}\left(g,P_{A}\right)\leq\overline{S}\left(g,P_{A}\right)}\leq\overline{S}\left(h,P_{A}\right)\leq\overline{S}\left(f,P\right)<\intop_{A\times B}f\left(x,y\right)dxdy+\varepsilon\\
\intop_{A\times B}f\left(x,y\right)dxdy-\varepsilon & <\underline{s}\left(f,P\right)\leq\underline{s}\left(g,P_{A}\right)\leq{\color{red}\underline{s}\left(h,P_{A}\right)\leq\overline{S}\left(h,P_{A}\right)}\leq\overline{S}\left(f,P\right)<\intop_{A\times B}f\left(x,y\right)dxdy+\varepsilon
\end{align*}


\end_inset

\begin_inset Formula
$\varepsilon$
\end_inset
 הנ"ל היה שרירותי ולכן מהגדרת האינטגרביליות נקבל שקיימים האינטגרלים:
\begin_inset Formula
\begin{align*}
 & \intop_{A}g\left(x\right)dx & \intop_{A}h\left(x\right)dx
\end{align*}


\end_inset
ומתקיימים השוויונות:
\begin_inset Formula
\begin{align*}
\intop_{A}\left(\underline{\intop}_{B}f\left(x,y\right)dy\right)dx & =\intop_{A}g\left(x\right)dx=\intop_{A\times B}f\left(x,y\right)dxdy\\
\intop_{A}\left(\overline{\intop}_{B}f\left(x,y\right)dy\right)dx & =\intop_{A}h\left(x\right)dx=\intop_{A\times B}f\left(x,y\right)dxdy
\end{align*}


\end_inset

\end_layout

\begin_layout Corollary
תהיינה 
\begin_inset Formula
