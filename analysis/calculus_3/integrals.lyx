W_{i}\left(f\right) & :=\sup_{x\in A_{i}}f\left(x\right)-\inf_{x\in A_{i}}f\left(x\right)\\
W_{i}\left(h\circ f\right) & :=\sup_{x\in A_{i}}h\left(f\left(x\right)\right)-\inf_{x\in A_{i}}h\left(f\left(x\right)\right)
\end{align*}


\end_inset
