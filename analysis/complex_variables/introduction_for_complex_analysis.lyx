\begin_layout Standard
\series bold
\color red
כל הטענות שבסעיף זה לא ממש נלמדו בכיתה, מסיבות מובנות לא יכולתי להתאפק ולחכות לסוף הסמסטר וכתבתי אותן כבר עכשיו.
\color inherit

\series default

\end_layout

\begin_layout Claim
יהי 
\begin_inset Formula
$z\in\MKcomplex$
\end_inset
, שלושת הטורים:
\begin_inset Formula
\begin{align*}
 & \sum_{n=0}^{\infty}\left(-1\right)^{n}\cdot\frac{z^{2n}}{\left(2n\right)!}\\
 & \sum_{n=0}^{\infty}\left(-1\right)^{n}\cdot\frac{z^{2n+1}}{\left(2n+1\right)!}\\
 & \sum_{n=0}^{\infty}\frac{z^{n}}{n!}
\end{align*}


\end_inset
מתכנסים בהחלט ובפרט מתכנסים.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הטענה נובעת מהשוואה לטור הנדסי מתכנס, לכל 
\begin_inset Formula
$z\in\MKcomplex$
\end_inset
 קיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$\left|z\right|<N$
\end_inset
 ואז לכל 
\begin_inset Formula
$N<n\in\MKnatural$
\end_inset
 מתקיים גם:
\begin_inset Formula
\[
\left|\pm1\cdot\frac{z^{n}}{n!}\right|=\frac{\left|z\right|^{n}}{n!}=\frac{\left|z\right|^{N}}{N!}\cdot\frac{\left|z\right|^{n-N}}{n\cdot\left(n-1\right)\cdot\ldots\cdot\left(N+1\right)}<\frac{\left|z\right|^{N}}{N!}\cdot\left(\frac{\left|z\right|}{N}\right)^{n-N}
\]


\end_inset

\begin_inset Formula
${\displaystyle \frac{\left|z\right|^{N}}{N!}}$
\end_inset
 הוא מספר ממשי קבוע ו-
\begin_inset Formula
${\displaystyle \frac{\left|z\right|}{N}<1}$
\end_inset
, א"כ לכל 
\begin_inset Formula
$N<n\in\MKnatural$
\end_inset
 הערך המוחלט של האיבר ה-
\begin_inset Formula
$n$
\end_inset
-י בטורים הנ"ל קטן מהאיבר ה-
\begin_inset Formula
$n-N$
\end_inset
-י בסדרה הנדסית שמנתה קטנה מ-
\begin_inset Formula
$1$
\end_inset
.
\end_layout

\begin_layout Theorem
\series bold
נוסחת אוילר
\series default

\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$\theta\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
e^{i\theta}=\exp\left(i\theta\right)=\MKcis\left(\theta\right)
\]


\end_inset

\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$\theta\in\MKreal$
\end_inset
, מאריתמטיקה של התכנסות טורים (טענה 
\begin_inset CommandInset ref
LatexCommand ref
reference "claim 3.2"
plural false
caps false
noprefix false
\end_inset
) נובע כי:
\begin_inset Formula
\begin{align*}
\MKcis\left(\theta\right) & =\cos\theta+i\cdot\sin\theta=\sum_{n=0}^{\infty}\left(\left({\color{red}-1}\right)^{n}\cdot\frac{\theta^{2n}}{\left(2n\right)!}\right)+\sum_{n=0}^{\infty}\left(\left({\color{red}-1}\right)^{n}\cdot\frac{\theta^{2n+1}}{\left(2n+1\right)!}\right)\\
 & =\sum_{n=0}^{\infty}\left(\left({\color{red}i^{2}}\right)^{n}\cdot\frac{\theta^{2n}}{\left(2n\right)!}\right)+\sum_{n=0}^{\infty}\left({\color{red}i}\cdot\left({\color{red}i^{2}}\right)^{n}\cdot\frac{\theta^{2n+1}}{\left(2n+1\right)!}\right)\\
 & =\sum_{n=0}^{\infty}\left({\color{red}i^{2n}}\cdot\frac{\theta^{2n}}{\left(2n\right)!}\right)+\sum_{n=0}^{\infty}\left({\color{red}i^{2n+1}}\cdot\frac{\theta^{2n+1}}{\left(2n+1\right)!}\right)\\
 & =\sum_{n=0}^{\infty}\left(\frac{\left({\color{red}i}\cdot\theta\right)^{2n}}{\left(2n\right)!}\right)+\sum_{n=0}^{\infty}\left(\frac{\left({\color{red}i}\cdot\theta\right)^{2n+1}}{\left(2n+1\right)!}\right)\\
 & =\sum_{n=0}^{\infty}\left(\frac{\left({\color{red}i}\theta\right)^{2n}}{\left(2n\right)!}+\frac{\left({\color{red}i}\theta\right)^{2n+1}}{\left(2n+1\right)!}\right)
\end{align*}


\end_inset
הטור שקיבלנו מתקבל מהטור 
\begin_inset Formula
${\displaystyle \sum_{n=0}^{\infty}\frac{\left(i\theta\right)^{n}}{n!}}$
\end_inset
 ע"י הכנסת סוגריים, מכאן שמתקיים:
\begin_inset Formula
\[
e^{i\theta}=\exp\left(i\theta\right)=\sum_{n=0}^{\infty}\frac{\left(i\theta\right)^{n}}{n!}=\sum_{n=0}^{\infty}\left(\frac{\left(i\theta\right)^{2n}}{\left(2n\right)!}+\frac{\left(i\theta\right)^{2n+1}}{\left(2n+1\right)!}\right)=\MKcis\left(\theta\right)
\]


\end_inset

\end_layout

\begin_layout Corollary
לכל 
\begin_inset Formula
$0<r\in\MKreal$
\end_inset
 ולכל 
\begin_inset Formula
$\theta\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$r\cdot e^{i\theta}=r\cdot\MKcis\theta$
\end_inset
.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

\end_layout

