\begin_inset Formula
$\cos z\neq0$
\end_inset
, ומכאן נובע כי:
\begin_inset Formula
\begin{align*}
\left\{ z\in\MKcomplex\mid\sin z=0\right\}  & =\left\{ \pi k\mid k\in\MKinteger\right\} \\
\left\{ z\in\MKcomplex\mid\cos z=0\right\}  & =\left\{ \frac{\pi}{2}+\pi k\mid k\in\MKinteger\right\} 
\end{align*}


