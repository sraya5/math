\begin_layout Corollary
לכל 
\begin_inset Formula
$\alpha,\beta\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\sin\left(\alpha\pm\beta\right) & =\sin\alpha\cdot\cos\beta\pm\cos\alpha\cdot\sin\beta\\
\cos\left(\alpha\pm\beta\right) & =\cos\alpha\cdot\cos\beta\mp\sin\alpha\cdot\sin\beta
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כמובן שניתן להוכיח את הטענות הללו גם ללא המרוכבים וכבר עשינו זאת בעבר, אך זוהי הוכחה אלגנטית ולכן שוב לא יכולתי להתאפק והבאתי אותה כאן.
\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula
$\alpha,\beta\in\MKreal$
\end_inset
, מכאן שמתקיים:
\begin_inset Formula
\begin{align*}
e^{i\cdot\left(\alpha\pm\beta\right)} & ={\color{red}\cos\left(\alpha\pm\beta\right)}+i\cdot{\color{blue}\sin\left(\alpha\pm\beta\right)}\\
e^{i\cdot\left(\alpha\pm\beta\right)} & =e^{i\cdot\alpha}\cdot e^{\pm i\cdot\beta}=\left(\cos\alpha+i\cdot\sin\alpha\right)\cdot\left(\cos\left(\pm\beta\right)+i\cdot\sin\left(\pm\beta\right)\right)\\
 & =\left(\cos\alpha+i\cdot\sin\alpha\right)\cdot\left(\cos\beta\pm i\cdot\sin\beta\right)\\
 & ={\color{red}\left(\cos\alpha\cdot\cos\beta\mp\sin\alpha\cdot\sin\beta\right)}+i\cdot{\color{blue}\left(\sin\alpha\cdot\cos\beta\pm\cos\alpha\cdot\sin\beta\right)}
\end{align*}


\end_inset
וממילא:
\begin_inset Formula
\begin{align*}
{\color{blue}\sin\left(\alpha\pm\beta\right)} & {\color{blue}=\sin\alpha\cdot\cos\beta\pm\cos\alpha\cdot\sin\beta}\\
{\color{red}\cos\left(\alpha\pm\beta\right)} & {\color{red}=\cos\alpha\cdot\cos\beta\mp\sin\alpha\cdot\sin\beta}
\end{align*}


\end_inset

\end_layout

\begin_layout Standard
\series bold
\color red
אני לא בטוח כמה ההוכחה הזו עוזרת לנו מפני שכזכור הוכחנו את הקשר בין ההצגה הקוטבית לבין הכפל ב-
