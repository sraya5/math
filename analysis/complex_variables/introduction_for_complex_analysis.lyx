\begin_layout Subsection
טורים הנדסיים
\end_layout

\begin_layout Claim
תהא 
\begin_inset Formula
$\left(a_{n}\right)_{n=0}^{\infty}$
\end_inset
 סדרה הנדסית ותהא 
\begin_inset Formula
$q\in\MKcomplex$
\end_inset
 הפרש הסדרה, לכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 מתקיים 
\begin_inset Formula
$a_{n}=a_{0}\cdot q^{n}$
\end_inset
.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$1\neq q\in\MKcomplex$
\end_inset
 ולכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sum_{k=0}^{n}q^{k}=\frac{q^{n+1}-1}{q-1}
\]


\end_inset

\end_layout

\begin_layout Corollary
תהא 
\begin_inset Formula
$\left(a_{n}\right)_{n=0}^{\infty}$
\end_inset
 סדרה הנדסית כך ש-
\begin_inset Formula
$1\neq q\in\MKcomplex$
\end_inset
 היא מנת הסדרה, לכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sum_{k=0}^{n}a_{k}=a_{0}\cdot\frac{q^{n+1}-1}{q-1}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כמובן שאם 
\begin_inset Formula
$q=1$
\end_inset
 אז הסכום החלקי ה-
\begin_inset Formula
$n$
\end_inset
-י הוא 
\begin_inset Formula
$a_{0}\cdot\left(n+1\right)$
\end_inset
.
\end_layout

\begin_layout Corollary
תהא 
\begin_inset Formula
$\left(a_{n}\right)_{n=0}^{\infty}$
\end_inset
 סדרה הנדסית, ותהא 
\begin_inset Formula
$q\in\MKcomplex$
\end_inset
 מנת הסדרה; הטור 
\begin_inset Formula
$\sum_{n=0}^{\infty}a_{n}$
\end_inset
 מתכנס אם"ם 
\begin_inset Formula
$\left|q\right|<1$
\end_inset
, ובמקרה כזה מתקיים:
\begin_inset Formula
\[
\sum_{n=0}^{\infty}a_{n}=a_{0}\cdot\frac{1}{1-q}
\]


\end_inset

\end_layout

\begin_layout Subsection
