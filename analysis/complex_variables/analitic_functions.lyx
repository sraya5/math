\begin_inset Formula
$\MKcomplex^{*}$
\end_inset
 ל-
\begin_inset Formula
$\left\{ z\in\MKcomplex\mid\alpha\leq\MKim\left(z\right)<\alpha+2\pi\right\} $
\end_inset
.
\end_layout

