\begin_inset Formula
\[
\frac{z}{\left|z\right|}=\MKcis\left(\arg_{\alpha}\left(z\right)\right)
\]


\end_inset
וכמו כן נסמן 
\begin_inset Formula
$\log_{\alpha}\left(z\right):=\ln\left|z\right|+i\cdot\arg_{\alpha}\left(z\right)$
\end_inset
.
