\end_inset
 שתי העתקות מביוס, ויהיו 
\begin_inset Formula
$a_{1},b_{1},c_{1},d_{1},a_{2},b_{2},c_{2},d_{2}\in\MKcomplex$
\end_inset
 כך שמתקיים (לכל 
\begin_inset Formula
$z\in\hat{\MKcomplex}$
\end_inset
):
\begin_inset Formula
\begin{align*}
T_{1}\left(z\right) & =\frac{a_{1}z+b_{1}}{c_{1}z+d_{1}} & T_{2}\left(z\right) & =\frac{a_{2}z+b_{2}}{c_{2}z+d_{2}}
\end{align*}


\end_inset
לכל 
\begin_inset Formula
$z\in\hat{\MKcomplex}$
\end_inset
 מתקיים גם:
\begin_inset Formula
\[
T_{1}\left(T_{2}\left(z\right)\right)=\frac{\left(a_{1}a_{2}+b_{1}c_{2}\right)\cdot z+\left(a_{1}b_{2}+b_{1}d_{2}\right)}{\left(c_{1}a_{2}+d_{1}c_{2}\right)\cdot z+\left(c_{1}b_{2}+d_{1}d_{2}\right)}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נשים לב לדמיון הברור לכפל מטריצות:
\begin_inset Formula
\[
\left[\begin{array}{cc}
a_{1} & b_{1}\\
c_{1} & d_{1}
\end{array}\right]\cdot\left[\begin{array}{cc}
a_{2} & b_{2}\\
c_{2} & d_{2}
\end{array}\right]=\left[\begin{array}{cc}
a_{1}a_{2}+b_{1}c_{2} & a_{1}b_{2}+b_{1}d_{2}\\
c_{1}a_{2}+d_{1}c_{2} & c_{1}b_{2}+d_{1}d_{2}
\end{array}\right]
\]


\end_inset
כלומר קבוצת כל ההעתקות של מביוס היא חבורה שהכפל שלה הוא הרכבת פונקציות, ובנוסף הפונקציה המעתיקה מטריצה ב-
\begin_inset Formula
