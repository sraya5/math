\end_inset
 ו-
\begin_inset Formula
$a_{1}<b_{1}$
\end_inset
, ותהיינה 
\begin_inset Formula
$\gamma_{0}:\left[a_{0},b_{0}\right]\rightarrow\Omega$
\end_inset
 ו-
\begin_inset Formula
$\gamma_{1}:\left[a_{1},b_{1}\right]\rightarrow\Omega$
\end_inset
 מסילות סגורות.
\begin_inset Newline newline
\end_inset
נאמר ש-
\begin_inset Formula
$\gamma_{0}$
\end_inset
 ו-
\begin_inset Formula
$\gamma_{1}$
\end_inset
 
\bar under
הומוטופיות
\bar default
 ב-
\begin_inset Formula
$\Omega$
\end_inset
 אם קיימת פונקציה רציפה 
\begin_inset Formula
$H:\left[0,1\right]\times\left[0,1\right]\rightarrow\Omega$
\end_inset
 (שתיקרא 
\bar under
הומוטופיה
\bar default
), כך שלכל 
\begin_inset Formula
$s,t\in\left[0,1\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
H\left(s,0\right) & =H\left(s,1\right)\\
H\left(0,t\right) & =\gamma_{0}\left(\left(1-t\right)\cdot a_{0}+t\cdot b_{0}\right)\\
H\left(1,t\right) & =\gamma_{1}\left(\left(1-t\right)\cdot a_{1}+t\cdot b_{1}\right)
\end{align*}


\end_inset
כלומר לכל 
\begin_inset Formula
$s\in\left[0,1\right]$
\end_inset
 הפונקציה 
\begin_inset Formula
$t\mapsto H\left(s,t\right)$
\end_inset
 היא מסילה סגורה, ובנוסף הפונקציות 
\begin_inset Formula
$t\mapsto H\left(0,t\right)$
\end_inset
 ו-
\begin_inset Formula
$t\mapsto H\left(1,t\right)$
\end_inset
 הן 
\begin_inset Formula
$\gamma_{0}$
\end_inset
 ו-
\begin_inset Formula
$\gamma_{1}$
\end_inset
 בהתאמה.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הומוטופיות הוא יחס שקילות.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הדרך הכי פשוטה לבנות הומוטופיה על שתי מסילות היא ע"י (לכל 
\begin_inset Formula
$\left(s,t\right)\in\left[0,1\right]\times\left[0,1\right]$
\end_inset
):
\begin_inset Formula
\[
H\left(s,t\right):=\left(1-s\right)\cdot\gamma_{0}\left(\left(1-t\right)\cdot a_{0}+t\cdot b_{0}\right)+s\cdot\gamma_{1}\left(\left(1-t\right)\cdot a_{1}+t\cdot b_{1}\right)
\]


\end_inset

\end_layout

