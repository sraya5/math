\begin_layout Proof
נוכיח את הטענה באינדוקציה; ראינו כבר שהטענה נכונה עבור 
\begin_inset Formula
$n=0$
\end_inset
 (נוסחת קושי), ולכן נעבור ישירות לצעד האינדוקציה.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 ונניח שלכל 
\begin_inset Formula
$w\in B_{r}\left(z_{0}\right)$
\end_inset
 מתקיים:
\begin_inset Formula
\[
f^{\left(n\right)}\left(w\right)=\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(z\right)}{\left(z-w\right)^{n+1}}\ dz
\]


\end_inset
יהי 
\begin_inset Formula
$w_{0}\in B_{r}\left(z_{0}\right)$
\end_inset
, א"כ לכל 
\begin_inset Formula
$w_{0}\neq w\in B_{r}\left(z_{0}\right)$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\frac{f^{\left(n\right)}\left(w\right)-f^{\left(n\right)}\left(w_{0}\right)}{w-w_{0}} & =\frac{1}{w-w_{0}}\cdot\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(z\right)}{\left(z-w\right)^{n+1}}\ dz-\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(z\right)}{\left(z-w_{0}\right)^{n+1}}\ dz\\
 & =\frac{1}{w-w_{0}}\cdot\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}f\left(z\right)\cdot\left(\frac{1}{\left(z-w\right)^{n+1}}-\frac{1}{\left(z-w_{0}\right)^{n+1}}\right)\ dz\\
 & =\frac{1}{w-w_{0}}\cdot\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}f\left(z\right)\cdot\frac{\left(z-w_{0}\right)^{n+1}-\left(z-w\right)^{n+1}}{\left(z-w\right)^{n+1}\left(z-w_{0}\right)^{n+1}}\ dz\\
 & =\frac{1}{w-w_{0}}\cdot\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}f\left(z\right)\cdot\frac{\left(\left(z-w_{0}\right)-\left(z-w\right)\right)\cdot\sum_{k=0}^{n}\left(z-w_{0}\right)^{k}\cdot\left(z-w\right)^{n-k}}{\left(z-w\right)^{n+1}\left(z-w_{0}\right)^{n+1}}\ dz\\
 & ={\color{red}\frac{1}{w-w_{0}}}\cdot\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}f\left(z\right)\cdot\frac{{\color{red}\left(w-w_{0}\right)}\cdot\sum_{k=0}^{n}\left(z-w_{0}\right)^{k}\cdot\left(z-w\right)^{n-k}}{\left(z-w\right)^{n+1}\left(z-w_{0}\right)^{n+1}}\ dz\\
 & =\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}f\left(z\right)\cdot\frac{\sum_{k=0}^{n}\left(z-w_{0}\right)^{k}\cdot\left(z-w\right)^{n-k}}{\left(z-w\right)^{n+1}\left(z-w_{0}\right)^{n+1}}\ dz
\end{align*}


\end_inset
ומכאן שגם:
\begin_inset Formula
\begin{align*}
 & \frac{f^{\left(n\right)}\left(w\right)-f^{\left(n\right)}\left(w_{0}\right)}{w-w_{0}}-\frac{\left(n+1\right)!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(z\right)}{\left(z-w_{0}\right)^{n+2}}\ dz\\
= & \frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}f\left(z\right)\cdot\frac{\left(\sum_{k=0}^{n}\left(z-w_{0}\right)^{k+1}\cdot\left(z-w\right)^{n-k}\right)-\left(n+1\right)\cdot\left(z-w\right)^{n+1}}{\left(z-w\right)^{n+1}\left(z-w_{0}\right)^{n+2}}\ dz
\end{align*}


\end_inset
תהא 
\begin_inset Formula
$\left(w_{m}\right)_{m=1}^{\infty}$
\end_inset
 סדרת נקודות ב-
\begin_inset Formula
$B_{r}\left(z_{0}\right)\setminus\left\{ w_{0}\right\} $
\end_inset
 המתכנסת ל-
\begin_inset Formula
$w_{0}$
\end_inset
, ותהא 
\begin_inset Formula
$\left(g_{m}\right)_{m=1}^{\infty}$
\end_inset
 סדרת פונקציות המוגדרות ע"י (לכל 
\begin_inset Formula
$m\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$z\in\partial B_{r}\left(z_{0}\right)$
\end_inset
):
\begin_inset Formula
\[
g_{m}\left(z\right):=f\left(z\right)\cdot\frac{\left(\sum_{k=0}^{n}\left(z-w_{0}\right)^{k+1}\cdot\left(z-w\right)^{n-k}\right)-\left(n+1\right)\cdot\left(z-w\right)^{n+1}}{\left(z-w\right)^{n+1}\left(z-w_{0}\right)^{n+2}}
\]


\end_inset
נסמן:
\begin_inset Formula
\[
M:=\max_{z\in\partial B_{r}\left(z_{0}\right)}\left|\frac{f\left(z\right)}{\left(z-w_{0}\right)^{2n+3}}\right|
\]


\end_inset
לכל 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
 קיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך שלכל 
\begin_inset Formula
$N<m\in\MKnatural$
\end_inset
, לכל 
\begin_inset Formula
$n\geq k\in\MKnatural_{0}$
\end_inset
 ולכל 
\begin_inset Formula
$z\in\partial B_{r}\left(z_{0}\right)$
\end_inset
 יתקיים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
השורה השנייה גוררת את השלישית, וכל הארבע הראשונות גוררות את הא"ש האחרון.
\end_layout

\end_inset
:
\begin_inset Formula
\begin{align*}
\left|\frac{f\left(z\right)}{\left(z-w_{m}\right)^{n+1}\left(z-w_{0}\right)^{n+2}}\right| & <M+1\\
\left|\left(z-w_{m}\right)^{n-k}-\left(z-w_{0}\right)^{n-k}\right| & <\frac{\varepsilon}{2n\cdot\left(M+1\right)}\\
\left|\sum_{k=0}^{n}\left(z-w_{0}\right)^{k+1}\cdot\left(z-w\right)^{n-k}-\left(n+1\right)\cdot\left(z-w_{0}\right)^{n-k}\right| & <\frac{\varepsilon}{2\cdot\left(M+1\right)}\\
\left|\left(n+1\right)\cdot\left(z-w\right)^{n+1}-\left(n+1\right)\cdot\left(z-w_{0}\right)^{n-k}\right| & <\frac{\varepsilon}{2\cdot\left(M+1\right)}
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\left|g_{m}\left(z\right)\right| & =\left|f\left(z\right)\cdot\frac{\left(\sum_{k=0}^{n}\left(z-w_{0}\right)^{k+1}\cdot\left(z-w\right)^{n-k}\right)-\left(n+1\right)\cdot\left(z-w\right)^{n+1}}{\left(z-w\right)^{n+1}\left(z-w_{0}\right)^{n+2}}\right|\\
 & <\frac{\varepsilon}{M+1}\cdot\left(M+1\right)=\varepsilon
\end{align*}


\end_inset
מכאן ש-
\begin_inset Formula
$\left(g_{m}\right)_{m=1}^{\infty}$
\end_inset
 מתכנסת במ"ש לפונקציית האפס ולכן:
\begin_inset Formula
\begin{align*}
 & \lim_{m\rightarrow\infty}\left(\frac{f^{\left(n\right)}\left(w_{m}\right)-f^{\left(n\right)}\left(w_{0}\right)}{w_{m}-w_{0}}-\frac{\left(n+1\right)!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(z\right)}{\left(z-w_{0}\right)^{n+2}}\ dz\right)\\
= & \lim_{m\rightarrow\infty}\left(\frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}g_{m}\left(z\right)dz\right)=\frac{n!}{2\pi i}\cdot\lim_{m\rightarrow\infty}\intop_{C\left(z_{0},r\right)}g_{m}\left(z\right)dz\\
= & \frac{n!}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}0\ dz=0
\end{align*}


\end_inset

\begin_inset Formula
$\left(w_{m}\right)_{m=1}^{\infty}$
\end_inset
 הייתה סדרה שרירותית ולכן הנ"ל נכון לכל סדרה ב-
\begin_inset Formula
$B_{r}\left(z_{0}\right)\setminus\left\{ w_{0}\right\} $
\end_inset
 המתכנסת ל-
\begin_inset Formula
$w_{0}$
\end_inset
, מאפיון היינה לגבול של פונקציה בנקודה נובע כי:
