\end_inset
:
\begin_inset Formula
\[
\frac{z-z_{0}}{z-w}=\left(\frac{z-w}{z-z_{0}}\right)^{-1}=\left(\frac{\left(z-z_{0}\right)-\left(w-z_{0}\right)}{z-z_{0}}\right)^{-1}=\frac{1}{1-\frac{w-z_{0}}{z-z_{0}}}=\sum_{n=0}^{\infty}\left(\frac{w-z_{0}}{z-z_{0}}\right)^{n}
\]


\end_inset
ולכן גם:
\begin_inset Formula
\[
\frac{1}{z-w}=\left(z-z_{0}\right)\cdot\sum_{n=0}^{\infty}\left(\frac{w-z_{0}}{z-z_{0}}\right)^{n}=\sum_{n=1}^{\infty}\frac{\left(w-z_{0}\right)^{n-1}}{\left(z-z_{0}\right)^{n}}
\]


\end_inset
כמו כל טור הנדסי מתכנס הטור הנ"ל מתכנס במידה שווה ולכן מתקיים:
\begin_inset Formula
\[
\intop_{C\left(z_{0},r\right)}\frac{1}{z-w}\ dz=\intop_{C\left(z_{0},r\right)}\sum_{n=1}^{\infty}\frac{\left(w-z_{0}\right)^{n-1}}{\left(z-z_{0}\right)^{n}}\ dz=\sum_{n=1}^{\infty}\left(\intop_{C\left(z_{0},r\right)}\frac{\left(w-z_{0}\right)^{n-1}}{\left(z-z_{0}\right)^{n}}\ dz\right)
\]


\end_inset
לכל 
\begin_inset Formula
$1<n\in\MKnatural$
