\end_inset
 להעתקת מביוס עם אותם מקדמים היא אפימורפיזם שהגרעין שלו הוא המטריצות הסקלריות. זו הסיבה לכך שהדרישה 
\begin_inset Formula
$ad-bc\neq0$
\end_inset
 קובעת שההעתקה הפיכה, וזו גם הסיבה לכך שכל ההצגות של העתקת מביוס נתונה זהות עד כדי כפל בסקלר.
\end_layout

