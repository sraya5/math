\end_inset
 עם יחס דמיון 
\begin_inset Formula
$2:1$
\end_inset
.
\begin_inset Newline newline
\end_inset
למעשה כל מה שאנחנו נצטרך עבור ההוכחה הוא שאורכי המסילות המקיפות את המשולשים הללו הם חצי מאורך המסילה המקיפה את המשולש המקורי, את זה קל לוודא ישירות מהגדרה ולכן לא מדובר בהוכחה המסתמכת על טענה גאומטרית.
\end_layout

\begin_layout Itemize
נגדיר סדרת מסילות 
\begin_inset Formula
$\left(\Delta_{n}\right)_{n=1}^{\infty}$
\end_inset
 וסדרת מספרים ממשיים 
\begin_inset Formula
$\left(I_{n}\right)_{n=1}^{\infty}$
\end_inset
 באופן הבא:
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula
$\Delta_{1}:=T\left(z_{1},z_{2},z_{3}\right)$
\end_inset
 ו-
\begin_inset Formula
$I_{1}:=\left|\intop_{\Delta_{1}}f\left(z\right)dz\right|$
\end_inset
.
\end_layout

\begin_layout Itemize
לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 נחלק את המשולש המוגדר ע"י 
\begin_inset Formula
$\Delta_{n}$
\end_inset
 לארבעה משולשים חופפים באופן המפורט לעיל, ונסמן ב-
\begin_inset Formula
$\Delta_{n+1}$
\end_inset
 את אחת מארבע המסילות הנוצרות מחלוקה זו כך שיתקיים:
\begin_inset Formula
\[
I_{n+1}:=\left|\intop_{\Delta_{n+1}}f\left(z\right)dz\right|\geq\frac{I_{n}}{4}
\]


\end_inset
מעיקרון שובך היונים נובע שקיימת לפחות מסילה אחת כזו.
\end_layout

\end_deeper

\begin_layout Itemize
לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 נסמן ב-
\begin_inset Formula
$\tilde{\Delta_{n}}$
\end_inset
 את המשולש הסגור המוגדר ע"י המסילה 
\begin_inset Formula
$\Delta_{n}$
\end_inset
 (כולל פנים המשולש ושפתו) - זוהי קבוצה סגורה וחסומה; מהגדרה מתקיים 
\begin_inset Formula
$\tilde{\Delta_{n+1}}\subseteq\tilde{\Delta_{n}}$
\end_inset
 לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
, ו-
\begin_inset Formula
${\displaystyle \lim_{n\rightarrow\infty}\MKdiam\left(\tilde{\Delta_{n}}\right)=0}$
\end_inset
, ומכאן שע"פ הלמה של קנטור קיימת נקודה יחידה 
\begin_inset Formula
$z_{0}\in\MKcomplex$
\end_inset
 כך ש-
\begin_inset Formula
${\displaystyle \bigcap_{n=1}^{\infty}\tilde{\Delta_{n}}=\left\{ z_{0}\right\} }$
\end_inset
; תהא 
\begin_inset Formula
$z_{0}$
\end_inset
 כנ"ל.
\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$\varepsilon:\Omega\rightarrow\MKcomplex$
\end_inset
 פונקציה רציפה כך ש-
\begin_inset Formula
$\varepsilon\left(z_{0}\right)=0$
\end_inset
 ולכל 
\begin_inset Formula
$z\in\Omega$
\end_inset
 מתקיים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
מהיות 
\begin_inset Formula
$f$
\end_inset
 אנליטית ב-
\begin_inset Formula
$z_{0}$
\end_inset
 נובע שקיימת 
\begin_inset Formula
$\varepsilon$
\end_inset
 כזו.
\end_layout

\end_inset
:
\begin_inset Formula
\[
f\left(z\right)=f\left(z_{0}\right)+f'\left(z_{0}\right)\cdot\left(z-z_{0}\right)+\varepsilon\left(z\right)\cdot\left(z-z_{0}\right)
\]


\end_inset
מהמשפט היסודי נובע כי (לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
):
\begin_inset Formula
\begin{align*}
\frac{I_{1}}{4^{n}}\leq I_{n} & =\left|\intop_{\Delta_{n}}f\left(z\right)dz\right|=\left|{\color{red}\intop_{\Delta_{n}}f\left(z_{0}\right)dz+\intop_{\Delta_{n}}f'\left(z_{0}\right)\cdot\left(z-z_{0}\right)dz}+\intop_{\Delta_{n}}\varepsilon\left(z\right)\cdot\left(z-z_{0}\right)dz\right|\\
 & =\left|{\color{red}0+0}+\intop_{\Delta_{n}}\mathcal{S}_{f,z_{0}}\left(z\right)\cdot\left(z-z_{0}\right)dz\right|\leq\max_{z\in\Delta_{n}^{*}}\left|\varepsilon\left(z\right)\right|\cdot\max_{z\in\Delta_{n}^{*}}\left|z-z_{0}\right|\cdot L\left(\Delta_{n}\right)\\
 & =\max_{z\in\Delta_{n}^{*}}\left|\varepsilon\left(z\right)\right|\cdot\left(L\left(\Delta_{n}\right)\right)^{2}=\max_{z\in\Delta_{n}^{*}}\left|\varepsilon\left(z\right)\right|\cdot\left(\frac{L\left(\Delta_{1}\right)}{2^{n}}\right)^{2}=\max_{z\in\Delta_{n}^{*}}\left|\varepsilon\left(z\right)\right|\cdot\frac{\left(L\left(\Delta_{1}\right)\right)^{2}}{4^{n}}
\end{align*}


\end_inset
וממילא גם:
\begin_inset Formula
\[
\left|\intop_{\Delta_{1}}f\left(z\right)dz\right|=I_{1}\leq\left(L\left(\Delta_{1}\right)\right)^{2}\cdot\max_{z\in\Delta_{n}^{*}}\left|\varepsilon\left(z\right)\right|\xrightarrow[n\rightarrow\infty]{}0
\]


\end_inset
ומכאן ש-
\begin_inset Formula
$\intop_{\Delta_{1}}f\left(z\right)dz=\left|\intop_{\Delta_{1}}f\left(z\right)dz\right|=0$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Theorem
\series bold
משפט האינטגרל של קושי למשולשים (הגרסה החזקה)
\series default

\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$f:\Omega\rightarrow\MKcomplex$
\end_inset
 פונקציה רציפה, אם 
\begin_inset Formula
$f$
\end_inset
 אנליטית בכל נקודה ב-
\begin_inset Formula
$\Omega$
\end_inset
 מלבד מספר סופי של נקודות, אז לכל 
\begin_inset Formula
$z_{1},z_{2},z_{3}\in\MKcomplex$
\end_inset
 כך ש-
\begin_inset Formula
$\Delta\left(z_{1},z_{2},z_{3}\right)\subseteq\Omega$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\intop_{T\left(z_{1},z_{2},z_{3}\right)}f\left(z\right)dz=0
\]


\end_inset

\end_layout

\begin_layout Proof
נניח ש-
\begin_inset Formula
$f$
\end_inset
 אנליטית בכל נקודה ב-
\begin_inset Formula
$\Omega$
\end_inset
 מלבד מספר סופי של נקודות, ונסמן ב-
\begin_inset Formula
$k$
\end_inset
 את מספר הנקודות שבהן 
\begin_inset Formula
$f$
\end_inset
 אינה אנליטית.
\begin_inset Newline newline
\end_inset
כפי שראינו בהוכחת הגרסה החלשה של המשפט, לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 ניתן להציג את 
\begin_inset Formula
$\intop_{T\left(z_{1},z_{2},z_{3}\right)}f\left(z\right)dz$
\end_inset
 כאינטגרל של של 
\begin_inset Formula
$f$
\end_inset
 לאורך 
\begin_inset Formula
$4^{n}$
\end_inset
 מסילות משולשיות חופפות שאורכן הוא 
\begin_inset Formula
$\frac{1}{2^{n}}$
\end_inset
 מהאורך של 
\begin_inset Formula
$T\left(z_{1},z_{2},z_{3}\right)$
\end_inset
, ובנוסף כל אחת מ-
\begin_inset Formula
$k$
\end_inset
 הנקודות הללו יכולה להיות במשולש של 
\begin_inset Formula
$6$
\end_inset
 מסילות כאלה לכל היותר. מהגרסה החלשה של המשפט נובע שהאינטגרל של 
\begin_inset Formula
$f$
\end_inset
 לאורך כל אחת מהמסילות האחרות הוא 
\begin_inset Formula
$0$
\end_inset
 ולכן לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|\intop_{T\left(z_{1},z_{2},z_{3}\right)}f\left(z\right)dz\right|\leq6k\cdot M\cdot\frac{1}{2^{n}}\xrightarrow[n\rightarrow\infty]{}0
\]


\end_inset
כאשר 
\begin_inset Formula
$M:=\max\left\{ \left|f\left(z\right)\right|:z\in\Delta\left(z_{1},z_{2},z_{3}\right)\right\} $
\end_inset
. מכאן שגם במקרה זה מתקיים:
\begin_inset Formula
\[
\intop_{T\left(z_{1},z_{2},z_{3}\right)}f\left(z\right)dz=\left|\intop_{T\left(z_{1},z_{2},z_{3}\right)}f\left(z\right)dz\right|=0
\]


\end_inset

\end_layout

\begin_layout Lemma
\begin_inset CommandInset label
LatexCommand label
