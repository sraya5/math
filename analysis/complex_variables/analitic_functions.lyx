\shape default

\series default

\family default
(לכל 
\begin_inset Formula
$w\in\Omega$
\end_inset
):
\begin_inset Formula
\[
F\left(w\right):=\intop_{I\left(z_{0},w\right)}f\left(z\right)dz
\]


\end_inset
אם 
\begin_inset Formula
$f$
\end_inset
 אנליטית בכל נקודה ב-
\begin_inset Formula
$\Omega$
\end_inset
 מלבד מספר סופי של נקודות, אז לכל 
\begin_inset Formula
$w\in\Omega$
\end_inset
 מתקיים 
\begin_inset Formula
$F'\left(w\right)=f\left(w\right)$
\end_inset
; כלומר 
\begin_inset Formula
$F$
\end_inset
 אנליטית על 
\begin_inset Formula
$\Omega$
\end_inset
 והיא קדומה של 
\begin_inset Formula
$f$
\end_inset
.
\end_layout

\begin_layout Proof
נניח ש-
\begin_inset Formula
$f$
\end_inset
 אנליטית בכל נקודה ב-
\begin_inset Formula
$\Omega$
\end_inset
 מלבד מספר סופי של נקודות, יהי 
\begin_inset Formula
$w_{0}\in\Omega$
\end_inset
, ויהי 
\begin_inset Formula
$0<r\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$B_{r}\left(w_{0}\right)\subseteq\Omega$
\end_inset
.
\begin_inset Newline newline
\end_inset
ע"פ הלמה (
\begin_inset CommandInset ref
LatexCommand ref
reference "lemma 1.3"
plural false
caps false
noprefix false
nolink false
\end_inset
) לכל 
\begin_inset Formula
$w\in B_{r}\left(w_{0}\right)$
\end_inset
 מתקיים 
\begin_inset Formula
$\Delta\left(z_{0},w,w_{0}\right)\subseteq\Omega$
\end_inset
, ולכן ממשפט האינטגרל של קושי נובע כי:
\begin_inset Formula
\[
\intop_{I\left(z_{0},w\right)}f\left(z\right)dz+\intop_{I\left(w,w_{0}\right)}f\left(z\right)dz+\intop_{I\left(w_{0},z_{0}\right)}f\left(z\right)dz=\intop_{T\left(z_{0}\right)}f\left(z\right)dz=0
\]


\end_inset
ולכן גם:
\begin_inset Formula
\[
\intop_{I\left(z_{0},w\right)}f\left(z\right)dz-\intop_{I\left(z_{0},w_{0}\right)}f\left(z\right)dz=\intop_{I\left(z_{0},w\right)}f\left(z\right)dz+\intop_{I\left(w_{0},z_{0}\right)}f\left(z\right)dz=-\intop_{I\left(w,w_{0}\right)}f\left(z\right)dz
\]


\end_inset
וממילא:
\begin_inset Formula
\begin{align*}
\frac{F\left(w\right)-F\left(w_{0}\right)}{w-w_{0}} & =\frac{\intop_{I\left(z_{0},w\right)}f\left(z\right)dz-\intop_{I\left(z_{0},w_{0}\right)}f\left(z\right)dz}{w-w_{0}}\\
 & =\frac{-\intop_{I\left(w,w_{0}\right)}f\left(z\right)dz}{w-w_{0}}=\frac{\intop_{I\left(w_{0},w\right)}f\left(z\right)dz}{w-w_{0}}\\
 & =\frac{\intop_{0}^{1}f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)\cdot\left(w-w_{0}\right)dt}{w-w_{0}}\\
 & =\frac{\left(w-w_{0}\right)\cdot\intop_{0}^{1}f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)dt}{w-w_{0}}\\
 & =\intop_{0}^{1}f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)dt\\
 & =\intop_{0}^{1}f\left(w_{0}\right)dt+\intop_{0}^{1}f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)-f\left(w_{0}\right)dt\\
 & =f\left(w_{0}\right)+\intop_{0}^{1}f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)-f\left(w_{0}\right)dt
\end{align*}


\end_inset
מהיות 
\begin_inset Formula
$f$
\end_inset
 רציפה נובע כי:
\begin_inset Formula
\[
\lim_{t\rightarrow0}\left|f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)-f\left(w_{0}\right)\right|=0
\]


\end_inset
ולכן גם:
\begin_inset Formula
\[
\left|\intop_{0}^{1}f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)-f\left(w_{0}\right)dt\right|\leq\max_{t\in\left[0,1\right]}\left|f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)-f\left(w_{0}\right)\right|\xrightarrow[w\rightarrow w_{0}]{}0
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow F'\left(w_{0}\right)=\lim_{w\rightarrow w_{0}}\frac{F\left(w\right)-F\left(w_{0}\right)}{w-w_{0}}=f\left(w_{0}\right)+\lim_{w\rightarrow w_{0}}\left(\intop_{0}^{1}f\left(w_{0}+t\cdot\left(w-w_{0}\right)\right)-f\left(w_{0}\right)dt\right)=f\left(w_{0}\right)
\]


\end_inset

\end_layout

