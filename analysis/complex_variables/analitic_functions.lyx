\begin_layout Standard
יהיו 
\begin_inset Formula
$a,b\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$a<b$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 החיסרון שביכולת לקבוע מהו הארגומנט של נקודה במישור המרוכב באופן רציף מהווה יתרון בתחום אחר: בהינתן מסילה סגורה 
\begin_inset Formula
$\gamma:\left[a,b\right]\rightarrow\MKcomplex$
\end_inset
 ונקודה 
\begin_inset Formula
$z_{0}\in\MKcomplex$
\end_inset
 שאינה בתמונה של 
\begin_inset Formula
$\gamma$
\end_inset
 היינו רוצים להגדיר את מספר הפעמים ש-
\begin_inset Formula
$\gamma$
\end_inset
 "מקיפה" את 
\begin_inset Formula
$z_{0}$
\end_inset
, ראינו בקובץ הטענות שלמסילה 
\begin_inset Formula
$\gamma-z_{0}$
\end_inset
 יש ארגומנט רציף ולכן נוכל להשתמש בו כדי לקבוע את מספר הסיבובים - הערכים שהארגומנט מחזיר עבור 
\begin_inset Formula
$a$
\end_inset
 ו-
\begin_inset Formula
$b$
\end_inset
 צריכים לייצג את אותה זווית (כי 
\begin_inset Formula
$\gamma\left(a\right)=\gamma\left(b\right)$
\end_inset
) ולכן ההפרש ביניהם צריך להיות כפולה שלמה של 
\begin_inset Formula
$2\pi$
\end_inset
! כדי להבין מדוע אותה כפולה של 
\begin_inset Formula
$2\pi$
\end_inset
 היא מספר הסיבובים המבוקש נניח ש-
\begin_inset Formula
$z_{0}=0$
\end_inset
, הארגומנט מחזיר ערכים עבור נקודות ב-
\begin_inset Formula
$\left[a,b\right]$
\end_inset
, כאשר 
\begin_inset Formula
$\gamma$
\end_inset
 מסתובבת נגד כיוון השעון הערכים הולכים וגדלים ואם פתאום תחזור 
\begin_inset Formula
$\gamma$
\end_inset
 בכיוון ההפוך הם ילכו ויקטנו; אבל מתי הארגומנט יחזיר את 
\begin_inset Formula
$2\pi$
\end_inset
? בדיוק כאשר נגיע לנקודה שנמצאת על אותה קרן שמכילה את 
\begin_inset Formula
$\gamma\left(a\right)$
\end_inset
 ולאחר שסיימנו הקפה שלמה סביב הראשית.
\end_layout

\begin_layout Theorem*
תהא 
\begin_inset Formula
$\gamma:\left[a,b\right]\rightarrow\MKcomplex$
\end_inset
 מסילה סגורה, יהי 
\begin_inset Formula
$z_{0}\in\MKcomplex$
\end_inset
 כך ש-
\begin_inset Formula
$z_{0}\notin\gamma^{*}$
\end_inset
 ויהיו 
\begin_inset Formula
$\theta_{1}$
\end_inset
 ו-
\begin_inset Formula
$\theta_{2}$
\end_inset
 ארגומנטים רציפים של המסילה 
\begin_inset Formula
$\gamma-z_{0}$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow\frac{\theta_{1}\left(b\right)-\theta_{1}\left(a\right)}{2\pi}=\frac{\theta_{2}\left(b\right)-\theta_{2}\left(a\right)}{2\pi}\in\MKinteger
\]


\end_inset

\end_layout

\begin_layout Definition
\series bold
אינדקס של מסילה סביב נקודה
\series default

\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$\gamma:\left[a,b\right]\rightarrow\MKcomplex$
\end_inset
 מסילה סגורה, 
\bar under
האינדקס
\bar default
 של 
\begin_inset Formula
$\gamma$
\end_inset
 
\bar under
סביב
\bar default
 נקודה 
\begin_inset Formula
$z_{0}\in\MKcomplex$
\end_inset
 כך ש-
\begin_inset Formula
$z_{0}\notin\gamma^{*}$
\end_inset
 הוא:
\begin_inset Formula
\[
\MKind\left(\gamma,z_{0}\right):=n\left(\gamma,z_{0}\right):=\frac{\theta\left(b\right)-\theta\left(a\right)}{2\pi}
\]


\end_inset
כאשר 
\begin_inset Formula
$\theta$
\end_inset
 הוא ארגומנט רציף של המסילה 
\begin_inset Formula
$\gamma-z_{0}$
\end_inset
.
\end_layout

