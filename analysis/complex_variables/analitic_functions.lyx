\begin_layout Theorem
\series bold
נוסחת קושי
\series default

\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$f$
\end_inset
 פונקציה אנליטית על קבוצה פתוחה 
\begin_inset Formula
$\Omega\subseteq\MKcomplex$
\end_inset
 ויהיו 
\begin_inset Formula
$z_{0}\in\Omega$
\end_inset
 ו-
\begin_inset Formula
$0<r\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$\hat{B_{r}}\left(z_{0}\right)\subseteq\Omega$
\end_inset
, לכל 
\begin_inset Formula
$w\in B_{r}\left(z_{0}\right)$
\end_inset
 מתקיים:
\begin_inset Formula
\[
f\left(w\right)=\frac{1}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(z\right)}{z-w}\ dz
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר הערכים ש-
\begin_inset Formula
$f$
\end_inset
 מקבלת על שפת המעגל קובעים אותה ביחידות בתוך המעגל - אין עוד פונקציה אנליטית אחרת שמקבלת את אותם הערכים על השפה אך מקבלת ערכים שונים בפנים.
\end_layout

\begin_layout Proof
נסמן:
\begin_inset Formula
\[
\delta:=\frac{1}{2}\cdot\inf\left\{ \left|z-w\right|:z\in\hat{B_{r}}\left(z_{0}\right),\ w\in\MKcomplex\setminus\Omega\right\} 
\]


\end_inset
מהגדרה 
\begin_inset Formula
$\delta>0$
\end_inset
 משום שאחרת לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 קיימים 
\begin_inset Formula
$z_{n}\in\hat{B_{r}}\left(z_{0}\right)$
\end_inset
 ו-
\begin_inset Formula
$w_{n}\in\MKcomplex\setminus\Omega$
\end_inset
 כך ש-
\begin_inset Formula
$\lim_{n\rightarrow\infty}\left|z_{n}-w_{n}\right|=0$
\end_inset
, 
\begin_inset Formula
$\hat{B_{r}}\left(z_{0}\right)$
\end_inset
 היא קבוצה קומפקטית ולכן לסדרה 
\begin_inset Formula
$\left(z_{n}\right)_{n=1}^{\infty}$
\end_inset
 יש תת-סדרה מתכנסת שגבולה ב-
\begin_inset Formula
$\hat{B_{r}}\left(z_{0}\right)$
\end_inset
, מכאן שלסדרה 
\begin_inset Formula
$\left(w_{n}\right)_{n=1}^{\infty}$
\end_inset
 כנ"ל יש תת-סדרה המתכנסת לגבול ב-
\begin_inset Formula
$\hat{B_{r}}\left(z_{0}\right)$
\end_inset
 ומכיוון ש-
\begin_inset Formula
$\MKcomplex\setminus\Omega$
\end_inset
 סגורה הגבול הזה נמצא בתוכה בסתירה לכך שהגבול שייך ל-
\begin_inset Formula
$\Omega$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$w\in B_{r+\delta}\left(z_{0}\right)$
\end_inset
 ותהא 
\begin_inset Formula
$\varepsilon:\Omega\rightarrow\MKreal$
\end_inset
 הפונקציה המוגדרת ע"י (לכל 
\begin_inset Formula
$z\in\Omega$
\end_inset
):
\begin_inset Formula
\[
\varepsilon\left(z\right):=\begin{cases}
\frac{f\left(z\right)-f\left(w\right)}{z-w}-f'\left(w\right) & z\neq w\\
0 & z=w
\end{cases}
\]


\end_inset
זוהי פונקציה רציפה, והיא אנליטית ב-
\begin_inset Formula
$B_{r+\delta}\left(z_{0}\right)$
\end_inset
 מלבד (אולי) ב-
\begin_inset Formula
$z_{0}$
\end_inset
 עצמה, מכאן שע"פ משפט האינטגרל של קושי מתקיים:
\begin_inset Formula
\begin{align*}
\frac{1}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(z\right)}{z-w}\ dz & =\frac{1}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(w\right)+f'\left(z_{0}\right)\cdot\left(z-w\right)+\varepsilon\left(z\right)\cdot\left(z-w\right)}{z-w}\ dz\\
 & =\frac{1}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{f\left(w\right)}{z-w}\ dz+{\color{red}\intop_{C\left(z_{0},r\right)}f'\left(z_{0}\right)\ dz+\intop_{C\left(z_{0},r\right)}\varepsilon\left(z\right)dz}\\
 & =\frac{f\left(w\right)}{2\pi i}\cdot\intop_{C\left(z_{0},r\right)}\frac{1}{z-w}\ dz+{\color{red}0+0}=\frac{f\left(w\right)}{2\pi i}\cdot2\pi i=f\left(w\right)
\end{align*}


\end_inset

\end_layout

\begin_layout Corollary
\series bold
