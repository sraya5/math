\begin_layout Description
סימון: 
\begin_inset Formula
$\MKbbd:=B_{1}\left(0\right)$
\end_inset
 וממילא 
\begin_inset Formula
$\overline{\MKbbd}=\hat{B_{1}}\left(0\right)$
\end_inset
.
\end_layout

\begin_layout Description
סימון: תהא 
\begin_inset Formula
$P:\partial\MKbbd\times\MKbbd\rightarrow\MKreal$
\end_inset
 הפונקציה המוגדרת ע"י (לכל 
\begin_inset Formula
$\left(w,z\right)\in\partial\MKbbd\times\MKbbd$
\end_inset
):
\begin_inset Formula
\[
P\left(w,z\right):=\frac{1-\left|z\right|^{2}}{\left|w-z\right|^{2}}
\]


\end_inset
פונקציה זו נקראת 
\bar under
גרעין פואסון
\bar default

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
ערך בוויקיפדיה: 
\begin_inset CommandInset href
LatexCommand href
name "סימאון דני פואסון"
target https://he.wikipedia.org/wiki/%D7%A1%D7%99%D7%9E%D7%90%D7%95%D7%9F_%D7%93%D7%A0%D7%99_%D7%A4%D7%95%D7%90%D7%A1%D7%95%D7%9F
literal false
\end_inset
.
\end_layout

\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נשים לב לכך שלכל 
\begin_inset Formula
$z\in\MKbbd$
\end_inset
 ולכל 
\begin_inset Formula
$w\in\partial\MKbbd$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
P\left(w,z\right) & =\frac{1-\left|z\right|^{2}}{\left|w-z\right|^{2}}=\frac{\left|w\right|^{2}-\left|z\right|^{2}}{\left|w-z\right|^{2}}=\MKre\left(\frac{\left|w\right|^{2}-\left|z\right|^{2}+z\overline{w}-\overline{z}w}{\left|w-z\right|^{2}}\right)\\
 & =\MKre\left(\frac{w+z}{w-z}\cdot\frac{\overline{w}-\overline{z}}{\overline{w-z}}\right)=\MKre\left(\frac{w+z}{w-z}\cdot\frac{\overline{w}-\overline{z}}{\overline{w}-\overline{z}}\right)=\MKre\left(\frac{w+z}{w-z}\right)
\end{align*}


\end_inset
כלומר 
\begin_inset Formula
$P$
\end_inset
 היא החלק הממשי של פונקציה אנליטית ולכן היא פונקציה הרמונית.
\end_layout

\begin_layout Theorem
\series bold
נוסחת פואסון
\series default

\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$u$
\end_inset
 פונקציה הרמונית על 
\begin_inset Formula
$\MKbbd$
\end_inset
 ורציפה ב-
\begin_inset Formula
$\overline{\MKbbd}$
\end_inset
, לכל 
\begin_inset Formula
$z\in\MKbbd$
\end_inset
 מתקיים:
\begin_inset Formula
\[
u\left(z\right)=\frac{1}{2\pi}\cdot\intop_{0}^{2\pi}P\left(e^{i\theta},z\right)\cdot u\left(e^{i\theta}\right)d\theta
\]


\end_inset

\end_layout

\begin_layout Corollary
תהא 
\begin_inset Formula
$z_{0}\in\MKcomplex$
\end_inset
, יהי 
\begin_inset Formula
$0<r\in\MKreal$
\end_inset
 ותהא 
\begin_inset Formula
$u$
\end_inset
 פונקציה הרמונית על 
\begin_inset Formula
$B_{r}\left(z_{0}\right)$
\end_inset
 ורציפה ב-
\begin_inset Formula
$\hat{B_{r}}\left(z_{0}\right)$
\end_inset
, לכל 
\begin_inset Formula
$z\in B_{r}\left(z_{0}\right)$
\end_inset
 מתקיים:
\begin_inset Formula
\[
u\left(z\right)=\frac{1}{2\pi}\cdot\intop_{0}^{2\pi}P\left(e^{i\theta},\frac{z-z_{0}}{r}\right)\cdot u\left(z_{0}+r\cdot e^{i\theta}\right)d\theta
\]


\end_inset
ובפרט:
\begin_inset Formula
\[
u\left(z_{0}\right)=\frac{1}{2\pi}\cdot\intop_{0}^{2\pi}u\left(z_{0}+r\cdot e^{i\theta}\right)d\theta
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר הערכים ש-
\begin_inset Formula
$u$
\end_inset
 מקבלת על שפת המעגל קובעים אותה ביחידות בתוך המעגל - אין עוד פונקציה הרמונית אחרת שמקבלת את אותם הערכים על השפה אך מקבלת ערכים שונים בפנים. למעשה גם הכיוון ההפוך נכון: בהינתן פונקציה רציפה על שפה של עיגול (מעגל) ניתן להגדיר אותה גם על פנים העיגול באמצעות הנוסחה הנ"ל וכך לקבל פונקציה הרמונית.
\end_layout

