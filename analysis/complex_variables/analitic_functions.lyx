\begin_layout Claim
להעתקת מביוס שאינה הזהות יש לכל הפחות נקודת שבת אחת ולכל היותר שתי נקודות שבת.
\end_layout

\begin_layout Proof
תהא 
\begin_inset Formula
$T:\hat{\MKcomplex}\rightarrow\hat{\MKcomplex}$
\end_inset
 העתקת מביוס שאינה הזהות ויהיו 
\begin_inset Formula
$a,b,c,d\in\MKcomplex$
\end_inset
 כך שמתקיים (לכל 
\begin_inset Formula
$z\in\hat{\MKcomplex}$
\end_inset
):
\begin_inset Formula
\[
T\left(z\right)=\frac{az+b}{cz+d}
\]


\end_inset
נחלק למקרים:
\end_layout

\begin_deeper
\begin_layout Itemize
נניח ש-
\begin_inset Formula
$c\neq0$
\end_inset
 (הנחה זו לבדה כבר קובעת ש-
\begin_inset Formula
$T\neq\MKid$
\end_inset
), א"כ 
\begin_inset Formula
$T\left(\infty\right)=\frac{a}{c}\neq\infty$
\end_inset
 ולכן 
\begin_inset Formula
$\infty$
\end_inset
 אינה נקודת שבת של 
\begin_inset Formula
$T$
\end_inset
.
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$z\in\MKcomplex$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
T\left(z\right)=\frac{az+b}{cz+d}=z & \Longleftrightarrow cz^{2}+dz=az+b\\
 & \Longleftrightarrow cz^{2}+\left(d-a\right)\cdot z-b=0
\end{align*}


\end_inset
זוהי משוואה ריבועית ולכן יש לה פתרון ב-
\begin_inset Formula
$\MKcomplex$
\end_inset
 ובנוסף יש לה לכל היותר שני פתרונות שונים, כלומר יש ל-
\begin_inset Formula
$T$
\end_inset
 לכל הפחות נקודת שבת אחת ולכל היותר שתי נקודות שבת.
\end_layout

\begin_layout Itemize
נניח ש-
\begin_inset Formula
$c=0$
\end_inset
 (מהעובדה ש-
\begin_inset Formula
$T\neq\MKid$
\end_inset
 נובע ש-
\begin_inset Formula
$b\neq0$
\end_inset
 ו/או 
\begin_inset Formula
$a\neq d$
\end_inset
), א"כ 
\begin_inset Formula
$a\neq0$
\end_inset
 ו-
\begin_inset Formula
$T\left(\infty\right)=\frac{a}{c}=\infty$
\end_inset
, כלומר במקרה זה 
\begin_inset Formula
$\infty$
\end_inset
 היא אחת מנקודות השבת של 
\begin_inset Formula
$T$
\end_inset
.
\begin_inset Newline newline
\end_inset
בנוסף, לכל 
\begin_inset Formula
$z\in\MKcomplex$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
T\left(z\right)=\frac{az+b}{0\cdot z+d}=z & \Longleftrightarrow dz=az-b\\
 & \Longleftrightarrow\left(d-a\right)\cdot z=-b\\
 & \Longleftrightarrow z=\frac{b}{a-d}
\end{align*}


\end_inset
מכאן של-
\begin_inset Formula
$T$
\end_inset
 יש נקודת שבת נוספת (מלבד 
\begin_inset Formula
$\infty$
\end_inset
) אם"ם 
\begin_inset Formula
$a\neq d$
\end_inset
, ובמקרה זה יש לה בדיוק שתי נקודות שבת: 
\begin_inset Formula
$\infty$
\end_inset
 ו-
\begin_inset Formula
$\frac{b}{a-d}$
\end_inset
.
\end_layout

\end_deeper

