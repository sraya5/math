\begin_layout Theorem
תהא 
\begin_inset Formula
$\gamma:\left[a,b\right]\rightarrow\MKreal^{n}$


\end_inset
 מסילה חלקה בעלת אורך, ויהי 
\begin_inset Formula
$\vec{X}:U\rightarrow\MKreal^{n}$


\end_inset
 שדה וקטורי. האינטגרל 
\begin_inset Formula
$\intop_{\gamma}\vec{X}\cdot d\vec{\ell}$


\end_inset
 קיים, ומתקיים:
\begin_inset Formula
\[
\intop_{\gamma}\vec{X}\cdot d\vec{\ell}=\intop_{a}^{b}\vec{X}\left(\gamma\left(t\right)\right)\cdot\gamma'\left(t\right)dt
\]




\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$


\end_inset
 אם 
\begin_inset Formula
$\gamma$


\end_inset
 היא מסילה רגולרית וחח"ע, נוכל להגדיר פונקציה 
\begin_inset Formula
$\vec{T}:\gamma^{*}\rightarrow\MKreal^{n}$


\end_inset
 כך שלכל 
\begin_inset Formula
$t\in\left[a,b\right]$


\end_inset
 יתקיים 
\begin_inset Formula
$\vec{T}\left(\gamma\left(t\right)\right)=\frac{\gamma'\left(t\right)}{\left\Vert \gamma\left(t\right)\right\Vert }$


\end_inset
, ואם נצליח להגדיר גם פונקציה רציפה 
\begin_inset Formula
$h:\MKreal^{n}\rightarrow\MKreal$


\end_inset
 כך שלכל 
\begin_inset Formula
$p\in\gamma^{*}$


\end_inset
 מתקיים 
\begin_inset Formula
$h\left(p\right)=\vec{X}\left(p\right)\cdot\vec{T}\left(p\right)$


\end_inset
, אז נקבל:
\begin_inset Formula
\[
\intop_{\gamma}\vec{X}\cdot d\vec{\ell}=\intop_{a}^{b}\vec{X}\left(\gamma\left(t\right)\right)\cdot\gamma'\left(t\right)dt=\intop_{a}^{b}\vec{X}\left(\gamma\left(t\right)\right)\cdot\frac{\gamma'\left(t\right)}{\left\Vert \gamma'\left(t\right)\right\Vert }\cdot\left\Vert \gamma'\left(t\right)\right\Vert dt=\intop_{a}^{b}h\left(\gamma\left(t\right)\right)\cdot\left\Vert \gamma'\left(t\right)\right\Vert dt=\intop_{\gamma}h\ ds
\]




\end_inset
ולהפך: אם נתונה פונקציה רציפה 
\begin_inset Formula
$f:\MKreal^{n}\rightarrow\MKreal$


\end_inset
 נוכל לנסות להגדיר שדה וקטורי 
\begin_inset Formula
$\vec{F}:\MKreal^{n}\rightarrow\MKreal^{n}$


\end_inset
כך שלכל 
\begin_inset Formula
$p\in\gamma^{*}$


\end_inset
 מתקיים 
\begin_inset Formula
$\vec{F}\left(p\right)\cdot\vec{T}\left(p\right)=f\left(p\right)$


\end_inset
, ואז נקבל:
\begin_inset Formula
\[
\intop_{\gamma}f\ ds=\intop_{a}^{b}f\left(\gamma\left(t\right)\right)\cdot\left\Vert \gamma'\left(t\right)\right\Vert dt=\intop_{a}^{b}\vec{F}\left(\gamma\left(t\right)\right)\cdot\frac{\gamma'\left(t\right)}{\left\Vert \gamma'\left(t\right)\right\Vert }\cdot\left\Vert \gamma'\left(t\right)\right\Vert dt=\intop_{a}^{b}\vec{F}\left(\gamma\left(t\right)\right)\cdot\gamma'\left(t\right)dt=\intop_{\gamma}\vec{F}\cdot d\vec{\ell}
\]




\end_inset

\end_layout

