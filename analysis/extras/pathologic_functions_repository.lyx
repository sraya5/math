\begin_layout Standard
תהיינה 
\begin_inset Formula
$\left(a_{n}\right)_{n=1}^{\infty}$
\end_inset
 ו-
\begin_inset Formula
$\left(h_{n}\right)_{n=1}^{\infty}$
\end_inset
 שתי סדרות כך ש-
\begin_inset Formula
$0<a_{n}\leq\frac{1}{2}$
\end_inset
 ו-
\begin_inset Formula
$h_{n}\geq0$
\end_inset
 לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
.
\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$f:\left[1,\infty\right)\rightarrow\left[0,\infty\right)$
\end_inset
 פונקציה המוגדרת ע"י (לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$x\in\left[n,n+1\right]$
\end_inset
):
\begin_inset Formula
\begin{align*}
f\left(x\right) & :=\begin{cases}
\frac{h_{n}}{a_{n}}\cdot\left(x-n\right) & x\in\left[n,n+a_{n}\right]\\
-\frac{h_{n}}{a_{n}}\cdot\left(x-\left(n+2a_{n}\right)\right) & x\in\left[n+a_{n},n+2a_{n}\right]\\
0 & x\in\left[n+a_{n},n+1\right]
\end{cases}\\
 & =\begin{cases}
\frac{h_{n}}{a_{n}}\cdot\left(x-n\right) & x\in\left[n,n+a_{n}\right]\\
-\frac{h_{n}}{a_{n}}\cdot\left(x-n\right)+2h_{n} & x\in\left[n+a_{n},n+2a_{n}\right]\\
0 & x\in\left[n+a_{n},n+1\right]
\end{cases}
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הרעיון הוא שבכל קטע 
\begin_inset Formula
$\left[n,n+1\right]$
\end_inset
 הקטע 
\begin_inset Formula
$\left[n,n+2a_{n}\right]$
\end_inset
 הוא הבסיס של משולש שווה שוקיים שקודקודו בנקודה 
\begin_inset Formula
$\left(n+a_{n},h_{n}\right)$
\end_inset
 ועל כן שטחו הוא בדיוק:
\begin_inset Formula
\[
\frac{2a_{n}\cdot h_{n}}{2}=a_{n}\cdot h_{n}
\]


\end_inset

