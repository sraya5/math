S_{2}\left(x\right)=\begin{cases}
x^{2}\cdot\sin\left(\frac{1}{x}\right) & x\neq0\\
0 & x=0
\end{cases}
\]


\end_inset
מכאן שלכל 
\begin_inset Formula
$0\neq x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
S_{2}'\left(x\right) & =2x\cdot\sin\left(\frac{1}{x}\right)+x^{2}\cdot\cos\left(\frac{1}{x}\right)\cdot\left(-\frac{1}{x^{2}}\right)\\
 & =2x\cdot\sin\left(\frac{1}{x}\right)-\cos\left(\frac{1}{x}\right)\\
S_{2}''\left(x\right) & =2\cdot S_{1}'\left(x\right)-\left(-\frac{1}{x^{2}}\right)\cdot\left(-\sin\left(\frac{1}{x}\right)\right)\\
 & =\left(-\frac{2}{x^{3}}-\frac{1}{x^{2}}\right)\cdot\sin\left(\frac{1}{x}\right)
\end{align*}


\end_inset
בנוסף מתקיים:
\begin_inset Formula
\begin{align*}
S_{2}'\left(0\right) & =\lim_{x\rightarrow0}\frac{S_{2}\left(x\right)-S_{2}\left(0\right)}{x-0}=\lim_{x\rightarrow0}\frac{x^{2}\cdot\sin\left(\frac{1}{x}\right)}{x}\\
 & =\lim_{x\rightarrow0}x\cdot\sin\left(\frac{1}{x}\right)=0
\end{align*}


\end_inset

