\begin_layout Claim
לכל 
\begin_inset Formula
$a\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\lim_{x\rightarrow a}R\left(x\right)=0$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$a\in\MKreal$
\end_inset
 ויהי 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$\eta:=\frac{1}{N}<\varepsilon$
\end_inset
, מכאן שלכל 
\begin_inset Formula
$N\geq q\in\MKnatural$
\end_inset
 קיים לכל היותר 
\begin_inset Formula
$p\in\MKinteger$
\end_inset
 אחד ויחיד כך שמתקיים 
\begin_inset Formula
$\frac{p}{q}\in B_{\eta}^{\circ}\left(a\right)$
\end_inset
.
\begin_inset Newline newline
\end_inset
א"כ קיימת 
\begin_inset Formula
$0<\delta\in\MKreal$
\end_inset
 כך שלכל 
\begin_inset Formula
$N\geq q\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$p\in\MKinteger$
\end_inset
 מתקיים 
\begin_inset Formula
$\frac{p}{q}\notin B_{\delta}^{\circ}\left(a\right)$
\end_inset
, תהא 
\begin_inset Formula
$\delta$
\end_inset
 כנ"ל.
\begin_inset Newline newline
\end_inset
מכאן שלכל 
\begin_inset Formula
$x\in B_{\delta}^{\circ}\left(a\right)$
\end_inset
 מתקיים 
\begin_inset Formula
$-\varepsilon<0\leq R\left(x\right)\leq\frac{1}{N}<\varepsilon$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow\lim_{x\rightarrow a}R\left(x\right)=0
\]


\end_inset

\end_layout

\begin_layout Corollary
פונקציית רימן רציפה בכל הנקודות האי-רציונליות ואינה רציפה בכל הנקודות הרציונליות.
\end_layout

\begin_layout Claim
פונקציית רימן אינה גזירה בשום נקודה.
\end_layout

\begin_layout Proof
ראינו שהיא אינה רציפה בכל נקודה רציונלית ומכאן שהיא גם אינה גזירה בנקודות אלו.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$x\in\MKreal\setminus\MKrational$
\end_inset
, כשהתחלנו ללמוד על קירובים דיופנטיים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
בקורס "תורת המספרים האלמנטרית".
\end_layout

\end_inset
 ראינו שקיימות סדרת טבעיים עולה ממש 
\begin_inset Formula
$\left(q_{n}\right)_{n=1}^{\infty}$
\end_inset
 וסדרת שלמים 
\begin_inset Formula
$\left(p_{n}\right)_{n=1}^{\infty}$
\end_inset
 כך שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|x-\frac{p_{n}}{q_{n}}\right|<\frac{1}{\left(q_{n}\right)^{2}}
\]


\end_inset
ובפרט 
\begin_inset Formula
$\lim_{n\rightarrow\infty}\frac{p_{n}}{q_{n}}=x$
\end_inset
; מכאן שאם הנגזרת 
\begin_inset Formula
$R'\left(x\right)$
\end_inset
 קיימת אז גם הגבול:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\frac{R\left(\frac{p_{n}}{q_{n}}\right)-R\left(x\right)}{\frac{p_{n}}{q_{n}}-x}
\]


\end_inset
קיים ושווה לה. אבל לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$R\left(\frac{p_{n}}{q_{n}}\right)=\frac{\gcd\left(p_{n},q_{n}\right)}{q_{n}}\geq\frac{1}{q_{n}}$
\end_inset
 ולכן גם:
\begin_inset Formula
\[
\left|\frac{R\left(\frac{p_{n}}{q_{n}}\right)-R\left(x\right)}{\frac{p_{n}}{q_{n}}-x}\right|\geq\frac{\left|\frac{1}{q_{n}}-0\right|}{\left|\frac{p_{n}}{q_{n}}-x\right|}>\frac{\frac{1}{q_{n}}}{\frac{1}{\left(q_{n}\right)^{2}}}=q_{n}\xrightarrow[n\rightarrow\infty]{}\infty
\]


\end_inset
מכאן שהנגזרת שפונקציית רימן אינה גזירה ב-
\begin_inset Formula
$x$
\end_inset
 ומכיוון שהוא היה שרירותי הרי שהיא אינה גזירה בשום נקודה אי-רציונלית.
