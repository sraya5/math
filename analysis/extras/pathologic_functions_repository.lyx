\begin_inset Formula
\begin{align*}
S_{1}'\left(x\right) & =1\cdot\sin\left(\frac{1}{x}\right)+x\cdot\cos\left(\frac{1}{x}\right)\cdot\left(-\frac{1}{x^{2}}\right)=\sin\left(\frac{1}{x}\right)-\frac{1}{x}\cdot\cos\left(\frac{1}{x}\right)\\
S_{1}''\left(x\right) & ={\color{red}\left(-\frac{1}{x^{2}}\right)\cdot\cos\left(\frac{1}{x}\right)}-\left({\color{red}\left(-\frac{1}{x^{2}}\right)\cdot\cos\left(\frac{1}{x}\right)}+\frac{1}{x}\cdot\left(-\sin\left(\frac{1}{x}\right)\right)\cdot\left(-\frac{1}{x^{2}}\right)\right)=-\frac{1}{x^{3}}\cdot\sin\left(\frac{1}{x}\right)
\end{align*}


\end_inset

