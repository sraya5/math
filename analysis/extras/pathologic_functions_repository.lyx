\end_layout

\begin_layout Standard
\begin_inset Formula
\[
S\left(x\right)=\begin{cases}
\sin\left(\frac{1}{x}\right) & x\neq0\\
0 & x=0
\end{cases}
\]


\end_inset
מכאן שלכל 
\begin_inset Formula
$0\neq x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
S'\left(x\right) & =-\frac{1}{x^{2}}\cdot\sin\left(\frac{1}{x}\right)\\
S''\left(x\right) & =\frac{2}{x^{3}}\cdot\sin\left(\frac{1}{x}\right)-\frac{1}{x^{2}}\cdot\cos\left(\frac{1}{x}\right)\cdot\left(-\frac{1}{x^{2}}\right)\\
 & =\frac{2}{x^{3}}\cdot\sin\left(\frac{1}{x}\right)+\frac{1}{x^{4}}\cdot\cos\left(\frac{1}{x}\right)
\end{align*}


\end_inset

\end_layout

