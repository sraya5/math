\begin_layout Standard
נניח שנתבקשנו למצוא פונקציה 
\begin_inset Formula
$f:\MKreal\rightarrow\MKreal$
\end_inset
 כך שיתקיים:
\begin_inset Formula
\[
\lim_{x\rightarrow\infty}\intop_{-x}^{2x}f\left(t\right)dt=c
\]


\end_inset
עבור 
\begin_inset Formula
$0\neq c\in\MKreal$
\end_inset
 כלשהו
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
זה לא באמת משנה באיזה 
\begin_inset Formula
$c$
\end_inset
 מדובר כי תמיד יהיה ניתן להכפיל את 
\begin_inset Formula
$f$
\end_inset
 בקבוע ולקבל את הנדרש עבור 
\begin_inset Formula
$c$
\end_inset
 אחר.
\end_layout

\end_inset
. הדבר הראשון שעולה לי בראש הוא שמהנוסחה היסודית נובע שלכל 
\begin_inset Formula
$0<x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\intop_{x}^{2x}\frac{1}{t}\ dt=\ln\left(2x\right)-\ln\left(x\right)=\ln\left(\frac{2x}{x}\right)=\ln\left(2\right)
\]


\end_inset
הבעיה היא כמובן שנתבקשתי שהאינטגרל יהיה מ-
\begin_inset Formula
$-x$
\end_inset
 ל-
\begin_inset Formula
$2x$
\end_inset
 ולא מ-
\begin_inset Formula
$x$
\end_inset
 ל-
\begin_inset Formula
$2x$
\end_inset
.
\begin_inset Newline newline
\end_inset
כדי לתקן זאת אני רוצה למצוא פונקציה שתחזיר 
\begin_inset Formula
$\ln\left(-x\right)$
\end_inset
 לכל 
\begin_inset Formula
$x$
\end_inset
 שלילי קטן מספיק ו-
\begin_inset Formula
$\ln\left(x\right)$
\end_inset
 לכל 
\begin_inset Formula
$x$
\end_inset
 חיובי גדול מספיק; הבעיה היא שאני זקוק לפונקציה שהיא לא רק רציפה, אלא גם גזירה בכל נקודה כדי שהיא תהווה קדומה של פונקציה אחרת ואז אוכל להשתמש בנוסחה היסודית.
\begin_inset Newline newline
\end_inset
הפתרון הוא כזה: תהא 
\begin_inset Formula
$F:\MKreal\rightarrow\MKreal$
\end_inset
 פונקציה המוגדרת ע"י (לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
):
\begin_inset Formula
\[
F\left(x\right):=\begin{cases}
\ln\left(x\right) & x\geq1\\
\frac{x^{2}-1}{2} & -1\leq x\leq1\\
\ln\left(-x\right) & x\leq-1
\end{cases}
\]


\end_inset
כיצד הפונקציה הזו פותרת את הבעיה? הרעיון הוא כזה בתחילה רצינו שהפונקציה תוגדר כך:
\begin_inset Formula
\[
F_{0}\left(x\right):=\begin{cases}
\ln\left(x\right) & x>0\\
\ln\left(-x\right) & x<0
\end{cases}
\]


\end_inset
אבל לפונקציה הזו יש אי-רציפות מסדר שני ב-
\begin_inset Formula
$0$
\end_inset
, זו בעיה שא"א לתקן בקלות, א"כ נרצה לבטל את כלל ההתאמה של 
\begin_inset Formula
$F_{0}$
\end_inset
 בקטע 
\begin_inset Formula
$\left(-1,1\right)$
\end_inset
 ולהכניס בקטע זה פונקציה גזירה 
\begin_inset Formula
$F_{1}$
\end_inset
 שתתלכד עם 
\begin_inset Formula
$F_{0}$
\end_inset
 בנקודות הקצה ולא זו אף זו גם הנגזרות שלהן תתלכדנה בנקודות הקצה של 
\begin_inset Formula
$\left(-1,1\right)$
\end_inset
; לשיטה הזו אני קורא "הלחמה" של פונקציות.
\begin_inset Newline newline
\end_inset
בד"כ הדרך הכי פשוטה לבצע "הלחמה" היא באמצעות פולינום, ואכן הפולינום 
\begin_inset Formula
$F_{1}\left(x\right):=\frac{x^{2}-1}{2}$
\end_inset
 מקיים את המבוקש, שכן מתקיים:
\begin_inset Formula
\begin{align*}
F_{1}\left(\pm1\right) & =\frac{\left(\pm1\right)^{2}-1}{2}=0=\ln\left(1\right)=F_{0}\left(\pm1\right)\\
F_{1}'\left(\pm1\right) & =\pm1=\left(\pm1\right)\cdot\frac{1}{1}=\left(\pm1\right)\cdot\ln'\left(1\right)=F_{0}'\left(\pm1\right)\\
\intop_{-1}^{0}F_{1}\left(x\right)dx & =\intop_{-1}^{0}\frac{x^{2}-1}{2}dx=\frac{1}{2}\cdot\left(\frac{0^{3}}{3}-0\right)-\frac{1}{2}\cdot\left(\frac{\left(-1\right)^{3}}{3}-\left(-1\right)\right)\\
 & =\frac{1}{2}\cdot\left(\frac{1^{3}}{3}-1\right)-\frac{1}{2}\cdot\left(\frac{0^{3}}{3}-0\right)=\intop_{0}^{1}F_{1}\left(x\right)dx
\end{align*}


\end_inset
כעת לאחר שאנו מבינים את הרעיון נעבור להוכחה הפורמלית.
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$\pm1\neq x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
F'\left(x\right)=\begin{cases}
\frac{1}{x} & x>1\\
x & -1<x<1\\
\frac{1}{x} & x<-1
\end{cases}
\]


\end_inset
וכמו כן מתקיים 
\begin_inset Formula
$F'\left(1^{+}\right)=\frac{1}{1}=1=F'\left(1^{-}\right)$
\end_inset
 ו-
\begin_inset Formula
$F'\left(-1^{+}\right)=\frac{1}{-1}=-1=F'\left(-1^{-}\right)$
\end_inset
 ומכאן ש-
\begin_inset Formula
$F'\left(\pm1\right)=\pm1$
\end_inset
, כלומר לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
F'\left(x\right)=\begin{cases}
\frac{1}{x} & x\geq1\\
x & -1\leq x\leq1\\
\frac{1}{x} & x\leq-1
\end{cases}
\]


\end_inset
נסמן 
\begin_inset Formula
$f:=F'$
\end_inset
, מכאן שע"פ הנוסחה היסודית מתקיים לכל 
\begin_inset Formula
$1<x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\intop_{x}^{2x}f\left(t\right)dt=F\left(2x\right)-F\left(x\right)=\ln\left(2x\right)-\ln\left(x\right)=\ln\left(2\right)
\]


\end_inset

\end_layout

