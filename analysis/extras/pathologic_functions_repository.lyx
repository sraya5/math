\begin_layout Claim
מתקיים (מדובר בשוויון פורמלי בלבד):
\begin_inset Formula
\[
\sum_{n=1}^{\infty}a_{n}\cdot h_{n}=\intop_{1}^{\infty}f\left(x\right)dx
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ע"פ השוויון הזה והידע שלנו על טורים נוכל לבנות פונקציות רציפות חסומות/לא חסומות שעבורן האינטגרל הנ"ל מתכנס/מתבדר כרצוננו, כל מה שצריך לעשות הוא לבחור את הסדרות המתאימות (דוגמאות בהמשך).
\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Proof
מהנוסחה היסודית נובע שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\intop_{n}^{n+a_{n}}f\left(x\right)dx & =\intop_{n}^{n+a_{n}}\frac{h_{n}}{a_{n}}\cdot\left(x-n\right)dx=\frac{h_{n}}{a_{n}}\cdot\intop_{n}^{n+a_{n}}x-n\ dx\\
 & =\frac{h_{n}}{a_{n}}\cdot\left(\frac{\left(n+a_{n}\right)^{2}}{2}-n\cdot\left(n+a_{n}\right)\right)-\frac{h_{n}}{a_{n}}\cdot\left(\frac{n^{2}}{2}-n\cdot n\right)\\
 & =\frac{h_{n}}{a_{n}}\cdot\left(\frac{{\color{red}n^{2}}+2{\color{blue}n\cdot a_{n}}+\left(a_{n}\right)^{2}}{2}{\color{red}-n^{2}}{\color{blue}-n\cdot a_{n}}\right)+\frac{h_{n}}{a_{n}}\cdot{\color{red}\frac{n^{2}}{2}}\\
 & =\frac{h_{n}}{a_{n}}\cdot\frac{\left(a_{n}\right)^{2}}{2}=\frac{a_{n}\cdot h_{n}}{2}\\
\intop_{n+a_{n}}^{n+2a_{n}}f\left(x\right)dx & =\intop_{n+a_{n}}^{n+2a_{n}}-\frac{h_{n}}{a_{n}}\cdot\left(x-n\right)+2h_{n}\ dx=-\intop_{n+a_{n}}^{n+2a_{n}}\frac{h_{n}}{a_{n}}\cdot\left(x-n\right)dx+{\color{green}\intop_{n+a_{n}}^{n+2a_{n}}2h_{n}\ dx}\\
 & =-\frac{h_{n}}{a_{n}}\cdot\left({\color{red}\frac{\left(n+2a_{n}\right)^{2}}{2}}{\color{blue}-n\cdot\left(n+2a_{n}\right)}\right)+\frac{h_{n}}{a_{n}}\cdot\left({\color{red}\frac{\left(n+a_{n}\right)^{2}}{2}}{\color{blue}-n\cdot\left(n+a_{n}\right)}\right)+{\color{green}2h_{n}\cdot a_{n}}\\
 & =-\frac{h_{n}}{a_{n}}\cdot\left({\color{red}\frac{2n\cdot a_{n}+3\left(a_{n}\right)^{2}}{2}}{\color{blue}-n\cdot a_{n}}\right)+{\color{green}2h_{n}\cdot a_{n}}=\frac{4h_{n}\cdot a_{n}}{2}-\frac{h_{n}\cdot3\left(a_{n}\right)^{2}}{2a_{n}}\\
 & =\frac{a_{n}\cdot h_{n}}{2}\\
\intop_{n+2a_{n}}^{n+1}f\left(x\right)dx & =\intop_{n+2a_{n}}^{n+1}0\ dx=0
\end{align*}


\end_inset
ועל כן גם:
\begin_inset Formula
\[
\intop_{n}^{n+1}f\left(x\right)dx=a_{n}\cdot h_{n}
\]


\end_inset
וממילא:
\begin_inset Formula
\begin{align*}
\intop_{1}^{\infty}f\left(x\right)dx & =\lim_{b\rightarrow\infty}\intop_{1}^{b}f\left(x\right)dx=\lim_{N\rightarrow\infty}\intop_{1}^{N+1}f\left(x\right)dx=\lim_{N\rightarrow\infty}\sum_{n=1}^{N}\left(\intop_{n}^{n+1}f\left(x\right)dx\right)\\
 & =\lim_{N\rightarrow\infty}\sum_{n=1}^{N}\left(a_{n}\cdot h_{n}\right)=\sum_{n=0}^{\infty}\left(a_{n}\cdot h_{n}\right)
\end{align*}


\end_inset

\end_layout

