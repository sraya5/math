\begin_layout Proof
לכל חלוקה 
\begin_inset Formula
$P$
\end_inset
 של 
\begin_inset Formula
$\left[0,1\right]$
\end_inset
 מתקיים 
\begin_inset Formula
$L\left(R,P\right)=0$
\end_inset
 ומכאן שמתקיים 
\begin_inset Formula
$\underline{I}\left(R\right)$
\end_inset
, כלומר סכום דארבו התחתון של פונקציית רימן עבור חלוקה כלשהי של 
\begin_inset Formula
$\left[0,1\right]$
\end_inset
 הוא 
\begin_inset Formula
$0$
\end_inset
 ולכן גם האינטגרל התחתון שלה בקטע זה הוא 
\begin_inset Formula
$0$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
, נניח בהג"כ ש-
\begin_inset Formula
$\varepsilon<1$
\end_inset
 ונסמן 
\begin_inset Formula
$N:=\left\lceil \frac{2}{\varepsilon}\right\rceil +1$
\end_inset
 (כלומר 
\begin_inset Formula
$\frac{1}{N}<\frac{\varepsilon}{2}$
\end_inset
 ו-
\begin_inset Formula
$\frac{\varepsilon}{4}<\frac{1}{N}$
\end_inset
), א"כ קיימות לכל היותר 
\begin_inset Formula
$N^{2}$
\end_inset
 נקודות רציונליות ב-
\begin_inset Formula
$\left[0,1\right]$
\end_inset
 שהמכנה המצומצם שלהן גדול או שווה ל-
\begin_inset Formula
$N$
\end_inset
; תהיינה 
\begin_inset Formula
$a_{1},a_{2},\ldots,a_{n}\in\left[0,1\right]$
\end_inset
 כל הנקודות הללו כך שהן מסודרות בסדר עולה (
\begin_inset Formula
$a_{i}<a_{i+1}$
\end_inset
 לכל 
\begin_inset Formula
$n>i\in\MKnatural$
\end_inset
), א"כ (בהנחה ש-
\begin_inset Formula
$\varepsilon<1$
\end_inset
) לכל 
\begin_inset Formula
$n>i\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$a_{i+1}-a_{i}\geq\frac{1}{N}>\frac{\varepsilon}{4}$
\end_inset
.
\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$x_{1},x_{2},\ldots,x_{n},x_{n+1},y_{0},y_{1},y_{2},\ldots,y_{n}\in\left(0,1\right)$
\end_inset
 נקודות המוגדרות ע"י (לכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
):
\begin_inset Formula
\begin{align*}
y_{0} & :=0\\
x_{i} & :=a_{i}-\frac{\varepsilon}{8n}\\
y_{i} & :=a_{i}+\frac{\varepsilon}{8n}\\
x_{n+1} & :=1
\end{align*}


\end_inset
א"כ לכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$y_{i}-x_{i}=\frac{\varepsilon}{4n}$
\end_inset
 (כלומר 
\begin_inset Formula
$y_{i}>x_{i}$
\end_inset
) ולכל 
\begin_inset Formula
$n>i\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
x_{i+1}-y_{i}=\left(a_{i+1}-\frac{\varepsilon}{8n}\right)-\left(a_{i}+\frac{\varepsilon}{8n}\right)>0
\]


\end_inset
כמו כן מתקיים: 
\begin_inset Formula
\begin{align*}
x_{1}-y_{0} & =a_{1}-\frac{\varepsilon}{8}=\frac{1}{N}-\frac{\varepsilon}{8}>0\\
x_{n+1}-y_{n} & =1-\left(a_{n}+\frac{\varepsilon}{8n}\right)=1-\left(\frac{N-1}{N}+\frac{\varepsilon}{8}\right)=\frac{1}{N}-\frac{\varepsilon}{8}>0
\end{align*}


\end_inset
מכאן שלכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left(y_{i}-x_{i}\right)\cdot\sup\left\{ R\left(x\right):x\in\left[x_{i},y_{i}\right]\right\} \leq\left(y_{i}-x_{i}\right)\cdot1=y_{i}-x_{i}
\]


\end_inset
ולכל 
\begin_inset Formula
$n\geq i\in\MKnatural_{0}$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left(x_{i+1}-y_{i}\right)\cdot\sup\left\{ R\left(x\right):x\in\left[y_{i},x_{i+1}\right]\right\} <\left(x_{i+1}-y_{i}\right)\cdot\frac{1}{N}<\left(x_{i+1}-y_{i}\right)\cdot\frac{\varepsilon}{2}
\]


\end_inset
הקבוצה 
\begin_inset Formula
$P:=\left\{ y_{0},x_{1},y_{1},x_{2},y_{2},\ldots,x_{n},y_{n},x_{n+1}\right\} $
\end_inset
 היא חלוקה של 
\begin_inset Formula
$\left[0,1\right]$
\end_inset
 המקיימת:
\begin_inset Formula
\[
U\left(R,P\right)<\sum_{i=1}^{n}\left(y_{i}-x_{i}\right)+\sum_{i=0}^{n}\left(x_{i+1}-y_{i}\right)\cdot\frac{\varepsilon}{2}<\frac{\varepsilon}{4n}\cdot n+\left(1-0\right)\cdot\frac{\varepsilon}{2}<\varepsilon
\]


\end_inset

\begin_inset Formula
$\varepsilon$
\end_inset
 הנ"ל היה שרירותי ולכן 
\begin_inset Formula
$\overline{I}\left(R\right)=0$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow\intop_{0}^{1}R\left(x\right)dx=0
\]


\end_inset

