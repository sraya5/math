\begin_layout Theorem
\series bold
אינטגרציה בחלקים
\series default

\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$f,g$
\end_inset
 גזירות על 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
 כך ש-
\begin_inset Formula
$f',g'\in R\left[a,b\right]$
\end_inset
, א"כ מתקיים:
\begin_inset Formula
\begin{align*}
\intop_{a}^{b}f'\left(x\right)\cdot g\left(x\right)dx & =\left.\left(f\cdot g\right)\right|_{a}^{b}-\intop_{a}^{b}f\left(x\right)\cdot g'\left(x\right)dx\\
 & =f\left(b\right)\cdot g\left(b\right)-f\left(a\right)\cdot g\left(a\right)-\intop_{a}^{b}f\left(x\right)\cdot g'\left(x\right)dx
\end{align*}


\end_inset

\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

