\begin_layout Proof
תהא 
\begin_inset Formula
$P:=\left\{ x_{0},x_{1},\ldots,x_{n}\right\} $
\end_inset
 חלוקה של 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
, ממשפט הערך הממוצע של לגראנז' נובע שלכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
 קיימת 
\begin_inset Formula
$c_{i}\in\left[x_{i-1},x_{i}\right]$
\end_inset
:
\begin_inset Formula
\[
\phi\left(x_{i}\right)-\phi\left(x_{i-1}\right)=\phi'\left(c_{i}\right)\cdot\left(x_{i}-x_{i-1}\right)
\]


\end_inset
יהיו 
\begin_inset Formula
$c_{1},c_{2},\ldots,c_{n}$
\end_inset
 כנ"ל ומכאן שמתקיים:
\begin_inset Formula
\[
\phi\left(b\right)-\phi\left(a\right)=\phi\left(x_{n}\right)-\phi\left(x_{0}\right)=\sum_{i=1}^{n}\phi'\left(c_{i}\right)\cdot\left(x_{i}-x_{i-1}\right)
\]


\end_inset
כלומר לכל חלוקה של 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
 קיימת בחירת נקודות כך שסכום רימן המתאים (של 
\begin_inset Formula
$\phi'$
\end_inset
) שווה ל-
\begin_inset Formula
$\phi\left(b\right)-\phi\left(a\right)$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהגדרת האינטגרל המסוים ומהמסקנה האחרונה (
\begin_inset CommandInset ref
LatexCommand ref
reference "corollary 3.8"
plural false
caps false
noprefix false
nolink false
\end_inset
) נובע שמתקיים:
\begin_inset Formula
\[
\intop_{a}^{b}f\left(x\right)dx=\intop_{a}^{b}\phi'\left(x\right)dx=\phi\left(b\right)-\phi\left(a\right)
\]


\end_inset

\end_layout

