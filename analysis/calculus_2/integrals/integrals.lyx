\begin_layout Corollary
מתקיים:
\begin_inset Formula
\begin{align*}
\intop\ln\left(x\right)dx & =x\cdot\ln\left(x\right)-x\\
\intop\arcsin\left(x\right)dx & =x\cdot\arcsin\left(x\right)+\sqrt{1-x^{2}}\\
\intop\arccos\left(x\right)dx & =x\cdot\arccos\left(x\right)-\sqrt{1-x^{2}}\\
\intop\arctan\left(x\right)dx & =x\cdot\arctan\left(x\right)+\frac{1}{2}\cdot\ln\left(1+x^{2}\right)
\end{align*}


\end_inset

