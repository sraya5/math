\intop f^{-1}\left(y\right)dy=y\cdot f^{-1}\left(y\right)-F\left(f^{-1}\left(y\right)\right)+C
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מבחינה אינטואיטיבית זה אכן מה שציפינו לקבל מכיוון שלכל נקודה על הגרף של 
\begin_inset Formula
$f$
\end_inset
, שטח המלבן הנוצר מהצירים ומהישרים המקבילים אליהם שנחתכים בנקודה זו מחלק לשני חלקים: החלק התחום בין גרף הפונקציה לציר ה-
\begin_inset Formula
$x$
\end_inset
 וזה התחום בינו לבין ציר ה-
\begin_inset Formula
$y$
\end_inset
 שעבור 
\begin_inset Formula
$f^{-1}$
\end_inset
 הוא ציר ה-
\begin_inset Formula
$x$
\end_inset

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
הגרפים של 
\begin_inset Formula
$f$
\end_inset
 ושל 
\begin_inset Formula
$f^{-1}$
\end_inset
 זהים עד כדי שיקוף וסיבוב שכמובן אינם משנים את השטחים.
\end_layout

\end_inset
; הביטוי 
\begin_inset Formula
$f^{-1}\left(y\right)\cdot y$
\end_inset
 מבטא את שטח המלבן כולו והביטוי 
\begin_inset Formula
$F\left(f^{-1}\left(y\right)\right)$
\end_inset
 מבטא את השטח התחום בין הגרף של 
\begin_inset Formula
$f$
\end_inset
 לציר ה-
\begin_inset Formula
$x$
\end_inset
 "שלה".
\begin_inset Newline newline
\end_inset
כן, אני יודע, הטיעון הזה מדבר על אינטגרלי רימן (ומשתמש בהוכחה גאומטרית רחמנא ליצלן) ואינו מתייחס לאפשרות שהפונקציה עוברת ביותר מרביע אחד של המישור; אבל הקשר של השטח מתחת לגרף הפונקציה לבין הקדומה שלה הוא אינטואיטיבי מאד וניתן להכליל את הטיעון הזה גם ליותר מרביע אחד, כמובן שכל זה ברמת האינטואיציה ולא מדובר בהוכחה פורמלית אבל זה כל היופי במתמטיקה: האפשרות לפרמל את האינטואיציה.
\end_layout

