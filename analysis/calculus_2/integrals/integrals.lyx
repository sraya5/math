\begin_layout Theorem
\begin_inset Formula
$F$
\end_inset
 רציפה על 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נשים לב שזה אינטואיטיבי מאד: השינוי בערכי 
\begin_inset Formula
$F$
\end_inset
 עבור 
\begin_inset Formula
$x,y\in\left[a,b\right]$
\end_inset
 כך ש-
\begin_inset Formula
$\left|x-y\right|<\delta$
\end_inset
 חסום מלעיל ע"י 
\begin_inset Formula
$2M\cdot\delta$
\end_inset
 כאשר 
\begin_inset Formula
$M$
\end_inset
 הוא מספר המקיים 
\begin_inset Formula
$\left|f\left(x\right)\right|<M$
\end_inset
 לכל 
\begin_inset Formula
$x\in\left[a,b\right]$
\end_inset
, כלומר כשמסתכלים על קטע קטן מאד השטח שמתחת לגרף של 
\begin_inset Formula
$f$
\end_inset
 קטן מאד גם הוא (האמת שזה מוכיח רציפות במידה שווה ואכן היות 
\begin_inset Formula
$F$
\end_inset
 רציפה על קטע סגור גורר את היותה רציפה במידה שווה עליו), ההוכחה תפרמל בדיוק את האינטואיציה הזו.
\end_layout

\begin_layout Proof
\begin_inset Formula
$f$
\end_inset
 רציפה על קטע סגור ולכן חסומה, מכאן שקיים 
\begin_inset Formula
$M\in\MKreal$
\end_inset
 כך שלכל 
\begin_inset Formula
$x\in\left[a,b\right]$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|f\left(x\right)\right|<M$
\end_inset
.
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$h\in\left[a-b,b-a\right]\setminus\left\{ 0\right\} $
\end_inset
 ולכל 
\begin_inset Formula
$x\in\left[a,b\right]$
\end_inset
 ו-
\begin_inset Formula
$h\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$x+h\in\left[a,b\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\left|F\left(x+h\right)-F\left(x\right)\right| & =\left|\intop_{a}^{x+h}f\left(x\right)dx-\intop_{a}^{x}f\left(x\right)dx\right|=\left|-\intop_{x+h}^{a}f\left(x\right)dx-\intop_{a}^{x}f\left(x\right)dx\right|\\
 & =\left|-\intop_{x+h}^{x}f\left(x\right)dx\right|=\left|\intop_{x}^{x+h}f\left(x\right)dx\right|\leq\left|\intop_{x}^{x+h}\left|f\left(x\right)\right|dx\right|\\
 & \leq\left|\intop_{x}^{x+h}M\ dx\right|=\left|h\cdot M\right|=\left|h\right|\cdot M
\end{align*}


\end_inset
ומכאן שלכל 
\begin_inset Formula
$x\in\left[a,b\right]$
\end_inset
 מתקיים 
\begin_inset Formula
$\lim_{h\rightarrow0}\left|F\left(x+h\right)-F\left(x\right)\right|=0$
\end_inset
, כלומר 
\begin_inset Formula
$F$
\end_inset
 רציפה על 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
.
\end_layout

\begin_layout Corollary
מתקיים:
\begin_inset Formula
\[
\lim_{\delta\rightarrow0^{+}}\intop_{a+\delta}^{b}f\left(x\right)dx=\intop_{a}^{b}f\left(x\right)dx=\lim_{\delta\rightarrow0^{+}}\intop_{a}^{b-\delta}f\left(x\right)dx
\]


\end_inset

\end_layout

