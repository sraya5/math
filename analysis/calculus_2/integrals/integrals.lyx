\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 בד"כ לא נקבל אינטגרלים בצורה הזו ונצטרך להביא אותם אליה כדי שנוכל להשתמש במשפט: נניח שאנחנו רוצים למצוא את האינטגרל 
\begin_inset Formula
$\intop g\left(x\right)dx$
\end_inset
 עבור פונקציה 
\begin_inset Formula
$g:I\rightarrow\MKreal$
\end_inset
 והצלחנו למצוא שתי פונקציות 
\begin_inset Formula
$\varphi:I\rightarrow I_{0}$
\end_inset
 ו-
\begin_inset Formula
$\psi:I_{0}\rightarrow\MKreal$
\end_inset
 כך של-
\begin_inset Formula
$\psi$
\end_inset
 יש קדומה 
\begin_inset Formula
$\varPsi$
\end_inset
 על 
\begin_inset Formula
$I_{0}$
\end_inset
 ו-
\begin_inset Formula
$\varphi$
\end_inset
 גזירה ב-
\begin_inset Formula
$I$
\end_inset
 ובנוסף מתקיים 
\begin_inset Formula
$g\left(x\right)=\psi\left(\varphi\left(x\right)\right)$
\end_inset
 לכל 
\begin_inset Formula
$x\in I$
\end_inset
, במקרה כזה נוכל להשתמש במשפט ולומר שמתקיים 
\begin_inset Formula
$\intop g\left(x\right)dx=\varPsi\left(\varphi\left(x\right)\right)+C$
\end_inset
.
\end_layout

\begin_deeper
\begin_layout Itemize
פעמים רבות משתמשים במשפט זה בצורה הלא פורמלית הבאה: מסמנים 
\begin_inset Formula
${\color{red}u=\varphi\left(x\right)}$
\end_inset
 ואז (נשתמש בסימון של לייבניץ לנגזרות) 
\begin_inset Formula
$\frac{du}{dx}=\varphi'\left(x\right)$
\end_inset
 ולכן "מתקיים" 
\begin_inset Formula
${\color{blue}du=\varphi'\left(x\right)dx}$
\end_inset
 ומכאן שגם:
\begin_inset Formula
\[
\intop g\left(x\right)dx=\intop\psi\left({\color{red}\varphi\left(x\right)}\right)\cdot{\color{blue}\varphi'\left(x\right)dx}=\intop\psi\left({\color{red}u}\right){\color{blue}du}=\varPsi\left(u\right)+C=\varPsi\left(\varphi\left(x\right)\right)+C
\]


\end_inset

\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$\varphi$
\end_inset
 גם הפיכה נפוצה גם הצורה הלא פורמלית הנוספת: 
\begin_inset Formula
${\color{red}\varphi^{-1}\left(u\right)=x}$
\end_inset
 ומכאן נובע כי:
\begin_inset Formula
\[
\frac{dx}{du}=\varphi^{-1}'\left(u\right)=\frac{1}{\varphi'\left(\varphi^{-1}\left(u\right)\right)}
\]


\end_inset
ולכן "מתקיים" 
\begin_inset Formula
${\color{blue}dx=\frac{1}{\varphi'\left(\varphi^{-1}\left(u\right)\right)}du}$
\end_inset
 ומכאן שגם
\begin_inset Formula
\begin{align*}
\intop g\left(x\right)dx & =\intop\psi\left(\varphi\left({\color{red}x}\right)\right)\cdot\varphi'\left({\color{red}x}\right){\color{blue}dx}\\
 & =\intop\psi\left(\varphi\left({\color{red}\varphi^{-1}\left(u\right)}\right)\right)\cdot\varphi'\left({\color{red}\varphi^{-1}\left(u\right)}\right)\cdot{\color{blue}\frac{1}{\varphi'\left(\varphi^{-1}\left(u\right)\right)}du}\\
 & =\intop\psi\left(u\right)du=\varPsi\left(u\right)+C=\varPsi\left(\varphi\left(x\right)\right)+C
\end{align*}


\end_inset

\end_layout

