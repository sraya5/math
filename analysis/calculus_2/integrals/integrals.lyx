\begin_layout Proof
ראינו בקורס הקודם שהנגזרת של 
\begin_inset Formula
$f^{-1}$
\end_inset
 היא 
\begin_inset Formula
$f^{-1}'\left(y\right)=\frac{1}{f'\left(f^{-1}\left(y\right)\right)}$
\end_inset
.
\begin_inset Newline newline
\end_inset
נסמן 
\begin_inset Formula
$u=f^{-1}\left(y\right)$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow\frac{du}{dy}=\frac{1}{f'\left(f^{-1}\left(y\right)\right)}\Rightarrow du=\frac{1}{f'\left(f^{-1}\left(y\right)\right)}\cdot dy
\]


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\intop f^{-1}\left(y\right)dy & =\intop f^{-1}\left(y\right)\cdot\frac{f'\left(f^{-1}\left(y\right)\right)}{f'\left(f^{-1}\left(y\right)\right)}dy=\intop u\cdot f'\left(u\right)du\\
 & =u\cdot f\left(u\right)-\intop1\cdot f\left(u\right)du\\
 & =u\cdot f\left(u\right)-F\left(u\right)+C\\
 & =f^{-1}\left(y\right)\cdot f\left(f^{-1}\left(y\right)\right)-F\left(f^{-1}\left(y\right)\right)+C\\
 & =y\cdot f^{-1}\left(y\right)-F\left(f^{-1}\left(y\right)\right)+C
\end{align*}


\end_inset
עד כאן השתמשנו בשיטה הלא פורמלית שתוארה לעיל וכעת יש לנו שתי סיבות אינטואיטיביות להאמין שאכן הפונקציה הנ"ל היא קדומה של 
\begin_inset Formula
$f^{-1}$
\end_inset
 וכעת נעבור להוכחה פורמלית.
\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$g:\MKim f\rightarrow\MKreal$
\end_inset
 פונקציה המוגדרת ע"י (לכל 
\begin_inset Formula
$y\in\MKim f$
\end_inset
):
\begin_inset Formula
\[
g\left(y\right):=y\cdot f^{-1}\left(y\right)-F\left(f^{-1}\left(y\right)\right)
\]


\end_inset
מכאן שלכל 
\begin_inset Formula
$y\in\MKim f$
\end_inset
 כך ש-
\begin_inset Formula
$f'\left(f^{-1}\left(y\right)\right)\neq0$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
g'\left(y\right) & =1\cdot f^{-1}\left(y\right)+y\cdot\frac{1}{f'\left(f^{-1}\left(y\right)\right)}-F'\left(f^{-1}\left(y\right)\right)\cdot\frac{1}{f'\left(f^{-1}\left(y\right)\right)}\\
 & =f^{-1}\left(y\right)+y\cdot\frac{1}{f'\left(f^{-1}\left(y\right)\right)}-f\left(f^{-1}\left(y\right)\right)\cdot\frac{1}{f'\left(f^{-1}\left(y\right)\right)}\\
 & =f^{-1}\left(y\right)+y\cdot\frac{1}{f'\left(f^{-1}\left(y\right)\right)}-y\cdot\frac{1}{f'\left(f^{-1}\left(y\right)\right)}=f^{-1}\left(y\right)
\end{align*}


\end_inset
כדי להוכיח את הטענה עבור נקודות שבהן 
\begin_inset Formula
$f'\left(f^{-1}\left(y\right)\right)=0$
\end_inset
 נצטרך להשתמש בעובדה ש-
\begin_inset Formula
$f^{-1}$
\end_inset
 רציפה
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
הגזירות של 
\begin_inset Formula
$f$
\end_inset
 גוררת את רציפותה ומכאן שגם 
\begin_inset Formula
$f^{-1}$
\end_inset
 רציפה.
\end_layout

\end_inset
 ולכן ע"פ המשפט היסודי (שעוד לא למדנו) יש לה פונקציה קדומה 
\begin_inset Formula
$G$
\end_inset
.
\begin_inset Newline newline
\end_inset
בהג"כ נניח שקיים 
\begin_inset Formula
$y_{0}\in\MKim f$
\end_inset
 כך ש-
\begin_inset Formula
$G\left(y_{0}\right)=g\left(y_{0}\right)$
\end_inset
 וא"כ לכל 
\begin_inset Formula
$y\in\MKim f$
\end_inset
 כך ש-
\begin_inset Formula
$f'\left(f^{-1}\left(y\right)\right)\neq0$
\end_inset
 מתקיים 
\begin_inset Formula
$G\left(y\right)=g\left(y\right)$
\end_inset
,
\begin_inset Newline newline
\end_inset
נשים לב לכך שקבוצת הנקודות ב-
\begin_inset Formula
$\MKim f$
\end_inset
 המקיימת 
\begin_inset Formula
$f'\left(f^{-1}\left(y\right)\right)\neq0$
\end_inset
 צפופה ב-
\begin_inset Formula
$\MKim f$
\end_inset

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
אחרת מהרציפות של 
\begin_inset Formula
$f^{-1}$
\end_inset
 ומהיותה הפיכה היה נובע שקיים מקטע שבו מתקיים 
\begin_inset Formula
$f'\left(x\right)=0$
\end_inset
, כלומר 
\begin_inset Formula
$f$
\end_inset
 הייתה פונקציה קבועה במקטע זה בסתירה לכך שהיא חח"ע.
\end_layout

\end_inset
 ולכן מהרציפות של שתי הפונקציות נובע שהן מקבלות את אותו ערך גם בנקודות שבהן 
\begin_inset Formula
$f'\left(f^{-1}\left(y\right)\right)=0$
\end_inset
.
\end_layout

