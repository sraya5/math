 & =\frac{\varepsilon}{b-a}\cdot\sum_{i=1}^{n}\left(x_{i}-x_{i-1}\right)\\
 & =\frac{\varepsilon}{b-a}\cdot\left(b-a\right)=\varepsilon
\end{align*}


