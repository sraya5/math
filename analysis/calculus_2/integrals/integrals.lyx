\end_inset
 דומה למדי.
\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$F$
\end_inset
 הפונקציה הצוברת של 
\begin_inset Formula
$f$
\end_inset
 )מהמשפט היסודי של החשבון האינטגרלי 
\begin_inset Formula
$F$
\end_inset
 היא פונקציה קדומה של 
\begin_inset Formula
$f$
\end_inset
( ויהי 
\begin_inset Formula
$M\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$\left|F\left(x\right)\leq M\right|$
\end_inset
 לכל 
\begin_inset Formula
$x\in\left[a,b\right)$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהיותה של 
\begin_inset Formula
$g$
\end_inset
 מונוטונית יורדת נדע ש-
\begin_inset Formula
$g$
\end_inset
 אינטגרבילית רימן על כל תת-קטע סגור של 
\begin_inset Formula
$\left[a,\infty\right)$
\end_inset

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
ולכן גם מכפלתה ב-
\begin_inset Formula
$f$
\end_inset
 אינטגרבילית רימן כל כל תת-קטע סגור של 
\begin_inset Formula
$\left[a,\infty\right)$
\end_inset
.
\end_layout

\end_inset
 וש-
\begin_inset Formula
$g'$
\end_inset
 אי-חיובית.
\begin_inset Newline newline
\end_inset
מאינטגרציה בחלקים נובע כי לכל 
\begin_inset Formula
$x\in\left[a,b\right)$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\intop_{a}^{x}f\left(t\right)\cdot g\left(t\right)dt=\left.\left(F\cdot g\right)\right|_{a}^{b}-\intop_{a}^{x}F\left(t\right)\cdot g'\left(t\right)\ dt
\]


\end_inset
נשים לב לכך ש לכל 
\begin_inset Formula
$x\in\left[a,b\right)$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
F\left(x\right)\cdot g\left(x\right)-F\left(a\right)\cdot g\left(a\right) & =F\left(x\right)\cdot g\left(x\right)-0\cdot g\left(a\right)\\
 & =F\left(x\right)\cdot g\left(x\right)\\
 & \leq M\cdot g\left(x\right)\xrightarrow[x\rightarrow b]{}0
\end{align*}


\end_inset
ובנוסף גם:
\begin_inset Formula
\begin{align*}
\intop_{a}^{x}\left|F\left(t\right)\cdot g'\left(t\right)\right|dt & =\intop_{a}^{x}\left|F\left(t\right)\right|\cdot\left|g'\left(t\right)\right|dt\leq\intop_{a}^{x}M\cdot\left|g'\left(t\right)\right|dt\\
 & =M\cdot\intop_{a}^{x}\left|g'\left(t\right)\right|dt=M\cdot\intop_{a}^{x}-g'\left(t\right)dt=-M\cdot\intop_{a}^{x}g'\left(t\right)dt
\end{align*}


\end_inset
כעת נזכור ש-
\begin_inset Formula
$g'$
\end_inset
 אינטגרבילית רימן כל כל תת-קטע סגור של 
\begin_inset Formula
$\left[a,b\right)$
\end_inset
 ולכן, ע"פ נוסחת לייבניץ-ניוטון, לכל 
\begin_inset Formula
$x\in\left[a,b\right)$
\end_inset
 מתקיים גם:
\begin_inset Formula
\[
\intop_{a}^{x}g'\left(t\right)dt=g\left(x\right)-g\left(a\right)\xrightarrow[x\rightarrow b]{}-g\left(a\right)
\]


\end_inset
כלומר האינטגרל 
\begin_inset Formula
$-M\cdot\intop_{a}^{b}g'\left(t\right)dt$
\end_inset
 מתכנס ולכן ממבחן ההשוואה גם 
\begin_inset Formula
$\intop_{a}^{b}F\left(t\right)\cdot g'\left(t\right)$
\end_inset
 מתכנס בהחלט ובפרט מתכנס, מאריתמטיקה של גבולות נקבל שהאינטגרל המבוקש מתכנס.
\end_layout

