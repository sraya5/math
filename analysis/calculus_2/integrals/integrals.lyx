\begin_layout Theorem
\series bold
הצבה
\series default

\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$f:I\rightarrow\MKreal$
\end_inset
 פונקציה רציפה
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
ניתן להחליף את הרציפות בעמידה בתנאים של הרחבת הנוסחה היסודית, הערה זו תקפה גם במסקנה ובמשפט שלהלן.
\end_layout

\end_inset
 על קטע סגור 
\begin_inset Formula
$I$
\end_inset
 ותהא 
\begin_inset Formula
$\varphi:\left[a,b\right]\rightarrow I$
\end_inset
 פונקציה גזירה כך ש-
\begin_inset Formula
$\varphi'$
\end_inset
 אינטגרבילית רימן על 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
, מתקיים:
\begin_inset Formula
\[
\intop_{a}^{b}f\left(\varphi\left(x\right)\right)\cdot\varphi'\left(x\right)dx=\intop_{\varphi\left(a\right)}^{\varphi\left(b\right)}f\left(t\right)dt
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 האינטואיציה דומה מאד לאינטואיציה של כלל השרשרת.
\begin_inset Newline newline
\end_inset
כל פונקציה ליניארית 
\begin_inset Formula
$ax+b$
\end_inset
 מעוותת את הישר הממשי בצורה הבאה: היא מותחת/מכווצת אותו פי 
\begin_inset Formula
$a$
\end_inset
 ומזיזה אותו ב-
\begin_inset Formula
$b$
\end_inset
 יחידות ימינה, ההזזה ב-
\begin_inset Formula
$b$
\end_inset
 אינה משנה דבר לאינטגרל אבל ברור שאם ניקח גרף של פונקציה אינטגרבילית ונכווץ אותו פי 
\begin_inset Formula
$a$
\end_inset
 (שזה שקול להרכבה על פונקציה ליניארית כנ"ל) נקבל פונקציה דומה מאד שהשטח שמחת לגרף שלה קטן/גדול פי 
\begin_inset Formula
$a$
\end_inset
 מזה של הפונקציה המקורית ולכן עלינו לתקן זאת ע"י הכפלת האינטגרל ב-
\begin_inset Formula
$a$
\end_inset
. פונקציות שאינן ליניאריות מעוותות גם הן את הישר הממשי ע"פ כלל ההתאמה שלהן אך מכיוון שקרוב מספיק לנקודה גזירה 
\begin_inset Formula
$x$
\end_inset
 הן מתנהגות "כמעט" כמו פונקציות ליניאריות התיקון שוב יהיה הכפלה בנגזרת כשהפעם התיקון מתבצע בכל נקודה בקטע הסגור שבו נחשב את האינטגרל.
\end_layout

\begin_layout Proof
תהא 
\begin_inset Formula
$F$
\end_inset
 פונקציה קדומה של 
\begin_inset Formula
$f$
\end_inset
, מתקיים:
\begin_inset Formula
\[
\intop_{a}^{b}f\left(\varphi\left(x\right)\right)\cdot\varphi'\left(x\right)dx=\left(F\circ\varphi\right)\left(b\right)-\left(F\circ\varphi\right)\left(a\right)=F\left(\varphi\left(b\right)\right)-F\left(\varphi\left(a\right)\right)=\intop_{\varphi\left(a\right)}^{\varphi\left(b\right)}f\left(t\right)dt
\]


\end_inset

\end_layout

\begin_layout Corollary
תהא 
\begin_inset Formula
$f:\left[a,b\right]\rightarrow\MKreal$
\end_inset
 פונקציה רציפה ותהיינה 
\begin_inset Formula
$\varphi,\psi:\left[\alpha,\beta\right]\rightarrow\left[a,b\right]$
\end_inset
 פונקציות גזירות.
\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$g:\left[\alpha,\beta\right]\rightarrow\MKreal$
\end_inset
 פונקציה המוגדרת ע"י (לכל 
\begin_inset Formula
$x\in\left[\alpha,\beta\right]$
\end_inset
):
\begin_inset Formula
\[
g\left(x\right)=\intop_{\varphi\left(x\right)}^{\psi\left(x\right)}f\left(t\right)dt
\]


\end_inset

\begin_inset Formula
$g$
\end_inset
 גזירה ולכל 
\begin_inset Formula
$x\in\left[\alpha,\beta\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\[
g'\left(x\right)=f\left(\psi\left(x\right)\right)\cdot\psi'\left(x\right)-f\left(\varphi\left(x\right)\right)\cdot\varphi'\left(x\right)
\]


\end_inset

\end_layout

\begin_layout Theorem
\series bold
הצבה הפוכה
\series default

\begin_inset Newline newline
\end_inset
תהיינה 
