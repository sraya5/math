, כלומר ישנה אנלוגיה בין סדרה והטור שלה לבין פונקציה והאינטגרל שלה. במשפט אנחנו רואים את הכיוון ההפוך: לקחנו פונקציה ובנינו ממנה סדרה, הבעיה היא שבתהליך הזה ישנה שרירותיות מסוימת בבחירה של הנקודות בגרף של 
\begin_inset Formula
$f$
\end_inset
 שיהיו איברי הסדרה; כלומר מסדרה אפשר ליצור פונקציה אחת בדיוק שתהיה מקבילה לה אך קיימות פונקציות רבות שהסדרה המקבילה להן זהה. העובדה הזו בעצם מאפשרת לפונקציה "להשתולל" בין הנקודות הטבעיות ולהיות "יפה" רק בהן ואז הטור והאינטגרל לא בהכרח יתכנסו ויתבדרו ביחד, זו הסיבה לכך שהמשפט דורש את המונוטוניות של 
\begin_inset Formula
$f$
\end_inset
: המונוטוניות של 
\begin_inset Formula
$f$
\end_inset
 לא תאפשר לה "להשתולל" ויתר על כן ניתן יהיה "לכלוא" את השטח שמתחת לגרף שלה בין הטור 
\begin_inset Formula
$\sum_{n=0}^{\infty}f\left(a+n\right)$
\end_inset
 לטור 
\begin_inset Formula
$\sum_{n=0}^{\infty}f\left(a+n+1\right)$
\end_inset
, הוכחת המשפט תפרמל בדיוק את הטיעון הזה.
\end_layout

\begin_layout Proof
נוכיח את הסעיף הראשון, ההוכחה עבור הסעיפים האחרים דומה מאד.
\begin_inset Newline newline
\end_inset
מהעובדה ש-
\begin_inset Formula
$f$
\end_inset
 מונוטונית יורדת ואי-שלילית נובע שלכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 ולכל 
\begin_inset Formula
$x\in\left[a+n-1,a+n\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\[
f\left(a+n+1\right)\leq f\left(x\right)\leq f\left(a+n\right)
\]


\end_inset
וממילא:
\begin_inset Formula
\[
f\left(a+n+1\right)=\intop_{a+n}^{a+n+1}f\left(a+n+1\right)dx\leq\intop_{a+n}^{a+n+1}f\left(x\right)dx\leq\intop_{a+1}^{a+n+1}f\left(a+n\right)dx=f\left(a+n\right)
\]


\end_inset
ולכן לכל 
\begin_inset Formula
$N\in\MKnatural_{0}$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sum_{n=1}^{N+1}f\left(a+n\right)=\sum_{n=0}^{N}f\left(a+n+1\right)\leq\sum_{n=0}^{N}\intop_{a+n}^{a+n+1}f\left(x\right)dx\leq\sum_{n=0}^{N}f\left(a+n\right)
\]


\end_inset
מכאן שע"פ מבחן ההשוואה הטור 
\begin_inset Formula
$\begin{alignedat}{1}\sum_{n=0}^{\infty}f\left(a+n\right)\end{alignedat}
$

\end_inset
 מתכנס אם"ם הטור 
\begin_inset Formula
$\begin{alignedat}{1}\sum_{n=0}^{\infty}\intop_{a+n}^{a+n+1}f\left(x\right)dx\end{alignedat}
$

\end_inset
 מתכנס.
\begin_inset Newline newline
\end_inset
נשים לב לכך שלכל 
\begin_inset Formula
$N\in\MKnatural_{0}$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sum_{n=0}^{N}\intop_{a+n}^{a+n+1}f\left(x\right)dx=\intop_{a}^{a+N+1}f\left(x\right)dx
\]


\end_inset
ולכך שמהיות 
\begin_inset Formula
$f$
\end_inset
 אי-שלילית נובע שלכל 
\begin_inset Formula
$x\in\left[a,\infty\right)$
\end_inset
 מתקיים קיים 
\begin_inset Formula
$N\in\MKnatural_{0}$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
\intop_{a}^{a+N}f\left(x\right)dx\leq\intop_{a}^{x}f\left(t\right)dt\leq\intop_{a}^{a+N+1}f\left(x\right)dx
\]


\end_inset
ולכן (מדובר בשוויון פורמלי בלבד):
\begin_inset Formula
\[
\lim_{N\rightarrow\infty}\intop_{a}^{a+N}f\left(x\right)dx=\lim_{x\rightarrow\infty}\intop_{a}^{x}f\left(t\right)dt=\intop_{a}^{\infty}f\left(x\right)dx
\]


\end_inset
כלומר הגבול שבאגף שמאל קיים אם"ם האינטגרל שבאגף ימין מתכנס ואז הם שווים.
\end_layout

