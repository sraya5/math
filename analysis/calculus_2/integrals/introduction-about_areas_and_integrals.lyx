\begin_layout Example
לאחר שנוכיח את הקשר בין האינטגרל הלא מסוים לבין השטח שמתחת לגרף הפונקציה נוכל לחשב את הנפח של פירמידה ששטח בסיסה הוא 
\begin_inset Formula $S$
\end_inset

 וגובהה הוא 
\begin_inset Formula $h$
\end_inset

:
\begin_inset Newline newline
\end_inset

נשים לב שלכל 
\begin_inset Formula $x\in\left[0,h\right]$
\end_inset

 שטח החתך המתאים הוא 
\begin_inset Formula $\left(\frac{x}{h}\right)^{2}\cdot S$
\end_inset

 (היקף המלבן
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
או כל צורה אחרת של הבסיס,
 כולל עיגול ואז נקבל נפח של חרוט.
\end_layout

\end_inset

 המהווה את החתך עולה בקצב ליניארי ולכן שטחו גדל בקצב ריבועי),
\begin_inset Newline newline
\end_inset

כאשר 
\begin_inset Formula $x=h$
\end_inset

 פירושו החתך בגובה בסיס הפירמידה ו-
\begin_inset Formula $x=0$
\end_inset

 פירושו החתך בקודקוד הפירמידה.
\begin_inset Newline newline
\end_inset

נגדיר 
\begin_inset Formula $V:\left[0,h\right]\rightarrow\MKreal$
\end_inset

 ע"י 
\begin_inset Formula $V\left(x\right)=\left(\frac{x}{h}\right)^{2}\cdot S$
\end_inset

 ומכאן שנפח הפירמידה מתקבל ע"י החישוב הבא:
\begin_inset Formula 
\[
\intop V\left(x\right)dx=\intop\frac{x^{2}}{h^{2}}\cdot S\ dx=\frac{S}{h^{2}}\cdot\intop x^{2}\ dx=\frac{S}{h^{2}}\cdot\frac{x^{3}}{3}+C=\frac{S}{3h^{2}}\cdot x^{3}+C
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow V_{\Delta}=\intop_{0}^{h}V\left(x\right)dx=\frac{S}{3h^{2}}\cdot h^{3}-\frac{S}{3h^{2}}\cdot0^{3}=\frac{S\cdot h}{3}
\]

\end_inset

וקיבלנו את הנוסחה המוכרת מהתיכון.
\end_layout

