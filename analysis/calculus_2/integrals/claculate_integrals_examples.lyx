\begin_layout Example
יהיו 
\begin_inset Formula
$n,m\in\MKnatural$
\end_inset
 כך שלפחות אחד מהם אי-זוגי, מתקיים:
\begin_inset Formula
\[
\intop\sin^{n}\theta\cdot\cos^{m}\theta\ d\theta
\]


\end_inset
כאשר לפחות אחד מ-
\begin_inset Formula
$n$
\end_inset
 ו-
\begin_inset Formula
$m$
\end_inset
 אי-זוגי.
\end_layout

\begin_layout Standard
נניח בהג"כ ש-
\begin_inset Formula
$m$
\end_inset
 אי-זוגי, נציב 
\begin_inset Formula
$u=\sin\theta$
\end_inset

\begin_inset Formula
\[
\Rightarrow\frac{du}{d\theta}=\cos\theta\Rightarrow du=\cos\theta\ d\theta
\]


\end_inset
א"כ נקבל:
\begin_inset Formula
\begin{align*}
\intop\sin^{n}\theta\cdot\cos^{m}\theta d\theta & =\intop\sin^{n}\theta\cdot\left(\cos^{2}\theta\right)^{\frac{m-1}{2}}\cdot\cos\left(\theta\right)d\theta\\
 & =\intop\sin^{n}\theta\cdot\left(1-\sin^{2}\theta\right)^{\frac{m-1}{2}}\cdot\cos\left(\theta\right)d\theta\\
 & =\intop u^{n}\cdot\left(1-u^{2}\right)^{\frac{m-1}{2}}du
\end{align*}


\end_inset
וזהו כבר אינטגרל של פולינום (נפתח סוגריים).
\end_layout

\begin_layout Example
\series bold
חישוב גבולות באמצעות אינטגרלי רימן
\series default

\begin_inset Newline newline
\end_inset
מתקיים:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\sum_{k=1}^{n}\frac{1}{k}\cdot\sin\left(\frac{1}{k}\right)=\lim_{\delta\rightarrow0^{+}}\intop_{\delta}^{1}\sin\left(x\right)dx=\intop_{0}^{1}\sin\left(x\right)dx=\left(-\cos\left(1\right)\right)-\left(-\cos\left(0\right)\right)=1-\cos\left(1\right)
\]


