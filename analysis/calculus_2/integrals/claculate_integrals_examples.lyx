\begin_layout Example
יהיו 
\begin_inset Formula
$\alpha\in\MKreal$
\end_inset
 ו-
\begin_inset Formula
$0<\beta\in\MKreal$
\end_inset
.
\begin_inset Newline newline
\end_inset
האינטגרל (הלא אמיתי) 
\begin_inset Formula
$\intop_{1}^{\infty}x^{\alpha}\cdot\sin\left(x^{\beta}\right)dx$
\end_inset
 מתכנס אם"ם 
\begin_inset Formula
$\alpha<\beta-1$
\end_inset
.
\end_layout

\begin_layout Proof
\begin_inset space \space{}
\end_inset

\begin_inset Newline newline
\end_inset
נסמן 
\begin_inset Formula
$u:=x^{\beta}$
\end_inset
.
\begin_inset Formula
\[
\frac{dx}{du}=\frac{1}{\beta}\cdot u^{\frac{1}{\beta}-1}\Rightarrow dx=\frac{1}{\beta}\cdot u^{\frac{1-\beta}{\beta}}\ du
\]


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\intop_{1}^{\infty}x^{\alpha}\cdot\sin\left(x^{\beta}\right)dx & =\intop_{1}^{\infty}u^{\frac{\alpha}{\beta}}\cdot\sin\left(u\right)\cdot\frac{1}{\beta}\cdot u^{\frac{1-\beta}{\beta}}du\\
 & =\frac{1}{\beta}\cdot\intop_{1}^{\infty}u^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(u\right)du
\end{align*}


\end_inset

\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula
$\Leftarrow$
\end_inset

\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$\alpha\geq\beta-1$
\end_inset
 ומכאן ש-
\begin_inset Formula
$\alpha+1-\beta\geq0$
\end_inset
 ולכן גם 
\begin_inset Formula
$\frac{\alpha+1-\beta}{\beta}\geq0$
\end_inset
.
\begin_inset Newline newline
\end_inset
אם 
\begin_inset Formula
$\frac{\alpha+1-\beta}{\beta}=0$
\end_inset
 אז:
\begin_inset Formula
\[
\frac{1}{\beta}\cdot\intop_{1}^{\infty}u^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(u\right)du=\frac{1}{\beta}\cdot\intop_{1}^{\infty}\sin\left(u\right)du
\]


\end_inset
וכבר ראינו שהאינטגרל הלא אמיתי 
\begin_inset Formula
$\intop_{1}^{\infty}\sin\left(u\right)du$
\end_inset
 אינו מתכנס ולכן גם 
\begin_inset Formula
$\frac{1}{\beta}\cdot\intop_{1}^{\infty}\sin\left(u\right)du$
\end_inset
 אינו מתכנס.
\begin_inset Newline newline
\end_inset
א"כ נתמקד במקרה שבו 
\begin_inset Formula
$P:=\frac{\alpha+1-\beta}{\beta}>0$
\end_inset
ַ, לכל 
\begin_inset Formula
$1<u\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$u^{P}>1$
\end_inset
.
\begin_inset Newline newline
\end_inset
ע"פ נוסחת לייבניץ-ניוטון (
\begin_inset Formula
$\sin$
\end_inset
 היא פונקציה רציפה בכל 
\begin_inset Formula
$\MKreal$
\end_inset
) לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\left|\intop_{2\pi n}^{2\pi n+\frac{\pi}{2}}u^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(u\right)du\right| & \geq\intop_{2\pi n}^{2\pi n+\frac{\pi}{2}}u^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(u\right)\ du\geq\intop_{2\pi n}^{2\pi n+\frac{\pi}{2}}\sin\left(u\right)\ du\\
 & =-\cos\left(2\pi n+\frac{\pi}{2}\right)-\left[-\cos\left(2\pi n\right)\right]\\
 & =-\left(-1\right)-\left(-1\right)=2
\end{align*}


\end_inset
א"כ נבחר 
\begin_inset Formula
$\varepsilon:=2$
\end_inset
 ולכל 
\begin_inset Formula
$B\in\MKreal$
\end_inset
 קיים 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$\frac{B}{2\pi}<n$
\end_inset
 (ולכן גם 
\begin_inset Formula
$B<2\pi n<2\pi n+\frac{\pi}{2}$
\end_inset
) המקיים:
\begin_inset Formula
\[
\left|\intop_{2\pi n}^{2\pi n+\frac{\pi}{2}}u^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(u\right)\ du\right|\geq2=\varepsilon
\]


\end_inset
מתנאי קושי להתכנסות של אינטגרל לא אמיתי נובע ש-
\begin_inset Formula
$\frac{1}{\beta}\cdot\intop_{1}^{\infty}u^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(u\right)du$
\end_inset
 מתבדר ולכן גם 
\begin_inset Formula
$\intop_{1}^{\infty}x^{\alpha}\cdot\sin\left(x^{\beta}\right)dx$
\end_inset
 מתבדר.
\end_layout

\begin_layout Itemize
\begin_inset Formula
$\Rightarrow$
\end_inset

\begin_inset Newline newline
\end_inset
נניח כי 
\begin_inset Formula
$\alpha<\beta-1$
\end_inset
 ומכאן ש-
\begin_inset Formula
$\alpha+1-\beta<0$
\end_inset
 ולכן גם 
\begin_inset Formula
$P:=\frac{\alpha+1-\beta}{\beta}<0$
\end_inset
.
\begin_inset Newline newline
\end_inset

\begin_inset Formula
$\sin$
\end_inset
 היא פונקציה שהצוברת שלה (
\begin_inset Formula
$\cos$
\end_inset
) חסומה ו-
\begin_inset Formula
$u^{P}$
\end_inset
 היא פונקציה מונוטונית יורדת כך ש-
\begin_inset Formula
$\lim_{u\rightarrow\infty}u^{P}=0$
\end_inset
 והנגזרת שלה אינטגרבילית על כל תת-קטע סגור של 
\begin_inset Formula
$\left[1,\infty\right)$
\end_inset
, ממבחן דיריכלה להתכנסות אינטגרלים לא אמיתיים נובע ש-
\begin_inset Formula
$\frac{1}{\beta}\cdot\intop_{1}^{\infty}u^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(u\right)du$
\end_inset
 מתכנס ולכן גם 
\begin_inset Formula
$\intop_{1}^{\infty}x^{\alpha}\cdot\sin\left(x^{\beta}\right)dx$
\end_inset
 מתכנס.
\end_layout

\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 למעשה, מבחינה פורמלית מה שעשינו בשלב הראשון של ההוכחה היה התהליך המפרך המפורט להלן, ודאי תבינו מדוע לא הבאתי אותו ראשון...
\begin_inset Newline newline
\end_inset
תהא 
\begin_inset Formula
$f:\left[1,\infty\right)\rightarrow\MKreal$
\end_inset
 המוגדרת ע"י:
\begin_inset Formula
\[
f\left(x\right)=x^{\frac{\alpha+\beta-1}{\beta}}\cdot\sin\left(x\right)
\]


\end_inset
תהא 
\begin_inset Formula
$\varphi:\left[1,\infty\right)\rightarrow\left[1,\infty\right)$
\end_inset
 המוגדרת ע"י 
\begin_inset Formula
$\varphi\left(x\right)=x^{\beta}$
\end_inset
 (לכל 
\begin_inset Formula
$x\in\left[1,\infty\right)$
\end_inset
), א"כ ילכל 
\begin_inset Formula
$x\in\left[1,\infty\right)$
\end_inset
 מתקיים 
\begin_inset Formula
$\varphi'\left(x\right)=\beta\cdot x^{\beta-1}$
\end_inset
.
\begin_inset Newline newline
\end_inset
נשים לב לכך ש-
\begin_inset Formula
$f$
\end_inset
 רציפה וש-
\begin_inset Formula
$\varphi'$
\end_inset
 אינטגרבילית רימן על כל תת-קטע סגור של 
\begin_inset Formula
$\left[1,\infty\right)$
\end_inset
 ולכן ניתן להשתמש במשפט ההצבה.
\begin_inset Formula
\begin{align*}
\intop_{1}^{\infty}x^{\alpha}\cdot\sin\left(x^{\beta}\right)dx & =\lim_{b\rightarrow\infty}\intop_{1}^{b}\left(x^{\beta}\right)^{\frac{\alpha}{\beta}}\cdot\sin\left(x^{\beta}\right)\cdot\frac{1}{\beta}\cdot\left(x^{\beta}\right)^{\frac{1-\beta}{\beta}}\cdot\beta\cdot\left(x^{\beta}\right)^{\frac{\beta-1}{\beta}}dx\\
 & =\frac{1}{\beta}\cdot\lim_{b\rightarrow\infty}\intop_{1}^{b}\left(x^{\beta}\right)^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(x^{\beta}\right)\cdot\beta\cdot\left(x^{\beta}\right)^{\frac{\beta-1}{\beta}}dx\\
 & =\frac{1}{\beta}\cdot\lim_{b\rightarrow\infty}\intop_{1}^{b}\left(\varphi\left(x\right)\right)^{\frac{\alpha+1-\beta}{\beta}}\cdot\sin\left(\varphi\left(x\right)\right)\cdot\varphi'\left(x\right)dx\\
 & =\frac{1}{\beta}\cdot\lim_{b\rightarrow\infty}\intop_{1}^{b}f\left(\varphi\left(x\right)\right)\cdot\varphi'\left(x\right)dx=\frac{1}{\beta}\cdot\lim_{b\rightarrow\infty}\intop_{\varphi\left(1\right)}^{\varphi\left(b\right)}f\left(t\right)dt\\
 & =\frac{1}{\beta}\cdot\lim_{b\rightarrow\infty}\intop_{1}^{b^{\beta}}f\left(t\right)dt=\frac{1}{\beta}\cdot\lim_{c\rightarrow\infty}\intop_{1}^{c}t^{\frac{\alpha+\beta-1}{\beta}}\cdot\sin\left(t\right)dt
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 אז איך נמנעים מהסיבוך המיותר הזה? התשובה היא שעלינו להראות שהתנאים למשפט ההצבה מתקיימים ואז לבצע את ההצבה כפי שהיינו עושים עבור אינטגרל לא מסוים ולבסוף עלינו לבחור את הקצוות לפי הערך ש-
\begin_inset Formula
$\varphi$
\end_inset
 מקבלת עבורם, במקרה הזה כש-
\begin_inset Formula
$x$
\end_inset
 נע בין 
\begin_inset Formula
$1$
\end_inset
 ל-
\begin_inset Formula
$b$
\end_inset
 
\begin_inset Formula
$\varphi\left(x\right)=u$
\end_inset
 נע בין 
\begin_inset Formula
$1^{\beta}$
\end_inset
 ל-
\begin_inset Formula
$b^{\beta}$
\end_inset
 ומכיוון שהצוברת רציפה ו-
\begin_inset Formula
$\lim_{b\rightarrow\infty}b^{\beta}=\infty=\lim_{c\rightarrow\infty}c$
\end_inset
 יכולנו להחליף את 
\begin_inset Formula
$b^{\beta}$
\end_inset
 ב-
\begin_inset Formula
$c$
\end_inset
.
\end_layout

