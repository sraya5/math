\begin_layout Proof
אלגוריתם אוקלידס המורחב מבטיח לנו שקיימים 
\begin_inset Formula
$C,D\in\MKfield\left[x\right]$
\end_inset
 המקיימים 
\begin_inset Formula
$A\cdot F+B\cdot G=1$
\end_inset
, יהיו 
\begin_inset Formula
$C$
\end_inset
 ו-
\begin_inset Formula
$D$
\end_inset
 כנ"ל.
\begin_inset Newline newline
\end_inset
נחלק את 
\begin_inset Formula
$C$
\end_inset
 ב-
\begin_inset Formula
$G$
\end_inset
 ואת 
\begin_inset Formula
$D$
\end_inset
 ב-
\begin_inset Formula
$F$
\end_inset
 (חלוקה עם שארית): יהיו 
\begin_inset Formula
$Q_{1},Q_{2},A,B\in\MKfield\left[x\right]$
\end_inset
 כך ש-
\begin_inset Formula
$\deg A<\deg G$
\end_inset
, 
\begin_inset Formula
$\deg B<\deg F$
\end_inset
 ומתקיים:
\begin_inset Formula
\begin{align*}
C & =Q_{1}\cdot G+A\\
D & =Q_{2}\cdot F+B
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow1=C\cdot F+D\cdot G & =\left(Q_{1}\cdot G+A\right)\cdot F+\left(Q_{2}\cdot F+B\right)\cdot G\\
 & =Q_{1}\cdot G\cdot F+A\cdot F+Q_{2}\cdot F\cdot G+B\cdot G\\
 & =\left(Q_{1}+Q_{2}\right)\cdot F\cdot G+A\cdot F+B\cdot G
\end{align*}


\end_inset
נזכור ש-
\begin_inset Formula
$\deg R_{1}<\deg G$
\end_inset
 ו-
\begin_inset Formula
$\deg R_{2}<\deg F$
\end_inset
 ולפיכך:
\begin_inset Formula
\begin{align*}
\deg\left(A\cdot F\right) & =\deg A+\deg F<\deg G+\deg F=\deg\left(F\cdot G\right)\\
\deg\left(B\cdot G\right) & =\deg B+\deg G<\deg F+\deg G=\deg\left(F\cdot G\right)
\end{align*}


\end_inset
כעת נניח בשלילה ש-
\begin_inset Formula
$Q_{1}+Q_{2}\neq0$
\end_inset
 ומכאן שמתקיים 
\begin_inset Formula
$\deg\left(\left(Q_{1}+Q_{2}\right)\cdot F\cdot G\right)\geq\deg\left(F\cdot G\right)$
\end_inset
 ולכן גם:
\begin_inset Formula
\begin{align*}
0 & =\deg\left(1\right)=\deg\left(C\cdot F+D\cdot G\right)\\
 & =\deg\left(\left(Q_{1}+Q_{2}\right)\cdot F\cdot G+A\cdot F+B\cdot G\right)\\
 & =\deg\left(\left(Q_{1}+Q_{2}\right)\cdot F\cdot G\right)\geq\deg\left(F\cdot G\right)>0
\end{align*}


\end_inset
מכאן שהנחת השלילה אינה נכונה ו-
\begin_inset Formula
$Q_{1}+Q_{2}=0$
\end_inset
, כלומר 
\begin_inset Formula
$1=A\cdot F+B\cdot G$
\end_inset
 כנדרש.
