\begin_layout Claim
יהיו 
\begin_inset Formula
$F,G,G_{1},G_{2}\in\MKfield\left[x\right]$
\end_inset
 כך ש- 
\begin_inset Formula
$\deg F<\deg G$
\end_inset
, 
\begin_inset Formula
$\gcd\left(G_{1},G_{2}\right)=1$
\end_inset
 ו-
\begin_inset Formula
$G_{1}\cdot G_{2}=G$
\end_inset
.
\begin_inset Newline newline
\end_inset
קיימים 
\begin_inset Formula
$F_{1},F_{2}\in\MKfield\left[x\right]$
\end_inset
 יחידים כך ש-
\begin_inset Formula
$\deg F_{1}<\deg G_{1}$
\end_inset
 ו-
\begin_inset Formula
$\deg F_{2}<\deg G_{2}$
\end_inset
 המקיימים:
\begin_inset Formula
\[
\frac{F}{G}=\frac{F_{1}}{G_{1}}+\frac{F_{2}}{G_{2}}
\]


\end_inset

\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula
$A,B\in\MKfield\left[x\right]$
\end_inset
 כך ש-
\begin_inset Formula
$\deg A<\deg G_{2}$
\end_inset
 ו-
\begin_inset Formula
$\deg B<\deg G_{1}$
\end_inset
 המקיימים 
\begin_inset Formula
$A\cdot G_{1}+B\cdot G_{2}=1$
\end_inset
 (ע"פ הטענה הקודמת קיימים 
\begin_inset Formula
$A$
\end_inset
 ו-
\begin_inset Formula
$B$
\end_inset
 כאלה).
\begin_inset Newline newline
\end_inset
נחלק את 
\begin_inset Formula
$F\cdot B$
\end_inset
 ב-
\begin_inset Formula
$G_{1}$
\end_inset
 עם שארית: יהיו 
\begin_inset Formula
$Q,F_{1}\in\MKfield\left[x\right]$
\end_inset
 כך ש-
\begin_inset Formula
$\deg F_{1}<\deg G_{1}$
\end_inset
 ו-
\begin_inset Formula
$F\cdot B=Q\cdot G_{1}+F_{1}$
\end_inset
.
\begin_inset Newline newline
\end_inset
נגדיר 
\begin_inset Formula
$F_{2}:=F\cdot A+Q\cdot G_{2}$
\end_inset
, ומכאן שמתקיים:
\begin_inset Formula
\[
\frac{F}{G}=\frac{F\cdot\left(A\cdot G_{1}+B\cdot G_{2}\right)}{G_{1}\cdot G_{2}}=\frac{F\cdot B}{G_{1}}+\frac{F\cdot A}{G_{2}}=\frac{{\color{red}Q\cdot G_{1}}+F_{1}}{G_{1}}+\frac{F_{2}{\color{red}-Q\cdot G_{2}}}{G_{2}}=\frac{F_{1}}{G_{1}}+\frac{F_{2}}{G_{2}}
\]


\end_inset
כבר ראינו ש-
\begin_inset Formula
$\deg F_{1}<\deg G_{1}$
\end_inset
 ולכן כל מה שנותר לנו להוכיח הוא שמתקיים גם 
\begin_inset Formula
$\deg F_{2}<\deg G_{2}$
\end_inset
. מהשוויון בשורה הקודמת נובע שמתקיים 
\begin_inset Formula
$F=F_{1}\cdot G_{2}+F_{2}\cdot G_{1}$
\end_inset
,
\begin_inset Formula
\begin{align*}
\Rightarrow\deg F_{2} & =\deg\left(\frac{F-F_{1}\cdot G_{2}}{G_{1}}\right)=\deg\left(F-F_{1}\cdot G_{2}\right)-\deg G_{1}\\
 & \leq\max\left\{ \deg F,\deg\left(F_{1}\cdot G_{2}\right)\right\} -\deg G_{1}\\
 & =\max\left\{ \deg F,\deg F_{1}+\deg G_{2}\right\} -\deg G_{1}\\
 & <\max\left\{ \deg G,\deg G_{1}+\deg G_{2}\right\} -\deg G_{1}\\
 & =\max\left\{ \deg\left(G_{1}\cdot G_{2}\right),\deg\left(G_{1}\cdot G_{2}\right)\right\} -\deg G_{1}\\
 & =\deg\left(G_{1}\cdot G_{2}\right)-\deg G_{1}=\deg G_{1}+\deg G_{2}-\deg G_{1}=\deg G_{2}
\end{align*}


\end_inset
נוכיח את היחידות, יהיו 
\begin_inset Formula
$P_{1},P_{2}\in\MKfield\left[x\right]$
\end_inset
