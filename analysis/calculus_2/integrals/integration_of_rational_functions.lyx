\begin_inset Formula
$\deg P_{1}<\deg G_{1}$
\end_inset
 ו-
\begin_inset Formula
$\deg P_{2}<\deg G_{2}$
\end_inset
 המקיימים:
\begin_inset Formula
\[
\frac{F}{G}=\frac{P_{1}}{G_{1}}+\frac{P_{2}}{G_{2}}
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow0=\left(\frac{P_{1}}{G_{1}}+\frac{P_{2}}{G_{2}}\right)-\left(\frac{F_{1}}{G_{1}}+\frac{F_{2}}{G_{2}}\right)=\frac{P_{1}-F_{1}}{G_{1}}+\frac{P_{2}-F_{2}}{G_{2}}=\frac{\left(P_{1}-F_{1}\right)\cdot G_{2}+\left(P_{2}-F_{2}\right)\cdot G_{1}}{G_{1}\cdot G_{2}}
\]


\end_inset
מכאן שמתקיים 
\begin_inset Formula
$\left(P_{1}-F_{1}\right)\cdot G_{2}=-\left(P_{2}-F_{2}\right)\cdot G_{1}$
\end_inset
, כלומר 
\begin_inset Formula
$G_{1}$
\end_inset
 מחלק את 
\begin_inset Formula
