\end_inset
וממילא:
\begin_inset Formula
\[
\frac{F}{G^{e}}=\sum_{k=0}^{e}\frac{F_{k}}{G^{k}}
\]


\end_inset
היחידות נובעת מסיבה דומה לכך שניתן להציג מספר טבעי בצורה יחידה בבסיס ספירה נתון: החזקות הגדולות מהדרגה של 
\begin_inset Formula
$G^{e-1}$
\end_inset
 מגיעות אך ורק מ-
\begin_inset Formula
$F_{0}$
\end_inset
 ולכן הוא יחיד, המקדם של החזקה ה-
\begin_inset Formula
$\deg G^{e-1}$
\end_inset
 מגיע אך ורק מ-
\begin_inset Formula
$F_{0}$
\end_inset
 ו-
\begin_inset Formula
$F_{1}$
\end_inset
 ולכן גם 
\begin_inset Formula
$F_{1}$
\end_inset
 יחיד; א"כ נותר לנו להוכיח ש-
\begin_inset Formula
$\deg F_{k}<\deg G$
\end_inset
 לכל 
\begin_inset Formula
$e\geq k\in\MKnatural$
\end_inset
.
\begin_inset Newline newline
\end_inset
נשים לב לכך שלכל 
\begin_inset Formula
$e\geq k\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$\deg R_{k}<\deg G^{e-\left(k-1\right)}$
\end_inset
, כלומר 
\begin_inset Formula
$\deg R_{k}<\left(e+1-k\right)\cdot\deg G$
\end_inset
, אך מהגדרה לכל 
\begin_inset Formula
$k\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\deg R_{k}=\deg\left(F_{k}\cdot G^{e-k}\right)=\deg F_{k}+\deg\left(G^{e-k}\right)=\deg F_{k}+\left(e-k\right)\cdot\deg G
\]


\end_inset
ולכן גם:
\begin_inset Formula
\[
\deg F_{k}<\left(e+1-k\right)\cdot\deg G-\left(e-k\right)\cdot\deg G=\deg G
\]


\end_inset

\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Theorem
\series bold
פירוק לשברים חלקיים
\series default

\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$0\neq F,G\in\MKfield\left[x\right]$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$P_{1},P_{2},\ldots,P_{n}\in\MKfield\left[x\right]$
\end_inset
 פולינומים אי-פריקים שונים זה מזה ו-
\begin_inset Formula
$e_{1},e_{2},\ldots,e_{n}\in\MKnatural$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
G=\prod_{i=1}^{n}\left(P_{i}\right)^{e_{i}}
\]


\end_inset
קיימים פולינומים 
\begin_inset Formula
$Q,F_{1,1},F_{1,2}\ldots,F_{1,e_{1}},F_{2,1},F_{2,2}\ldots,F_{1,e_{2}},\ldots\ldots\ldots,F_{n,1},F_{n,2}\ldots,F_{1,e_{n}}\in\MKfield\left[x\right]$
\end_inset
 יחידים כך ש-
\begin_inset Formula
$\deg F_{i,j}<\deg P_{i}$
\end_inset
 לכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$e_{i}\geq j\in\MKnatural$
\end_inset
 המקיימים:
\begin_inset Formula
\[
\frac{F}{G}=Q+\sum_{i=1}^{n}\sum_{j=1}^{e_{i}}\frac{F_{ij}}{\left(P_{i}\right)^{j}}
\]


\end_inset
כאשר 
\begin_inset Formula
$\deg Q=\deg F-\deg G$
\end_inset
 אם 
\begin_inset Formula
$\deg F\geq\deg G$
\end_inset
 ואחרת 
\begin_inset Formula
$Q=0$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ניתן לדרוש ש-
\begin_inset Formula
$P_{1},P_{2},\ldots,P_{n}$
\end_inset
 הם פולינומים מתוקנים ואז קיים 
\begin_inset Formula
$c\in\MKfield$
\end_inset
 (המקדם של החזקה הגדולה ביותר ב-
\begin_inset Formula
$G$
\end_inset
) כך שמתקיים:
\begin_inset Formula
\[
G=c\cdot\prod_{i=1}^{n}\left(P_{i}\right)^{e_{i}}
\]


\end_inset
ואז המשפט אומר שקיימים פולינומים ... המקיימים:
\begin_inset Formula
\[
\frac{F}{G}=Q+\frac{1}{c}\cdot\sum_{i=1}^{n}\sum_{j=1}^{e_{i}}\frac{A_{ij}}{\left(P_{i}\right)^{j}}
\]


\end_inset

\end_layout

\begin_layout Proof
נחלק את 
\begin_inset Formula
$F$
\end_inset
 ב-
\begin_inset Formula
$G$
\end_inset
 עם שארית: יהיו 
\begin_inset Formula
$Q,R\in\MKfield\left[x\right]$
\end_inset
 כך ש-
\begin_inset Formula
$\deg R<\deg G$
\end_inset
 ו-
\begin_inset Formula
$F=Q\cdot G+R$
\end_inset
.
\begin_inset Newline newline
\end_inset
נשים לב כבר עכשיו לכך ש-
\begin_inset Formula
$\deg Q=\deg F-\deg G$
\end_inset
 אם 
\begin_inset Formula
$\deg F\geq\deg G$
\end_inset
 ואחרת 
\begin_inset Formula
$Q=0$
\end_inset
.
\begin_inset Newline newline
\end_inset
מאינדוקציה על הטענה האחרונה נובע שקיימים 
\begin_inset Formula
$R_{1},R_{2},\ldots,R_{e_{i}}\in\MKfield\left[x\right]$
\end_inset
 יחידים כך ש-
\begin_inset Formula
$\deg R_{i}<\deg\left(P_{i}\right)^{e_{i}}$
\end_inset
 לכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
 המקיימים:
\begin_inset Formula
\[
\frac{F}{G}=Q+\frac{R}{G}=Q+\sum_{i=1}^{n}\frac{R_{i}}{\left(P_{i}\right)^{e_{i}}}
\]


\end_inset
ומהלמה נובע שלכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
 קיימים 
\begin_inset Formula
$F_{i,1},F_{i,1},\ldots,F_{i,e_{i}}\in\MKfield\left[x\right]$
\end_inset
 יחידים כך ש-
\begin_inset Formula
$\deg A_{i,j}<\deg P_{i}$
\end_inset
 לכל 
\begin_inset Formula
$e_{i}\geq j\in\MKnatural$
\end_inset
 המקיימים:
\begin_inset Formula
\[
\frac{R_{i}}{\left(p_{i}\right)^{e_{i}}}=\sum_{j=1}^{e_{i}}\frac{F_{i,j}}{\left(P_{i}\right)^{j}}
\]


\end_inset
ומכאן נובע כי:
\begin_inset Formula
\[
\frac{F}{G}=Q+\frac{R}{G}=Q+\sum_{i=1}^{n}\sum_{j=1}^{e_{i}}\frac{F_{i,j}}{\left(P_{i}\right)^{j}}
\]


\end_inset

\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Subsection
איך בפועל מוצאים את הפולינומים שהמשפט מבטיח את קיומם?
\end_layout

\begin_layout Standard
יופי, הוכחנו שקיימים פולינומים כנ"ל, אבל למצוא אותם בדרך שהופיעה בהוכחה נראה כמו משימה ארוכה ומייגעת; למזלנו ניתן למצוא אותם בדרך פשוטה יותר נשתמש בסימוני המשפט:
\end_layout

\begin_layout Itemize
כדי למצוא את 
\begin_inset Formula
$Q$
\end_inset
 עלינו לחלק את 
\begin_inset Formula
$F$
\end_inset
 ב-
\begin_inset Formula
$G$
\end_inset
 עם שארית והמנה המתקבלת היא 
\begin_inset Formula
$Q$
\end_inset
.
\end_layout

\begin_layout Itemize
כדי למצוא את הפירוק של 
\begin_inset Formula
$G$
\end_inset
 לגורמים אי-פריקים אין שיטה כללית, אך בדרך כלל נקבל בתרגילים ובמבחנים פולינומים מדרגה נמוכה שקל לפרק ע"י ניחוש השורשים שלהם.
\end_layout

\begin_layout Itemize
כדי למצוא את 
\begin_inset Formula
$F_{i,j}$
\end_inset
 לכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$e_{i}\geq j\in\MKnatural$
\end_inset
 נשים לב לכך שמתקיים:
\begin_inset Formula
\[
R=G\cdot\sum_{i=1}^{n}\sum_{j=1}^{e_{i}}\frac{F_{i,j}}{\left(P_{i}\right)^{j}}=\prod_{i=1}^{n}\left(P_{i}\right)^{e_{i}}\cdot\sum_{i=1}^{n}\sum_{j=1}^{e_{i}}\frac{F_{i,j}}{\left(P_{i}\right)^{j}}
\]


\end_inset
נפתח את הסוגריים ונקבל את המקדם של כל חזקה כביטוי של המקדמים של הפולינומים ה-
\begin_inset Formula
$F_{i,j}$
\end_inset
-ים (שאינם ידועים לנו), ומכיוון שקיימת רק דרך אחת להציג פולינום בצורה זו והמקדמים של 
\begin_inset Formula
$R$
\end_inset
 ידועים לנו (הוא השארית של חילוק 
\begin_inset Formula
$F$
\end_inset
 ב-
\begin_inset Formula
$G$
\end_inset
) הרי שקיבלנו מערכת משוואות ליניאריות שאנחנו כבר יודעים לפתור וכבר ידוע לנו שקיים פתרון יחיד.
\begin_inset Newline newline
\end_inset
למעשה ניתן לפשט את הדרך עוד יותר ע"י הצבת 
\begin_inset Formula
$x$
\end_inset
-ים מסוימים ב-
\begin_inset Formula
$R$
\end_inset
 כדי לאפס חלק מהאיברים ולהתמקד באחרים.
\end_layout

