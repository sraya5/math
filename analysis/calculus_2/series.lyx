\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$\alpha_{1},\alpha_{2},...,\alpha_{m},\beta_{1},\beta_{2},...,\beta_{m}\in\MKreal$
\end_inset
 ולכל 
\begin_inset Formula
$m\geq k\in\MKnatural$
\end_inset
 נגדיר 
\begin_inset Formula
$B_{k}:=\sum_{i=1}^{k}\beta_{i}$
\end_inset
; מתקיים השוויון הבא:
\begin_inset Formula
\[
\sum_{i=1}^{m}\left(\alpha_{i}\cdot\beta_{i}\right)=\alpha_{m}\cdot B_{m}-\sum_{i=1}^{m-1}\left(B_{i}\cdot\left(\alpha_{i+1}-\alpha_{i}\right)\right)
\]


\end_inset

\end_layout

\begin_layout Proof
נגדיר 
\begin_inset Formula
$B_{0}:=\sum_{i=1}^{0}\beta_{i}=0$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\sum_{i=1}^{m}\left(\alpha_{i}\cdot\beta_{i}\right) & =\sum_{i=1}^{m}\left(\alpha_{i}\cdot\left(B_{i}-B_{i-1}\right)\right)\\
 & =\sum_{i=1}^{m}\left(\alpha_{i}\cdot B_{i}\right)-\sum_{i=1}^{m}\left(\alpha_{i}\cdot B_{i-1}\right)\\
 & =\sum_{i=1}^{m}\left(\alpha_{i}\cdot B_{i}\right)-\sum_{i=0}^{m-1}\left(\alpha_{i+1}\cdot B_{i}\right)\\
 & =\alpha_{m}\cdot B_{m}-\alpha_{1}\cdot B_{0}+\sum_{i=1}^{m-1}\left(B_{i}\cdot\left(\alpha_{i}-\alpha_{i+1}\right)\right)\\
 & =\alpha_{m}\cdot B_{m}-\sum_{i=1}^{m-1}\left(B_{i}\cdot\left(\alpha_{i+1}-\alpha_{i}\right)\right)
\end{align*}


\end_inset

\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Lemma
\begin_inset CommandInset label
LatexCommand label
name "lemma 3.4"
\end_inset
נשתמש בסימוני הטרנספורמציה של אבל.
\begin_inset Newline newline
\end_inset
אם קיים 
\begin_inset Formula
$L\in\MKreal$
\end_inset
 כך שלכל 
\begin_inset Formula
$m\geq i\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|B_{i}\right|\leq L$
\end_inset
, ובנוסף, הסדרה 
\begin_inset Formula
$\left(\alpha_{i}\right)_{i=1}^{m}$
\end_inset
 היא סדרה מונוטונית אזי מתקיים הא"ש הבא:
\begin_inset Formula
\[
\left|\sum_{i=1}^{m}\left(\alpha_{i}\cdot\beta_{i}\right)\right|\leq L\cdot\left(2\left|\alpha_{m}\right|+\left|\alpha_{1}\right|\right)
\]


\end_inset

\end_layout

\begin_layout Proof
מהיות 
\begin_inset Formula
$\left(\alpha_{i}\right)_{i=1}^{m}$
\end_inset
 מונוטונית נובע שכל ההפרשים מהצורה 
\begin_inset Formula
$\alpha_{i+1}-\alpha_{i}$
\end_inset
 (לכל 
\begin_inset Formula
$m-1\geq i\in\MKnatural$
\end_inset
) הם בעלי אותו סימן.
\begin_inset Formula
\[
\Rightarrow{\color{red}\sum_{i=1}^{m-1}\left|\alpha_{i+1}-\alpha_{i}\right|=}\left|\sum_{i=1}^{m-1}\left(\alpha_{i+1}-\alpha_{i}\right)\right|{\color{red}=\left|\alpha_{m}-\alpha_{1}\right|}
\]


\end_inset
מכאן, ע"פ הטרנספורמציה של אבל וא"ש המשולש, שמתקיים:
\begin_inset Formula
\begin{align*}
\left|\sum_{i=1}^{m}\left(\alpha_{i}\cdot\beta_{i}\right)\right| & =\left|\alpha_{m}\cdot B_{m}-\sum_{i=1}^{m-1}\left(B_{i}\cdot\left(\alpha_{i+1}-\alpha_{i}\right)\right)\right|\\
 & \leq\left|\alpha_{m}\cdot B_{m}\right|+\sum_{i=1}^{m-1}\left|B_{i}\cdot\left(\alpha_{i+1}-\alpha_{i}\right)\right|\\
 & =\left|\alpha_{m}\right|\cdot\left|B_{m}\right|+\sum_{i=1}^{m-1}\left|B_{i}\right|\cdot\left|\alpha_{i+1}-\alpha_{i}\right|\\
 & \leq\left|\alpha_{m}\right|\cdot L+\sum_{i=1}^{m-1}L\cdot\left|\alpha_{i+1}-\alpha_{i}\right|\\
 & =L\cdot\left(\left|\alpha_{m}\right|+{\color{red}\sum_{i=1}^{m-1}\left|\alpha_{i+1}-\alpha_{i}\right|}\right)\\
 & =L\cdot\left(\left|\alpha_{m}\right|+{\color{red}\left|\alpha_{m}-\alpha_{1}\right|}\right)\\
 & \leq L\cdot\left(2\left|\alpha_{m}\right|+\left|\alpha_{1}\right|\right)
\end{align*}


\end_inset

\end_layout

