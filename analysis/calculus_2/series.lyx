\begin_inset Newline newline
\end_inset
נסמן:
\begin_inset Formula
\[
r:=\liminf_{n\rightarrow\infty}r_{n},\ \overline{r}=\frac{r+1}{2}
\]


\end_inset

\end_layout

\begin_layout Proof
מההנחה נובע ש-
\begin_inset Formula
$r>1$
\end_inset
 ולכן 
\begin_inset Formula
$r>\overline{r}$
\end_inset
, ומכאן שקיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך שלכל 
\begin_inset Formula
$N\leq n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
n\cdot\left(1-\frac{a_{n+1}}{a_{n}}\right)=r_{n}>\overline{r}
\]


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow1-\frac{a_{n+1}}{a_{n}}>\frac{\overline{r}}{n}\\
 & \Rightarrow\frac{a_{n+1}}{a_{n}}<1-\frac{\overline{r}}{n}\leq e^{-\frac{\overline{r}}{n}}
\end{align*}


\end_inset
יהי 
\begin_inset Formula
$N$
\end_inset
 כנ"ל ומכאן שלכל 
\begin_inset Formula
$N\leq n\in\MKnatural$
\end_inset
 מתקיים
\begin_inset Formula
\[
a_{n+1}=a_{N}\cdot\prod_{k=N}^{n}\frac{a_{k+1}}{a_{k}}<a_{N}\cdot\prod_{k=N}^{n}e^{-\frac{\overline{r}}{n}}=a_{n}\cdot e^{-\sum_{k=N}^{n}\frac{\overline{r}}{k}}=a_{n}\cdot e^{-\overline{r}\cdot\sum_{k=N}^{n}\frac{1}{k}}
\]


\end_inset
לכל 
\begin_inset Formula
$N\leq n\in\MKnatural$
\end_inset
 מתקיים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
השטח מתחת לגרף של 
\begin_inset Formula
$\frac{1}{x}$
\end_inset
 בין הנקודות 
\begin_inset Formula
$N$
\end_inset
 ו-
\begin_inset Formula
$n+1$
\end_inset
 הוא בדיוק 
\begin_inset Formula
$\ln\left(n+1\right)-\ln\left(N\right)$
\end_inset
 (נראה זאת כשנלמד את הנוסחה היסודית של החשבון האינטגרלי), ואילו הסכום 
\begin_inset Formula
$\sum_{k=N}^{n}\frac{1}{k}$
\end_inset
 מייצג את השטח מתחת לגרף של פונקציית המדרגות 
\begin_inset Formula
$\frac{1}{\left\lfloor x\right\rfloor }$
\end_inset
 בין 
\begin_inset Formula
$N$
\end_inset
 ל-
\begin_inset Formula
$n+1$
\end_inset
; מהעובדה שלכל 
\begin_inset Formula
$0<x\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\frac{1}{\left\lfloor x\right\rfloor }\geq\frac{1}{x}$
\end_inset
 נובע שהא"ש מתקיים גם בין השטחים. מבחינה פורמלית הנימוק הוא:
\begin_inset Formula
\[
\sum_{k=N}^{n}\frac{1}{k}=\intop_{N}^{n+1}\frac{1}{\left\lfloor x\right\rfloor }dx\geq\intop_{N}^{n+1}\frac{1}{x}dx=\ln\left(n+1\right)-\ln\left(N\right)
\]


\end_inset

\end_layout

\end_inset
:
\begin_inset Formula
\[
\sum_{k=N}^{n}\frac{1}{k}\geq\ln\left(n+1\right)-\ln\left(N\right)
\]


\end_inset
ולכן גם:
\begin_inset Formula
\begin{align*}
-\overline{r}\cdot\sum_{k=N}^{n}\frac{1}{k} & \leq-\overline{r}\cdot\left(\ln\left(n+1\right)-\ln\left(N\right)\right)=\overline{r}\cdot\ln\left(N\right)-\overline{r}\cdot\ln\left(n+1\right)\\
 & =\ln\left(N^{\overline{r}}\right)-\ln\left(\left(n+1\right)^{\overline{r}}\right)=\ln\left(\frac{N^{\overline{r}}}{\left(n+1\right)^{\overline{r}}}\right)
\end{align*}


\end_inset
מכאן נובע שלכל 
\begin_inset Formula
$N\leq n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
a_{n+1}\leq a_{N}\cdot e^{-\overline{r}\cdot\sum_{k=N}^{n}\frac{1}{k}}\leq a_{N}\cdot e^{\overline{r}\cdot\ln\left(N\right)-\overline{r}\cdot\ln\left(n+1\right)}=a_{N}\cdot\frac{N^{\overline{r}}}{\left(n+1\right)^{\overline{r}}}
\]


\end_inset
והרי 
\begin_inset Formula
$\overline{r}>1$
\end_inset
 ולכן ע"פ הדוגמה שלעיל (
