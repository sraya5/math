\begin_inset Formula
\[
\limsup_{n\rightarrow\infty}\sqrt[n]{a_{n}}\leq\limsup_{n\rightarrow\infty}\left(\sqrt[n]{a_{N+1}}\cdot q\right)=q\cdot\lim_{n\rightarrow\infty}\sqrt[n]{a_{N+1}}=q\cdot1=q<1
\]


\end_inset

\end_layout

