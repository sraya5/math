נובע שכל טור המתקבל ממנו ע"י שינוי סדר האיברים מתכנס לאותו סכום.
\begin_inset Formula
\[
\Rightarrow\sum_{n=1}^{\infty}w_{n}=\sum_{n=1}^{\infty}W_{n}:={\color{red}\underset{W_{1}}{\underbrace{a_{1}\cdot b_{1}}}}+{\color{blue}\underset{W_{2}}{\underbrace{a_{1}\cdot b_{2}}}+\underset{W_{3}}{\underbrace{a_{2}\cdot b_{2}}}+\underset{W_{4}}{\underbrace{a_{2}\cdot b_{1}}}}+{\color{green}\underset{W_{5}}{\underbrace{a_{1}\cdot b_{3}}}+\underset{W_{6}}{\underbrace{a_{2}\cdot b_{3}}}+\underset{W_{7}}{\underbrace{a_{3}\cdot b_{3}}}+\underset{W_{8}}{\underbrace{a_{3}\cdot b_{2}}}+\underset{W_{9}}{\underbrace{a_{3}\cdot b_{1}}}}...
\]


\end_inset
כלומר, אם נסדר את האיברים בטבלה:
\begin_inset Formula
\[
\left[\begin{array}{cccc}
{\color{red}a_{1}\cdot b_{1}} & {\color{blue}a_{1}\cdot b_{2}} & {\color{green}a_{1}\cdot b_{3}} & ...\\
{\color{blue}a_{2}\cdot b_{1}} & {\color{blue}a_{2}\cdot b_{2}} & {\color{green}a_{2}\cdot b_{3}} & ...\\
{\color{green}a_{3}\cdot b_{1}} & {\color{green}a_{3}\cdot b_{2}} & {\color{green}a_{3}\cdot b_{3}} & ...\\
\vdots & \vdots & \vdots & \ddots
\end{array}\right]
\]


\end_inset
אז סדר הסכימה יהיה כזה:
\begin_inset Formula
\[
\left[\begin{array}{cccc}
{\color{red}1} & {\color{blue}2} & {\color{green}5} & ...\\
{\color{blue}4} & {\color{blue}3} & {\color{green}6} & ...\\
{\color{green}9} & {\color{green}8} & {\color{green}7} & ...\\
\vdots & \vdots & \vdots & \ddots
\end{array}\right]
\]


\end_inset
נשים לב שלכל 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sum_{n=1}^{N^{2}}W_{n}=\left(\sum_{n=1}^{N}a_{n}\right)\left(\sum_{n=1}^{N}b_{n}\right)
\]


\end_inset
ומכאן, ע"פ אריתמטיקה של גבולות שמתקיים:
\begin_inset Formula
\[
\lim_{N\rightarrow\infty}\sum_{n=1}^{N^{2}}W_{n}=\lim_{N\rightarrow\infty}\left(\sum_{n=1}^{N}a_{n}\right)\left(\sum_{n=1}^{N}b_{n}\right)=\lim_{N\rightarrow\infty}\left(\sum_{n=1}^{N}a_{n}\right)\cdot\lim_{N\rightarrow\infty}\left(\sum_{n=1}^{N}b_{n}\right)=A\cdot B
\]


\end_inset
ממשפט הירושה נובע שמתקיים:
\begin_inset Formula
\[
\sum_{n=1}^{\infty}w_{n}=\sum_{n=1}^{\infty}W_{n}=\lim_{N\rightarrow\infty}\sum_{n=1}^{N}W_{n}=\lim_{N\rightarrow\infty}\sum_{n=1}^{N^{2}}W_{n}=A\cdot B
\]


\end_inset

\end_layout

\begin_layout Theorem
\series bold
\shape italic
משפט מרטן
\shape default
 (
\lang english
Mertens
\lang default

\lang hebrew
)
\shape italic
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
ערך בוויקיפדיה האנגלית: 
\begin_inset CommandInset href
LatexCommand href
name "Franz Mertens"
target https://en.wikipedia.org/wiki/Franz_Mertens
literal false
\end_inset
.
\end_layout

\end_inset

\shape default

\lang default

\series default

\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$\sum_{n=0}^{\infty}a_{n}$
\end_inset
 ו-
\begin_inset Formula
$\sum_{n=0}^{\infty}b_{n}$
\end_inset
 טורים המתכנסים ל-
\begin_inset Formula
$A$
\end_inset
 ול-
\begin_inset Formula
$B$
\end_inset
 בהתאמה כך שלפחות אחד מהם מתכנס בהחלט, מתקיים:
\begin_inset Formula
\[
\sum_{n=0}^{\infty}\sum_{k=0}^{n}a_{k}\cdot b_{n-k}=A\cdot B
\]


\end_inset

\end_layout

\begin_layout Proof
נניח בהג"כ ש-
\begin_inset Formula
$\sum_{n=1}^{\infty}a_{n}$
\end_inset
 מתכנס בהחלט.
\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$\left(A_{n}\right)_{n=0}^{\infty}$
\end_inset
, 
\begin_inset Formula
$\left(B_{n}\right)_{n=0}^{\infty}$
\end_inset
, 
\begin_inset Formula
$\left(D_{n}\right)_{n=0}^{\infty}$
\end_inset
 ו-
\begin_inset Formula
$\left(\beta_{n}\right)_{n=0}^{\infty}$
\end_inset
 סדרות המוגדרות כך (לכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
):
\begin_inset Formula
\begin{align*}
A_{n} & :=\sum_{k=0}^{n}a_{k}\\
B_{n} & :=\sum_{k=0}^{n}b_{k}\\
D_{n} & :=\sum_{k=0}^{n}d_{k}\\
\beta_{n} & :=B-B_{n}
\end{align*}


\end_inset
מכאן שלכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 מתקיים 
\begin_inset Formula
$B_{n}=B-\beta_{n}$
\end_inset
 ולכן לכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
D_{n} & =\sum_{k=0}^{n}d_{n}=\sum_{k=0}^{n}\left(\sum_{i=0}^{k}a_{i}\cdot b_{n-i}\right)=\left(a_{0}b_{0}\right)+\left(a_{0}b_{1}+a_{1}b_{0}\right)+...\left(a_{0}b_{n}+a_{1}b_{n-1}+...+a_{n}b_{0}\right)\\
 & =a_{0}B_{n}+a_{1}B_{n-1}+...a_{n}B_{0}=a_{0}\left(B-\beta_{n}\right)+a_{1}\left(B-\beta_{n-1}\right)+...+a_{n}\left(B-\beta_{0}\right)\\
 & =A_{n}\cdot B-\left(a_{0}\beta_{n}+a_{1}\beta_{n-1}+...+a_{n}\beta_{0}\right)
\end{align*}


\end_inset
מאריתמטיקה של גבולות נובע שמתקיים:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\left(A_{n}\cdot B\right)=A\cdot B
\]


\end_inset
ולכן עלינו להוכיח כי:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\sum_{i=0}^{n}a_{i}\beta_{n-i}=0
\]


\end_inset
יהי 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 ונסמן 
\begin_inset Formula
$m:=\left\lfloor \frac{n}{2}\right\rfloor $
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\left|\sum_{i=0}^{n}a_{i}\beta_{n-i}\right| & =\left|\sum_{i=0}^{m}a_{i}\beta_{n-i}+\sum_{i=m+1}^{n}a_{i}\beta_{n-i}\right|\leq\left|\sum_{i=0}^{m}a_{i}\beta_{n-i}\right|+\left|\sum_{i=m+1}^{n}a_{i}\beta_{n-i}\right|\\
 & \leq\sum_{i=0}^{m}\left|a_{i}\beta_{n-i}\right|+\sum_{i=m+1}^{n}\left|a_{i}\beta_{n-i}\right|=\sum_{i=0}^{m}\left(\left|a_{i}\right|\cdot\left|\beta_{n-i}\right|\right)+\sum_{i=m+1}^{n}\left(\left|a_{i}\right|\cdot\left|\beta_{n-i}\right|\right)\\
 & \leq\sup\left\{ \left|\beta_{k}\right|:n-m\leq k\in\MKnatural_{0}\right\} \cdot\sum_{i=0}^{m}\left|a_{i}\right|+\sup\left\{ \left|\beta_{k}\right|:n-m>k\in\MKnatural_{0}\right\} \cdot\sum_{i=m+1}^{n}\left|a_{i}\right|\\
 & \leq\sup\left\{ \left|\beta_{k}\right|:n-\left\lfloor \frac{n}{2}\right\rfloor \leq k\in\MKnatural_{0}\right\} \cdot\sum_{i=0}^{\infty}\left|a_{i}\right|+\sup\left\{ \left|\beta_{k}\right|:n-\left\lfloor \frac{n}{2}\right\rfloor >k\in\MKnatural_{0}\right\} \cdot\sum_{i=\left\lfloor \frac{n}{2}\right\rfloor +1}^{\infty}\left|a_{i}\right|
\end{align*}


\end_inset
כעת נשים לב לעובדות הבאות:
\end_layout

\begin_deeper
\begin_layout Enumerate
הטור 
\begin_inset Formula
$\sum_{i=0}^{\infty}\left|a_{i}\right|$
\end_inset
 מתכנס.
\end_layout

\begin_layout Enumerate
מכאן שע"פ מסקנה 
\begin_inset CommandInset ref
LatexCommand ref
reference "corollary 1.7"
plural false
caps false
noprefix false
\end_inset
 מתקיים:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\sum_{i=\left\lfloor \frac{n}{2}\right\rfloor +1}^{\infty}\left|a_{i}\right|=0
\]


\end_inset

\end_layout

\begin_layout Enumerate
\begin_inset Formula
$\lim_{n\rightarrow\infty}\sup\left\{ \left|\beta_{k}\right|:n-\left\lfloor \frac{n}{2}\right\rfloor \leq k\in\MKnatural_{0}\right\} =\lim_{n\rightarrow\infty}\beta_{n}=0$
\end_inset
.
\end_layout

\begin_layout Enumerate
הגבול 
\begin_inset Formula
$\lim_{n\rightarrow\infty}\sup\left\{ \left|\beta_{k}\right|:n-\left\lfloor \frac{n}{2}\right\rfloor >k\in\MKnatural_{0}\right\} $
\end_inset
 קיים במובן הצר (כלומר הוא מספר ממשי) שכן הסדרה 
\begin_inset Formula
$\left(\beta_{n}\right)_{n=0}^{\infty}$
\end_inset
 מתכנסת וממילא חסומה.
\end_layout

\end_deeper

\begin_layout Proof
לפיכך:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\left(\sup\left\{ \left|\beta_{k}\right|:n-m\leq k\right\} \cdot\sum_{i=0}^{\infty}\left|a_{i}\right|+\sup\left\{ \left|\beta_{k}\right|:n-m>k\geq0\right\} \cdot\sum_{i=\left\lfloor \frac{n}{2}\right\rfloor +1}^{\infty}\left|a_{i}\right|\right)=0
\]


\end_inset
וממילא:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\sum_{i=0}^{n}a_{i}\beta_{n-i}=0
\]


\end_inset

\end_layout

