\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$\left(b_{n}\right)_{n=0}^{\infty}$
\end_inset
 סדרה המוגדרת ע"י 
\begin_inset Formula
$b_{n}:=n\cdot a_{n+1}$
\end_inset
 לכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 (א"כ 
\begin_inset Formula
$b_{n}\geq0$
\end_inset
 לכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
) ו-
\begin_inset Formula
$\left(c_{n}\right)_{n=1}^{\infty}$
\end_inset
 סדרה המוגדרת ע"י 
\begin_inset Formula
$c_{n}:=b_{n-1}-b_{n}$
\end_inset
 לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
.
\begin_inset Newline newline
\end_inset
א"כ לכל 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sum_{n=1}^{N}c_{n}=\sum_{n=1}^{N}\left(b_{n-1}-b_{n}\right)=b_{0}-b_{N}=0-b_{N}=-b_{N}
\]


\end_inset
כלומר הטור 
\begin_inset Formula
$\sum_{n=1}^{\infty}c_{n}$
\end_inset
 והסדרה 
\begin_inset Formula
$\left(b_{n}\right)_{n=1}^{\infty}$
\end_inset
 מתכנסים ומתבדרים ביחד.
\begin_inset Newline newline
\end_inset
כעת נשים לב לכך שלכל 
\begin_inset Formula
$n\in\MKnatural_{0}$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
c_{n+1}=b_{n}-b_{n+1} & =n\cdot a_{n+1}-\left(n+1\right)\cdot a_{n+2}=\left(n+1\right)\cdot a_{n+1}-\left(n+1\right)\cdot a_{n+2}-a_{n+1}\\
 & =\left(n+1\right)\cdot\left(a_{n+1}-a_{n+2}\right)-a_{n+1}=a_{n+1}\cdot\left(\left(n+1\right)\cdot\left(\frac{a_{n+1}}{a_{n+1}}-\frac{a_{n+2}}{a_{n+1}}\right)-\frac{a_{n+1}}{a_{n+1}}\right)\\
 & =a_{n+1}\cdot\left(\left(n+1\right)\cdot\left(1-\frac{a_{n+2}}{a_{n+1}}\right)-1\right)
\end{align*}


\end_inset
ומכאן שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\frac{c_{n}}{a_{n}}=n\cdot\left(1-\frac{a_{n+1}}{a_{n}}\right)-1=r_{n}-1
\]


\end_inset
אם מתקיים 
\begin_inset Formula
$r_{n}>1$
\end_inset
 ממקום מסוים ואילך אז מתקיים 
\begin_inset Formula
$c_{n}=b_{n}-b_{n+1}>0$
\end_inset
 ממקום מסוים ואילך, כלומר עבור 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 גדול דיו הטור 
\begin_inset Formula
$\sum_{n=N}^{\infty}c_{n}$
\end_inset
 הוא טור חיובי והסדרה 
\begin_inset Formula
$\left(b_{n}\right)_{n=N}^{\infty}$
\end_inset
 היא סדרה מונוטונית יורדת וחסומה מלרע ולכן מתכנסת. מכאן שגם 
\begin_inset Formula
$\sum_{n=1}^{\infty}c_{n}$
\end_inset
 ו-
\begin_inset Formula
$\left(b_{n}\right)_{n=1}^{\infty}$
\end_inset
 מתכנסים ומתקיים:
\begin_inset Formula
\[
\sum_{n=1}^{\infty}c_{n}=\lim_{N\rightarrow\infty}\sum_{n=1}^{N}c_{n}=-\lim_{N\rightarrow\infty}b_{N}
\]


\end_inset
מצד שני אם 
\begin_inset Formula
$r>1$
\end_inset
 אז מתקיים:
\begin_inset Formula
\[
\frac{c_{n}}{a_{n}}=n\cdot\left(1-\frac{a_{n+1}}{a_{n}}\right)-1>1
\]


\end_inset
ממקום מסוים ואילך ולכן ממבחן ההשוואה נובע שהתכנסות הטור 
\begin_inset Formula
$\sum_{n=1}^{\infty}c_{n}$
\end_inset
 גוררת את התכנסות הטור 
\begin_inset Formula
$\sum_{n=1}^{\infty}a_{n}$
\end_inset
.
