\end_layout

\begin_layout Example
ראינו בקורס הקודם (כשעסקנו בפולינומי טיילור) שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים (עבור 
\begin_inset Formula
$\xi$
\end_inset
 בין 
\begin_inset Formula
$0$
\end_inset
 ל-
\begin_inset Formula
$x$
\end_inset
):
\begin_inset Formula
\begin{align*}
P_{n,\exp,0}\left(x\right) & =\sum_{k=0}^{n}\frac{x^{n}}{k!}\\
R_{n,\exp,0}\left(x\right) & =\frac{\exp\left(\xi\right)\cdot x^{n+1}}{\left(n+1\right)!}
\end{align*}


\end_inset
מהשוואה לסדרה הנדסית מתכנסת
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
קיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$\frac{x}{n+1}<\frac{1}{2}$
\end_inset
 לכל 
\begin_inset Formula
$N<n\in\MKnatural$
\end_inset
.
\end_layout

\end_inset
 ניתן להסיק כי לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\lim_{n\rightarrow\infty}\frac{\exp\left(\xi\right)\cdot x^{n+1}}{\left(n+1\right)!}=0
\]


\end_inset
ומכאן שגם:
\begin_inset Formula
\[
\Rightarrow\exp\left(x\right)=\lim_{n\rightarrow\infty}\left(P_{n,\exp,0}\left(x\right)+R_{n,\exp,0}\left(x\right)\right)=\lim_{n\rightarrow\infty}P_{n,\exp,0}\left(x\right)=\sum_{k=0}^{\infty}\frac{x^{k}}{k!}
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow\sum_{k=0}^{\infty}\left|\frac{x^{k}}{k!}\right|=\exp\left(\left|x\right|\right)
\]


\end_inset
ממשפט מרטן נובע שלכל 
\begin_inset Formula
$x,y\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\exp\left(x\right)\cdot\exp\left(y\right) & =\left(\sum_{n=0}^{\infty}\frac{x^{n}}{n!}\right)\left(\sum_{n=0}^{\infty}\frac{y^{n}}{n!}\right)=\sum_{n=0}^{\infty}\left(\sum_{k=0}^{n}\frac{x^{k}\cdot y^{n-k}}{k!\cdot\left(n-k\right)!}\right)\\
 & =\sum_{n=0}^{\infty}{\color{red}\frac{1}{n!}}\left(\sum_{k=0}^{n}\frac{{\color{red}n!}\cdot{\color{blue}x^{k}\cdot y^{n-k}}}{k!\cdot\left(n-k\right)!}\right)=\sum_{n=0}^{\infty}\frac{1}{n!}\left(\sum_{k=0}^{n}{\color{green}\frac{n!}{k!\cdot\left(n-k\right)!}}\cdot{\color{blue}x^{k}\cdot y^{n-k}}\right)\\
 & =\sum_{n=0}^{\infty}\frac{1}{n!}\left(\sum_{k=0}^{n}{\color{green}\begin{pmatrix}n\\
k
\end{pmatrix}}\cdot x^{k}\cdot y^{n-k}\right)=\sum_{n=0}^{\infty}\frac{\left(x+y\right)^{n}}{n!}=\exp\left(x+y\right)
\end{align*}


\end_inset

\end_layout

