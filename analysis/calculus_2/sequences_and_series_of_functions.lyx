\end_layout

\end_inset
:
\begin_inset Formula
\begin{align*}
\varepsilon & \leq\lim_{j\rightarrow\infty}\left|f_{n}\left(x_{k_{j}}\right)-f\left(x_{k_{j}}\right)\right|\\
 & =\left|\lim_{j\rightarrow\infty}f_{n}\left(x_{k_{j}}\right)-\lim_{j\rightarrow\infty}f\left(x_{k_{j}}\right)\right|\\
 & =\left|f_{n}\left(x_{0}\right)-f\left(x_{0}\right)\right|
