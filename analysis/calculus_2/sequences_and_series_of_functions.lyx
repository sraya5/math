\begin_layout Theorem
כל טור חזקות מתכנס בהחלט במ"ש על כל תת-קטע סגור של קטע ההתכנסות, אם הטור מתכנס נקודתית בהחלט בקצה הקטע
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
התכנסות בהחלט בקצה אחד שקולה להתכנסות בהחלט בקצה האחר ולכן אין כל הבדל ביניהם, בנוסף, נשים לב שאם קטע ההתכנסות הוא כל הישר אז אין לקטע ההתכנסות קצה ולכן תנאי זה אינו מתקיים מהגדרה.
\end_layout

\end_inset
 אז הוא מתכנס במ"ש על הקטע הסגור המתאים לקטע ההתכנסות (שהוא קטע פתוח מהגדרה).
\end_layout

\begin_layout Proof
נסמן ב-
\begin_inset Formula
$R$
\end_inset
 את רדיוס ההתכנסות (אם רדיוס ההתכנסות הוא 
\begin_inset Formula
$\infty$
\end_inset
 אז 
\begin_inset Formula
$R$
\end_inset
 הוא מספר חיובי שרירותי), יהי 
\begin_inset Formula
$r\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$0\leq r\leq R$
\end_inset
 ובנוסף הטור מתכנס נקודתית ב-
\begin_inset Formula
$x_{0}+r$
\end_inset
.
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$x\in\left[x_{0}-r,x_{0}+r\right]$
\end_inset
 ולכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|a_{n}\cdot\left(x-x_{0}\right)^{n}\right|=\left|a_{n}\right|\cdot\left|x-x_{0}\right|^{n}\leq\left|a_{n}\right|\cdot r^{n}=\left|a_{n}\right|\cdot\left|\left(x_{0}+r\right)-x_{0}\right|^{n}=\left|a_{n}\cdot\left(\left(x_{0}+r\right)-x_{0}\right)^{n}\right|
\]


\end_inset
ומכיוון שע"פ ההנחה הטור 
\begin_inset Formula
$\begin{alignedat}{1}\sum_{n=0}^{\infty}a_{n}\cdot\left|\left(x_{0}+r\right)-x_{0}\right|^{n}\end{alignedat}
$

\end_inset
מתכנס נובע ממשפט ויירשטראס שטור החזקות 
\begin_inset Formula
$\begin{alignedat}{1}\sum_{n=0}^{\infty}a_{n}\cdot\left(x-x_{0}\right)^{n}\end{alignedat}
$

\end_inset
 מתכנס בהחלט במ"ש על 
\begin_inset Formula
