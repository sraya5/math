\begin_inset Formula
\[
\varepsilon\leq\left|f_{n_{k_{j}}}\left(x_{k_{j}}\right)-f\left(x_{k_{j}}\right)\right|\leq\left|f_{n}\left(x_{k_{j}}\right)-f\left(x_{k_{j}}\right)\right|
\]


\end_inset
אבל 
\begin_inset Formula
$f$
\end_inset
