\begin_layout Theorem
\begin_inset CommandInset label
LatexCommand label
name "theorem 1.10"
\end_inset
תהא 
\begin_inset Formula
$\left(f_{n}\right)_{n=1}^{\infty}$
\end_inset
 סדרת פונקציות אינטגרביליות רימן על קטע סגור 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
 המתכנסת במ"ש על קטע זה לפונקציה 
\begin_inset Formula
$f$
\end_inset
, 
\begin_inset Formula
$f$
\end_inset
 אינטגרבילית רימן על 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
 ולא זו אף זו, מתקיים:
\begin_inset Formula
\[
\intop_{a}^{x}f_{n}\left(t\right)dt\xrightarrow[n\rightarrow\infty]{\text{במידה שווה}}\intop_{a}^{x}f\left(t\right)dt
\]


\end_inset
כלומר סדרת הצוברות של 
\begin_inset Formula
$\left(f_{n}\right)_{n=1}^{\infty}$
\end_inset
 מתכנסת במ"ש על הקטע 
\begin_inset Formula
$\left[a,b\right]$
\end_inset
 לצוברת של 
\begin_inset Formula
$f$
\end_inset
, וכמו כן מתקיים גם:
\begin_inset Formula
\[
\intop_{x}^{b}f_{n}\left(t\right)dt\xrightarrow[n\rightarrow\infty]{\text{במידה שווה}}\intop_{x}^{b}f\left(t\right)dt
\]


\end_inset

\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהתכנסות 
\begin_inset Formula
$\left(f_{n}\right)_{n=1}^{\infty}$
\end_inset
 במ"ש נובע שקיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך שלכל 
\begin_inset Formula
$x\in\left[a,b\right]$
\end_inset
 יתקיים 
\begin_inset Formula
$\varepsilon':=\frac{\varepsilon}{1+2\left(b-a\right)}>\left|f_{N}\left(x\right)-f\left(x\right)\right|$
\end_inset
, מכאן שלכל 
\begin_inset Formula
$x,y\in\left[a,b\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\left|f\left(x\right)-f\left(y\right)\right| & =\left|f\left(x\right)-f_{N}\left(x\right)+f_{N}\left(x\right)-f_{N}\left(y\right)+f_{N}\left(y\right)-f\left(y\right)\right|\\
 & \leq\left|f\left(x\right)-f_{N}\left(x\right)\right|+\left|f_{N}\left(x\right)-f_{N}\left(y\right)\right|+\left|f_{N}\left(y\right)-f\left(y\right)\right|\\
 & =2\varepsilon'+\left|f_{N}\left(x\right)-f_{N}\left(y\right)\right|
\end{align*}


\end_inset
ולכן גם לכל תת-קטע סגור 
\begin_inset Formula
$\left[\alpha,\beta\right]\subseteq\left[a,b\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sup\left\{ \left|f\left(x\right)-f\left(y\right)\right|:x,y\in\left[\alpha,\beta\right]\right\} \leq\sup\left\{ \left|f_{N}\left(x\right)-f_{N}\left(y\right)\right|:x,y\in\left[\alpha,\beta\right]\right\} +2\varepsilon'
\]


\end_inset
כלומר התנודות של 
\begin_inset Formula
$f$
\end_inset
 קטנות קרובות לאלו של 
\begin_inset Formula
$f_{N}$
\end_inset
 עד כדי 
\begin_inset Formula
$2\varepsilon'$
\end_inset
.
\begin_inset Newline newline
\end_inset
כעת נזכר ש-
\begin_inset Formula
$f_{N}\in R\left[a,b\right]$
\end_inset
 ולכן מתנאי רימן לאינטגרביליות נובע שקיימת 
\begin_inset Formula
$0<\delta\in\MKreal$
\end_inset
 כך שלכל חלוקה 
\begin_inset Formula
$P:=\left\{ x_{0},x_{1},\ldots,x_{n}\right\} $
\end_inset
 המקיימת 
\begin_inset Formula
$\lambda\left(P\right)<\delta$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\sum_{i=1}^{n}W_{i}\left(f_{N},P\right)\cdot\left(x_{i}-x_{i-1}\right)<\varepsilon'
\]


\end_inset
תהא 
\begin_inset Formula
$\delta$
\end_inset
 כנ"ל ומכאן שלכל חלוקה 
\begin_inset Formula
$P$
\end_inset
 כנ"ל המקיימת 
\begin_inset Formula
$\lambda\left(P\right)<\delta$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\sum_{i=1}^{n}W_{i}\left(f,P\right)\cdot\left(x_{i}-x_{i-1}\right) & \leq\sum_{i=1}^{n}\left(W_{i}\left(f_{N},P\right)+2\varepsilon'\right)\cdot\left(x_{i}-x_{i-1}\right)\\
 & =\sum_{i=1}^{n}W_{i}\left(f_{N},P\right)\cdot\left(x_{i}-x_{i-1}\right)+2\varepsilon'\cdot\sum_{i=1}^{n}\left(x_{i}-x_{i-1}\right)\\
 & <\varepsilon'+2\varepsilon'\cdot\left(b-a\right)=\varepsilon'\cdot\left(1+2\left(b-a\right)\right)\\
 & =\frac{\varepsilon}{1+2\left(b-a\right)}\cdot\left(1+2\left(b-a\right)\right)=\varepsilon
\end{align*}


\end_inset

\end_layout

\begin_layout Proof
\begin_inset Formula
$\varepsilon$
\end_inset
 הנ"ל היה שרירותי ולכן הנ"ל נכון לכל 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
 ומתנאי רימן לאינטגרביליות נובע ש-
\begin_inset Formula
$f\in\left[a,b\right]$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהתכנסות במ"ש של 
\begin_inset Formula
$\left(f_{n}\right)_{n=1}^{\infty}$
\end_inset
 נובע שקיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך שלכל 
\begin_inset Formula
$N<n\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$t\in\left[a,b\right]$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|f_{n}\left(t\right)-f\left(t\right)\right|<\frac{\varepsilon}{b-a}$
\end_inset
, יהי 
\begin_inset Formula
$N$
\end_inset
 כנ"ל.
\begin_inset Newline newline
\end_inset
מכאן שלכל 
\begin_inset Formula
$N<n\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$x\in\left[a,b\right]$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\left|\intop_{a}^{x}f_{n}\left(t\right)dt-\intop_{a}^{x}f\left(t\right)dt\right| & =\left|\intop_{a}^{x}f_{n}\left(t\right)-f\left(t\right)dt\right|\leq\intop_{a}^{x}\left|f_{n}\left(t\right)-f\left(t\right)\right|dt\\
 & <\intop_{a}^{x}\frac{\varepsilon}{b-a}dt=\left(x-a\right)\cdot\frac{\varepsilon}{b-a}\leq\varepsilon\\
\left|\intop_{x}^{b}f_{n}\left(t\right)dt-\intop_{x}^{b}f\left(t\right)dt\right| & =\left|\intop_{x}^{b}f_{n}\left(t\right)-f\left(t\right)dt\right|\leq\intop_{x}^{b}\left|f_{n}\left(t\right)-f\left(t\right)\right|dt\\
 & <\intop_{x}^{b}\frac{\varepsilon}{b-a}dt=\left(b-x\right)\cdot\frac{\varepsilon}{b-a}\leq\varepsilon
\end{align*}


\end_inset
ושוב, 
\begin_inset Formula
$\varepsilon$
\end_inset
 הנ"ל היה שרירותי ולכן הנ"ל נכון לכל 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
 ומהגדרה נובע שסדרת הצוברות של 
\begin_inset Formula
$\left(f_{n}\right)_{n=1}^{\infty}$
\end_inset
 מתכנסת במ"ש לצוברת של 
\begin_inset Formula
$f$
\end_inset
 כנדרש
