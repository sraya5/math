\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נשים לב: המשפט אינו נכון אם היינו משתמשים בא"ש חלש במקום החזק המופיע בו משום שייתכן שהטור מתכנס ב-
\begin_inset Formula
$\alpha$
\end_inset
 אך אינו מתכנס ב-
\begin_inset Formula
$2x_{0}-\alpha=x_{0}-\left(\alpha-x_{0}\right)$
\end_inset
 והרי מתקיים 
\begin_inset Formula
$\left|2x_{0}-\alpha-x_{0}\right|=\left|x_{0}-\alpha\right|$
\end_inset
.
\end_layout

\begin_layout Proof
הטור 
\begin_inset Formula
$\sum_{n=0}^{\infty}a_{n}\cdot\left(\alpha-x_{0}\right)^{n}$
\end_inset
 מתכנס ולכן 
\begin_inset Formula
$a_{n}\cdot\left(\alpha-x_{0}\right)^{n}\xrightarrow[n\rightarrow\infty]{}0$
\end_inset
 בפרט קיים 
\begin_inset Formula
$M\in\MKreal$
\end_inset
 כך שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|a_{n}\cdot\left(\alpha-x_{0}\right)^{n}\right|\leq M$
\end_inset
, א"כ לכל נקודה 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 המקיימת 
\begin_inset Formula
$\left|x-x_{0}\right|<\left|\alpha-x_{0}\right|$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\sum_{n=0}^{\infty}\left|a_{n}\cdot\left(x-x_{0}\right)^{n}\right| & =\sum_{n=0}^{\infty}\left|a_{n}\right|\cdot\left|x-x_{0}\right|^{n}\\
 & =\sum_{n=0}^{\infty}\left|a_{n}\right|\cdot\left|x-x_{0}\right|^{n}\cdot\frac{\left|\alpha-x_{0}\right|^{n}}{\left|\alpha-x_{0}\right|^{n}}\\
 & =\sum_{n=0}^{\infty}\left|a_{n}\right|\cdot\left|\alpha-x_{0}\right|^{n}\cdot\frac{\left|x-x_{0}\right|^{n}}{\left|\alpha-x_{0}\right|^{n}}\\
 & =\sum_{n=0}^{\infty}\left|a_{n}\cdot\left(\alpha-x_{0}\right)^{n}\right|\cdot\left|\frac{x-x_{0}}{\alpha-x_{0}}\right|^{n}\\
 & \leq\sum_{n=0}^{\infty}M\cdot\left|\frac{x-x_{0}}{\alpha-x_{0}}\right|^{n}
\end{align*}


\end_inset
והרי 
\begin_inset Formula
$\left|\frac{x-x_{0}}{\alpha-x_{0}}\right|<1$
\end_inset
 ולכן 
\begin_inset Formula
$\sum_{n=0}^{\infty}M\cdot\left|\frac{x-x_{0}}{\alpha-x_{0}}\right|^{n}$
\end_inset
 הוא טור גאומטרי מתכנס וממבחן ההשוואה לטורים חיוביים נובע שהטור 
\begin_inset Formula
$\sum_{n=0}^{\infty}\left|a_{n}\cdot\left(x-x_{0}\right)^{n}\right|$
\end_inset
 אכן מתכנס וממילא הטור 
\begin_inset Formula
$\sum_{n=0}^{\infty}a_{n}\cdot\left(x-x_{0}\right)^{n}$
\end_inset
 מתכנס ואפילו מתכנס בהחלט.
\end_layout

