\begin_layout Lemma
\begin_inset CommandInset label
LatexCommand label
name "lemma 2.7"
\end_inset
יהי 
\begin_inset Formula
$m\in\MKnatural$
\end_inset
 ויהיו 
\begin_inset Formula
$\alpha_{1},\alpha_{2},\ldots,\alpha_{m},\beta_{1},\beta_{2},\ldots,\beta_{m}\in\MKreal$
\end_inset
 כך שלכל 
\begin_inset Formula
$m-1\geq i\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$\alpha_{i}\geq\alpha_{i+1}\geq0$
\end_inset
. אם קיים 
\begin_inset Formula
$M\in\MKreal$
\end_inset
 כך שלכל 
\begin_inset Formula
$m\geq k\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|\sum_{i=1}^{k}\beta_{i}\right|<M
\]


\end_inset
אז מתקיים:
\begin_inset Formula
\[
\left|\sum_{i=1}^{m}\alpha_{i}\cdot\beta_{i}\right|<M\cdot\left(\alpha_{1}+\alpha_{m}\right)
\]


\end_inset

\end_layout

\begin_layout Proof
נסמן 
\begin_inset Formula
$B_{k}:=\sum_{i=1}^{k}\beta_{i}$
\end_inset
 לכל 
\begin_inset Formula
$m\geq k\in\MKnatural_{0}$
\end_inset
, א"כ מתקיים:
\begin_inset Formula
\begin{align*}
\sum_{i=1}^{m}\alpha_{i}\cdot\beta_{i} & =\sum_{i=1}^{m}\alpha_{i}\cdot\left(B_{i}-B_{i-1}\right)=\sum_{i=1}^{m}\left(\alpha_{i}\cdot B_{i}\right)-\sum_{i=1}^{m}\left(\alpha_{i}\cdot B_{i-1}\right)\\
 & =\sum_{i=1}^{m}\left(\alpha_{i}\cdot B_{i}\right)-\sum_{i=0}^{m-1}\left(\alpha_{i+1}\cdot B_{i}\right)\\
 & =\alpha_{m}\cdot B_{m}-\alpha_{1}\cdot B_{0}+\sum_{i=1}^{m-1}\left(B_{i}\cdot\left(\alpha_{i}-\alpha_{i+1}\right)\right)\\
 & =\alpha_{m}\cdot B_{m}-\alpha_{1}\cdot0+\sum_{i=1}^{m-1}\left(B_{i}\cdot\left(\alpha_{i}-\alpha_{i+1}\right)\right)
\end{align*}


\end_inset
מהעובדה ש-
\begin_inset Formula
$\alpha_{i}\geq\alpha_{i+1}\geq0$
\end_inset
 לכל 
\begin_inset Formula
$m-1\geq i\in\MKnatural$
\end_inset
 נובע שמתקיים גם 
\begin_inset Formula
$\alpha_{i}-\alpha_{i+1}=\left|\alpha_{i}-\alpha_{i+1}\right|$
\end_inset
 לכל 
\begin_inset Formula
$m-1\geq i\in\MKnatural$
\end_inset
,
\begin_inset Formula
\begin{align*}
\left|\sum_{i=1}^{m}\alpha_{i}\cdot\beta_{i}\right| & =\left|\alpha_{m}\cdot B_{m}-\alpha_{1}\cdot0+\sum_{i=1}^{m-1}\left(B_{i}\cdot\left(\alpha_{i}-\alpha_{i+1}\right)\right)\right|\\
 & \leq\left|\alpha_{m}\cdot B_{m}\right|+\sum_{i=1}^{m-1}\left|B_{i}\cdot\left(\alpha_{i}-\alpha_{i+1}\right)\right|\\
 & =\left|\alpha_{m}\right|\cdot\left|B_{m}\right|+\sum_{i=1}^{m-1}\left|B_{i}\right|\cdot\left|\alpha_{i}-\alpha_{i+1}\right|\\
 & <\alpha_{m}\cdot M+\sum_{i=1}^{m-1}M\cdot\left(\alpha_{i}-\alpha_{i+1}\right)\\
 & =\alpha_{m}\cdot M+M\cdot\left(\alpha_{1}-\alpha_{m}\right)=M\cdot\alpha_{1}\leq M\cdot\left(\alpha_{1}+\alpha_{m}\right)
\end{align*}


\end_inset

\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Theorem
אם הטור 
\begin_inset Formula
$\sum_{n=0}^{\infty}a_{n}\cdot\left(x-x_{0}\right)^{n}$
\end_inset
 מתכנס נקודתית ב-
\begin_inset Formula
$x_{0}+R$
\end_inset
 (כאשר 
\begin_inset Formula
$R$
\end_inset
 הוא רדיוס ההתכנסות של הטור ו-
\begin_inset Formula
$0<R\in\MKreal$
\end_inset
) אז הוא מתכנס במ"ש ב-
\begin_inset Formula
$\left[x_{0},x_{0}+R\right]$
\end_inset
, כמו כן, אם הטור מתכנס נקודתית ב-
\begin_inset Formula
$x_{0}-R$
\end_inset
 אז הוא מתכנס במ"ש ב-
\begin_inset Formula
$\left[x_{0}-R,x_{0}\right]$
\end_inset
. בנוסף, אם הטור מתבדר ב-
\begin_inset Formula
$x_{0}+R$
\end_inset
 ו/או ב-
\begin_inset Formula
$x_{0}-R$
\end_inset
 אז הוא איננו מתכנס במ"ש בקטע ההתכנסות.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כמסקנה משני המשפטים האחרונים, אם הטור מתכנס נקודתית ב-
\begin_inset Formula
$x_{0}+R$
\end_inset
 אז הוא מתכנס במ"ש בכל קטע מהצורה 
\begin_inset Formula
$\left[x_{0}-r,x_{0}+R\right]$
\end_inset
 עבור 
\begin_inset Formula
$0<r\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$r<R$
\end_inset
, ואם הוא מתכנס נקודתית ב-
\begin_inset Formula
$x_{0}-R$
\end_inset
 אז הוא מתכנס במ"ש בכל קטע מהצורה 
\begin_inset Formula
$\left[x_{0}-R,x_{0}+r\right]$
\end_inset
 (שוב עבור 
\begin_inset Formula
$0<r\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$r<R$
\end_inset
).
\end_layout

\begin_layout Proof
נניח שהטור הנ"ל מתכנס ב-
\begin_inset Formula
$x_{0}+R$
\end_inset
 (ההוכחה עבור 
\begin_inset Formula
$x_{0}-R$
\end_inset
 דומה מאד).
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
, מתנאי קושי להתכנסות טורים נובע שקיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך שלכל 
\begin_inset Formula
$N<n,m\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$n<m$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|\sum_{i=n+1}^{m}a_{i}\cdot R^{i}\right|=\left|\sum_{i=n+1}^{m}a_{i}\cdot\left(\left(x_{0}+R\right)-x_{0}\right)^{i}\right|<\frac{\varepsilon}{2}
\]


\end_inset
יהי 
\begin_inset Formula
$N$
\end_inset
 כנ"ל ויהיו 
\begin_inset Formula
$N<n,m\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$n<m$
\end_inset
. לכל 
\begin_inset Formula
$x\in\left[x_{0},x_{0}+R\right]$
\end_inset
 מתקיים 
\begin_inset Formula
$0\leq\frac{x-x_{0}}{R}\leq1$
\end_inset
 ולכן מהלמה (
\begin_inset CommandInset ref
LatexCommand ref
reference "lemma 2.7"
plural false
caps false
noprefix false
\end_inset
) נובע שגם:
\begin_inset Formula
\[
\left|\sum_{i=n+1}^{m}a_{i}\cdot\left(x-x_{0}\right)^{i}\right|=\left|\sum_{i=n+1}^{m}a_{i}\cdot R^{i}\cdot\left(\frac{x-x_{0}}{R}\right)^{i}\right|<\frac{\varepsilon}{2}\cdot\left(\left(\frac{x-x_{0}}{R}\right)^{n+1}+\left(\frac{x-x_{0}}{R}\right)^{n+m}\right)\leq\frac{\varepsilon}{2}\cdot2=\varepsilon
\]


\end_inset
שכן לכל 
\begin_inset Formula
$i\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$n+1\leq i\leq m-1$
\end_inset
 מתקיים 
\begin_inset Formula
$\left(\frac{x-x_{0}}{R}\right)^{i}\geq\left(\frac{x-x_{0}}{R}\right)^{i+1}$
\end_inset
.
\begin_inset Newline newline
\end_inset

\begin_inset Formula
$n$
\end_inset
 ו-
\begin_inset Formula
$m$
\end_inset
 הנ"ל היו שרירותיים וכמותם גם 
\begin_inset Formula
$\varepsilon$
\end_inset
 ולכן מתנאי קושי להתכנסות במ"ש נובע שהטור מתכנס במ"ש ב-
\begin_inset Formula
$\left[x_{0},x_{0}+R\right]$
\end_inset
.
\begin_inset Newline newline
\end_inset
נניח שהטור מתבדר ב-
\begin_inset Formula
$x_{0}+R$
\end_inset
 ו/או ב-
\begin_inset Formula
$x_{0}+R$
\end_inset
 ונניח בשלילה שהוא מתכנס במ"ש ב-
\begin_inset Formula
$\left(x_{0}-R,x_{0}+R\right)$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
, א"כ מתנאי קושי להתכנסות טורים נובע שקיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך שלכל 
\begin_inset Formula
$x\in\left(x_{0}-R,x_{0}+R\right)$
\end_inset
 ולכל 
\begin_inset Formula
$N<n,m\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$n<m$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|\sum_{i=n+1}^{m}a_{i}\cdot\left(x-x_{0}\right)^{i}\right|<\frac{\varepsilon}{2}
\]


\end_inset
יהי 
\begin_inset Formula
$N$
\end_inset
 כנ"ל ויהיו 
\begin_inset Formula
$N<n,m\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$n<m$
\end_inset
, מרציפות של פולינומים נובע שמתקיים:
\begin_inset Formula
\[
\left|\sum_{i=n+1}^{m}a_{i}\cdot\left(\left(x_{0}\pm R\right)-x_{0}\right)^{i}\right|=\lim_{x\rightarrow\left(x_{0}\pm R\right)^{\mp}}\left|\sum_{i=n+1}^{m}a_{i}\cdot\left(x-x_{0}\right)^{i}\right|\leq\frac{\varepsilon}{2}<\varepsilon
\]


\end_inset
ולכן מתנאי קושי להתכנסות טורים נובע שהטורים 
\begin_inset Formula
$\sum_{n=0}^{\infty}a_{n}\cdot\left(\left(x_{0}\pm R\right)-x_{0}\right)^{n}$
\end_inset
 מתכנסים בסתירה להנחה, מכאן שהנחת השלילה אינה נכונה והטור אינו מתכנס במ"ש ב-
\begin_inset Formula
$\left(x_{0}-R,x_{0}+R\right)$
\end_inset
.
