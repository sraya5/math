f_{n}\left(x\right)=\left(f_{n}\left(x\right)-f_{n}\left(x_{0}\right)\right)+f_{n}\left(x_{0}\right)=\intop_{x_{0}}^{x}f_{n}'\left(t\right)dt+f_{n}\left(x_{0}\right)
\]


