\begin_layout Definition
נגדיר את הפונקציות 
\begin_inset Formula
$\sinh:\MKreal\rightarrow\MKreal$
\end_inset
 (
\bar under
סינוס היפרבולי
\bar default
) ו-
\begin_inset Formula
$\cosh:\MKreal\rightarrow\MKreal$
\end_inset
 (
\bar under
קוסינוס היפרבולי
\bar default
) ע"י (לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
):
\begin_inset Formula
\begin{align*}
\sinh\left(x\right) & :=\frac{e^{x}-e^{-x}}{2}\\
\cosh\left(x\right) & :=\frac{e^{x}+e^{-x}}{2}
\end{align*}


\end_inset

\end_layout

\begin_layout Corollary
\begin_inset Formula
$\sinh$
\end_inset
 היא פונקציה אי-זוגית ו-
\begin_inset Formula
$\cosh$
\end_inset
 היא פונקציה זוגית.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הקשר לפונקציות הטריגונומטריות עמוק יותר משמירה על האי-זוגיות של 
\begin_inset Formula
$\sin$
\end_inset
 ועל הזוגיות של 
\begin_inset Formula
$\cos$
\end_inset
, בהמשך הקורס נראה שלכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
אלה פשוט הגבולות של סדרת פולינומי טיילור של הפונקציות כשהם מפותחים סביב 
\begin_inset Formula
$0$
\end_inset
.
\end_layout

\end_inset
:
\begin_inset Formula
\begin{align*}
\exp\left(x\right) & =\sum_{n=0}^{\infty}\frac{x^{n}}{n!}\\
\sin\left(x\right) & =\sum_{n=0}^{\infty}\left(-1\right)^{n}\cdot\frac{x^{2n+1}}{\left(2n+1\right)!}\\
\cos\left(x\right) & =\sum_{n=0}^{\infty}\left(-1\right)^{n}\cdot\frac{x^{2n}}{\left(2n\right)!}
\end{align*}


\end_inset
נוסחאות אלו הן שהביאה את אוילר להגדיר את שלוש הפונקציות הללו עבור מספרים מדומים בצורה הבאה
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
הגדרת הגבול של סדרה במרוכבים עובדת באותה צורה רק עם הערך המוחלט של המרוכבים.
\end_layout

\end_inset
:
\begin_inset Formula
\begin{align*}
\exp\left(ix\right) & =\sum_{n=0}^{\infty}\frac{\left(ix\right)^{n}}{n!}\\
\sin\left(ix\right) & =\sum_{n=0}^{\infty}\left(-1\right)^{n}\cdot\frac{\left(ix\right)^{2n+1}}{\left(2n+1\right)!}\\
\cos\left(ix\right) & =\sum_{n=0}^{\infty}\left(-1\right)^{n}\cdot\frac{\left(ix\right)^{2n}}{\left(2n\right)!}
\end{align*}


\end_inset
כעת נשים לב לכך שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left(-i\right)\cdot i^{2n+1}\cdot\left(-1\right)^{n}=\left(-i\right)\cdot i\cdot i^{2n}\cdot\left(-1\right)^{n}=1\cdot\left(i^{2}\right)^{n}\cdot\left(-1\right)^{n}=\left(-1\right)^{n}\cdot\left(-1\right)^{n}=1
\]


\end_inset
ומכאן שמתקיים:
\begin_inset Formula
\begin{align*}
\sinh\left(x\right) & =\frac{1}{2}\cdot\left(\sum_{n=0}^{\infty}\frac{x^{n}}{n!}-\sum_{n=0}^{\infty}\frac{\left(-x\right)^{n}}{n!}\right)=\frac{1}{2}\cdot\sum_{n=0}^{\infty}\left(\frac{x^{n}}{n!}-\frac{\left(-x\right)^{n}}{n!}\right)\\
 & =\frac{1}{2}\cdot\sum_{n=0}^{\infty}\frac{2x^{2n+1}}{\left(2n+1\right)!}=\sum_{n=0}^{\infty}\frac{x^{2n+1}}{\left(2n+1\right)!}=\sum_{n=0}^{\infty}\left(\left(-i\right)\cdot i^{2n+1}\cdot\left(-1\right)^{n}\cdot\frac{x^{2n+1}}{\left(2n+1\right)!}\right)\\
 & =-i\cdot\sum_{n=0}^{\infty}\left(\left(-1\right)^{n}\cdot\frac{\left(ix\right)^{2n+1}}{\left(2n+1\right)!}\right)=-i\cdot\sin\left(ix\right)
\end{align*}


\end_inset
וגם:
\begin_inset Formula
\begin{align*}
\cosh\left(x\right) & =\frac{1}{2}\cdot\left(\sum_{n=0}^{\infty}\frac{x^{n}}{n!}+\sum_{n=0}^{\infty}\frac{\left(-x\right)^{n}}{n!}\right)=\frac{1}{2}\cdot\sum_{n=0}^{\infty}\left(\frac{x^{n}}{n!}+\frac{\left(-x\right)^{n}}{n!}\right)\\
 & =\frac{1}{2}\cdot\sum_{n=0}^{\infty}\frac{2x^{2n}}{\left(2n\right)!}=\sum_{n=0}^{\infty}\frac{x^{2n}}{\left(2n\right)!}=\sum_{n=0}^{\infty}\left(\left(-i\right)\cdot i\cdot i^{2n}\cdot\left(-1\right)^{n}\cdot\frac{x^{2n}}{\left(2n\right)!}\right)\\
 & =\sum_{n=0}^{\infty}\left(\left(-1\right)^{n}\cdot\frac{\left(ix\right)^{2n}}{\left(2n\right)!}\right)=\cos\left(ix\right)
\end{align*}


\end_inset

\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\cosh^{2}\left(x\right)-\sinh^{2}\left(x\right)=1$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$x\in\MKreal$
\end_inset
, מהגדרה מתקיים:
\begin_inset Formula
\begin{align*}
\cosh^{2}\left(x\right)-\sinh^{2}\left(x\right) & =\left(\frac{e^{x}+e^{-x}}{2}\right)^{2}-\left(\frac{e^{x}-e^{-x}}{2}\right)^{2}\\
 & =\frac{\left({\color{red}e^{2x}}+{\color{green}2e^{x}e^{-x}}+{\color{blue}e^{-2x}}\right){\color{green}-}\left({\color{red}e^{2x}}{\color{green}-2e^{x}e^{-x}}+{\color{blue}e^{-2x}}\right)}{4}\\
 & =\frac{{\color{green}2\cdot1+2\cdot1}}{4}=1
\end{align*}


\end_inset

\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\sinh'\left(x\right) & =\cosh\left(x\right)\\
\cosh'\left(x\right) & =\sinh\left(x\right)
\end{align*}


\end_inset

\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

\end_layout

\begin_layout Claim
\begin_inset Formula
$\sinh$
\end_inset
 היא פונקציה הפיכה וההופכית שלה היא הפונקציה 
\begin_inset Formula
$\text{arsinh}:\MKreal\rightarrow\MKreal$
\end_inset
 המוגדרת ע"י (לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
):
\begin_inset Formula
\[
\text{arsinh}\left(x\right):=\ln\left(x+\sqrt{1+x^{2}}\right)
\]


\end_inset

\end_layout

\begin_layout Proof
ראינו לעיל שלכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$\sinh'\left(x\right)=\cosh\left(x\right)=\frac{e^{x}+e^{-x}}{2}$
\end_inset
, פונקציית האקספוננט חיובית ממש על כל הישר הממשי ומכאן שגם 
\begin_inset Formula
$\cosh$
\end_inset
 חיובית ממש על כל הישר, כלומר הנגזרת של 
\begin_inset Formula
$\sinh$
\end_inset
 חיובית ממש על כל הישר ומכאן שהיא עולה ממש וממילא חח"ע.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$y\in\MKreal$
\end_inset
, ונגדיר 
\begin_inset Formula
$x:=\ln\left(y+\sqrt{y^{2}+1}\right)$
\end_inset
, נשים לב ש-
\begin_inset Formula
$y^{2}+1>y^{2}$
\end_inset
 ומכיוון שפונקציית השורש עולה ממש הדבר גורר ש-
\begin_inset Formula
$\sqrt{y^{2}+1}>\sqrt{y^{2}}=\left|y\right|\geq-y$
\end_inset
 ומכאן ש-
\begin_inset Formula
$y+\sqrt{y^{2}+1}>0$
\end_inset
 ולכן ניתן לחלק בו ללא בעיות.
\begin_inset Newline newline
\end_inset
נוכיח ש-
\begin_inset Formula
$\sinh\left(x\right)=y$
\end_inset
:
\begin_inset Formula
\begin{align*}
\sinh\left(x\right) & =\frac{e^{x}-e^{-x}}{2}=\frac{1}{2}\cdot\left(e^{\ln\left(y+\sqrt{y^{2}+1}\right)}-e^{-\ln\left(y+\sqrt{y^{2}+1}\right)}\right)\\
 & =\frac{1}{2}\cdot\left({\color{red}y+\sqrt{y^{2}+1}}-\frac{1}{y+\sqrt{y^{2}+1}}\right)\\
 & =\frac{1}{2}\cdot\frac{{\color{red}\left(y+\sqrt{y^{2}+1}\right)^{2}}-1}{y+\sqrt{y^{2}+1}}\\
 & =\frac{1}{2}\cdot\frac{{\color{red}\left(y^{2}+2y\cdot\sqrt{y^{2}+1}+y^{2}+1\right)}-1}{y+\sqrt{y^{2}+1}}\\
 & ={\color{blue}\frac{1}{2}}\cdot\frac{{\color{blue}2}y^{2}+{\color{blue}2}y\cdot\sqrt{y^{2}+1}}{y+\sqrt{y^{2}+1}}\\
 & =\frac{y^{2}+y\cdot\sqrt{y^{2}+1}}{y+\sqrt{y^{2}+1}}=y
\end{align*}


\end_inset

\begin_inset Formula
$y$
\end_inset
 הנ"ל היה שרירותי ולכן לכל 
\begin_inset Formula
$y\in\MKreal$
\end_inset
 קיים 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$\sinh\left(x\right)=y$
\end_inset
, כלומר 
\begin_inset Formula
$\sinh$
\end_inset
 היא על, אך לא רק שבכך הוכחנו שהיא הפיכה אלא שמצאנו גם את ההופכית שלה שהיא הפונקציה 
\begin_inset Formula
$\text{arsinh}:\MKreal\rightarrow\MKreal$
\end_inset
 המוגדרת ע"י (לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
):
\begin_inset Formula
\[
\text{arsinh}\left(x\right):=\ln\left(x+\sqrt{1+x^{2}}\right)
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 אבל איך בכלל ידענו לסמן 
\begin_inset Formula
$x:=\ln\left(y+\sqrt{y^{2}+1}\right)$
\end_inset
? נניח שקיים 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$\sinh\left(x\right)=y$
\end_inset
, כלומר:
\begin_inset Formula
\[
y=\frac{e^{x}-e^{-x}}{2}
\]


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow y\cdot e^{x}=e^{x}\cdot\frac{e^{x}-e^{-x}}{2}=\frac{e^{2x}-1}{2}\\
 & \Rightarrow2ye^{x}=e^{2x}-1\\
 & \Rightarrow0=e^{2x}-2ye^{x}-1
\end{align*}


\end_inset
נסמן 
\begin_inset Formula
$t:=e^{2x}$
\end_inset
,
\begin_inset Formula
\begin{align*}
 & \Rightarrow0=t^{2}-2yt-1\\
 & \Rightarrow t=\frac{2y\pm\sqrt{4y^{2}+4}}{2}=\frac{2y\pm2\sqrt{y^{2}+1}}{2}=y\pm\sqrt{y^{2}+1}
\end{align*}


\end_inset
כעת נשים לב לכך ש-
\begin_inset Formula
$y+\sqrt{y^{2}+1}$
\end_inset
 חיובי בעוד ש-
\begin_inset Formula
$y-\sqrt{y^{2}+1}$
\end_inset
 שלילי ולכן בהכרח 
\begin_inset Formula
$x=\ln\left(y+\sqrt{y^{2}+1}\right)$
\end_inset
.
\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Corollary
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\text{arsinh}'\left(x\right)=\frac{1}{\sqrt{1+x^{2}}}
\]


\end_inset

\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$x\in\MKreal$
\end_inset
, מכלל השרשרת נובע שמתקיים:
\begin_inset Formula
\begin{align*}
\text{arsinh}'\left(x\right) & =\frac{1}{x+\sqrt{1+x^{2}}}\cdot\left(1+\frac{2x}{2\cdot\sqrt{1+x^{2}}}\right)\\
 & =\frac{1}{x+\sqrt{1+x^{2}}}\cdot\left(1+\frac{x}{\sqrt{1+x^{2}}}\right)\\
 & =\frac{1}{x+\sqrt{1+x^{2}}}+\frac{1}{x+\sqrt{1+x^{2}}}\cdot\frac{x}{\sqrt{1+x^{2}}}\\
 & =\frac{\sqrt{1+x^{2}}+x}{\left(x+\sqrt{1+x^{2}}\right)\cdot\sqrt{1+x^{2}}}=\frac{1}{\sqrt{1+x^{2}}}
\end{align*}


\end_inset

