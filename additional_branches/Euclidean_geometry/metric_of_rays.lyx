\end_inset


\begin_inset Newline newline
\end_inset

נניח ש-
\begin_inset Formula $\angle AOB$
\end_inset

 היא זווית שטוחה (כלומר 
\begin_inset Formula $\angle AOB=\frac{1}{2}$
\end_inset

),
 ע"פ שוויונות המשולש המנוון מתקיים 
\begin_inset Formula $\left|AB\right|=\left|AO\right|+\left|OB\right|$
\end_inset

.
\begin_inset Formula 
\begin{align*}
\Rightarrow\left|AO\right| & =\left|\left|AO\right|\right|=\left|\left|AB\right|-\left|OB\right|\right|\\
\Rightarrow\left|BO\right| & =\left|\left|OB\right|\right|=\left|\left|AB\right|-\left|OA\right|\right|
\end{align*}

\end_inset

כעת,
 משוויונות המשולש המנוון נקבל ש-
\begin_inset Formula $\angle ABO=\angle OAB=0$
\end_inset

,
 כלומר 
\begin_inset Formula $\angle ABO$
\end_inset

 ו-
\begin_inset Formula $\angle OAB$
\end_inset

 הן זוויות מנוונות.
\end_layout

\begin_layout Itemize
\begin_inset Formula $\Rightarrow$
\end_inset


\begin_inset Newline newline
\end_inset

נניח ש-
\begin_inset Formula $\angle ABO$
\end_inset

 ו-
\begin_inset Formula $\angle OAB$
\end_inset

 הן זוויות מנוונות (כלומר 
\begin_inset Formula $\angle ABO=\angle OAB=0$
\end_inset

),
 ולכן ע"פ שוויונות המשולש המנוון מתקיים:
\begin_inset Formula 
\begin{align*}
\left|AO\right|= & \left|\left|BO\right|-\left|BA\right|\right|=\left|\left|AB\right|-\left|OB\right|\right|\\
\left|OB\right|= & \left|\left|AB\right|-\left|AO\right|\right|
\end{align*}

\end_inset

נשים לב לכך שאם 
\begin_inset Formula $\left|AB\right|\geq\left|OB\right|$
\end_inset

 ו/או 
\begin_inset Formula $\left|AB\right|\geq\left|AO\right|$
\end_inset

 אז ע"י העברת אגף נקבל ש-
\begin_inset Formula $\left|AB\right|=\left|AO\right|+\left|OB\right|$
\end_inset

,
 ומכאן ש-
\begin_inset Formula $\angle AOB$
\end_inset

 היא זווית שטוחה (שוויונות המשולש המנוון).
 אם כן נניח בשלילה ש-
\begin_inset Formula $\left|AB\right|<\left|OB\right|$
\end_inset

 וגם 
\begin_inset Formula $\left|AB\right|<\left|AO\right|$
\end_inset

 אז מתקיים:
\begin_inset Formula 
\begin{align*}
\left|AO\right| & =\left|OB\right|-\left|AB\right|\\
\left|OB\right| & =\left|AO\right|-\left|AB\right|\\
\Rightarrow\left|OA\right|+\left|AB\right| & =\left|AB\right|+\left|AO\right|=\left|OB\right|=\left|BO\right|\\
\Rightarrow\left|AB\right|+\left|OB\right| & =\left|AB\right|+\left|OB\right|=\left|AO\right|
\end{align*}

\end_inset

ולכן ע"פ שוויונות המשולש המנוון,
 הזוויות 
\begin_inset Formula $\angle OAB$
\end_inset

 ו-
\begin_inset Formula $\angle ABO$
\end_inset

 הן זוויות שטוחות - בסתירה להנחה שהן מנוונות.
\begin_inset Newline newline
\end_inset

מכאן ש-
\begin_inset Formula $\left|AB\right|\geq\left|OB\right|$
\end_inset

 ו/או 
\begin_inset Formula $\left|AB\right|\geq\left|AO\right|$
\end_inset

 וכפי שהראינו לעיל נובע מזה ש-
\begin_inset Formula $\angle AOB$
\end_inset

 היא זווית שטוחה.
