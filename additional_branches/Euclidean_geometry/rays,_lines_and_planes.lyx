\begin_layout Proof
ע"פ א"ש הפירמידה מתקיים:
\begin_inset Formula 
\begin{align*}
\angle AOB & \leq\angle AOC+\angle COB\\
\angle BOC & \leq\angle BOA+\angle AOC
\end{align*}

\end_inset

ולכן גם:
\begin_inset Formula 
\begin{align*}
\angle AOB-\angle COB & \leq\angle AOC\\
\angle BOC-\angle BOA & \leq\angle AOC
\end{align*}

\end_inset

כעת,
 מהסימטריה נובע כי:
\begin_inset Formula 
\begin{align*}
\angle AOB-\angle BOC & \leq\angle AOC\\
\angle BOC-\angle AOB & \leq\angle AOC
\end{align*}

\end_inset

ומכיוון שבהכרח מתקיים 
\begin_inset Formula $\left|\angle AOB-\angle BOC\right|=\angle AOB-\angle BOC$
\end_inset

 ו/או 
\begin_inset Formula $\left|\angle AOB-\angle BOC\right|=\angle BOC-\angle AOB$
\end_inset

 נדע ש-
\begin_inset Formula $\left|\angle AOB-\angle BOC\right|\leq\angle AOC$
\end_inset

.
\end_layout

\end_inset


\end_layout

