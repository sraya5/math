$-\prod_{i=1}^{0}p_{i}=-1$
\end_inset
.
\end_layout

\end_inset
 קיימת הצגה יחידה בצורה הבאה:
\begin_inset Formula
\[
n=\MKsign\left(n\right)\cdot\prod_{i=1}^{r}p_{i}^{e_{i}}
\]


\end_inset
כאשר 
\begin_inset Formula
$p_{1},p_{2},\ldots,p_{r}\in\MKnatural$
\end_inset
 הם מספרים ראשוניים המקיימים 
\begin_inset Formula
$p_{1}<p_{2}<\ldots<p_{r}$
\end_inset
 ו-
\begin_inset Formula
$e_{1},e_{2},\ldots,e_{r}\in\MKnatural$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$n\in\MKinteger\setminus\left\{ -1,1,0\right\} $
\end_inset
.
\begin_inset Newline newline
\end_inset
ניתן להוכיח באינדוקציה שניתן להציג כל מספר שלם כמכפלה של אי-פריקים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
מפרקים לגורמים עד שכבר א"א לחלק מפני שכל הגורמים אי-פריקים.
\end_layout

\end_inset
, א"כ יהיו 
\begin_inset Formula
$p_{1},p_{2},\ldots p_{r},q_{1},q_{2},\ldots q_{s}\in\MKprime$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
\prod_{i=1}^{r}p_{i}=n=\prod_{j=1}^{s}q_{j}
\]


\end_inset
נגדיר פונקציה 
\begin_inset Formula
$f:\left\{ i\in\MKnatural\mid i\leq r\right\} \rightarrow\left\{ i\in\MKnatural\mid i\leq s\right\} $
\end_inset
 באופן אינדוקטיבי.
\begin_inset Newline newline
\end_inset
נסמן 
\begin_inset Formula
$i:=1$
\end_inset
 
\end_layout

\begin_deeper
\begin_layout Itemize
לכל 
\begin_inset Formula
$r\geq i\in\MKnatural$
\end_inset
:
\end_layout

\begin_deeper
\begin_layout Itemize
מהלמה האחרונה נובע שקיים 
\begin_inset Formula
$s\geq j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$q_{j}=\pm p_{i}$
\end_inset
, יהי 
\begin_inset Formula
$j$
\end_inset
 כנ"ל ונסמן 
\begin_inset Formula
$f\left(i\right):=j$
\end_inset
.
\end_layout

\begin_layout Itemize
כעת נסיר מהמכפלה באגף שמאל את 
\begin_inset Formula
$p_{i}$
\end_inset
 ומאגף ימין נסיר את 
\begin_inset Formula
$q_{j}$
\end_inset
 ושוב נקבל שוויון עד כדי סימן כך ש-
\begin_inset Formula
$q_{j}$
\end_inset
 כבר אינו מופיע מופיע במכפלה הימנית ומכאן שהפונקציה שנגדיר תהיה חח"ע.
