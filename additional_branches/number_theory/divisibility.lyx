\begin_layout Lemma
יהי 
\begin_inset Formula
$p\in\MKinteger$
\end_inset
 מספר ראשוני ויהיו 
\begin_inset Formula
$a_{1},a_{2},\ldots,a_{n}\in\MKinteger$
\end_inset
 כך שמתקיים 
\begin_inset Formula
$p\mid a_{1}\cdot a_{2}\cdot\ldots\cdot a_{n}$
\end_inset
, קיים 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$p\mid a_{i}$
\end_inset
.
