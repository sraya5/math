\begin_layout Proof
יהי 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 פריק ויהיו 
\begin_inset Formula
$1<a,b\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$a\cdot b=n$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow M_{n} & =2^{a\cdot b}-1=\left(2^{a}\right)^{b}-1^{b}\\
 & =\left(2^{a}-1\right)\cdot\left(2^{0\cdot a}+2^{1\cdot a}+2^{2a}+\ldots+2^{\left(b-1\right)\cdot a}\right)
\end{align*}


