\begin_layout Proof
יהי 
\begin_inset Formula
$1<n\in\MKnatural$
\end_inset
 חופשי מריבועים ונניח בשלילה ש-
\begin_inset Formula
$\sqrt{n}\in\MKrational$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$p,q\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$\frac{p}{q}$
\end_inset
 היא ההצגה המצומצמת של 
\begin_inset Formula
$\sqrt{n}$
\end_inset
 (כלומר 
\begin_inset Formula
$\gcd\left(p,q\right)=1$
\end_inset
).
\begin_inset Formula
\begin{align*}
 & \Rightarrow\frac{p^{2}}{q^{2}}=\left(\frac{p}{q}\right)^{2}=n\\
 & \Rightarrow p^{2}=nq^{2}\\
 & \Rightarrow n\mid p^{2}
\end{align*}


\end_inset
כעת, מכיוון ש-
\begin_inset Formula
$n$
\end_inset
 חופשי מריבועים נדע שמתקיים 
\begin_inset Formula
$n\mid p$
\end_inset
, א"כ קיים 
\begin_inset Formula
$k\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$nk=p$
\end_inset
, יהי 
\begin_inset Formula
$k$
\end_inset
 כנ"ל.
\begin_inset Formula
\begin{align*}
 & \Rightarrow n^{2}k^{2}=p^{2}=nq^{2}\\
 & \Rightarrow k^{2}n=q^{2}\\
 & \Rightarrow n\mid q^{2}
\end{align*}


\end_inset
ושוב מאותה סיבה נקבל ש-
\begin_inset Formula
$n\mid q$
\end_inset
, כלומר 
\begin_inset Formula
$n$
\end_inset
 מחלק הן את 
\begin_inset Formula
$p$
\end_inset
 והן את 
\begin_inset Formula
$q$
\end_inset
 בסתירה לכך ש-
\begin_inset Formula
$\gcd\left(p,q\right)=1$
\end_inset
 ו-
\begin_inset Formula
$1<n$
\end_inset
.
\begin_inset Newline newline
\end_inset
מכאן שהנחת השלילה אינה נכונה ו-
\begin_inset Formula
$\sqrt{n}\notin\MKrational$
\end_inset
.
\end_layout

\begin_layout Corollary
לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 שאינו מספר ריבועי מתקיים 
