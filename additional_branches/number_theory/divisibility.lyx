, ההוכחה מסתמכת על משפט צ'בישב ולמעשה ממשפט המספרים הראשוניים נובעת טענה חזקה יותר האומרת שלכל 
\begin_inset Formula
$0<\varepsilon\in\MKreal$
\end_inset
 קיים 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 כך שלכל 
\begin_inset Formula
$N<n\in\MKnatural$
\end_inset
 יש לפחות ראשוני אחד בקטע 
\begin_inset Formula
$\left(n,n+\varepsilon\cdot n\right)$
\end_inset
.
\end_layout

\begin_layout Proof
נסמן 
\begin_inset Formula
$A:=\frac{1}{2}\cdot\ln2$
\end_inset
 ו-
\begin_inset Formula
$B:=6\cdot\ln2$
\end_inset
 ונוכיח שלכל 
\begin_inset Formula
$1<x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
A\cdot\frac{x}{\ln x}\leq\pi\left(x\right)\leq B\cdot\frac{x}{\ln x}
\]


\end_inset
נזכור בכל שלב של ההוכחה שהפונקציה 
\begin_inset Formula
$\frac{x}{\ln x}$
\end_inset
 עולה ממש בתחום 
\begin_inset Formula
$\left[e,\infty\right)$
\end_inset
 ויורדת בתחום 
\begin_inset Formula
$\left(1,e\right]$
\end_inset
.
\begin_inset Newline newline
\end_inset
נוכיח תחילה עבור החסם מלעיל (
\begin_inset Formula
$B$
\end_inset
).
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
, נסמן 
\begin_inset Formula
$N:=\begin{pmatrix}2n\\
n
\end{pmatrix}$

\end_inset
.
\begin_inset Formula
\[
\Rightarrow N\leq\sum_{k=0}^{2n}\begin{pmatrix}2n\\
k
\end{pmatrix}=\left(1+1\right)^{2n}
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow N\leq2^{2n}
\]


\end_inset
נסמן 
\begin_inset Formula
$P:=\left\{ p\in\MKprime\mid n<p\leq2n\right\} $
\end_inset
, לכל ראשוני 
\begin_inset Formula
$p\in P$
\end_inset
 מתקיים 
\begin_inset Formula
$p\mid N$
\end_inset
 ו-
\begin_inset Formula
$\MKord_{p}\left(N\right)=1$
\end_inset
 וזאת משום ש-
\begin_inset Formula
$p$
\end_inset
 מחלק את המכפלה 
\begin_inset Formula
$\prod_{i=n+1}^{2n}i$
\end_inset
 אך 
\begin_inset Formula
$p^{2}$
\end_inset
 אינו מחלק את המכפלה ובנוסף 
\begin_inset Formula
$p$
\end_inset
 אינו מחלק אף אחד מהאיברים ב-
\begin_inset Formula
$n!$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\prod_{p\in P}p & \leq N\leq2^{2n}\\
\Rightarrow\sum_{p\in P}\ln\left(p\right) & \leq\ln\left(N\right)\leq\ln\left(2^{2n}\right)=2n\cdot\ln\left(2\right)
\end{align*}


\end_inset
נניח כרגע ש-
\begin_inset Formula
$n>1$
\end_inset
,
\begin_inset Formula
\begin{align*}
\Rightarrow\ln\left(n\right)\cdot\left(\pi\left(2n\right)-\pi\left(n\right)\right) & =\ln\left(n\right)\cdot\left|P\right|\leq\sum_{p\in P}\ln\left(p\right)\leq2n\cdot\ln\left(2\right)\\
\Rightarrow\pi\left(2n\right)-\pi\left(n\right) & =\frac{2n\cdot\ln\left(2\right)}{\ln\left(n\right)}=2\cdot\ln\left(2\right)\cdot\frac{n}{\ln n}
\end{align*}


\end_inset

\begin_inset Formula
$n$
\end_inset
 הנ"ל היה שרירותי ולכן הנ"ל נכון לכל 
\begin_inset Formula
$1<n\in\MKnatural$
\end_inset
, בפרט לכל 
\begin_inset Formula
$k\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\pi\left(2^{k+1}\right)-\pi\left(2^{k}\right)=2\cdot\ln\left(2\right)\cdot\frac{2^{k}}{\ln\left(2^{k}\right)}
\]


\end_inset
