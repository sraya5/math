\end_layout

\begin_layout Itemize
אחרת, נזכור ש-
\begin_inset Formula
$r_{i+1}=a_{i-1}\cdot r_{0}+b_{i-1}\cdot r_{1}$
\end_inset
 וגם 
\begin_inset Formula
$r_{i}=a_{i-2}\cdot r_{0}+b_{i-2}\cdot r_{1}$
\end_inset
, ומכיוון ש-
\begin_inset Formula
$r_{i+2}=r_{i}-q_{i}\cdot r_{i+1}$
\end_inset
 ניתן להציג את 
\begin_inset Formula
$r_{i+2}$
\end_inset
 כך:
\begin_inset Formula
\begin{align*}
r_{i+2} & =r_{i}-r_{i+1}\cdot q_{i}=\left(a_{i-2}\cdot r_{0}+b_{i-2}\cdot r_{1}\right)-\left(a_{i-1}\cdot r_{0}+b_{i-1}\cdot r_{1}\right)\cdot q_{i}\\
 & ={\color{red}\left(a_{i-2}-q_{i}\cdot a_{i-1}\right)}\cdot r_{0}+{\color{blue}\left(b_{i-2}-q_{i}\cdot b_{i-1}\right)}\cdot r_{1}
\end{align*}


\end_inset
ולכן נגדיר 
\begin_inset Formula
${\color{red}a_{i}=a_{i-2}-q_{i}\cdot a_{i-1}}$
\end_inset
