\begin_layout Lemma
יהיו 
\begin_inset Formula
$0\neq a,b\in\MKinteger$
\end_inset
, נסמן 
\begin_inset Formula
$n:=ab$
\end_inset
 ויהי 
\begin_inset Formula
$p\in\MKinteger$
\end_inset
 מספר ראשוני, מתקיים 
\begin_inset Formula
$\MKord_{p}\left(a\right)+\MKord_{p}\left(b\right)=\MKord_{p}\left(n\right)$
\end_inset
.
\end_layout

\begin_layout Claim
יהיו 
\begin_inset Formula
$0\neq a,b\in\MKinteger$
\end_inset
, מתקיים 
\begin_inset Formula
$a\mid b$
\end_inset
 אם"ם 
\begin_inset Formula
$\MKord_{p}\left(a\right)\leq\MKord_{p}\left(b\right)$
\end_inset
 לכל 
\begin_inset Formula
$p\in\MKinteger$
\end_inset
 ראשוני.
\end_layout

\begin_layout Corollary
יהיו 
\begin_inset Formula
$0\neq a,b\in\MKinteger$
\end_inset
 ויהיו 
\begin_inset Formula
$p_{1},p_{2},\ldots,p_{r}\in\MKnatural$
\end_inset
 מספרים ראשוניים ו-
\begin_inset Formula
$e_{1},e_{2},\ldots,e_{r},f_{1},f_{2},\ldots,f_{r}\in\MKnatural_{0}$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\begin{align*}
a & =\MKsign\left(a\right)\cdot\prod_{i=1}^{r}p_{i}^{e_{i}}\\
b & =\MKsign\left(b\right)\cdot\prod_{i=1}^{r}p_{i}^{f_{i}}
\end{align*}


\end_inset
במקרה כזה מתקיים:
\begin_inset Formula
\begin{align*}
\gcd\left(a,b\right) & =\prod_{i=1}^{r}p_{i}^{\min\left\{ e_{i},f_{i}\right\} }\\
\MKlcm\left(a,b\right) & =\prod_{i=1}^{r}p_{i}^{\max\left\{ e_{i},f_{i}\right\} }
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מכאן נובע שמתקיים גם:
\begin_inset Formula
\[
\MKlcm\left(a,b\right)=\frac{\left|a\cdot b\right|}{\gcd\left(a,b\right)}
\]


\end_inset
שהרי לכל 
\begin_inset Formula
$r\geq i\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$\max\left\{ e_{i},f_{i}\right\} +\min\left\{ e_{i},f_{i}\right\} =e_{i}+f_{i}$
\end_inset
.
