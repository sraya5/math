\begin_inset Newline newline
\end_inset
נניח שקבוצת הראשוניים היא קבוצה סופית ויהיו 
\begin_inset Formula
$p_{1},p_{2},\ldots,p_{r}\in\MKnatural$
\end_inset
 כל הראשוניים הטבעיים בקבוצה.
\begin_inset Newline newline
\end_inset
ע"פ הנוסחה לסכום של סדרה הנדסית מתכנסת מתקיים:
\begin_inset Formula
\[
\prod_{i=1}^{r}\frac{1}{1-\frac{1}{p_{i}}}=\prod_{i=1}^{r}\left(\sum_{n=0}^{\infty}\frac{1}{\left(p_{i}\right)^{n}}\right)
\]


\end_inset
תהא 
\begin_inset Formula
$\left(a_{n}\right)_{n=1}^{\infty}$
\end_inset
 סדרה המוגדרת ע"י (לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
a_{n}:=\prod_{i=1}^{r}\left(\sum_{j=0}^{m_{n}}\frac{1}{\left(p_{i}\right)^{j}}\right)
\]


\end_inset
כאשר 
\begin_inset Formula
$\left(m_{n}\right)_{n=1}^{\infty}$
\end_inset
 היא סדרה המוגדרת ע"י 
\begin_inset Formula
$m_{n}:=\max\left\{ \MKord_{p_{i}}\left(n\right)\mid r\geq i\in\MKnatural\right\} $
\end_inset
 לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
, כלומר 
\begin_inset Formula
$m_{n}$
\end_inset
 הוא החזקה הגדולה ביותר שבה ראשוני כלשהו מחלק את 
\begin_inset Formula
$n$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow\lim_{n\rightarrow\infty}a_{n}=\prod_{i=1}^{r}\left(\sum_{n=0}^{\infty}\frac{1}{\left(p_{i}\right)^{n}}\right)=\prod_{i=1}^{r}\frac{1}{1-\frac{1}{p_{i}}}
\]


\end_inset
בנוסף, לכל 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$N\geq n\in\MKnatural$
\end_inset
 ,
\begin_inset Formula
$\frac{1}{n}$
\end_inset
 מופיע במכפלה:
\begin_inset Formula
\[
a_{N}:=\prod_{i=1}^{r}\left(\sum_{j=0}^{m_{N}}\frac{1}{\left(p_{i}\right)^{j}}\right)=\sum_{\forall i\leq r:\ 0\leq e_{i}\leq m_{n}}\prod_{i=1}^{r}\frac{1}{\left(p_{i}\right)^{e_{i}}}
\]


\end_inset
ומזה נובע שלכל 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 מתקיים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
נזכור שכל האיברים במכפלה חיוביים ושלכל 
\begin_inset Formula
$N\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$m_{N}\leq N$
\end_inset
.
\end_layout

\end_inset
:
\begin_inset Formula
\[
a_{N}\geq\sum_{n=1}^{N}\frac{1}{n}
\]


\end_inset
כעת נזכור ש-
\begin_inset Formula
$\left(a_{n}\right)_{n=1}^{\infty}$
\end_inset
 היא סדרה מתכנסת ושהטור ההרמוני הוא טור חיובי ולכן אי-השוויון הנ"ל גורר את התכנסות הטור ההרמוני בסתירה לכך שאנו יודעים שאינו מתכנס.
\begin_inset Newline newline
\end_inset
מכאן שהנחת השלילה אינה נכונה וקבוצת הראשוניים היא אינסופית.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 זוהי הגרסה המפורמלת של ההוכחה שכתב אוילר:
\begin_inset Formula
\[
\sum_{n=1}^{\infty}\frac{1}{n}=\prod_{p\in\MKprime}\left(\sum_{n=0}^{\infty}\frac{1}{p^{n}}\right)
\]


\end_inset

\end_layout

