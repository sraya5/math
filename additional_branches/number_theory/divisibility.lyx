\begin_inset Formula
\begin{align*}
 & \Rightarrow q'\cdot a+r'=q\cdot a+r\\
 & \Rightarrow\left(q'-q\right)\cdot a+\left(r'-r\right)=0
\end{align*}


\end_inset
אבל בהכרח מתקיים 
\begin_inset Formula
