\begin_layout Claim
יהי 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
, אם 
\begin_inset Formula
$F_{n}=2^{n}+1$
\end_inset
 (מספר פרמה ה-
\begin_inset Formula
$n$
\end_inset
-י) ראשוני אז קיים 
\begin_inset Formula
$m\in\MKnatural_{0}$
\end_inset
 כך ש-
\begin_inset Formula
$n=2^{m}$
\end_inset
.
\end_layout

\begin_layout Proof
נניח ש-
\begin_inset Formula
$F_{n}$
\end_inset
 ראשוני, כמו לכל טבעי גם ל-
\begin_inset Formula
$n$
\end_inset
 קיימים 
\begin_inset Formula
$m\in\MKnatural_{0}$
\end_inset
 ו-
\begin_inset Formula
$k\in\MKodd$
\end_inset
 כך ש-
\begin_inset Formula
$n=2^{m}\cdot k$
\end_inset
, יהיו 
\begin_inset Formula
$m$
\end_inset
 ו-
\begin_inset Formula
$k$
\end_inset
 כנ"ל ונסמן 
\begin_inset Formula
$u:2^{m}$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow F_{n} & =2^{u\cdot k}+1=\left(2^{u}\right)^{k}-\left(-1\right)^{k}\\
 & =\left(2^{u}-\left(-1\right)\right)\cdot\sum_{j=0}^{k-1}\left(2^{u}\right)^{j}\cdot\left(-1\right)^{k-1-j}\\
 & =\left(2^{u}+1\right)\cdot\sum_{j=0}^{k-1}\left(2^{u}\right)^{j}\cdot\left(-1\right)^{k-1-j}
\end{align*}


\end_inset
כעת, אם 
\begin_inset Formula
$k>1$
\end_inset
 אז 
\begin_inset Formula
$k-1>1$
\end_inset
 (נזכור ש-
\begin_inset Formula
$k$
\end_inset
 אי-זוגי) ולכן הגורם הימני שונה מ-
\begin_inset Formula
$\pm1$
\end_inset
 ומכיוון שהגורם השמאלי ודאי שונה מ-
\begin_inset Formula
$\pm1$
\end_inset
 הרי שמצאנו פירוק לא טריוויאלי של 
\begin_inset Formula
$F_{n}$
\end_inset
 בסתירה להיות 
\begin_inset Formula
$F_{n}$
\end_inset
