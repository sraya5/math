\end_inset
 וגם 
\begin_inset Formula
${\color{green}P_{k-1}\cdot Q_{k-2}-Q_{k-1}\cdot P_{k-2}=\left(-1\right)^{k-2}}$
\end_inset
, א"כ מהגדרה מתקיים:
\begin_inset Formula
\begin{align*}
P_{k+1}\cdot Q_{k} & =\left(P_{k}\cdot a_{k+1}+P_{k-1}\right)\cdot\left(Q_{k-1}\cdot a_{k}+Q_{k-2}\right)\\
 & ={\color{blue}P_{k}\cdot a_{k+1}\cdot Q_{k-1}\cdot a_{k}}+P_{k}\cdot a_{k+1}\cdot Q_{k-2}+{\color{red}P_{k-1}\cdot Q_{k-1}\cdot a_{k}}+{\color{green}P_{k-1}\cdot Q_{k-2}}
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
Q_{k+1}\cdot P_{k} & =\left(Q_{k}\cdot a_{k+1}+Q_{k-1}\right)\left(P_{k-1}\cdot a_{k}+P_{k-2}\right)\\
 & ={\color{blue}Q_{k}\cdot a_{k+1}\cdot P_{k-1}\cdot a_{k}}+Q_{k}\cdot a_{k+1}\cdot P_{k-2}+{\color{red}Q_{k-1}\cdot P_{k-1}\cdot a_{k}}+{\color{green}Q_{k-1}\cdot P_{k-2}}
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow P_{k+1}\cdot Q_{k}-Q_{k+1}\cdot P_{k} & =a_{k}\cdot a_{k+1}\cdot{\color{blue}\left(-1\right)^{k-1}}+P_{k}\cdot a_{k+1}\cdot Q_{k-2}-Q_{k}\cdot a_{k+1}\cdot P_{k-2}+{\color{green}\left(-1\right)^{k-2}}\\
 & =a_{k}\cdot a_{k+1}\cdot{\color{blue}\left(-1\right)^{k-1}}+a_{k+1}\cdot\left(P_{k}\cdot Q_{k-2}-Q_{k}\cdot P_{k-2}\right)+{\color{green}\left(-1\right)^{k-2}}
\end{align*}


\end_inset
כמו כן מהגדרה מתקיים:ֵ
\begin_inset Formula
\begin{align*}
P_{k}\cdot Q_{k-2} & =\left(P_{k-1}\cdot a_{k}+P_{k-2}\right)\cdot Q_{k-2}\\
 & ={\color{green}P_{k-1}\cdot a_{k}\cdot Q_{k-2}}+{\color{red}P_{k-2}\cdot Q_{k-2}}\\
Q_{k}\cdot P_{k-2} & =\left(Q_{k-1}\cdot a_{k}+Q_{k-2}\right)\cdot P_{k-2}\\
 & ={\color{green}Q_{k-1}\cdot a_{k}\cdot P_{k-2}}+{\color{red}Q_{k-2}\cdot P_{k-2}}
\end{align*}


\end_inset

\begin_inset Formula
\[
\Rightarrow P_{k}\cdot Q_{k-2}-Q_{k}\cdot P_{k-2}=a_{k}\cdot{\color{green}\left(-1\right)^{k-2}}
\]


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow P_{k+1}\cdot Q_{k}-Q_{k+1}\cdot P_{k} & =a_{k}\cdot a_{k+1}\cdot{\color{blue}\left(-1\right)^{k-1}}+a_{k+1}\cdot a_{k}\cdot{\color{green}\left(-1\right)^{k-2}}+{\color{green}\left(-1\right)^{k-2}}\\
 & =a_{k}\cdot a_{k+1}\cdot\left({\color{blue}\left(-1\right)^{k-1}}+{\color{green}\left(-1\right)^{k-2}}\right)+{\color{green}\left(-1\right)^{k-2}}\\
 & =a_{k}\cdot a_{k+1}\cdot0+{\color{green}\left(-1\right)^{k-2}}=\left(-1\right)^{k}=\left(-1\right)^{k+1-1}
\end{align*}


\end_inset

\end_layout

