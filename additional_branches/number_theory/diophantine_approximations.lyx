\begin_layout Proof
נסמן 
\begin_inset Formula
$\alpha:=x+\sqrt{D}\cdot y$
\end_inset
 ויהי 
\begin_inset Formula
$\left(a,b\right)\in\MKnatural\times\MKinteger$
\end_inset
 כך ש-
\begin_inset Formula
$b\neq0$
\end_inset
.
\end_layout

\begin_deeper
\begin_layout Itemize
נניח ש-
\begin_inset Formula
$\left(a,b\right)$
\end_inset
הוא פתרון ויהי 
\begin_inset Formula
$k\in\MKnatural$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
\alpha^{k}\leq a+\sqrt{D}\cdot\left|b\right|\leq\alpha^{k+1}
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow1\leq\frac{a+\sqrt{D}\cdot\left|b\right|}{\alpha^{k}}\leq\alpha
\]


\end_inset
אבל:
\begin_inset Formula
\[
N\left(\frac{a+\sqrt{D}\cdot\left|b\right|}{\alpha^{k}}\right)=\frac{N\left(a+\sqrt{D}\cdot\left|b\right|\right)}{N\left(\alpha^{k}\right)}=\frac{a^{2}-D\cdot b^{2}}{N^{k}\left(\alpha\right)}=1
\]


\end_inset
ומכאן ש-
\begin_inset Formula
$\left(a+\sqrt{D}\cdot\left|b\right|\right)\cdot\alpha^{-k}$
\end_inset
 גם הוא פתרון ולכן מהמינימליות של 
\begin_inset Formula
$\alpha$
\end_inset
 נובע שמתקיים:
\begin_inset Formula
\[
\frac{a+\sqrt{D}\cdot\left|b\right|}{\alpha^{k}}=\alpha
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow a+\sqrt{D}\cdot\left|b\right|=\alpha^{k+1}
\]


\end_inset
אם 
\begin_inset Formula
$b>0$
\end_inset
 אז סיימנו, אחרת נשים לב לכך שמתקיים:
\begin_inset Formula
\begin{align*}
a+\sqrt{D}\cdot b & =\frac{a-\sqrt{D}\cdot\left|b\right|}{1}=\frac{a-\sqrt{D}\cdot\left|b\right|}{a^{2}-D\cdot b^{2}}\\
 & =\frac{a-\sqrt{D}\cdot\left|b\right|}{\left(a-\sqrt{D}\cdot\left|b\right|\right)\left(a+\sqrt{D}\cdot\left|b\right|\right)}\\
 & =\left(a+\sqrt{D}\cdot\left|b\right|\right)^{-1}=\alpha^{-k-1}
\end{align*}


\end_inset

\end_layout

\begin_layout Itemize
נניח שקיים 
\begin_inset Formula
$0\neq n\in\MKinteger$
\end_inset
 כך שמתקיים 
\begin_inset Formula
$a+\sqrt{D}\cdot b=\left(x+\sqrt{D}\cdot y\right)^{n}=\alpha^{n}$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow a^{2}-D\cdot b^{2}=N\left(a+\sqrt{D}\cdot b\right)=N\left(\alpha^{n}\right)=N^{n}\left(\alpha\right)=1^{n}=1
\]


\end_inset
ומכאן שזהו אכן פתרון.
\end_layout

\end_deeper

