מהגדרה מתקיים:
\begin_inset Formula
\begin{align*}
P_{0}\cdot Q_{-1}-Q_{0}\cdot P_{-1} & =a_{0}\cdot0-1\cdot1=-1=\left(-1\right)^{-1}\\
P_{1}\cdot Q_{0}-Q_{1}\cdot P_{0} & =\left(P_{0}\cdot a_{1}+P_{-1}\right)\cdot Q_{0}-\left(Q_{0}\cdot a_{1}+Q_{-1}\right)\cdot P_{0}\\
 & =\left(a_{0}\cdot a_{1}+1\right)\cdot1-\left(1\cdot a_{1}+0\right)\cdot a_{0}=1=\left(-1\right)^{0}
\end{align*}


