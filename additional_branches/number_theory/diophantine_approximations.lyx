\begin_layout Theorem
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 קיימות סדרת טבעיים עולה ממש 
\begin_inset Formula
$\left(q_{n}\right)_{n=1}^{\infty}$
\end_inset
 וסדרת שלמים 
\begin_inset Formula
$\left(p_{n}\right)_{n=1}^{\infty}$
\end_inset
 כך שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|x-\frac{p_{n}}{q_{n}}\right|<\frac{1}{\left(q_{n}\right)^{2}}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר קיימת סדרת קירובים טובה כל כך שהיא מקרבת עד כדי ההופכי של ריבוע המכנה ולא רק עד כדי מחצית מההופכי של המכנה.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כמובן ש-
\begin_inset Formula
$\left(p_{n}\right)_{n=1}^{\infty}$
\end_inset
 תהיה סדרת חיוביים אם 
\begin_inset Formula
$x$
\end_inset
 חיובי וסדרת שליליים אם 
\begin_inset Formula
$x$
\end_inset
 שלילי.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$x\in\MKreal$
\end_inset
, אם 
\begin_inset Formula
$x\in\MKrational$
\end_inset
 אז קיימים 
\begin_inset Formula
$a\in\MKinteger$
\end_inset
 ו-
\begin_inset Formula
$b\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$x=\frac{a}{b}$
\end_inset
 ואותם 
\begin_inset Formula
$a$
\end_inset
 ו-
\begin_inset Formula
$b$
\end_inset
 יקיימו שהסדרות 
\begin_inset Formula
$\left(n\cdot a\right)_{n=1}^{\infty}$
\end_inset
 ו-
\begin_inset Formula
$\left(n\cdot b\right)_{n=1}^{\infty}$
\end_inset
 הן סדרות מתאימות, א"כ נניח ש-
\begin_inset Formula
$x\notin\MKrational$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$Q\in\MKnatural$
\end_inset
 ונסמן 
\begin_inset Formula
$\alpha_{n}:=\left\lfloor nx\right\rfloor $
\end_inset
 ו-
\begin_inset Formula
$\beta_{n}:=nx-\left\lfloor nx\right\rfloor $
\end_inset
 לכל 
\begin_inset Formula
$Q\geq n\in\MKnatural$
\end_inset
, מהגדרה מתקיים 
\begin_inset Formula
$\beta_{n}\in\left(0,1\right)$
\end_inset
 לכל 
\begin_inset Formula
$Q\geq n\in\MKnatural$
\end_inset
 ולכן מעקרון שובך היונים נובע שקיימים 
\begin_inset Formula
$Q\geq i,j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$i\neq j$
\end_inset
 ומתקיים:
\begin_inset Formula
\[
0\leq\beta_{i}-\beta_{j}\leq\frac{1}{Q}
\]


\end_inset
יהיו 
\begin_inset Formula
$i$
\end_inset
 ו-
\begin_inset Formula
$j$
\end_inset
 כנ"ל ונבחין כי:
\begin_inset Formula
\[
\left(i-j\right)\cdot x=\left(\alpha_{i}+\beta_{i}\right)-\left(\alpha_{j}+\beta_{j}\right)=\left(\alpha_{i}-\alpha_{j}\right)+\left(\beta_{i}-\beta_{j}\right)
\]


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow\left|\left(i-j\right)\cdot x-\left(\alpha_{i}-\alpha_{j}\right)\right|=\beta_{i}-\beta_{j}\leq\frac{1}{Q}\\
 & \Rightarrow\left|x-\frac{\alpha_{i}-\alpha_{j}}{i-j}\right|\leq\frac{\beta_{i}-\beta_{j}}{\left|i-j\right|}\leq\frac{1}{Q\cdot\left|i-j\right|}<\frac{1}{\left(i-j\right)^{2}}
\end{align*}


\end_inset
נסמן 
\begin_inset Formula
$p:=\alpha_{i}-\alpha_{j}$
\end_inset
 ו-
\begin_inset Formula
$q:=\left|i-j\right|$
\end_inset
, א"כ מתקיים:
\begin_inset Formula
\[
\left|x-\frac{p}{q}\right|<\frac{1}{q^{2}},\ \left|x-\frac{p}{q}\right|\leq\frac{1}{q\cdot Q}<\frac{1}{Q}
\]


\end_inset
נסמן:
\begin_inset Formula
\[
\varepsilon:=\min\left\{ \left|x-\frac{m}{n}\right|:m\in\MKinteger,\ Q\geq n\in\MKnatural\right\} 
\]


\end_inset
כלומר 
\begin_inset Formula
$\varepsilon$
\end_inset
 הוא המרחק בין 
\begin_inset Formula
$x$
\end_inset
 לקירוב הטוב ביותר שלו שהמכנה שלו קטן או שווה ל-
\begin_inset Formula
$Q$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$Q'\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$\frac{1}{Q'}<\varepsilon$
\end_inset
, 
\begin_inset Formula
$Q$
\end_inset
 הנ"ל היה שרירותי ולכן קיימים 
\begin_inset Formula
$p'\in\MKinteger$
\end_inset
 ו-
\begin_inset Formula
$q'\in\MKnatural$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
\left|x-\frac{p'}{q'}\right|<\frac{1}{q'^{2}},\ \left|x-\frac{p'}{q'}\right|\leq\frac{1}{q'\cdot Q'}<\frac{1}{Q'}<\varepsilon
\]


\end_inset

\begin_inset Newpage newpage
\end_inset
כלומר 
\begin_inset Formula
$\frac{p'}{q'}$
\end_inset
 הוא קירוב טוב יותר מכל קירוב שהמכנה שלו קטן או שווה ל-
\begin_inset Formula
$Q$
\end_inset
 ומכאן שבהכרח 
\begin_inset Formula
$q<Q<q'$
\end_inset
, מכאן שאכן ניתן לבנות סדרה עולה ממש של טבעיים 
\begin_inset Formula
$\left(q_{n}\right)_{n=1}^{\infty}$
\end_inset
 וסדרת שלמים מתאימה 
\begin_inset Formula
$\left(p_{n}\right)_{n=1}^{\infty}$
\end_inset
 כך שלכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|x-\frac{p_{n}}{q_{n}}\right|<\frac{1}{\left(q_{n}\right)^{2}}
\]


\end_inset

\end_layout

