\begin_inset Newline newline
\end_inset
נוכיח את הטענה עבור מכפלת חזקות של שני ראשוניים שונים ואז מאינדוקציה תנבע המסקנה כולה.
\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$p,q\in\MKnatural$
\end_inset
 שני ראשוניים שונים, מעיקרון ההכלה וההדחה
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
\begin_inset Formula
$p^{s-1}\cdot q^{t}$
\end_inset
 הוא מספר הכפולות של 
\begin_inset Formula
$p$
\end_inset
 הקטנות או שוות ל-
\begin_inset Formula
$p^{s}\cdot q^{t}$
\end_inset
, כמו כן 
\begin_inset Formula
$q^{t-1}\cdot p^{s}$
\end_inset
 הוא מספר הכפולות של 
\begin_inset Formula
$q$
\end_inset
 בטווח זה ואילו 
\begin_inset Formula
$p^{s-1}\cdot q^{t-1}$
\end_inset
 הוא כמות המספרים שהם כפולות של שניהם שהרי 
\begin_inset Formula
$p$
\end_inset
 ו-
\begin_inset Formula
$q$
\end_inset
 זרים זה לזה ולכן כל כפולה של שניהם היא כפולה של 
\begin_inset Formula
$p\cdot q$
\end_inset
.
\end_layout

\end_inset
 נובע שלכל 
\begin_inset Formula
$s,t\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\phi\left(p^{s}\cdot q^{t}\right)=p^{s}\cdot q^{t}-p^{s-1}\cdot q^{t}-q^{t-1}\cdot p^{s}+p^{s-1}\cdot q^{t-1}
\]


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\phi\left(p^{s}\cdot q^{t}\right) & =p^{s-1}\cdot q^{t-1}\cdot\left(p\cdot q-q-p+1\right)\\
 & =p^{s-1}\cdot q^{t-1}\cdot\left(p-1\right)\cdot\left(q-1\right)\\
 & =p^{s-1}\cdot\left(p-1\right)\cdot q^{t-1}\cdot\left(q-1\right)\\
 & =\phi\left(p^{s}\right)\cdot\phi\left(q^{t}\right)
\end{align*}


\end_inset
כעת נקבל מאינדוקציה שהטענה נכונה לכל מספר של ראשוניים שונים ומהקיבוץ של הכפל נקבל את הטענה עבור מספרים זרים באשר הם
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
ראינו שניתן להציג כל מספר שלם כמכפלת חזקות של ראשוניים, וכמדובר בשני מספרים זרים הם אינם חולקים ראשוני משותף בפירוק.
\end_layout

\end_inset
.
\end_layout

