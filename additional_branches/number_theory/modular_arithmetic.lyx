\end_inset
 ולכל 
\begin_inset Formula
$0\neq a\in\MKinteger$
\end_inset
 הזר ל-
\begin_inset Formula
$N$
\end_inset
 מתקיים:
\begin_inset Formula
\[
ax\equiv ay\mod N\Longleftrightarrow x\equiv y\mod N
\]


\end_inset

\end_layout

\begin_layout Theorem
\begin_inset CommandInset label
LatexCommand label
name "theorem 1.6"
\end_inset
למשוואה מהצורה 
\begin_inset Formula
$ax\equiv b\mod N$
\end_inset
 יש פתרון אם"ם 
\begin_inset Formula
$\gcd\left(a,N\right)\mid b$
\end_inset
, במקרה כזה ניתן להמיר אותה (ע"פ טענה 
\begin_inset CommandInset ref
LatexCommand ref
reference "claim 1.4"
plural false
caps false
noprefix false
nolink false
\end_inset
) למשוואה (נגדיר 
\begin_inset Formula
$d:=\gcd\left(a,N\right)$
\end_inset
):
\begin_inset Formula
\[
\frac{a}{d}\cdot x\equiv\frac{b}{d}\mod{\frac{N}{d}}
\]


\end_inset
ואז 
\begin_inset Formula
$\frac{a}{d}$
\end_inset
 זר ל-
\begin_inset Formula
$\frac{N}{d}$
\end_inset
 ולכן יש לו הופכי מודולרי והפתרונות מוכרחים לקיים:
\begin_inset Formula
\[
x\equiv\left(\frac{a}{d}\right)^{-1}\cdot\frac{b}{d}\mod{\frac{N}{d}}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נשים לב לכך שקיום פתרון יחיד מודולו 
\begin_inset Formula
