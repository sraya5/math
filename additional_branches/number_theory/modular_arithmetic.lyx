\begin_layout Proof
נתבונן בשריג
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
דמיינו את הקבוצה כאוסף נקודות במישור הנמצאות בהצטלבויות של קווי האורך והרוחב השלמים.
\end_layout

\end_inset
:
\begin_inset Formula
\[
L:=\left\{ \left(x,y\right)\in\MKinteger^{2}\mid0<x\leq\frac{q-1}{2},\ 0<y\leq\frac{p-1}{2}\right\} 
\]


\end_inset
מהגדרה מתקיים 
\begin_inset Formula
$\left|L\right|=\frac{q-1}{2}\cdot\frac{p-1}{2}$
\end_inset
.
\begin_inset Newline newline
\end_inset
נסמן:
\begin_inset Formula
\begin{align*}
L_{1} & :=\left\{ \left(x,y\right)\in L\mid\frac{p}{q}\cdot x\geq y\right\} \\
L_{2} & :=\left\{ \left(x,y\right)\in L\mid\frac{p}{q}\cdot x\leq y\right\} 
\end{align*}


\end_inset
מהגדרה מתקיים 
\begin_inset Formula
$L=L_{1}\cup L_{2}$
\end_inset
, אך יתרה מזאת זהו איחוד זר מפני שלו הייתה קיימת נקודה 
\begin_inset Formula
$\left(x,y\right)\in L$
\end_inset
 כך ש-
\begin_inset Formula
$\frac{p}{q}\cdot x=y$
\end_inset
 היינו מקבלים ש-
\begin_inset Formula
$q\mid x$
\end_inset
 בסתירה לכך ש-
\begin_inset Formula
$0<x\leq\frac{q-1}{2}$
\end_inset
; א"כ מתקיים 
\begin_inset Formula
$\left|L\right|=\left|L_{1}\right|+\left|L_{2}\right|$
\end_inset
.
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$\frac{p-1}{2}\geq i\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$\frac{q-1}{2}\geq j\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\left|\left\{ \left(x,y\right)\in L_{1}\mid y=i\right\} \right| & =\left\lfloor \frac{i\cdot q}{p}\right\rfloor \\
\left|\left\{ \left(x,y\right)\in L_{2}\mid x=j\right\} \right| & =\left\lfloor \frac{j\cdot p}{q}\right\rfloor 
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow t_{2}:=\left|L_{2}\right| & =\sum_{i=1}^{\frac{p-1}{2}}\left\lfloor \frac{i\cdot q}{p}\right\rfloor \\
\Rightarrow t_{1}:=\left|L_{1}\right| & =\sum_{j=1}^{\frac{q-1}{2}}\left\lfloor \frac{j\cdot p}{q}\right\rfloor 
\end{align*}


\end_inset
נזכור שע"פ הלמה האחרונה (
\begin_inset CommandInset ref
LatexCommand ref
reference "lemma 4.8"
plural false
caps false
noprefix false
nolink false
\end_inset
) מתקיים:
\begin_inset Formula
\begin{align*}
\left(\begin{array}{c}
q\\
\hline p
\end{array}\right) & =\left(-1\right)^{t_{2}}\\
\left(\begin{array}{c}
p\\
\hline q
\end{array}\right) & =\left(-1\right)^{t_{1}}
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow\left(\begin{array}{c}
q\\
\hline p
\end{array}\right)\cdot\left(\begin{array}{c}
p\\
\hline q
\end{array}\right) & =\left(-1\right)^{t_{2}+t_{1}}=\left(-1\right)^{\left|L_{2}\right|+\left|L_{1}\right|}\\
 & =\left(-1\right)^{\left|L\right|}=\left(-1\right)^{\frac{p-1}{2}\cdot\frac{q-1}{2}}
\end{align*}


\end_inset

\end_layout

