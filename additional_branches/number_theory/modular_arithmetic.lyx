 אני רוצה להביא כאן המחשה קטנה לחשיבות האינטואיטיבית של העובדה שעבור מספרים זרים ניתן להציג את 
\begin_inset Formula
$1$
\end_inset
 כצר"ל שלהם:
\begin_inset Formula
\begin{align*}
x & \equiv{\color{red}1}\mod 3\\
x & \equiv{\color{blue}2}\mod 5\\
x & \equiv{\color{green}2}\mod 7
\end{align*}


\end_inset
אמנם ניתן לפתור זאת ע"פ ההוכחה השנייה שלמדנו אולם ישנה דרך דומה אבל קצרה הרבה יותר כשמדובר במספרים קטנים:
\begin_inset Formula
\begin{align*}
 & 3\cdot2\equiv{\color{violet}6}\equiv1\mod 5\\
 & {\color{blue}2}-{\color{red}1}=1\equiv1\mod 5\\
\Rightarrow & {\color{orange}7}={\color{violet}6}\cdot\left({\color{blue}2}-{\color{red}1}\right)+{\color{red}1}\equiv0+1\equiv{\color{red}1}\equiv x\mod 3\\
\Rightarrow & {\color{orange}7}={\color{violet}6}\cdot\left({\color{blue}2}-{\color{red}1}\right)+{\color{red}1}\equiv1+1\equiv{\color{blue}2}\equiv x\mod 5\\
 & \left(3\cdot5\right)\equiv{\color{purple}15}\equiv1\mod 7\\
 & {\color{orange}7}\equiv0\mod 7\\
\Rightarrow & {\color{green}2}-{\color{orange}7}\equiv{\color{green}2}\mod 7\\
\Rightarrow & 37={\color{purple}15}\cdot{\color{green}2}+{\color{orange}7}\equiv{\color{purple}15}\cdot\left({\color{green}2}-{\color{orange}7}\right)+{\color{orange}7}\equiv{\color{orange}7}\equiv{\color{violet}6}\cdot\left({\color{blue}2}-{\color{red}1}\right)+{\color{red}1}\equiv{\color{red}1}\equiv x\mod 3\\
\Rightarrow & 37={\color{purple}15}\cdot{\color{green}2}+{\color{orange}7}\equiv{\color{purple}15}\cdot\left({\color{green}2}-{\color{orange}7}\right)+{\color{orange}7}\equiv{\color{orange}7}\equiv{\color{violet}6}\cdot\left({\color{blue}2}-{\color{red}1}\right)+{\color{red}1}\equiv{\color{blue}2}\equiv x\mod 5\\
\Rightarrow & 37={\color{purple}15}\cdot{\color{green}2}+{\color{orange}7}\equiv{\color{purple}15}\cdot\left({\color{green}2}-{\color{orange}7}\right)+{\color{orange}7}\equiv{\color{green}2}\equiv x\mod 7
\end{align*}


\end_inset
כלומר אני מסובב את גלגל השעון של 
\begin_inset Formula
$3$
\end_inset
 כדי לקבל 
\begin_inset Formula
$1$
\end_inset
 בשעון של 
\begin_inset Formula
$5$
\end_inset
 (קיבלנו 
\begin_inset Formula
$6$
\end_inset
), כעת אני בודק כמה אני צריך להוסיף ל-
\begin_inset Formula
${\color{red}1}$
\end_inset
 כדי לקבל את 
\begin_inset Formula
${\color{blue}2}$
\end_inset
 (בשעון של 
\begin_inset Formula
$5$
\end_inset
) ומוסיף ל-
\begin_inset Formula
${\color{red}1}$
\end_inset
 (בשעון של 
\begin_inset Formula
$5$
\end_inset
) את 
\begin_inset Formula
$6$
\end_inset
 כפול ההפרש (קיבלנו 
\begin_inset Formula
${\color{orange}7}$
\end_inset
); לאחר מכן אני מסובב את גלגל השעון של 
\begin_inset Formula
$3\cdot5$
\end_inset
 כדי לקבל 
\begin_inset Formula
$1$
\end_inset
 בשעון של 
\begin_inset Formula
$7$
\end_inset
 (קיבלנו 
\begin_inset Formula
$15$
\end_inset
), כעת אני בודק כמה אני צריך להוסיף ל-
\begin_inset Formula
${\color{orange}7}$
\end_inset
 כדי לקבל את 
\begin_inset Formula
${\color{green}2}$
\end_inset
 (בשעון של 
\begin_inset Formula
$7$
\end_inset
) ומוסיף ל-
\begin_inset Formula
${\color{orange}7}$
\end_inset
 (בשעון של 
\begin_inset Formula
$7$
\end_inset
 שזה 
\begin_inset Formula
$0$
\end_inset
!) את 
\begin_inset Formula
${\color{purple}15}$
\end_inset
 כפול ההפרש
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
ניתן היה גם להתייחס ל-
\begin_inset Formula
${\color{green}2}-{\color{orange}7}$
\end_inset
 כ-
\begin_inset Formula
$-5$
\end_inset
 ואז היינו מקבלים 
\begin_inset Formula
$-68={\color{purple}15}\cdot\left(-5\right)+{\color{orange}7}\equiv37\mod 105$
\end_inset
 (והרי 
\begin_inset Formula
$105=3\cdot5\cdot7$
\end_inset
).
\end_layout

\end_inset
. בכל שלב מובטח שהכול יהיה תקין מפני שאני מוסיף כפולות של כל המספרים שכבר עברתי, כך שאצלם אני לא משנה דבר, ובמספר שאני עובד עליו עכשיו אני מוסיף אחדות ולכן אוכל להגיע לאן שארצה.
