בפרק על פולינומי טיילור שלכל 
\begin_inset Formula
$a\in\MKreal$
\end_inset
 מתקיים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
פולינום טיילור של פולינום, מסדר שווה לדרגת הפולינום, שווה לו עצמו בכל נקודה.
\end_layout

\end_inset
:
\begin_inset Formula
\[
P_{n,f,a}\left(x\right)=f\left(x\right)
\]


\end_inset
בפרט הדבר נכון עבור 
\begin_inset Formula
$a\in\MKinteger$
\end_inset
 המקיים 
\begin_inset Formula
$f\left(a\right)\equiv0\mod p^{e}$
\end_inset
, נניח שאכן יש ל-
\begin_inset Formula
$f$
\end_inset
 שורש מודולו 
\begin_inset Formula
$p^{e}$
\end_inset
 ויהי 
\begin_inset Formula
$a\in\MKinteger$
\end_inset
 שורש כזה. כעת נשים לבל לכך שלכל 
\begin_inset Formula
$t\in\MKinteger$
\end_inset
 מתקיים:
\begin_inset Formula
\[
f\left(a+t\cdot p^{e}\right)=P_{n,f,a}\left(a+t\cdot p^{e}\right)=\sum_{k=0}^{n}\frac{f^{\left(k\right)}\left(a\right)}{k!}\cdot\left(a+t\cdot p^{e}-a\right)^{k}=\sum_{k=0}^{n}\frac{f^{\left(k\right)}\left(a\right)}{k!}\cdot\left(t\cdot p^{e}\right)^{k}
\]


\end_inset
אך לכל 
\begin_inset Formula
$2\leq k\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$\left(t\cdot p^{e}\right)^{k}\equiv t^{k}\cdot p^{e\cdot k}\equiv0\mod p^{e+1}$
\end_inset
 ומכאן נובע כי לכל 
\begin_inset Formula
$t\in\MKinteger$
\end_inset
 מתקיים:
\begin_inset Formula
\[
f\left(a+t\cdot p^{e}\right)=\sum_{k=0}^{n}\frac{f^{\left(k\right)}}{k!}\cdot\left(t\cdot p^{e}\right)^{k}\equiv f\left(a\right)+f'\left(a\right)\cdot t\cdot p^{e}\mod p^{e+1}
\]


\end_inset
מהגדרה 
\begin_inset Formula
$f\left(a\right)\equiv0\mod p^{e}$
\end_inset
, א"כ קיים 
\begin_inset Formula
$k\in\MKinteger$
\end_inset
 כך ש-
\begin_inset Formula
$f\left(a\right)=k\cdot p^{e}$
\end_inset
, יהי 
\begin_inset Formula
$k$
\end_inset
 כנ"ל (
\begin_inset Formula
$k:=\frac{f\left(a\right)}{p^{e}}$
\end_inset
) ומכאן שמתקיים:
\begin_inset Formula
\[
f\left(a+t\cdot p^{e}\right)\equiv p^{e}\cdot\left(k+f'\left(a\right)\cdot t\right)\mod p^{e+1}
\]


\end_inset
כעת, אם 
\begin_inset Formula
$f'\left(a\right)\not\equiv0\mod p$
\end_inset
 אז יש ל-
\begin_inset Formula
$f'\left(a\right)$
\end_inset
 הופכי מודולו 
\begin_inset Formula
$p$
\end_inset
 ואותו הופכי מקיים:
\begin_inset Formula
\begin{align*}
f\left(a+t\cdot p^{e}\right)\equiv0\mod p^{e+1} & \Longleftrightarrow k+f'\left(a\right)\cdot t\equiv0\mod p\\
 & \Longleftrightarrow t\equiv-f'\left(a\right)^{-1}\cdot k\equiv-f'\left(a\right)^{-1}\cdot\frac{f\left(a\right)}{p^{e}}\mod p
\end{align*}


\end_inset
אנחנו יודעים שלכל שורש 
\begin_inset Formula
$b\in\MKinteger$
\end_inset
 של 
\begin_inset Formula
$f$
\end_inset
 מודולו 
\begin_inset Formula
$p^{e+1}$
\end_inset
 קיים 
\begin_inset Formula
$t\in\MKinteger$
\end_inset
 כך ש-
\begin_inset Formula
$b\equiv a+t\cdot p^{e}\mod p^{e+1}$
\end_inset
 ולכן השורה הקודמת מראה הן את הקיום של 
\begin_inset Formula
$t$
\end_inset
 כזה והן את יחידותו מודולו 
\begin_inset Formula
$p$
\end_inset
, יחידות זו נותנת גם את היחידות של מודולו 
\begin_inset Formula
$p^{e+1}$
\end_inset
 מפני שלכל 
\begin_inset Formula
$t_{1},t_{2}\in\MKinteger$
\end_inset
 כך ש-
\begin_inset Formula
$t_{1}\equiv t_{2}\mod p$
\end_inset
 (כלומר 
\begin_inset Formula
$p\mid t_{1}-t_{2}$
\end_inset
) מתקיים גם 
\begin_inset Formula
$t_{1}\cdot p^{e}\equiv t_{2}\cdot p^{e}$
\end_inset
 (כלומר 
\begin_inset Formula
$p^{e+1}\mid\left(t_{1}-t_{2}\right)\cdot p^{e}$
\end_inset
).
