רק באינדוקציה
\bar default

\begin_inset Newline newline
\end_inset
נוכיח את המשפט באינדוקציה על 
\begin_inset Formula
$k$
\end_inset
, עבור 
\begin_inset Formula
$k=1$
\end_inset
 המשפט טריוויאלי ולכן נעבור לצעד האינדוקציה.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$k\in\MKnatural$
\end_inset
, יהיו 
\begin_inset Formula
$1<m_{1},m_{2},\ldots,m_{k}\in\MKnatural$
\end_inset
 זרים זה לזה בזוגות ו-
\begin_inset Formula
$a_{1},a_{2},\ldots,a_{k}\in\MKinteger$
\end_inset
; נניח שקיים 
\begin_inset Formula
$x\in\MKinteger$
\end_inset
 כך שמתקיים (הנחת האינדוקציה):
\begin_inset Formula
\begin{align*}
x & \equiv a_{1}\mod m_{1}\\
x & \equiv a_{2}\mod m_{2}\\
 & \vdots\\
x & \equiv a_{k}\mod m_{k}
\end{align*}


\end_inset
ויהי 
\begin_inset Formula
$x$
\end_inset
 כנ"ל.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$1<m_{k+1}\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$\gcd\left(m_{k+1},m_{i}\right)=1$
\end_inset
 לכל 
\begin_inset Formula
$k\geq i\in\MKnatural$
\end_inset
 ויהא 
\begin_inset Formula
$a_{k+1}\in\MKinteger$
\end_inset
.
\begin_inset Newline newline
\end_inset
נסמן 
\begin_inset Formula
$\begin{alignedat}{1}m:=\begin{alignedat}{1}\prod_{i=1}^{k}m_{i}\end{alignedat}
\end{alignedat}
$

\end_inset
, מהגדרה מתקיים 
\begin_inset Formula
$\gcd\left(m_{k+1},m\right)=1$
\end_inset
 ולכן קיימים 
\begin_inset Formula
$r,s\in\MKinteger$
\end_inset
 כך ש-
\begin_inset Formula
$r\cdot m_{k+1}+s\cdot m=1$
\end_inset
, יהיו 
\begin_inset Formula
$r,s$
\end_inset
 כנ"ל.
\begin_inset Formula
\begin{align*}
 & \Rightarrow a_{k+1}-x=\left(a_{k+1}-x\right)\cdot r\cdot m_{k+1}+\left(a_{k+1}-x\right)\cdot s\cdot m\\
 & \Rightarrow a_{k+1}-x\equiv\left(a_{k+1}-x\right)\cdot s\cdot m\mod m_{k+1}\\
 & \Rightarrow a_{k+1}\equiv x+\left(a_{k+1}-x\right)\cdot s\cdot m\mod m_{k+1}
\end{align*}


\end_inset
כמובן שמתקיים 
\begin_inset Formula
$x+\left(a_{k+1}-x\right)\cdot s\cdot m\equiv x\mod m$
\end_inset
 ולכן 
\begin_inset Formula
$x+\left(a_{k+1}-x\right)\cdot s\cdot m\equiv a_{i}\mod m_{i}$
\end_inset
 לכל 
\begin_inset Formula
$k\geq i\in\MKnatural$
\end_inset
.
\begin_inset Newline newline
\end_inset
א"כ הוכחנו את הקיום של הפתרון, היחידות נובעת כרגיל מעקרון שובך היונים.
