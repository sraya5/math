\begin_layout Proof
נסמן 
\begin_inset Formula $x:=\frac{a}{c},\ y:=\frac{b}{c}$
\end_inset

 ונזכור שאנו עוסקים במקרה שבו 
\begin_inset Formula $b\neq0$
\end_inset

 ומכאן ש-
\begin_inset Formula $a^{2}\neq c^{2}$
\end_inset

 ולכן 
\begin_inset Formula $a\neq-c$
\end_inset

 וממילא 
\begin_inset Formula $x\neq-1$
\end_inset

.
\begin_inset Newline newline
\end_inset

יהי 
\begin_inset Formula $l\in\MKreal$
\end_inset

 השיפוע שבין הנקודות 
\begin_inset Formula $\left(x,y\right)$
\end_inset

 ו-
\begin_inset Formula $\left(-1,0\right)$
\end_inset

, מהגדרה זהו 
\begin_inset Formula $l:=\frac{y}{x+1}=\frac{b}{a+c}\neq0$
\end_inset

 ולכן 
\begin_inset Formula $l$
\end_inset

 רציונלי, א
"
כ יהיו 
\begin_inset Formula $m,n\in\MKnatural$
\end_inset

 כך ש-
\begin_inset Formula $l=\frac{n}{m}$
\end_inset

.
\begin_inset Newline newline
\end_inset


\begin_inset Formula $x$
\end_inset

 ו-
\begin_inset Formula $y$
\end_inset

 מקיימים:
\begin_inset Formula 
\[
y=l\left(x+1\right)
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow x^{2}+kl^{2}\left(x+1\right)^{2}=x^{2}+ky^{2}=\left(\frac{a}{c}\right)^{2}+k\left(\frac{b}{c}\right)^{2}=\frac{a^{2}+kb^{2}}{c^{2}}=\frac{c^{2}}{c^{2}}=1
\]

\end_inset

לכל 
\begin_inset Formula $-1\neq r\in\MKreal$
\end_inset

 המקיים 
\begin_inset Formula $r^{2}+kl^{2}\left(r+1\right)^{2}=1$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
0 & =r^{2}+kl^{2}\left(r+1\right)^{2}-1\\
