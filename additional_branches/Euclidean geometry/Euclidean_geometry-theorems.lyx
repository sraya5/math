\begin_layout Standard
\inset Branch proofs
inverted 0status collapsed
\begin_layout Proof
ע"פ א"ש הפירמידה מתקיים:
\begin_inset Formula
\begin{align*}
\measuredangle AOB & \leq\measuredangle AOC+\measuredangle COB\\
\measuredangle BOC & \leq\measuredangle BOA+\measuredangle AOC
\end{align*}


\end_inset
ולכן גם:
\begin_inset Formula
\begin{align*}
\measuredangle AOB-\measuredangle COB & \leq\measuredangle AOC\\
\measuredangle BOC-\measuredangle BOA & \leq\measuredangle AOC
\end{align*}


\end_inset
כעת, מהסימטריה של פונקציית הזווית נובע כי:
\begin_inset Formula
\begin{align*}
\measuredangle AOB-\measuredangle BOC & \leq\measuredangle AOC\\
\measuredangle BOC-\measuredangle AOB & \leq\measuredangle AOC
\end{align*}


\end_inset
ומכיוון שבהכרח מתקיים 
\begin_inset Formula
$\left|\measuredangle AOB-\measuredangle BOC\right|=\measuredangle AOB-\measuredangle BOC$
\end_inset
 ו/או 
\begin_inset Formula
$\left|\measuredangle AOB-\measuredangle BOC\right|=\measuredangle BOC-\measuredangle AOB$
\end_inset
 נדע ש-
\begin_inset Formula
$\left|\measuredangle AOB-\measuredangle BOC\right|\leq\measuredangle AOC$
\end_inset
.
\end_layout

\end_layout

\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "claim 1.2"
\end_inset

\begin_inset Formula
$\measuredangle AOB$
\end_inset
 היא זווית שטוחה אם"ם 
\begin_inset Formula
$\measuredangle ABO$
\end_inset
 ו-
\begin_inset Formula
$\measuredangle OAB$
\end_inset
 הן זוויות מנוונות.
\end_layout

\begin_layout Standard
\inset Branch proofs
inverted 0status collapsed
\begin_layout Proof
\begin_inset space \space{}
\end_inset

\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula
$\Leftarrow$
\end_inset

\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$\measuredangle AOB$
\end_inset
 היא זווית שטוחה (כלומר 
\begin_inset Formula
$\measuredangle AOB=\frac{1}{2}$
\end_inset
), ע"פ שוויונות המשולש המנוון מתקיים 
\begin_inset Formula
$\left|AB\right|=\left|AO\right|+\left|OB\right|$
\end_inset
, ומכאן שגם:
\begin_inset Formula
\begin{align*}
\left|AO\right| & =\left|\left|AO\right|\right|=\left|\left|AB\right|-\left|OB\right|\right|=\left|\left|AB\right|-\left|BO\right|\right|\\
\left|OB\right| & =\left|\left|OB\right|\right|=\left|\left|AB\right|-\left|AO\right|\right|=\left|\left|AB\right|-\left|BO\right|\right|
\end{align*}


\end_inset
כעת, משוויונות המשולש המנוון נקבל ש-
\begin_inset Formula
$\measuredangle ABO=\measuredangle OAB=0$
\end_inset
, כלומר 
\begin_inset Formula
$\measuredangle ABO$
\end_inset
 ו-
\begin_inset Formula
$\measuredangle OAB$
\end_inset
 הן זוויות מנוונות.
\end_layout

\begin_layout Itemize
\begin_inset Formula
$\Rightarrow$
\end_inset

\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$\measuredangle ABO$
\end_inset
 ו-
\begin_inset Formula
$\measuredangle OAB$
\end_inset
 הן זוויות מנוונות (כלומר 
\begin_inset Formula
$\measuredangle ABO=\measuredangle OAB=0$
\end_inset
), ולכן ע"פ שוויונות המשולש המנוון מתקיים:
\begin_inset Formula
\begin{align*}
\left|AO\right|= & \left|\left|BO\right|-\left|BA\right|\right|=\left|\left|AB\right|-\left|OB\right|\right|\\
\left|OB\right|= & \left|\left|AB\right|-\left|AO\right|\right|
\end{align*}


\end_inset
נשים לב לכך שאם 
\begin_inset Formula
$\left|AB\right|\geq\left|OB\right|$
\end_inset
 ו/או 
\begin_inset Formula
$\left|AB\right|\geq\left|AO\right|$
\end_inset
 אז ע"י העברת אגף נקבל ש-
\begin_inset Formula
$\left|AB\right|=\left|AO\right|+\left|OB\right|$
\end_inset
, ומכאן ש-
\begin_inset Formula
$\measuredangle AOB$
\end_inset
 היא זווית שטוחה (שוויונות המשולש המנוון).
\begin_inset Newline newline
\end_inset
א"כ נניח בשלילה ש-
\begin_inset Formula
$\left|AB\right|<\left|OB\right|$
\end_inset
 וגם 
\begin_inset Formula
$\left|AB\right|<\left|AO\right|$
\end_inset
 אז מתקיים:
\begin_inset Formula
\begin{align*}
\left|AO\right|= & \left|OB\right|-\left|AB\right|\\
\left|OB\right|= & \left|AO\right|-\left|AB\right|
\end{align*}


\end_inset
כלומר:
\begin_inset Formula
\begin{align*}
\left|OA\right|+\left|AB\right| & =\left|AB\right|+\left|AO\right|=\left|OB\right|=\left|BO\right|\\
\left|AB\right|+\left|OB\right| & =\left|AB\right|+\left|OB\right|=\left|AO\right|
\end{align*}


\end_inset
ולכן ע"פ שוויונות המשולש המנוון, הזוויות 
\begin_inset Formula
$\measuredangle OAB$
\end_inset
 ו-
\begin_inset Formula
$\measuredangle ABO$
\end_inset
 הן זוויות שטוחות - בסתירה להנחה שהן מנוונות.
\begin_inset Newline newline
\end_inset
מכאן ש-
\begin_inset Formula
$\left|AB\right|\geq\left|OB\right|$
\end_inset
 ו/או 
\begin_inset Formula
$\left|AB\right|\geq\left|AO\right|$
\end_inset
 וכפי שהראינו לעיל נובע מזה ש-
\begin_inset Formula
$\measuredangle AOB$
\end_inset
 היא זווית שטוחה.
\end_layout

