\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 עד כה, בכל פעם שרצינו לתאר שתי שאלות הסתברותיות שונות, היינו צריכים להגדיר שתי פונקציות הסתברות שונות אפילו אם מבחינה מעשית שתי השאלות חלו על אותו "ניסוי". לדוגמה: מטילים שתי קוביות, מהי ההסתברות שבאחת הקוביות יצא המספר 
\begin_inset Formula
$2$
\end_inset
? ומהי ההסתברות שסכום המספרים שיצאו הוא 
\begin_inset Formula
$2$
\end_inset
?
\begin_inset Newline newline
\end_inset
זה היה די מייגע, ולכן נרצה למצוא דרך לפרמל שתי שאלות על אותו "ניסוי" ע"י מרחב הסתברות יחיד, הדרך לכך היא הגדרת משתנים מקריים.
\end_layout

\begin_layout Definition
\series bold
משתנה מקרי
\series default

\begin_inset Newline newline
\end_inset
נאמר שפונקציה 
\begin_inset Formula
$X:\Omega\rightarrow E$
\end_inset
 היא 
\bar under
משתנה מקרי
\bar default
 אם מתקיים 
\begin_inset Formula
$X^{-1}\left(S\right)\in\MKclf$
\end_inset
 לכל 
\begin_inset Formula
$S\in\MKclf_{E}$
\end_inset
; במקרה שבו 
\begin_inset Formula
$E=\MKreal^{n}$
\end_inset
 (
\begin_inset Formula
$n\in\MKnatural$
\end_inset
) נאמר גם ש-
\begin_inset Formula
$X$
\end_inset
 הוא 
\bar under
וקטור מקרי
\bar default
.
\end_layout

\begin_layout Standard
\series bold
\color red
בכיתה הגדרנו זאת רק כאשר 
\begin_inset Formula
$E=\MKreal^{n}$
\end_inset
 עבור 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 כלשהו (
\begin_inset Formula
$\MKreal\cong\MKreal^{1}$
\end_inset
), ובנוסף לא דרשנו שיתקיים 
\begin_inset Formula
$X^{-1}\left(S\right)\in\MKclf$
\end_inset
 לכל 
\begin_inset Formula
$S\in\MKclf_{E}$
\end_inset
 למרות שאנחנו נראה כבר בהגדרה הבאה שאנו מניחים שזה אכן נכון.
\color inherit

\series default

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כך למשל במקרה של הטלת שתי הקוביות נשתמש בפונקציית ההסתברות האחידה 
\begin_inset Formula
$\MKbbp:\left[6\right]^{2}\rightarrow\MKreal$
\end_inset
 על 
\begin_inset Formula
$\left(\left[6\right]^{2},\MKclp\left(\left[6\right]^{2}\right)\right)$
\end_inset
, ונגדיר שני משתנים מקריים:
\begin_inset Formula
\begin{align*}
X\left(\left(\omega_{1},\omega_{2}\right)\right) & :=\begin{cases}
1 & \omega_{1}=2\lor\omega_{2}=2\\
0 & \text{אחרת}
\end{cases}\\
Y\left(\left(\omega_{1},\omega_{2}\right)\right) & :=\omega_{1}+\omega_{2}
\end{align*}


\end_inset
כעת ההסתברות לכך שבאחת משתי הקוביות יצא 
\begin_inset Formula
$2$
\end_inset
 היא 
\begin_inset Formula
$\MKbbp\left(X^{-1}\left(\left\{ 1\right\} \right)\right)$
\end_inset
, וההסתברות לכך שסכום שתי הקוביות הוא 
\begin_inset Formula
$2$
\end_inset
 היא 
\begin_inset Formula
$\MKbbp\left(Y^{-1}\left(\left\{ 2\right\} \right)\right)$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 עוד דבר מייגע שהיה בשיטה הקודמת הוא שבכל פעם שרצינו לדבר על מאורע היינו צריכים להגדיר קבוצה שתתאר את אותו מאורע, כאשר הרבה יותר נוח לכתוב פסוק המתאר את המאורע.
\end_layout

