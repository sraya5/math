\begin_layout Theorem
\series bold
נוסחת ההכלה וההדחה
\series default

\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$\MKseq A,n\in\MKclf$
\end_inset
 מאורעות, ולכל 
\begin_inset Formula
$\emptyset\neq I\subseteq\left[n\right]$
\end_inset
 נסמן 
\begin_inset Formula
${\displaystyle A_{I}:=\bigcap_{i\in I}A_{i}}$
\end_inset
. מתקיים:
\begin_inset Formula
\[
\MKbbp\left(\bigcup_{i=1}^{n}A_{i}\right)=\sum_{k=1}^{n}\left(-1\right)^{k+1}\cdot\left(\sum_{\begin{array}{c}
I\subseteq\left[n\right]\\
\left|I\right|=k
\end{array}}\MKbbp\left(A_{I}\right)\right)=\sum_{\emptyset\neq I\subseteq\left[n\right]}\left(-1\right)^{\left|I\right|+1}\cdot\MKbbp\left(A_{I}\right)
\]


\end_inset

\end_layout

\begin_deeper
\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 בד"כ לא נצטרך את נוסחת ההכלה וההדחה ליותר משלושה מאורעות, לכן נביא כאן את הנוסחה עבור שניים ושלושה מאורעות. לכל שלושה מאורעות 
\begin_inset Formula
$A,B,C\in\MKclf$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\MKbbp\left(A\cup B\right)=\MKbbp\left(A\right)+\MKbbp\left(B\right)-\MKbbp\left(A\cap B\right)
\]


\end_inset

\begin_inset Formula
\[
\MKbbp\left(A\cup B\cup C\right)=\MKbbp\left(A\right)+\MKbbp\left(B\right)+\MKbbp\left(C\right)-\left(\MKbbp\left(A\cap B\right)+\MKbbp\left(B\cap C\right)+\MKbbp\left(C\cap A\right)\right)+\MKbbp\left(A\cap B\cap C\right)
\]


\end_inset

\end_layout

\end_deeper

