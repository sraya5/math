\begin_layout Subsubsection*
חיבור
\end_layout

\begin_layout Standard
בהינתן שתי חתיכות עוגה שהמספרים המתאימים להן הם 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{2}}{n_{2}}$
\end_inset
 נרצה לקבוע מהי כמות העוגות בשתיהן יחד, ברור לכולנו שאם 
\begin_inset Formula
$n_{1}=n_{2}$
\end_inset
 אז התשובה פשוטה:
\begin_inset Formula
\[
\frac{m_{1}}{n_{1}}+\frac{m_{2}}{n_{2}}=\frac{m_{1}}{n_{1}}+\frac{m_{2}}{n_{1}}=\frac{m_{1}+m_{2}}{n_{1}}
\]


\end_inset
משום שאנו בעצם סופרים כמה חתיכות בגודל 
\begin_inset Formula
$\frac{1}{n_{1}}$
\end_inset
 נכנסות בשתיהן יחד; אבל מה קורה אם 
\begin_inset Formula
$n_{1}\neq n_{2}$
\end_inset
? מכיוון שאנחנו לא יכולים לחבר מספרים רציונליים שהמכנה שלהם שונה הדרך היחידה שעומדת לרשותנו היא לדאוג שהמכנה יהיה שווה, אבל איך נעשה זאת? ודאי תאמרו "מה הבעיה? עושים מכנה משותף וסיימנו", הבעיה היא שאנחנו לא מניחים כעת מערכת אקסיומות שעליה אני יכול להסתמך ולהוכיח שהטריק של מכנה משותף אכן עובד, הפרק הזה נכתב כדי להסביר מדוע בחרנו במערכת האקסיומות הזו, ולכן אני צריך להצדיק את הרעיון מבחינה אינטואיטיבית ולשם כך אני צריך לספר לכם קודם מהו כפל של מספר רציונלי במספר טבעי. ובכן, כבר יש לנו הגדרה עבור כפל של מספרים טבעיים וניתן להכליל אותה בקלות עבור כפל של מספר טבעי במספר רציונלי: המכפלה 
\begin_inset Formula
$k\times\frac{m}{n}$
\end_inset
 היא בעצם:
\begin_inset Formula
\[
\overset{k\ \text{פעמים}}{\overbrace{\frac{m}{n}+\frac{m}{n}+\ldots+\frac{m}{n}}}
\]


\end_inset
ושוב פירושו של הסימון "
\begin_inset Formula
$\times$
\end_inset
" הוא 
\series bold
פעמים
\series default
 כפי שלמדנו ביסודי ו-"
\begin_inset Formula
$k\times\frac{m}{n}$
\end_inset
" הוא "
\begin_inset Formula
$k$
\end_inset
 
\series bold
פעמים
\series default
 
\begin_inset Formula
$\frac{m}{n}$
\end_inset
".
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 שימו לב שנכון לעכשיו כפל מספר טבעי במספר רציונלי מוגדר רק כאשר המספר הטבעי נמצא משמאל והרציונלי מימין, הסיבה לכך היא שהתפקיד של המספר בצד שמאל הוא לקבוע כמה 
\series bold
פעמים
\series default
 יש לחבר את המספר שבצד ימין. נכון אני יכול להחליט שהכפל הזה חילופי ובכך להגדיר גם את המצב ההפוך, אני לא אעשה זאת מפני שאין לזה הצדקה אינטואיטיבית כעת, וגם מפני שזה לא יעזור לנו להגדיר כפל של שני מספרים רציונליים.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ושוב מהמהות של כפל במספר טבעי נקבל ש-
\begin_inset Formula
$1\cdot\frac{n}{m}=\frac{n}{m}$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כבר כעת ניתן לראות ש-
\begin_inset Formula
$n\times\frac{m}{n}=m$
\end_inset
 ולכן הסימון 
\begin_inset Formula
$\frac{p}{q}$
\end_inset
 מייצג בעצם את החילוק 
\begin_inset Formula
$p\div q$
\end_inset
.
\end_layout

\begin_layout Standard
מסקנה ראשונה שניתן להסיק מכאן היא שמתקיים 
\begin_inset Formula
$\frac{m}{n}=m\times\frac{1}{n}$
\end_inset
, נשים לב לכך שמתקיים גם 
\begin_inset Formula
$\frac{1}{n}=\frac{m}{n\times m}$
\end_inset
 שכן 
\begin_inset Formula
$1$
\end_inset
 "נכנס" 
\begin_inset Formula
$n$
\end_inset
 פעמים ב-
\begin_inset Formula
$n$
\end_inset
, וגם 
\begin_inset Formula
$m$
\end_inset
 "נכנס" 
\begin_inset Formula
$n$
\end_inset
 פעמים ב-
\begin_inset Formula
$n\times m$
\end_inset
, וביחד עם המסקנה הראשונה נקבל שמתקיים 
\begin_inset Formula
$\frac{1}{n}=m\times\frac{1}{n\times m}$
\end_inset
.
\begin_inset Newline newline
\end_inset
לפני שנוכל להמשיך אני רוצה שנשים לב לכך שכפל מספר טבעי במספר רציונלי מקיים את חוק הקיבוץ: מתקיים
\begin_inset Newline newline
\end_inset

\begin_inset Formula
$\left(l\times k\right)\times\frac{m}{n}=l\times\left(k\times\frac{m}{n}\right)$
\end_inset
, האינטואיציה זהה לזו שראינו עבור כפל של טבעיים.
\begin_inset Newline newline
\end_inset
וסוף סוף אנחנו יכולים להפעיל את הטריק של מכנה משותף, מתקיים:
\begin_inset Formula
\begin{align*}
\frac{m_{1}}{n_{1}}+\frac{m_{2}}{n_{2}} & =m_{1}\times\frac{1}{n_{1}}+m_{2}\times\frac{1}{n_{2}}=m_{1}\times\frac{n_{2}}{n_{1}\times n_{2}}+m_{2}\times\frac{n_{1}}{{\color{red}n_{2}\times n_{1}}}\\
 & =m_{1}\times\frac{n_{2}}{n_{1}\times n_{2}}+m_{2}\times\frac{n_{1}}{{\color{red}n_{1}\times n_{2}}}=m_{1}\times\left(n_{2}\times\frac{1}{n_{1}\times n_{2}}\right)+m_{2}\times\left(n_{1}\times\frac{1}{n_{1}\times n_{2}}\right)\\
 & =\left(m_{1}\times n_{2}\right)\times\frac{1}{n_{1}\times n_{2}}+\left(m_{2}\times n_{1}\right)\times\frac{1}{n_{1}\times n_{2}}\\
 & =\frac{m_{1}\times n_{2}}{n_{1}\times n_{2}}+\frac{m_{2}\times n_{1}}{n_{1}\times n_{2}}=\frac{m_{1}\times n_{2}+m_{2}\times n_{1}}{n_{1}\times n_{2}}
\end{align*}


\end_inset
האינטואיציה דורשת ש
\series bold
חיבור של מספרים רציונליים יקיים את חוקי החילוף והקיבוץ
\series default
 מאותן סיבות שדרשה זאת עבור הטבעיים.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מי שרוצה מוזמן לוודא שזה אכן מסתדר עם הנוסחה שהבאנו לעיל (כדי לעשות זאת יש להשתמש בכל החוקים שראינו עבור הטבעיים הן לגבי חיבור והן לגבי כפל).
\end_layout

\begin_layout Subsubsection*
יחס סדר
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כעת, לאחר שהבנו מדוע הטריק של מכנה משותף צריך לעבוד, נוכל להגדיר את יחס הסדר על המספרים הרציונליים באמצעות זה של הטבעיים וכך נוכל להגדיר גם את החיסור של מספרים רציונליים.
\end_layout

\begin_layout Standard
לאחר שהכרנו את הטריק של מכנה משותף ברור לכולנו כיצד יעבוד יחס הסדר על המספרים הרציונליים, עבור 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{2}}{n_{2}}$
\end_inset
 תתקיים בדיוק אחת משלוש האפשרויות הבאות:
\end_layout

\begin_layout Enumerate
אם 
\begin_inset Formula
$m_{1}\times n_{2}=m_{2}\times n_{1}$
\end_inset
 אז 
\begin_inset Formula
$\begin{alignedat}{1}\frac{m_{1}}{n_{1}}=\frac{m_{2}}{n_{2}}\end{alignedat}
$

\end_inset
.
\end_layout

\begin_layout Enumerate
אם 
\begin_inset Formula
$m_{1}\times n_{2}<m_{2}\times n_{1}$
\end_inset
 אז 
\begin_inset Formula
$\begin{alignedat}{1}\frac{m_{1}}{n_{1}}<\frac{m_{2}}{n_{2}}\end{alignedat}
$

\end_inset
 (או 
\begin_inset Formula
$\begin{alignedat}{1}\frac{m_{2}}{n_{2}}>\frac{m_{1}}{n_{1}}\end{alignedat}
$

\end_inset
).
\end_layout

\begin_layout Enumerate
אם 
\begin_inset Formula
$m_{1}\times n_{2}>m_{2}\times n_{1}$
\end_inset
 אז 
\begin_inset Formula
$\begin{alignedat}{1}\frac{m_{1}}{n_{1}}>\frac{m_{2}}{n_{2}}\end{alignedat}
$

\end_inset
 (או 
\begin_inset Formula
$\begin{alignedat}{1}\frac{m_{2}}{n_{2}}<\frac{m_{1}}{n_{1}}\end{alignedat}
$

\end_inset
).
\end_layout

\begin_layout Standard
וזאת מכיוון שמתקיים:
\begin_inset Formula
\[
\frac{m_{1}}{n_{1}}=\frac{m_{1}\times n_{2}}{n_{1}\times n_{2}},\ \frac{m_{2}}{n_{2}}=\frac{m_{2}\times n_{1}}{n_{1}\times n_{2}}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ושוב, ניתן להסיק מכאן את הטרנזיטיביות וההלימה לחיבור גם עבור מספרים רציונליים.
\end_layout

\begin_layout Subsubsection*
חיסור
\end_layout

\begin_layout Standard
כמו כן הטריק של המכנה המשותף מסביר לנו מדוע צריך להתקיים:
\begin_inset Formula
\[
\frac{m_{1}}{n_{1}}-\frac{m_{2}}{n_{2}}=\frac{m_{1}\times n_{2}-m_{2}\times n_{1}}{n_{1}\times n_{2}}
\]


\end_inset
ומכאן שהחיסור 
\begin_inset Formula
$\begin{alignedat}{1}\frac{m_{1}}{n_{1}}-\frac{m_{2}}{n_{2}}\end{alignedat}
$

\end_inset
 מוגדר רק כאשר 
\begin_inset Formula
$m_{1}\times n_{2}>m_{2}\times n_{1}$
\end_inset
 וזה מסתדר היטב עם האינטואיציה שלנו לכך שהחיסור 
\begin_inset Formula
$\begin{alignedat}{1}\frac{m_{1}}{n_{1}}-\frac{m_{2}}{n_{2}}\end{alignedat}
$

\end_inset
 יוגדר רק כאשר 
\begin_inset Formula
$\begin{alignedat}{1}\frac{m_{1}}{n_{1}}>\frac{m_{2}}{n_{2}}\end{alignedat}
$

\end_inset
.
\begin_inset Newline newline
\end_inset
ושוב, אנחנו יכולים להבין כבר כעת שהחיסור צריך לקיים "חילוף" ו"קיבוץ" בצורה הבאה:
\end_layout

\begin_layout Itemize
"חילוף" - 
\begin_inset Formula
$\left(\frac{m_{1}}{n_{1}}-\frac{m_{2}}{n_{2}}\right)-\frac{m_{3}}{n_{3}}=\left(\frac{m_{1}}{n_{1}}-\frac{m_{3}}{n_{3}}\right)-\frac{m_{2}}{n_{2}}$
\end_inset

\end_layout

\begin_layout Itemize
"קיבוץ" - 
\begin_inset Formula
$\left(\frac{m_{1}}{n_{1}}-\frac{m_{2}}{n_{2}}\right)-\frac{m_{3}}{n_{3}}=\frac{m_{1}}{n_{1}}-\left(\frac{m_{2}}{n_{2}}+\frac{m_{3}}{n_{3}}\right)$
\end_inset

\end_layout

\begin_layout Subsubsection*
כפל
\end_layout

\begin_layout Standard
כבר הגדרנו כפל של מספר טבעי במספר רציונלי כאשר הטבעי נמצא משמאל והרציונלי מימין, אבל מה בדבר המצב ההפוך? מה הפשר של האמירה תחבר את 
\begin_inset Formula
$k$
\end_inset
 לעצמו 
\begin_inset Formula
$\frac{m}{n}$
\end_inset
 
\series bold
פעמים
\series default
???
\begin_inset Newline newline
\end_inset
אני כבר שומע את אלו שקופצים ואומרים: "מה אתה עושה צרות? קבע שהכפל חילופי וחסל", התשובה הראשונה שלי תהיה שזה נחמד מבחינה אלגברית אך כפי שאמרתי לעיל: הפרק הזה נכתב כדי להסביר מדוע אנחנו מגדירים את ההגדרות דווקא כך ולא כיצד ניתן לעבוד איתן אחרי שהוגדרו. התשובה השנייה היא שאפילו מבחינה אלגברית זה לא מספיק, מפני שאני רוצה להגדיר גם כפל של שני מספרים רציונליים זה בזה וכאן אני כבר לא יכול להסתמך על האינטואיציה שכפל הוא חיבור מספר פעמים (מי שלא מאמין שזה בלתי אפשרי מוזמן לנסות בעצמו), גם המכנה המשותף אינו עוזר מפני שבניגוד לחיבור אין לנו שום מושג כיצד כופלים שני מספרים רציונליים שהמכנה שלהם זהה.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הצעד הבא יהיה אחד הצעדים הדרמטיים שבפרק הזה, ולכן אני חוזר על בקשתי מתחילת הפרק שתשימו לב כיצד הוא מכליל את השלבים הקודמים.
\end_layout

\begin_layout Standard
האינטואיציה לכפל של מספרים רציונליים היא שטחים של מלבנים (ונפחים של 
\begin_inset CommandInset href
LatexCommand href
name "תיבות"
target https://he.wikipedia.org/wiki/%D7%AA%D7%99%D7%91%D7%94_)%D7%92%D7%90%D7%95%D7%9E%D7%98%D7%A8%D7%99%D7%94(
literal false
\end_inset
): במלבן שאורכי צלעותיו הם 
\begin_inset Formula
$n$
\end_inset
 ו-
\begin_inset Formula
$m$
\end_inset
 טבעיים "נכנסים" 
\begin_inset Formula
$n\times m$
\end_inset
 ריבועים שאורך כל צלע שלהם הוא 
\begin_inset Formula
$1$
\end_inset
, איך אנחנו יודעים זאת? פשוט מאד: נחלק את המלבן לטבלה שבה כל תא הוא ריבוע שאורך של צלע שלו הוא 
\begin_inset Formula
$1$
\end_inset
 (אנחנו יכולים לעשות זאת כי אורכי הצלעות טבעיים) וכבר ראינו כשעסקנו בטבעיים שבמצב כזה יש בטבלה 
\begin_inset Formula
$n\times m$
\end_inset
 תאים. אבל אורכי הצלעות של מלבן לא מוכרחים להיות מספרים טבעיים - הם יכולים להיות גם מספרים רציונליים (בדיוק כמו שניתן לסכום חתיכות של עוגות ניתן לסכום חתיכות של מקלות), אז מה? נרים ידיים? אנחנו רוצים להגדיר מהו השטח של כל מלבן!
\begin_inset Newline newline
\end_inset
ובכן, נניח שיש לנו מלבן שאורכי צלעותיו הם מיודעינו משכבר הימים 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{2}}{n_{2}}$
\end_inset
 ונתבונן במלבן שאורכי צלעותיו הם 
\begin_inset Formula
$m_{1}$
\end_inset
 ו-
\begin_inset Formula
$m_{2}$
\end_inset
: ניתן לחלק אותו לטבלה שבה כל תא יהיה מלבן שאורכי צלעותיו הם 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{2}}{n_{2}}$
\end_inset
, בטבלה כזו יש 
\begin_inset Formula
$n_{1}\times n_{2}$
\end_inset
 תאים ולכן היות שהשטח של המלבן כולו הוא 
\begin_inset Formula
$m_{1}\times m_{2}$
\end_inset
 אנחנו מצפים שהשטח של כל תא כזה יהיה:
\begin_inset Formula
\[
\frac{m_{1}}{n_{1}}\times\frac{m_{2}}{n_{2}}=\frac{m_{1}\times m_{2}}{n_{1}\times n_{2}}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מי שהמעבר למלבנים מופשטים פחות נראה לו מוזמן לדמיין שכל העוגות שלנו מלבניות ובגובה אחיד; הנקודה החשובה שיש לשים לב אליה היא שאם עד עכשיו ה-
\begin_inset Formula
$1$
\end_inset
 שלנו הוגדר באופן טבעי, כעת ה-
\begin_inset Formula
$1$
\end_inset
 שלנו הוא עוגה ריבועית שרירותית שעבורה החלטנו שאורך הצלעות שלה הוא אמת המידה שלנו ולכן היא בגודל 
\begin_inset Formula
$1$
\end_inset
 על 
\begin_inset Formula
$1$
\end_inset
.
\end_layout

\begin_layout Standard
כדי להבין מדוע אנחנו רוצים ש
\series bold
כפל מספרים רציונליים יקיים את חוק החילוף
\series default
 נשים לב לכך שמלבן שאורכי צלעותיו הם 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{2}}{n_{2}}$
\end_inset
 חופף למלבן אורכי צלעותיו הם 
\begin_inset Formula
$\frac{m_{2}}{n_{2}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ולכן שטחיהם שווים, כמו כן 
\series bold
כפל מספרים רציונליים צריך לקיים את חוק הקיבוץ
\series default
 בגלל שכפל של שלושה מספרים מתאר למעשה את הנפח של תיבה שאלו הם אורכי ה
\begin_inset CommandInset href
LatexCommand href
name "מקצועות"
target https://he.wikipedia.org/wiki/%D7%9E%D7%A7%D7%A6%D7%95%D7%A2_)%D7%92%D7%90%D7%95%D7%9E%D7%98%D7%A8%D7%99%D7%94(
literal false
\end_inset
 שלה והתיבות המתאימות ל-
\begin_inset Formula
$\left(\frac{m_{1}}{n_{1}}\times\frac{m_{2}}{n_{2}}\right)\times\frac{m_{3}}{n_{3}}$
\end_inset
 ול-
\begin_inset Formula
$\frac{m_{1}}{n_{1}}\times\left(\frac{m_{2}}{n_{2}}\times\frac{m_{3}}{n_{3}}\right)$
\end_inset
 חופפות אף הן. כדי להבין מדוע אנחנו רוצים ש
\series bold
כפל מספרים רציונליים יקיים פילוג ביחס לחיבור שלהם
\series default
 נתבונן בשני מלבנים שאורכי צלעות האחד הם 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{2}}{n_{2}}$
\end_inset
 ואורכי צלעות האחר הן 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{2}}{n_{2}}$
\end_inset
, ניתן ליצור מהם מלבן אחד שאורכי צלעותיו הם 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}$
\end_inset
 ו-
\begin_inset Formula
$\frac{m_{2}}{n_{2}}+\frac{m_{3}}{n_{3}}$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ושוב, מי שרוצה מוזמן לוודא שחוקים אלו אכן מתקיימים עבור הנוסחה שראינו לעיל.
\end_layout

\begin_layout Subsubsection*
חילוק
\end_layout

\begin_layout Standard
כשדיברנו על חילוק של מספרים טבעיים ראינו שתי אינטואיציות שקולות עבור פעולת החילוק:
\end_layout

\begin_layout Enumerate
"נניח שיש לנו סלסילה ובה 
\begin_inset Formula
$n$
\end_inset
 כדורים ואנו מעבירים את כל הכדורים שבה ל-
\begin_inset Formula
$m$
\end_inset
 סלסילות, כך שלאחר ההעברה יהיה בכולן מספר שווה של כדורים, מספר הכדורים שבכל סלסילה הוא תוצאת החילוק 
\begin_inset Formula
$n\div m$
\end_inset
."
\end_layout

\begin_layout Enumerate
"מספר הכדורים שהיו צריכים להיות בכל אחת מ-
\begin_inset Formula
$m$
\end_inset
 סלסילות שבהן מספר שווה של כדורים, כך שהמצב הנוכחי יתקבל ע"י העברת כל הכדורים מ-
\begin_inset Formula
$m$
\end_inset
 הסלסילות לסלסילה אחת, הוא תוצאת החילוק 
\begin_inset Formula
$n\div m$
\end_inset
."
\end_layout

\begin_layout Standard
שתי האינטואיציות הללו אינן עוזרות לנו עבור חילוק של מספרים רציונליים מפני שבשתיהן צריכות להיות 
\begin_inset Formula
$m$
\end_inset
 סלסילות שבהן מספר שווה של כדורים, אבל אנחנו רוצים לחלק גם במספרים שאינם טבעיים - אין שום משמעות ל-
\begin_inset Formula
$\frac{m}{n}$
\end_inset
 סלסילות. למרות זאת ראינו ששתיהן אומרות שצריך להתקיים 
\begin_inset Formula
$m\times\left(n\div m\right)=n=\left(n\div m\right)\times m$
\end_inset
, כלומר פעולת החילוק היא פעולה הפוכה לפעולת הכפל: תוצאת החילוק 
\begin_inset Formula
$n\div m$
\end_inset
 היא המספר שאם נכפול אותו ב-
\begin_inset Formula
$m$
\end_inset
 נקבל את 
\begin_inset Formula
$n$
\end_inset
; אם כך נרצה שאם 
\begin_inset Formula
$\frac{x}{y}$
\end_inset
 היא תוצאת החילוק 
\begin_inset Formula
$\frac{m_{1}}{n_{1}}\div\frac{m_{2}}{n_{2}}$
\end_inset
 אז יתקיים:
\begin_inset Formula
\[
\frac{m_{2}}{n_{2}}\times\frac{x}{y}=\frac{m_{1}}{n_{1}}
\]


\end_inset

\end_layout

\begin_layout Standard
נשים לב לכך שע"פ הנוסחה הנ"ל מתקיים:
\begin_inset Formula
\[
\frac{m_{2}}{n_{2}}\times\frac{n_{2}}{m_{2}}=\frac{m_{2}\times n_{2}}{n_{2}\times m_{2}}=\frac{n_{2}\times m_{2}}{n_{2}\times m_{2}}=\frac{1}{1}=1
\]


\end_inset
ולכן:
\end_layout

\begin_layout Standard
\begin_inset Formula
\[
\frac{m_{2}}{n_{2}}\times\frac{n_{2}\times m_{1}}{m_{2}\times n_{1}}=\frac{m_{2}}{n_{2}}\times\left(\frac{n_{2}}{m_{2}}\times\frac{m_{1}}{n_{1}}\right)=\left(\frac{m_{2}}{n_{2}}\times\frac{n_{2}}{m_{2}}\right)\times\frac{m_{1}}{n_{1}}=1\times\frac{m_{1}}{n_{1}}=\frac{m_{1}}{n_{1}}
\]


\end_inset
א"כ מצאנו את התוצאה המבוקשת עבור החילוק
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
העובדה שקיים רק מספר רציונלי אחד שכזה נובעת מהטריכוטומיה של יחס הסדר ומהעובדה שאם נכפול במספר קטן יותר או גדול יותר נקבל מספר קטן מדי או גדול מדי בהתאמה (כן, אני יודע שלא הראיתי שניתן להסיק זאת מהאקסיומות אך את ההוכחות הללו אני משאיר לקורס אינפי'
