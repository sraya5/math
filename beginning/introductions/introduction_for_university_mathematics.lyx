\series default
.
\end_layout

\begin_layout Subsubsection*
חיבור
\end_layout

\begin_layout Standard
על המספרים הטבעיים מוגדרת פעולת 
\series bold
חיבור
\series default
: אם ניקח שתי סלסילות, אחת 
\color green
ירוקה
\color inherit
 ובה 
\begin_inset Formula
$m$
\end_inset
 כדורים ואחת 
\color blue
כחולה
\color inherit
 ובה 
\begin_inset Formula
$n$
\end_inset
 כדורים, ונעביר את כל הכדורים שבסלסילה 
\color green
הירוקה
\color inherit
 לסלסילה 
\color blue
הכחולה
\color inherit
 אז המספר הטבעי המתאים לסלסילה 
\color blue
הכחולה
\color inherit
 לאחר ההעברה הוא תוצאת החיבור 
\begin_inset Formula
$n+m$
\end_inset
. שימו לב לכך שכל הסיפור הזה אינו סימטרי - אם היינו מעבירים את הכדורים מהסלסילה 
\color blue
הכחולה
\color inherit
 אל 
\color green
הירוקה
\color inherit
 היינו מקבלים סיפור חדש שבו מספר הכדורים בסלסילה 
\color green
הירוקה
\color inherit
 לאחר ההעברה הוא 
\begin_inset Formula
$m+n$
\end_inset
, אז למה ברור לנו שמתקיים 
\begin_inset Formula
$n+m=m+n$
\end_inset
?
\begin_inset Newline newline
\end_inset
ברור לכולנו שלאחר סידור הכדורים בשורה אין שום הבדל אם נמנה אותם מימין לשמאל או משמאל לימין (זוהי תכונה מהותית של המושג 
\series bold
כמות
\series default
), א"כ נסכים שלאחר כל העברת כדורים מסלסילה אחת לאחרת נסדר את הכדורים כך שבצד שמאל יהיו כל הכדורים שהיו בסלסילה השנייה לפני ההעברה ובצד ימין הכדורים מהסלסילה הראשונה; לאחר הסכם זה נקבל שהן בסיפור הראשון והן בסיפור השני מספר הכדורים בסלסילה שאינה ריקה זהה - זוהי הסיבה לכך ש
\series bold
חיבור מספרים טבעיים צריך לקיים את חוק החילוף
\series default
.
\begin_inset Newline newline
\end_inset
כדי להסביר את העובדה ש
\series bold
חיבור מספרים טבעיים צריך לקיים חוק הקיבוץ
\series default
 נתבונן במקרה שבו יש לנו שלוש סלסילות ובהן 
\begin_inset Formula
$n$
\end_inset
, 
\begin_inset Formula
$m$
\end_inset
 ו-
\begin_inset Formula
$k$
\end_inset
 כדורים בהתאמה, כעת נתפצל לשני סיפורים: בסיפור הראשון ניקח את 
\begin_inset Formula
$m$
\end_inset
 הכדורים בסלסילה השנייה ונעביר אותם לסלסילה הראשונה ואח"כ נעביר את 
\begin_inset Formula
$k$
\end_inset
 הכדורים מהסלסילה השלישית לראשונה (כעת יש בסלסילה הראשונה 
\begin_inset Formula
$\left(n+m\right)+k$
\end_inset
 כדורים), ובסיפור השני ניקח את 
\begin_inset Formula
$k$
\end_inset
 הכדורים בסלסילה השלישית ונעביר אותם לסלסילה השנייה ואח"כ נעביר את 
\begin_inset Formula
$m+k$
\end_inset
 הכדורים מהסלסילה השנייה לראשונה (כעת יש בסלסילה הראשונה 
\begin_inset Formula
$n+\left(m+k\right)$
\end_inset
 כדורים). נוסיף סעיף קטן להסכם שלנו: אם בסלסילה מסוימת יש כדורים שהיו במקור בשתי סלסילות שונות אנו נשמור על הסדר שבו הכדורים סודרו לפי ההסכם גם כאשר נעביר את הכדורים מסלסילה זו לאחרת או להפך; במקרה שלנו זה אומר שלאחר שתי ההעברות, הכדורים שבסלסילה הראשונה מסודרים באותה צורה בשני הסיפורים: ראשית 
\begin_inset Formula
$n$
\end_inset
 כדורים שהיו בסלסילה במקור נמצאים בצד שמאל, אחריהם מגיעים 
\begin_inset Formula
$m$
\end_inset
 הכדורים מהסלסילה השנייה שנמצאים במרכז השורה, ולבסוף 
\begin_inset Formula
$k$
\end_inset
 הכדורים מהסלסילה השלישית נמצאים בצד ימין - כלומר בשני הסיפורים יש בסלסילה הראשונה את אותו מספר כדורים ולפיכך 
\begin_inset Formula
$\left(n+m\right)+k=n+\left(m+k\right)$
\end_inset
.
\end_layout

\begin_layout Subsubsection*
כפל
\end_layout

\begin_layout Standard
נניח שיש לנו 
\begin_inset Formula
$10$
\end_inset
 סלסילות שבכל אחת מהן 
\begin_inset Formula
$4$
\end_inset
 כדורים, א"כ לאחר שנעביר את כל הכדורים לסלסילה אחת יהיו בה 
\begin_inset Formula
$\overset{\text{10 פעמים}}{\overbrace{4+4+\ldots+4}}$
\end_inset
 כדורים - הכתיב הזה לא כל כך נוח ולכן היינו רוצים כתיב מקוצר לפעולה זו של חיבור אותו מספר לעצמו מספר מסוים של פעמים; א"כ נסמן ב-
\begin_inset Formula
$k\times n$
\end_inset
 את מספר הכדורים הנמצאים ב-
\begin_inset Formula
$k$
\end_inset
 סלסילות כך שבכל אחת מהן 
\begin_inset Formula
$n$
\end_inset
 כדורים, כלומר פירושו של הסימון "
\begin_inset Formula
$\times$
\end_inset
" הוא 
\series bold
פעמים
\series default
 כפי שאנו לומדים בבית הספר היסודי ו-"
\begin_inset Formula
$k\times n$
\end_inset
" הוא "
\begin_inset Formula
$k$
\end_inset
 
\series bold
פעמים
\series default
 
\begin_inset Formula
$n$
\end_inset
". גם הסיפור הזה אינו סימטרי, אז למה כל כך ברור לנו ש-
\begin_inset Formula
$k\times n=n\times k$
\end_inset
? כפי שאתם מנחשים הסיבה היא שלאחר שנעביר את כל הכדורים לסלסילה אחת נוכל לסדר את הכדורים בטבלה שבה כל שורה מכילה את כל הכדורים שהיו במקור באותה סלסילה, כך במקרה השמאלי נקבל טבלה שבה 
\begin_inset Formula
$k$
\end_inset
 שורות שבכל אחת מהן 
\begin_inset Formula
$n$
\end_inset
 כדורים ובמקרה הימני נקבל טבלה שבה 
\begin_inset Formula
$n$
\end_inset
 שורות שבכל אחת מהן 
\begin_inset Formula
$k$
\end_inset
 כדורים, ואז אם נסובב את נקודת המבט שלנו ב-
\begin_inset Formula
$90^{\circ}$
\end_inset
 נקבל מכל מקרה את רעהו ולכן ברור לכולנו שבשני מקרים מספר הכדורים זהה. א"כ הסברנו מדוע 
\series bold
כפל מספרים טבעיים צריך לקיים את חוק החילוף
\series default
, וכדי להבין מדוע 
\series bold
כפל מספרים טבעיים צריך לקיים את חוק הקיבוץ
\series default
 כל מה שעלינו לעשות הוא לבנות "טבלה" תלת-ממדית.
\begin_inset Newline newline
\end_inset
מהגדרה 
\series bold
כפל מספרים טבעיים מקיים את חוק הפילוג ביחס לחיבור שלהם
\series default
, שכן:
\begin_inset Formula
\[
k\times\left(n+m\right)=\overset{k\ \text{פעמים}}{\overbrace{\left(n+m\right)+\left(n+m\right)+\ldots+\left(n+m\right)}}=\overset{k\ \text{פעמים}}{\overbrace{n+n+\ldots+n}}+\overset{k\ \text{פעמים}}{\overbrace{m+m+\ldots+m}}=\left(k\times n\right)+\left(k\times m\right)
\]


\end_inset

\end_layout

\begin_layout Description
הסכמה: כפל תמיד קודם לחיבור, כלומר 
\begin_inset Formula
$k\times n+k\times m=\left(k\times n\right)+\left(k\times m\right)$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מהמהות של הכפל נקבל ש-
\begin_inset Formula
$1\cdot n=n$
\end_inset
.
\end_layout

\begin_layout Subsubsection*
יחס סדר
\end_layout

\begin_layout Standard
אנחנו יודעים לא רק להוסיף כדורים מסלסילה אחת לאחרת אלא גם להשוות בין כל שתי סלסילות.
\end_layout

\begin_layout Itemize
לכל שתי סלסילות מתקיימת בדיוק אחת משלוש האפשרויות הבאות (
\series bold
טריכוטומיה
\series default
):
\end_layout

\begin_deeper
\begin_layout Enumerate
מספר הכדורים בסלסילה הראשונה 
\series bold
שווה
\series default
 למספר הכדורים בשנייה, במקרה כזה נסמן 
\begin_inset Formula
$n=m$
\end_inset
.
\end_layout

\begin_layout Enumerate
מספר הכדורים בסלסילה הראשונה 
\series bold
קטן
\series default
 ממספר הכדורים בשנייה, במקרה כזה נסמן 
\begin_inset Formula
$n<m$
\end_inset
 (או 
\begin_inset Formula
$m>n$
\end_inset
).
\end_layout

\begin_layout Enumerate
מספר הכדורים בסלסילה הראשונה 
\series bold
גדול
\series default
 ממספר הכדורים בשנייה, במקרה כזה נסמן 
\begin_inset Formula
$n>m$
\end_inset
 (או 
\begin_inset Formula
$m<n$
\end_inset
).
\end_layout

\begin_layout Standard
כאשר הקביעה איזו אחת מהאפשרויות מתקיימת נעשית ע"י מניית הכדורים שבכל אחת מן הסלסילות: אם התקדמנו במנייה בסלסילה הראשונה יותר מבשנייה אז מדובר במקרה השלישי, אם המצב הפוך אז זהו המצב השני ואם שניהם אינם מתקיימים אז אנו עוסקים באפשרות הראשונה.
\end_layout

\end_deeper

\begin_layout Itemize
בנוסף, לכל שלוש סלסילות מתקיים: אם מספר הכדורים בראשונה קטן מזה שבשנייה, וזה בתורו קטן ממספר הכדורים בשלישית, אז מספר הכדורים בסלסילה הראשונה קטן ממספר הכדורים בסלסילה השלישית (
\series bold
טרנזיטיביות
\series default
).
\end_layout

\begin_layout Itemize
לבסוף, הוספה של כדורים לסלסילה מגדילה את מספר הכדורים שבה (ניתן להסיק מכאן את ה
\series bold
הלימה לחיבור
\series default

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
נניח ש-
\begin_inset Formula
$n<m$
\end_inset
 ואנו מוסיפים 
\begin_inset Formula
$k$
\end_inset
 לשני האגפים (אם מתקיים 
\begin_inset Formula
$n=m$
\end_inset
 אז ממהות השוויון נובע ש-
\begin_inset Formula
$n+k=m+k$
\end_inset
), ניתן להשתמש בחילוף ולהסתכל על זה כאילו אנו מוסיפים לשתי סלסילות שבהן 
\begin_inset Formula
$k$
\end_inset
 כדורים - לאחת אנחנו מוסיפים 
\begin_inset Formula
$m$
\end_inset
 ולאחרת 
\begin_inset Formula
$n$
\end_inset
, את ההוספה של 
\begin_inset Formula
$m$
\end_inset
 הכדורים ניתן לבצע בשתי פעימות: קודם להוסיף 
\begin_inset Formula
$n$
\end_inset
 כדורים ואח"כ להוסיף את השאר.
\end_layout

\end_inset
).
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מכיוון שכפל של מספרים טבעיים הוא חיבור בלבד אין צורך לדבר עליו בנפרד, ולמעשה ניתן להוכיח שגם הכפלת מספר הכדורים בסלסילה מגדילה את מספר הכדורים אם מדובר בכפל בטבעי שונה מ-
\begin_inset Formula
$1$
\end_inset
 ואינה מקטינה אותו בכל מקרה.
\end_layout

\begin_layout Standard
א"כ גם על הטבעיים מוגדר 
\series bold
יחס הסדר "קטן מ-"
\series default
 והוא מקיים את התכונות הנ"ל.
\end_layout

\begin_layout Subsubsection*
חיסור
\end_layout

\begin_layout Standard
יש לנו גם פעולת 
\series bold
חיסור
\series default
: נניח שיש לנו סלסילה ובה 
\begin_inset Formula
$n$
\end_inset
 כדורים, אם נוציא ממנה 
\begin_inset Formula
$m$
\end_inset
 כדורים ונעביר אותם לסלסילה אחרת אז מספר הכדורים שיישאר בה הוא תוצאת החיסור 
\begin_inset Formula
$n-m$
\end_inset
; ניתן להסתכל על פעולת החיסור גם בצורה הבאה: מספר הכדורים שהיו צריכים להיות בה כך שהמצב הנוכחי יתקבל ע"י הוספת 
\begin_inset Formula
$m$
\end_inset
 כדורים מסלסילה אחרת הוא תוצאת החיסור 
\begin_inset Formula
$n-m$
\end_inset
.
\begin_inset Newline newline
\end_inset
נשים לב לכך שבסלסילה צריך להיות לפחות כדור אחד
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
אחרי הוצאת הכדורים בניסוח הראשון של החיסור או לפני ההוספה בניסוח השני.
\end_layout

\end_inset
 ולכן 
\begin_inset Formula
$n-m\geq1$
\end_inset
, ובנוסף, מכיוון שהוספת כדורים לסלסילה 
\series bold
מגדילה
\series default
 את מספר הכדורים שבה פעולת החיסור על הטבעיים מוגדרת רק כאשר 
\begin_inset Formula
$n>m$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הסיבה לכך שקשה יותר לבצע חיסור בראש לעומת חיבור היא שפעולת החיסור במהותה היא "הנדסה לאחור" בעוד שהחיבור אינו כזה.
\end_layout

\begin_layout Standard
אנחנו יכולים להבין כבר כעת שהחיסור צריך לקיים "חילוף" ו"קיבוץ" בצורה הבאה:
\end_layout

\begin_layout Itemize
"חילוף" - 
\begin_inset Formula
$\left(n-m\right)-k=\left(n-k\right)-m$
\end_inset

\end_layout

\begin_layout Itemize
"קיבוץ" - 
\begin_inset Formula
$\left(n-m\right)-k=n-\left(m+k\right)$
\end_inset

\end_layout

\begin_layout Subsubsection*
חילוק
\end_layout

\begin_layout Standard
בדומה לחיבור גם לכפל יש פעולה הפוכה והיא 
\series bold
חילוק
\series default
: נניח שיש לנו סלסילה ובה 
\begin_inset Formula
$n$
\end_inset
 כדורים ואנו מעבירים את כל הכדורים שבה ל-
\begin_inset Formula
$m$
\end_inset
 סלסילות, כך שלאחר ההעברה יהיה בכולן מספר שווה של כדורים, מספר הכדורים שבכל סלסילה הוא תוצאת החילוק 
\begin_inset Formula
$n\div m$
\end_inset
; ניתן להסתכל על פעולת החיסור גם בצורה הבאה: מספר הכדורים שהיו צריכים להיות בכל אחת מ-
\begin_inset Formula
$m$
\end_inset
 סלסילות שבהן מספר שווה של כדורים, כך שהמצב הנוכחי יתקבל ע"י העברת כל הכדורים מ-
\begin_inset Formula
$m$
\end_inset
 הסלסילות לסלסילה אחת, הוא תוצאת החילוק 
\begin_inset Formula
$n\div m$
\end_inset
.
\begin_inset Newline newline
\end_inset
כך או כך תוצאת החילוק צריכה להיות מספר טבעי המקיים 
\begin_inset Formula
$m\times\left(n\div m\right)=n=\left(n\div m\right)\times m$
\end_inset
 וכפי שראינו לעיל נובע מזה ש-
\begin_inset Formula
$n\geq m$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 גם פעולת החילוק מערבת "הנדסה לאחור" ולכן היא קשה יותר לביצוע בראש מאשר כפל.
\end_layout

\begin_layout Standard
אנחנו יכולים להבין כבר כעת שהחילוק צריך לקיים "חילוף" ו"קיבוץ" בצורה דומה לחיסור:
\end_layout

\begin_layout Itemize
"חילוף" - 
\begin_inset Formula
$\left(n\div m\right)\div k=\left(n\div k\right)\div m$
\end_inset

\end_layout

\begin_layout Itemize
"קיבוץ" - 
\begin_inset Formula
$\left(n\div m\right)\div k=n\div\left(m\times k\right)$
\end_inset

\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Subsection
המספרים הרציונליים
\end_layout

\begin_layout Standard
ראינו לעיל שבמספרים הטבעיים יש מגבלות על היכולת לחסר ולחלק, המגבלה על החיסור נראית טבעית מאד אך לעומתה המגבלה על החילוק נראית מלאכותית - למה שלא נוכל לחלק כל כדור לחלקים שווים וכך נוכל לחלק כל כמות של כדורים לכל כמות של סלסילות? בנוסף, המגבלה על החילוק חזקה הרבה יותר: כמעט עבור כל מספר טבעי יש יותר מספרים שניתן לחסר ממנו לעומת אלו שבהם ניתן לחלק אותו. מסיבה זו אנחנו נעבור לדבר על עוגות שנמצאות בקופסאות (הרבה יותר כיף לחשוב על חלוקה של עוגה לחלקים שווים מאשר על חלוקה של כדור); נניח שכל העוגות בעולם זהות ושהן וכל חתיכות העוגות בעולם נמצאות בקופסאות (במינוח שלנו עוגה אחת שלמה נחשבת "חתיכה" אבל לא כל חתיכה היא עוגה שלמה), ולכל קופסה כזו נתאים מספר שיציין את כמות העוגות בקופסה בצורה הבאה:
\end_layout

