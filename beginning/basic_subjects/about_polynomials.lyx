\begin_inset Formula
$P\in\MKreal\left[x\right]\subseteq\MKcomplex\left[x\right]$
\end_inset
 ויהי 
\begin_inset Formula
$\lambda\in\MKcomplex$
\end_inset
 שורש של 
\begin_inset Formula
$P$
\end_inset
,  גם 
\begin_inset Formula
$\overline{\lambda}$
\end_inset
 הוא שורש של 
\begin_inset Formula
$P$
\end_inset
.
\end_layout

