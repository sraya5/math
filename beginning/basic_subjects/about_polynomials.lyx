\begin_layout Definition
\bar under
פולינום
\bar default
 מעל 
\begin_inset Formula
$\MKfield$
\end_inset
 הוא ביטוי מהצורה 
\begin_inset Formula
$a_{0}+a_{1}x+a_{2}x^{2}+...+a_{n}x^{n}$
\end_inset
 כאשר 
\begin_inset Formula
$a_{k}\in\MKfield$
\end_inset
 לכל 
\begin_inset Formula
$n\geq k\in\MKnatural$
\end_inset
.
\begin_inset Newline newline
\end_inset
המקדם של החזקה הגדולה ביותר (
\begin_inset Formula
$a_{n}$
\end_inset
) נקרא 
\bar under
המקדם המוביל
\bar default
 והמקדם של החזקה ה-
\begin_inset Formula
$0$
\end_inset
 (
\begin_inset Formula
$a_{0}$
\end_inset
) נקרא 
\bar under
המקדם החופשי
\bar default
.
\begin_inset Newline newline
\end_inset
נסמן את קבוצת הפולינומים מעל 
\begin_inset Formula
$\MKfield$
\end_inset
 ב-
\begin_inset Formula
$\MKfield\left[x\right]$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 
\bar under
מונום
\bar default
 הוא פולינום בעל איבר יחיד, כלומר כל פולינום הוא חיבור של מונומים.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מבחינה פורמלית פולינומים הם פשוט מחרוזת תווים, כדאי לזכור זאת בהמשך מבלי לאבד את האינטואיציה המזהה פולינום כפונקציה פולינומיאלית.
\begin_inset Newline newline
\end_inset
דוגמה הממחישה את העניין: הפולינומים 
\begin_inset Formula
$1$
\end_inset
, 
\begin_inset Formula
$x^{2}+x+1$
\end_inset
 ו-
\begin_inset Formula
$x^{3}+x+1$
\end_inset
 הם פולינומים שונים מעל 
\begin_inset Formula
$\MKfield_{2}$
\end_inset
 למרות שכפונקציות הם שווים:
\begin_inset Formula
\begin{align*}
1^{3}+1+1 & =1=1^{2}+1+1\\
0^{3}+0+1 & =1=0^{2}+0+1
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ה-
\begin_inset Formula
$x$
\end_inset
 בסימון 
\begin_inset Formula
$\MKfield\left[x\right]$
\end_inset
 הוא משתנה סרק, באותה מידה היה יכול להופיע שם כל קשקוש עקבי אחר, יתרה מזאת - לפעמים משתמשים בסימון זה כאשר במקום 
\begin_inset Formula
$x$
\end_inset
 כותבים מספר כלשהו ואז פירוש הסימון הוא קבוצת כל הביטויים הפולינומיאליים כשמציבים בהם את אותו מספר, לדוגמה (
\begin_inset CommandInset href
LatexCommand href
name "חוג השלמים של גאוס"
target https://he.wikipedia.org/wiki/%D7%97%D7%95%D7%92_%D7%94%D7%A9%D7%9C%D7%9E%D7%99%D7%9D_%D7%A9%D7%9C_%D7%92%D7%90%D7%95%D7%A1
literal false
\end_inset
):
\begin_inset Formula
\begin{align*}
\MKinteger\left[i\right] & :=\left\{ \begin{array}{c|c}
\begin{alignedat}{1}\sum_{k=0}^{n}a_{k}\cdot i^{k}\end{alignedat}
 & a_{0},a_{1},\ldots,a_{n}\in\MKinteger\end{array}\right\} \\
 & =\left\{ a+bi\mid a,b\in\MKinteger\right\} 
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כל מה שנראה בקובץ זה נכון גם עבור קבוצת הפולינומים מעל חוג (שאינו בהכרח שדה), למעט נקודה אחת שעליה נעיר במפורש.
\end_layout

\begin_layout Definition
\series bold
שוויון בין פולינומים
\series default

\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$P,G\in\MKfield\left[x\right]$
\end_inset
 ויהיו 
\begin_inset Formula
$a_{0},a_{1},\ldots,a_{n},b_{0},b_{1},\ldots,b_{m}$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\begin{align*}
P\left(x\right) & =\sum_{k=0}^{n}a_{k}\cdot x^{k}\\
G\left(x\right) & =\sum_{k=0}^{m}b_{k}\cdot x^{k}
\end{align*}


\end_inset
נאמר ש-
\begin_inset Formula
$P=G$
\end_inset
 אם 
\begin_inset Formula
$a_{k}=b_{k}$
\end_inset
 לכל 
\begin_inset Formula
$\min\left\{ n,m\right\} \geq k\in\MKnatural_{0}$
\end_inset
 ובנוסף מתקיים: 
\begin_inset Formula
$n\geq m$
\end_inset
 ו-
\begin_inset Formula
$a_{k}=0$
\end_inset
 לכל 
\begin_inset Formula
$m<k\in\MKnatural$
\end_inset
 ו/או 
\begin_inset Formula
$n\leq m$
\end_inset
 ו-
\begin_inset Formula
$b_{k}=0$
\end_inset
 לכל 
\begin_inset Formula
$n<k\in\MKnatural$
\end_inset
.
\begin_inset Newline newline
\end_inset
כלומר אם ממקום מסוים ואילך המקדמים של פולינום הם אפסים, אז מקדמים אלו (אך לא אלו שלפניהם) אינם משפיעים על זהות הפולינום.
\end_layout

