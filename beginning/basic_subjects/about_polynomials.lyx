\begin_inset Formula
$1$
\end_inset
.
\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$P\in\MKreal\left[x\right]\subseteq\MKcomplex\left[x\right]$
\end_inset
 ולכל 
\begin_inset Formula
$\lambda\in\MKcomplex$
\end_inset
 מתקיים 
\begin_inset Formula
$P\left(\overline{\lambda}\right)=\overline{P\left(\lambda\right)}$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הטענה נובעת מהעובדה שהצמדה היא כפלית וחיבורית (כלומר לכל 
\begin_inset Formula
$z,w\in\MKcomplex$
\end_inset
 מתקיים 
\begin_inset Formula
$\overline{z+w}=\overline{z}+\overline{w}$
\end_inset
 ו-
\begin_inset Formula
$\overline{z\cdot w}=\overline{z}\cdot\overline{w}$
\end_inset
), הטענה נכונה דווקא בפולינום בעל מקדמים ממשיים משום שרק אז המקדמים צמודים לעצמם.
\end_layout

\begin_layout Corollary
