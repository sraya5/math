\begin_layout Description
סימון: 
\begin_inset Formula
$\MKfield_{n}\left[x\right]:=\MKfield_{\leq n}\left[x\right]:=\left\{ P\in\MKfield\left[x\right]\mid\deg P\leq n\right\} $
