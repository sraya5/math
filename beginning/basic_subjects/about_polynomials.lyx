\begin_layout Theorem
\series bold
פירוק לגורמים אי-פריקים
\series default

\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$G\in\MKfield\left[x\right]$
\end_inset
 פולינום. קיימים פולינומים מתוקנים 
\begin_inset Formula
$P_{1},P_{2},\ldots,P_{r}\in\MKfield\left[x\right]$
\end_inset
 שונים זה מזה, מספרים טבעיים 
\begin_inset Formula
$n_{1},n_{2},\ldots,n_{r}\in\MKnatural$
\end_inset
 וסקלר 
\begin_inset Formula
$c\in\MKfield$
\end_inset
 יחידים
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
עד כדי שינוי סדר ושינוי סימן.
\end_layout

\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
G=c\cdot\prod_{i=1}^{r}\left(P_{i}\right)^{n_{i}}
\]


\end_inset
הצגה זו נקראת הפירוק של 
\begin_inset Formula
$P$
\end_inset
 לגורמים אי-פריקים.
\end_layout

\begin_layout Proof
ניתן להוכיח באינדוקציה שניתן להציג כל פולינום כמכפלה של פולינומים אי-פריקים מתוקנים וסקלר
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
מפרקים לגורמים עד שכבר א"א לחלק מפני שכל הגורמים אי-פריקים.
\end_layout

\end_inset
.
\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$P_{1},P_{2},\ldots P_{r},Q_{1},Q_{2},\ldots Q_{s}\in\MKfield\left[x\right]$
\end_inset
 כך ש-
\begin_inset Formula
$P_{i}\neq P_{j}$
\end_inset
 אם 
\begin_inset Formula
$i\neq j$
\end_inset
 (לכל 
\begin_inset Formula
$r\geq i,j\in\MKnatural$
\end_inset
) וכמו כן 
\begin_inset Formula
$Q_{i}\neq Q_{j}$
\end_inset
 אם 
\begin_inset Formula
$i\neq j$
\end_inset
 (לכל 
\begin_inset Formula
$s\geq i,j\in\MKnatural$
\end_inset
), 
\begin_inset Formula
$n_{1},n_{2},\ldots,n_{r},m_{1},m_{2},\ldots,m_{s}\in\MKnatural$
\end_inset
 ו-
\begin_inset Formula
$c,c'\in\MKfield$
\end_inset
 כך שמתקיים:
\begin_inset Formula
\[
c\cdot\prod_{i=1}^{r}\left(P_{i}\right)^{n_{i}}=G=c'\cdot\prod_{j=1}^{s}\left(Q_{j}\right)^{m_{i}}
\]


\end_inset
ראשית נשים לב לכך ש-
\begin_inset Formula
$c$
\end_inset
 ו-
\begin_inset Formula
