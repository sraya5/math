- פירמול ההוכחה של בני גורן ע"פ האסטרטגיה השנייה
\bar default

\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
ax^{2}+bx+c=0 & \Longleftrightarrow ax^{2}+bx=-c\\
 & \Longleftrightarrow4a^{2}x^{2}+4abx=-4ac\\
 & \Longleftrightarrow4a^{2}x^{2}+4abx+b^{2}=-4ac+b^{2}\\
 & \Longleftrightarrow\left(2ax\right)^{2}+2\cdot\left(2ax\right)\cdot b+b^{2}=b^{2}-4ac\\
 & \Longleftrightarrow\left(2ax+b\right)^{2}=b^{2}-4ac
\end{align*}


\end_inset
כאן עלינו להיזהר מפני שלכאורה אי אפשר להמשיך את שרשרת השקילויות שכן ייתכן שלא קיים 
\begin_inset Formula
$d\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$d^{2}=b^{2}-4ac$
\end_inset
 ובנוסף עלולים להיות שני מספרים 
\begin_inset Formula
$d_{1},d_{2}\in\MKreal$
\end_inset
 שונים זה מזה המקיימים 
\begin_inset Formula
$\left(d_{1}\right)^{2}=\left(d_{2}\right)^{2}=b^{2}-4ac$
\end_inset
, במילים אחרות: הוצאת שורש ריבועי מעל הממשיים היא פעולה שאינה הפיכה (ראו 
\begin_inset CommandInset href
LatexCommand href
name "כאן"
target https://he.wikipedia.org/wiki/%D7%9E%D7%A9%D7%95%D7%95%D7%90%D7%94#%D7%9E%D7%90%D7%A4%D7%99%D7%99%D7%A0%D7%99%D7%9D
literal false
\end_inset
 את הקשר לפונקציה הפיכה). למרות זאת אנחנו יכולים להמשיך את שרשרת השקילויות כך:
\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
ax^{2}+bx+c=0 & \Longleftrightarrow ax^{2}+bx+c-c=0-c\\
 & \vdots\\
 & \Longleftrightarrow\left(2ax+b\right)^{2}=b^{2}-4ac\\
 & \Longleftrightarrow\left(\exists d\in\MKreal:d^{2}=b^{2}-4ac\right)\land\left(2ax+b=\pm\sqrt{b^{2}-4ac}\right)\\
 & \Longleftrightarrow\left(b^{2}-4ac\geq0\right)\land\left(2ax=-b\pm\sqrt{b^{2}-4ac}\right)\\
 & \Longleftrightarrow\left(b^{2}-4ac\geq0\right)\land\left(x=\frac{-b\pm\sqrt{b^{2}-4ac}}{2a}\right)
\end{align*}


\end_inset
א"כ הצלחנו להוכיח שלכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$ax^{2}+bx+c=0$
\end_inset
 אם"ם מתקיים 
\begin_inset Formula
$b^{2}-4ac\geq0$
\end_inset
 ובנוסף 
\begin_inset Formula
$\begin{alignedat}{1}x=\frac{-b+\sqrt{b^{2}-4ac}}{2a}\end{alignedat}
$

\end_inset
 ו/או 
\begin_inset Formula
$\begin{alignedat}{1}x=\frac{-b-\sqrt{b^{2}-4ac}}{2a}\end{alignedat}
$

\end_inset
.
\begin_inset Newline newline
\end_inset
ראשית נובע מזה שאם 
\begin_inset Formula
$b^{2}-4ac<0$
\end_inset
 אז לא קיים 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$ax^{2}+bx+c=0$
\end_inset
, כלומר אין למשוואה פתרון; ושנית, אם 
\begin_inset Formula
$b^{2}-4ac\geq0$
\end_inset
 אז אוסף הפתרונות הוא:
\begin_inset Formula
\[
\left\{ \frac{-b+\sqrt{b^{2}-4ac}}{2a},\frac{-b-\sqrt{b^{2}-4ac}}{2a}\right\} 
\]


\end_inset
ושוב, אם 
\begin_inset Formula
$b^{2}-4ac=0$
\end_inset
 אז "שני" הפתרונות הם בעצם אחד...
\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Section
נספח: אינטואיציה לנוסחת השורשים
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נתבונן בפרבולה 
\begin_inset Formula
$p\cdot\left(x-d\right)^{2}+r$
\end_inset
, שימו לב מה קורה כאן: לקחנו את הפרבולה הכי פשוטה שהיא 
\begin_inset Formula
$x^{2}$
\end_inset
, מתחנו אותה בכיוון ציר ה-
\begin_inset Formula
$y$
\end_inset
 פי 
\begin_inset Formula
$p$
\end_inset
 (או כיווצנו פי 
\begin_inset Formula
$p^{-1}$
\end_inset
), הזזנו אותה ימינה ב-
\begin_inset Formula
$d$
\end_inset
 (או שמאלה ב-
\begin_inset Formula
$-d$
\end_inset
), אם 
\begin_inset Formula
$p<0$
\end_inset
 אז גם שיקפנו אותה סביב ציר ה-
\begin_inset Formula
$x$
\end_inset
 ולבסוף הזזנו אותה כלפי מעלה ב-
\begin_inset Formula
$r$
\end_inset
 (או מטה ב-
\begin_inset Formula
$-r$
\end_inset
). הרעיון הוא כזה: אנו עומדים להראות שניתן להציג כל פרבולה ע"י הפרבולה הבסיסית 
\begin_inset Formula
$x^{2}$
\end_inset
 לאחר מתיחה/כיווץ, הזזה ושיקוף סביב ציר ה-
\begin_inset Formula
$x$
\end_inset
; לאחר שנציג אותה כך יקל עלינו למצוא את השורשים (אם יש כאלה) שהרי הם:
\begin_inset Formula
\[
x=\pm\sqrt{-\frac{r}{p}}+d
\]


\end_inset

\end_layout

\begin_layout Standard
יהיו 
\begin_inset Formula
$a,b,c\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$a\neq0$
\end_inset
 ותהא 
\begin_inset Formula
$f:\MKreal\rightarrow\MKreal$
\end_inset
 פונקציה פולינומיאלית המוגדרת ע"י 
\begin_inset Formula
$f\left(x\right)=ax^{2}+bx+c$
\end_inset
 (לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
).
\end_layout

\begin_layout Standard
נניח שאכן קיימים 
\begin_inset Formula
$p,d,r\in\MKreal$
\end_inset
 כך שמתקיים (זה מזכיר לכם משהו?):
\begin_inset Formula
\[
f\left(x\right)=ax^{2}+bx+c=p\cdot\left(x-d\right)^{2}+r
\]


\end_inset
ונפתח את הריבוע כדי לראות מי הם:
\begin_inset Formula
\begin{align*}
p\cdot\left(x+d\right)^{2}+r & =p\cdot\left(x^{2}-2dx+d^{2}\right)+r\\
 & =px^{2}-2pdx+pd^{2}+r
\end{align*}


\end_inset
א"כ נקבל:
\begin_inset Formula
\begin{align*}
a & =p\\
b & =-2pd\\
c & =pd^{2}+r
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow p & =a\\
\Rightarrow d & =-\frac{b}{2p}=-\frac{b}{2a}\\
\Rightarrow r & =c-pd^{2}=c-a\cdot\left(-\frac{b}{2a}\right)^{2}\\
 & =c-a\cdot\frac{b^{2}}{4a^{2}}=c-\frac{b^{2}}{4a}
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כבר כעת ניתן לראות שקודקוד הפרבולה נמצא בנקודה 
\begin_inset Formula
$x=-\frac{b}{2a}$
\end_inset
 שכן 
\begin_inset Formula
$d$
\end_inset
 הוא בדיוק המרחק שבו הזזנו את הפרבולה בכיוון ציר ה-
\begin_inset Formula
$x$
\end_inset
.
\end_layout

\begin_layout Standard
אם נציב את 
\begin_inset Formula
$p$
\end_inset
, 
\begin_inset Formula
$d$
\end_inset
 ו-
\begin_inset Formula
$r$
\end_inset
 במקומותיהם נקבל את ההוכחה לטענה שהרי לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
p\cdot\left(x-d\right)^{2}+r & =a\cdot\left(x-\left(-\frac{b}{2a}\right)\right)^{2}+\left(c-\frac{b^{2}}{4a}\right)\\
 & =a\cdot\left(x+\frac{b}{2a}\right)^{2}+\left(c-\frac{b^{2}}{4a}\right)\\
 & =a\cdot\left(x^{2}+2x\cdot\frac{b}{2a}+\frac{b^{2}}{4a^{2}}\right)+\left(c-\frac{b^{2}}{4a}\right)\\
 & =ax^{2}+2ax\cdot\frac{b}{2a}+\frac{ab^{2}}{4a^{2}}+\left(c-\frac{b^{2}}{4a}\right)\\
 & =ax^{2}+bx+c
\end{align*}


\end_inset
לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
p\cdot\left(x-d\right)^{2}+r=0\Longleftrightarrow p\cdot\left(x-d\right)^{2}=-r\Longleftrightarrow\left(x-d\right)^{2}=-\frac{r}{p}
\]


\end_inset
מכאן שאם 
\begin_inset Formula
$-\frac{r}{p}<0$
\end_inset
 אז אין לפרבולה נקודות חיתוך עם ציר ה-
\begin_inset Formula
$x$
\end_inset
.
\begin_inset Newline newline
\end_inset
נמשיך בחיפוש אחר הפתרונות תוך הנחה ש-
\begin_inset Formula
$-\frac{r}{p}\geq0$
\end_inset
.
\begin_inset Formula
\begin{align*}
p\cdot\left(x-d\right)^{2}+r=0 & \Longleftrightarrow p\cdot\left(x-d\right)^{2}=-r\Longleftrightarrow\left(x-d\right)^{2}=-\frac{r}{p}\\
 & \Longleftrightarrow x-d=\pm\sqrt{-\frac{r}{p}}\Longleftrightarrow x=\pm\sqrt{-\frac{r}{p}}+d
\end{align*}


\end_inset
למעשה בזה היינו אמורים לסיים שהרי מצאנו את קבוצת הפתרונות של המשוואה, אך נמשיך מעט בשביל מי שרוצה לבדוק שאכן קיבלנו את נוסחת השורשים.
\end_layout

\begin_layout Standard
\begin_inset space \space{}
\end_inset

\end_layout

\begin_layout Standard
נשים לב לכך שמתקיים:
\begin_inset Formula
\[
-\frac{r}{p}=-\frac{c-\frac{b^{2}}{4a}}{a}=-\frac{4ac-b^{2}}{4a^{2}}=\frac{b^{2}-4ac}{4a^{2}}
\]


\end_inset
ומכאן נובע כי:
\begin_inset Formula
\[
-\frac{r}{p}<0\Longleftrightarrow\frac{b^{2}-4ac}{4a^{2}}<0\Longleftrightarrow b^{2}-4ac<0
\]


\end_inset
כלומר אם 
\begin_inset Formula
$b^{2}-4ac<0$
\end_inset
 אז אין לפרבולה נקודות חיתוך עם ציר ה-
\begin_inset Formula
$x$
\end_inset
. בנוסף, מתקיים:
\begin_inset Formula
\begin{align*}
\pm\sqrt{-\frac{r}{p}}+d & =\pm\sqrt{\frac{b^{2}-4ac}{4a^{2}}}+\left(-\frac{b}{2a}\right)=-\frac{b}{2a}\pm\frac{\sqrt{b^{2}-4ac}}{\sqrt{4a^{2}}}\\
 & =-\frac{b}{2a}\pm\frac{\sqrt{b^{2}-4ac}}{2a}=\frac{-b\pm\sqrt{b^{2}-4ac}}{2a}
\end{align*}


\end_inset

\end_layout

