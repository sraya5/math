\begin_layout Plain Layout
נשתמש בשיטה הנקראת "השלמה לריבוע".
\begin_inset Formula
\begin{align*}
ax^{2}+bx+c=0 & \Rightarrow ax^{2}+bx=-c\\
 & \Rightarrow4a\cdot\left(ax^{2}+bx\right)=4a\cdot\left(-c\right)\\
 & \Rightarrow4a^{2}x^{2}+4abx=-4ac\\
 & \Rightarrow4a^{2}x^{2}+4abx+b^{2}=b^{2}-4ac\\
 & \Rightarrow\left(2ax\right)^{2}+2\cdot\left(2ax\right)\cdot b+b^{2}=b^{2}-4ac\\
 & \Rightarrow\left(2ax+b\right)^{2}=b^{2}-4ac\\
 & \Rightarrow2ax+b=\pm\sqrt{b^{2}-4ac}\\
 & \Rightarrow2ax=-b\pm\sqrt{b^{2}-4ac}\\
 & \Rightarrow x=\frac{-b\pm\sqrt{b^{2}-4ac}}{2a}
\end{align*}


\end_inset

