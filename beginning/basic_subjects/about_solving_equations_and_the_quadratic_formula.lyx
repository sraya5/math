\begin_layout Subsection
פתרון משוואה ריבועית בשיטה שנייה
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 אסטרטגיה שנייה לפתרון משוואות: נשים לב לכך שכמעט כל הפעולות שביצענו כשניסינו למצוא מועמדים לפתרונות הן פעולות הפיכות ולכן ניתן לבצע גם גרירה בכיוון ההפוך ובכך לבטל את הצורך בהצבת המועמדים במשוואה כדי לוודא את היותם פתרונות, בואו נראה את השיטה הזו בפעולה.
\end_layout

