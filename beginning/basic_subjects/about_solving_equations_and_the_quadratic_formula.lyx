literal false
\end_inset
" שהוכחתו למשפט פיתגורס היא האלגנטית ביותר שראיתי (ראו 
\begin_inset CommandInset href
LatexCommand href
name "כאן"
target https://he.wikipedia.org/wiki/%D7%97%D7%99%D7%93%D7%95%D7%AA_%D7%97%D7%99%D7%AA%D7%95%D7%9A_%D7%95%D7%94%D7%A8%D7%9B%D7%91%D7%94#%D7%94%D7%95%D7%9B%D7%97%D7%95%D7%AA_%D7%9C%D7%9E%D7%A9%D7%A4%D7%98_%D7%A4%D7%99%D7%AA%D7%92%D7%95%D7%A8%D7%A1
literal false
\end_inset
).
\end_layout

\end_inset
 שלמדנו ובנוסף אשים את האצבע על כמה טעויות נפוצות ואסביר כיצד יש להימנע מהן. ובכן, ניגש ישר לעניין, הדוגמה שנעסוק בה היא פתרון משוואה ריבועית ונוסחת השורשים: תלמיד תיכון מקבל שלושה מספרים ממשיים 
\begin_inset Formula
$a,b,c$
\end_inset
 כך ש-
\begin_inset Formula
$a\neq0$
\end_inset
 ומתבקש למצוא פתרון למשוואה:
\begin_inset Formula
\[
ax^{2}+bx+c=0
\]


\end_inset
נעזוב את העובדה שברוב התיכונים בארץ המורים נותנים לתלמידים את נוסחת השורשים ללא כל הוכחה ועל התלמידים לקבל אותה כתורה למשה מסיני, ונתמקד בתלמיד מסוים שאינו מסתפק בכך שהמורה אמר מהי התשובה, הוא חייב למצוא הוכחה. מה עושה אותו תלמיד? פותח את הספר של בני גורן בעמוד המתאים ומתחיל לקרוא, "ההוכחה" שהוא רואה שם היא כזו:
