\begin_inset Formula
$\clubsuit$
\end_inset
 ניתן להכליל בקלות את כל ההגדרות גם ליותר מנעלם אחד ולמשוואות מעל קבוצות שאינן שדה הממשיים או אפילו תת-קבוצה שלו, אך מכיוון שאנו נעסוק כאן רק במשוואות מהסוג שלעיל הגדרה כוללת יותר הייתה מסרבלת את ההסבר שלא לצורך.
\end_layout

\begin_layout Subsection
טענות עזר
\end_layout

\begin_layout Claim
לכל שתי פונקציות 
\begin_inset Formula
$f,g:A\rightarrow B$
\end_inset
 כך ש-
\begin_inset Formula
$A,B\subseteq\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid f\left(x\right)=g\left(x\right)\right\} =\left\{ x\in\MKreal\mid f\left(x\right)-g\left(x\right)=0\right\} 
\]


\end_inset

\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

\end_layout

\begin_layout Claim
לכל שני פולינומים 
\begin_inset Formula
$p,q\in\MKreal\left[x\right]$
\end_inset
 הדרגה של פולינום ההפרש (
\begin_inset Formula
$p-q$
\end_inset
) קטנה או שווה לדרגה המקסימלית מבין אלו של 
\begin_inset Formula
$p$
\end_inset
 ו-
\begin_inset Formula
$q$
\end_inset
, כלומר:
\begin_inset Formula
\[
\deg\left(p-q\right)\leq\max\left\{ \deg p,\deg q\right\} 
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 משתי הטענות ביחד נובע שכדי לפתור כל משוואה ריבועית מעל 
\begin_inset Formula
$\MKreal$
\end_inset
 מספיק לדעת כיצד לפתור כל משוואה מהצורה 
\begin_inset Formula
$f\left(x\right)=0$
\end_inset
 כאשר 
\begin_inset Formula
$f$
\end_inset
 היא פונקציה פולינומיאלית מעל 
\begin_inset Formula
$\MKreal$
\end_inset
 שדרגתה קטנה או שווה ל-
\begin_inset Formula
$2$
\end_inset
.
\end_layout

\begin_layout Subsection
פתרון משוואה ריבועית בשיטה ראשונה
\end_layout

\begin_layout Standard
תהא 
\begin_inset Formula
$f$
\end_inset
 פונקציה פולינומיאלית מעל 
\begin_inset Formula
$\MKreal$
\end_inset
 שדרגתה קטנה או שווה ל-
\begin_inset Formula
$2$
\end_inset
 ויהיו 
\begin_inset Formula
$a,b,c\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$f\left(x\right)=ax^{2}+bx+c$
\end_inset
 לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
; מהגדרה, קבוצת הפתרונות של המשוואה 
\begin_inset Formula
$f\left(x\right)=0$
\end_inset
 היא:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid f\left(x\right)=0\right\} =\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} 
\]


\end_inset

\end_layout

\begin_layout Claim
נניח ש-
\begin_inset Formula
$a=0$
\end_inset
 ונחלק למקרים:
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula
$b\neq0$
\end_inset
 אז מתקיים:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\left\{ -\frac{c}{b}\right\} 
\]


\end_inset

\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$b=0$
\end_inset
 וגם 
\begin_inset Formula
$c=0$
\end_inset
 אז מתקיים:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\MKreal
\]


\end_inset

\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$b=0$
\end_inset
 אך 
\begin_inset Formula
$c\neq0$
\end_inset
 אז מתקיים:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\emptyset
\]


\end_inset

\end_layout

\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר אם 
\begin_inset Formula
$b\neq0$
\end_inset
 אז למשוואה 
\begin_inset Formula
$bx+c=0$
\end_inset
 יש פתרון יחיד והוא 
\begin_inset Formula
$-\frac{c}{b}$
\end_inset
, אם 
\begin_inset Formula
$b=c=0$
\end_inset
 אז כל מספר ממשי הוא פתרון של המשוואה ואם 
\begin_inset Formula
$b=0$
\end_inset
 אך 
\begin_inset Formula
$c\neq0$
\end_inset
 אין למשוואה פתרון כלל.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 אסטרטגיה ראשונה לפתרון משוואות: נניח שיש למשוואה פתרון ואחרי שנמצא את כל המועמדים נציב אותם אחד אחד בביטוי 
\begin_inset Formula
$bx+c$
\end_inset
 ונראה אם אנחנו אכן מקבלים 
\begin_inset Formula
$0$
\end_inset
.
\end_layout

\begin_layout Proof
נסמן 
\begin_inset Formula
$S:=\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} $
\end_inset
 ונניח שיש למשוואה פתרון (כלומר הקבוצה 
\begin_inset Formula
$S$
\end_inset
 אינה ריקה).
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$x$
\end_inset
 פתרון (כלומר יהי 
\begin_inset Formula
$x\in S$
\end_inset
), מהגדרה מתקיים:
\begin_inset Formula
\[
ax^{2}+bx+c=0
\]


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow0\cdot x^{2}+bx+c=0\\
 & \Rightarrow0+bx+c=0\\
 & \Rightarrow0+bx+c-c=0-c\\
 & \Rightarrow bx+0=-c\\
 & \Rightarrow bx=-c
\end{align*}


\end_inset

\begin_inset Newpage newpage
\end_inset
כעת נחלק למקרים:
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula
$b\neq0$
\end_inset
 אז יש לו הופכי ומכאן שמתקיים:
\begin_inset Formula
\[
b^{-1}\cdot b\cdot x=b^{-1}\cdot-c
\]


\end_inset

\begin_inset Formula
\[
\Rightarrow x=1\cdot x=\frac{-c}{b}=-\frac{c}{b}
\]


\end_inset
א"כ הוכחנו ש
\series bold
אם
\series default
 יש למשוואה פתרון ו-
\begin_inset Formula
$b\neq0$
\end_inset
 אז קיים פתרון יחיד והוא 
\begin_inset Formula
$-\frac{b}{c}$
\end_inset
, כלומר 
\begin_inset Formula
$S\subseteq\left\{ -\frac{b}{c}\right\} $
\end_inset
; אם נציב 
\begin_inset Formula
$x:=-\frac{b}{c}$
\end_inset
 נקבל שאכן מתקיים 
\begin_inset Formula
$ax^{2}+bx+c=0$
\end_inset
 ולכן 
\begin_inset Formula
$\left\{ -\frac{b}{c}\right\} \subseteq S$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\left\{ -\frac{c}{b}\right\} 
\]


\end_inset

\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$b=c=0$
\end_inset
 אז קיבלנו שמתקיים 
\begin_inset Formula
$0=0\cdot x=b\cdot x=-c=-0=0$
\end_inset
 ומכאן שאיננו יכולים לומר דבר על פתרונות המשוואה, זה רומז לנו (למרות שאין זה מוכרח) שכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 הוא פתרון של המשוואה ואכן לכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
ax^{2}+bx+c=0\cdot x^{2}+0\cdot c+0=0+0=0
\]


\end_inset
כלומר 
\begin_inset Formula
$\MKreal\subseteq S$
\end_inset
 ומכיוון שמהגדרה 
\begin_inset Formula
$S\subseteq\MKreal$
\end_inset
 הרי שקיבלנו את השוויון 
\begin_inset Formula
$S=\MKreal$
\end_inset
.
\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$b=0$
\end_inset
 ו-
\begin_inset Formula
$c\neq0$
\end_inset
 אז קיבלנו שלכל 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 המקיים 
\begin_inset Formula
$ax^{2}+bx+c=0$
\end_inset
 מתקיים 
\begin_inset Formula
$0=0\cdot x=b\cdot x=-c\neq-0=0$
\end_inset
 וזה לא יכול להיות ומכאן שלא קיים 
\begin_inset Formula
$x\in\MKreal$
\end_inset
 כך ש-
\begin_inset Formula
$ax^{2}+bx+c=0$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\emptyset
\]


\end_inset

\end_layout

\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ההוכחה הזו הייתה מסורבלת למדי: לא מספיק שעבדנו קשה כדי להוכיח שאם קיים פתרון אז הוא צריך להיות פתרון מסוים, אלא שגם היינו צריכים אחר להציב את הפתרון במשוואה כדי לוודא שהוא אכן פתרון; במקרה הזה היה מדובר בפעולה פשוטה, אך כפי שניווכח כשננסה ליישם את האסטרטגיה הזו בהוכחת נוסחת השורשים ישנם מקרים שבהם הדבר מסרבל את ההוכחה עד מאד.
\end_layout

\begin_layout Theorem
\series bold
נוסחת השורשים
\series default

\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$a\neq0$
\end_inset
 ונחלק למקרים:
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula
$b^{2}-4ac>0$
\end_inset
 אז מתקיים:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\left\{ \frac{-b+\sqrt{b^{2}-4ac}}{2a},\frac{-b-\sqrt{b^{2}-4ac}}{2a}\right\} 
\]


\end_inset

\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$b^{2}-4ac=0$
\end_inset
 אז מתקיים:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\left\{ \frac{-b+\sqrt{b^{2}-4ac}}{2a},\frac{-b-\sqrt{b^{2}-4ac}}{2a}\right\} =\left\{ -\frac{b}{2a}\right\} 
\]


\end_inset

\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$b^{2}-4ac<0$
\end_inset
 אז מתקיים:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\emptyset
\]


\end_inset

\end_layout

\end_deeper

\begin_layout Proof
\bar under
הוכחה 
\numeric on
1
\numeric off
 - פירמול ההוכחה של בני גורן ע"פ האסטרטגיה הראשונה
\bar default

\begin_inset Newline newline
\end_inset
כמו מקודם נסמן 
\begin_inset Formula
$S:=\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} $
\end_inset
 ונניח ש-
\begin_inset Formula
$S\neq\emptyset$
\end_inset
.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$x\in S$
\end_inset
 פתרון, מהגדרה מהגדרה מתקיים:
\begin_inset Formula
\[
ax^{2}+bx+c=0
\]


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow ax^{2}+bx+c-c=0-c\\
 & \Rightarrow ax^{2}+bx+0=-c\\
 & \Rightarrow ax^{2}+bx=-c\\
 & \Rightarrow4a\cdot\left(ax^{2}+bx\right)=4a\cdot\left(-c\right)\\
 & \Rightarrow4a^{2}x^{2}+4abx=-4ac\\
 & \Rightarrow4a^{2}x^{2}+4abx+b^{2}=-4ac+b^{2}\\
 & \Rightarrow\left(2ax\right)^{2}+2\cdot\left(2ax\right)\cdot b+b^{2}=b^{2}-4ac\\
 & \Rightarrow\left(2ax+b\right)^{2}=b^{2}-4ac
\end{align*}


\end_inset
אנחנו יודעים שלכל 
\begin_inset Formula
$d\in\MKreal$
\end_inset
 מתקיים 
\begin_inset Formula
$d^{2}\geq0$
\end_inset
 ומכאן ש-
\begin_inset Formula
$b^{2}-4ac\geq0$
\end_inset
.
\begin_inset Newline newline
\end_inset
א"כ הוכחנו כבר עכשיו שאם יש למשוואה פתרון אז 
\begin_inset Formula
$b^{2}-4ac\geq0$
\end_inset
 ומכאן שאם 
\begin_inset Formula
$b^{2}-4ac<0$
\end_inset
 אז אין למשוואה פתרון.
\begin_inset Newline newline
\end_inset
נמשיך בשרשרת הגרירות תוך הנחה שיש למשוואה פתרון, כפי שראינו לעיל זה אומר ש-
\begin_inset Formula
$b^{2}-4ac\geq0$
\end_inset
 ולכן 
\begin_inset Formula
$d:=\sqrt{b^{2}-4ac}$
\end_inset

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
נזכור שהגדרנו את 
\begin_inset Formula
$\sqrt{b^{2}-4ac}$
\end_inset
 להיות המספר 
\series bold
האי-שלילי
\series default
 היחיד שהכפלתו בעצמו נותנת את 
\begin_inset Formula
$b^{2}-4ac$
\end_inset
.
\end_layout

\end_inset
 מוגדר, אבל האם 
\begin_inset Formula
$d$
\end_inset
 הוא המספר היחיד המקיים 
\begin_inset Formula
$d^{2}=b^{2}-4ac$
\end_inset
?
\begin_inset Newline newline
\end_inset
לא בהכרח, אנחנו יודעים שמתקיים גם 
\begin_inset Formula
$\left(-d\right)^{2}=d^{2}=b^{2}-4ac$
\end_inset
 וש-
\begin_inset Formula
$-d\neq d$
\end_inset
 אם"ם 
\begin_inset Formula
$d\neq0$
\end_inset
, כמו כן אנחנו יודעים שלא קיימים מספרים ממשיים נוספים המקיימים זאת ולכן נוכל להמשיך את שרשרת הגרירות:
\begin_inset Formula
\begin{align*}
 & \Rightarrow\left(2ax+b=d\right)\lor\left(2ax+b=-d\right)\\
 & \Rightarrow\left(2ax+b-b=d-b\right)\lor\left(2ax+b-b=-d-b\right)\\
 & \Rightarrow\left(2ax+0=-b+d\right)\lor\left(2ax+0=-b-d\right)\\
 & \Rightarrow\left(2ax=-b+d\right)\lor\left(2ax=-b-d\right)
\end{align*}


\end_inset
כעת נזכור ש-
\begin_inset Formula
$a\neq0$
\end_inset
 ולכן גם 
\begin_inset Formula
$2a\neq0$
\end_inset
 ומכאן שיש ל-
\begin_inset Formula
$2a$
\end_inset
 הופכי.
\begin_inset Formula
\begin{align*}
 & \Rightarrow\left(2ax=-b+d\right)\lor\left(2ax=-b-d\right)\\
 & \Rightarrow\left(\left(2a\right)^{-1}\cdot2ax=\left(2a\right)^{-1}\cdot\left(-b+d\right)\right)\lor\left(\left(2a\right)^{-1}\cdot2ax=\left(2a\right)^{-1}\cdot\left(-b-d\right)\right)\\
 & \Rightarrow\left(1\cdot x=\frac{-b+d}{2a}\right)\lor\left(1\cdot x=\frac{-b-d}{2a}\right)\\
 & \Rightarrow\left(x=\frac{-b+d}{2a}\right)\lor\left(x=\frac{-b-d}{2a}\right)
\end{align*}


\end_inset

\begin_inset Formula
\[
\Rightarrow S\subseteq\left\{ \frac{-b+d}{2a},\frac{-b-d}{2a}\right\} 
\]


\end_inset

\end_layout

\begin_layout Proof
א"כ הוכחנו שאם יש למשוואה פתרון אז כל פתרון הוא 
\begin_inset Formula
$\begin{alignedat}{1}\frac{-b+d}{2a}=\frac{-b+\sqrt{b^{2}-4ac}}{2a}\end{alignedat}
$

\end_inset
 ו/או 
\begin_inset Formula
$\begin{alignedat}{1}\frac{-b-d}{2a}=\frac{-b-\sqrt{b^{2}-4ac}}{2a}\end{alignedat}
$

\end_inset
, כעת כל מה שנותר לנו הוא להציב את המועמדים שמצאנו ולוודא שהם אכן מהווים פתרונות של המשוואה.
\begin_inset Newline newline
\end_inset
הפעם ארשה לעצמי להשתמש בסימון 
\begin_inset Formula
$\frac{-b{\color{red}\pm}d}{2a}=\frac{-b{\color{red}\pm}\sqrt{b^{2}-4ac}}{2a}$
\end_inset
 משום שאני מאמין שכעת כולנו מבינים למה הכוונה, וכמו כן לא אכתוב במפורש כיצד מתבצע כל מעבר בין השוויונות.
\begin_inset Formula
\begin{align*}
a\cdot\left(\frac{-b\pm d}{2a}\right)^{2}+b\cdot\left(\frac{-b\pm d}{2a}\right)+c & =a\cdot\left(\frac{b^{2}\pm2\left(-b\right)d+d^{2}}{4a^{2}}\right)+\frac{-b^{2}\pm bd}{2a}+c\\
 & =\frac{b^{2}\mp2bd+d^{2}}{4a}+\frac{-b^{2}\pm bd}{2a}+c\\
 & =\frac{b^{2}\mp2bd+d^{2}}{4a}+\frac{-2b^{2}\pm2bd}{4a}+\frac{4ac}{4a}\\
 & =\frac{-b^{2}+d^{2}+4ac}{4a}\\
 & =\frac{-b^{2}+\left(\sqrt{b^{2}-4ac}\right)^{2}+4ac}{4a}\\
 & =\frac{-b^{2}+b^{2}-4ac+4ac}{4a}=0
\end{align*}


\end_inset

\begin_inset Formula
\begin{align*}
 & \Rightarrow\left\{ \frac{-b+d}{2a},\frac{-b-d}{2a}\right\} \subseteq S\\
 & \Rightarrow\left\{ \frac{-b+d}{2a},\frac{-b-d}{2a}\right\} =S
\end{align*}


\end_inset
כלומר קבוצת הפתרונות של המשוואה 
\begin_inset Formula
$ax^{2}+bx+c=0$
\end_inset
 היא:
\begin_inset Formula
\[
\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\} =\left\{ \frac{-b+\sqrt{b^{2}-4ac}}{2a},\frac{-b-\sqrt{b^{2}-4ac}}{2a}\right\} 
\]


\end_inset
כעת נשים לב לכך שאם 
\begin_inset Formula
$b^{2}-4ac=0$
\end_inset
 אז גם 
\begin_inset Formula
$\pm\sqrt{b^{2}-4ac}=0$
\end_inset
 ולכן:
\begin_inset Formula
\begin{align*}
\left\{ x\in\MKreal\mid ax^{2}+bx+c=0\right\}  & =\left\{ \frac{-b+\sqrt{b^{2}-4ac}}{2a},\frac{-b-\sqrt{b^{2}-4ac}}{2a}\right\} \\
 & =\left\{ \frac{-b+0}{2a},\frac{-b-0}{2a}\right\} \\
 & =\left\{ \frac{-b}{2a},\frac{-b}{2a}\right\} =\left\{ -\frac{b}{2a}\right\} 
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 שימו לב שתהליך הצבת הפתרונות דרש כמעט את אותו אורך של מציאת הפתרונות האפשריים וזאת למרות שבו הרשיתי לעצמי להשתמש בסימון "
\begin_inset Formula
$\pm$
\end_inset
" כדי לקצר את ההסבר, בנוסף, זה נראה כאילו הדרך שבה פתרנו משוואות בתיכון היא קשקוש מוחלט: כל החלק של הצבת המועמדים כדי לוודא שהם אכן פתרונות נעדרת לחלוטין מהדרך שבה השתמשנו בתיכון כדי לפתור משוואות. אנחנו יכולים להירגע, הדרך שבה פתרנו משוואות בתיכון ניתנת לפירמול אלא שהפירמול אינו משתמש באסטרטגיה הראשונה שראינו אלא באסטרטגיה אחרת שתפורט להלן.
\end_layout

