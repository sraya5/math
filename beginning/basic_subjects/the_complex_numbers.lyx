\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 החלוקה שבהערה הקודמת נותנת לנו עוד קבוצה מיוחדת ב-
\begin_inset Formula $\MKcomplex$
\end_inset

 מלבד הממשיים והמדומים - הקבוצה החדשה היא מעגל היחידה המרוכב,
 וכך מבחינה גאומטרית הקבוצות המיוחדות במישור הן הצירים ומעגל היחידה.
\end_layout

\begin_layout Proof
מהגדרת הכפל של מספרים מרוכבים ומהזהויות הטריגונומטריות של קוסינוס וסינוס של סכום זוויות
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
לכל 
\begin_inset Formula $\alpha,\beta\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\sin\left(\alpha\pm\beta\right) & =\sin\alpha\cdot\cos\beta\pm\cos\alpha\cdot\sin\beta\\
\cos\left(\alpha\pm\beta\right) & =\cos\alpha\cdot\cos\beta\mp\sin\alpha\cdot\sin\beta
\end{align*}

\end_inset


\end_layout

\end_inset

 נובע כי:
\begin_inset Formula 
\begin{align*}
\MKcis\left(\theta_{1}\right)\cdot\MKcis\left(\theta_{2}\right) & =\left(\cos\theta_{1}+i\cdot\sin\theta_{1}\right)\cdot\left(\cos\theta_{2}+i\cdot\sin\theta_{2}\right)\\
 & =\left(\cos\theta_{1}\cdot\cos\theta_{2}-\sin\theta_{1}\cdot\sin\theta_{2}\right)+i\cdot\left(\cos\theta_{1}\cdot\sin\theta_{2}+\sin\theta_{1}\cdot\cos\theta_{2}\right)\\
 & =\cos\left(\theta_{1}+\theta_{2}\right)+i\cdot\sin\left(\theta_{1}+\theta_{2}\right)=\MKcis\left(\theta_{1}+\theta_{2}\right)
\end{align*}

\end_inset

וממילא:
\begin_inset Formula 
\[
z\cdot w=\left(r_{1}\cdot\MKcis\left(\theta_{1}\right)\right)\cdot\left(r_{2}\cdot\MKcis\left(\theta_{2}\right)\right)=\left(r_{1}\cdot r_{2}\right)\cdot\left(\MKcis\left(\theta_{1}\right)\cdot\MKcis\left(\theta_{2}\right)\right)=\left(r_{1}\cdot r_{2}\right)\cdot\MKcis\left(\theta_{1}+\theta_{2}\right)
\]

\end_inset


\end_layout

\begin_layout Corollary
יהיו 
\begin_inset Formula $z:=r_{1}\cdot\MKcis\left(\theta_{1}\right)\in\MKcomplex$
\end_inset

 ו-
\begin_inset Formula $0\neq w:=r_{2}\cdot\MKcis\left(\theta_{2}\right)$
\end_inset

,
 מתקיים:
\begin_inset Formula 
\[
\frac{z}{w}=\frac{r_{1}}{r_{2}}\cdot\MKcis\left(\theta_{1}-\theta_{2}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset


\end_layout

\begin_layout Corollary

\series bold
משפט דה-מואבר
\series default

\begin_inset Foot
status collapsed

\begin_layout Plain Layout
ערך בוויקיפדיה:
 
\begin_inset CommandInset href
LatexCommand href
name "אברהם דה-מואבר"
target "https://he.wikipedia.org/wiki/%D7%90%D7%91%D7%A8%D7%94%D7%9D_%D7%93%D7%94_%D7%9E%D7%95%D7%90%D7%91%D7%A8"
literal "false"

\end_inset


\end_layout

\end_inset


\begin_inset Newline newline
\end_inset

יהי 
\begin_inset Formula $0\neq z:=r\cdot\MKcis\left(\theta\right)\in\MKcomplex$
\end_inset

,
 מתקיים (לכל 
\begin_inset Formula $n\in\MKinteger$
\end_inset

):
\begin_inset Formula 
\[
z^{n}=r^{n}\cdot\MKcis\left(n\cdot\theta\right)
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 כמובן שהנוסחה תקפה גם עבור 
\begin_inset Formula $0$
\end_inset

 בחזקה טבעית.
\end_layout

\begin_layout Corollary

\series bold
הוצאת שורש מרוכב באמצעות הצגה קוטבית
\series default

\begin_inset Newline newline
\end_inset

יהי 
\begin_inset Formula $z:=r\cdot\MKcis\left(\theta\right)\in\MKcomplex$
\end_inset

 מתקיים (לכל 
\begin_inset Formula $n\in\MKnatural$
\end_inset

):
\begin_inset Formula 
\[
\left\{ x\in\MKcomplex\mid x^{n}=z\right\} =\left\{ \begin{array}{c|c}
\begin{alignedat}{1}\sqrt[n]{r}\cdot\MKcis\left(\frac{\theta+2\pi k}{n}\right)\end{alignedat}
 & k\in\MKinteger\end{array}\right\} 
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 כלומר קיימים בדיוק 
\begin_inset Formula $n$
\end_inset

 מספרים מרוכבים המהווים שורש 
\begin_inset Formula $n$
\end_inset

-י של מספר מרוכב נתון שאינו 
\begin_inset Formula $0$
\end_inset

,
 והם נתונים ע"י הנוסחה:
\begin_inset Formula 
\[
z_{k}=\sqrt[n]{r}\cdot\MKcis\left(\frac{\theta+2\pi k}{n}\right)
\]

\end_inset

עבור 
\begin_inset Formula $n>k\in\MKnatural_{0}$
\end_inset

.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 מבחינה גאומטרית השורשים מהווים את קודקודיו של מצולע משוכלל בעל 
\begin_inset Formula $n$
\end_inset

 צלעות,
 החסום ע"י מעגל שמרכזו בראשית הצירים ואורך הרדיוס שלו הוא 
\begin_inset Formula $\sqrt[n]{r}$
\end_inset

,
 כאשר אחד מהרדיוסים היוצאים אל הקודקודים יוצר זווית של 
\begin_inset Formula $\frac{\theta}{n}$
\end_inset

 רדיאנים עם החלק החיובי של ציר ה-
\begin_inset Formula $x$
\end_inset

.
\begin_inset Newline newline
\end_inset


\series bold
\color red
כדאי להוסיף המחשה.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 א"כ השורשים ה-
\begin_inset Formula $n$
\end_inset

-יים של מספר ממשי 
\begin_inset Formula $0\neq a\in\MKreal$
\end_inset

 הם (כאשר 
\begin_inset Formula $a>0$
\end_inset

):
\begin_inset Formula 
\[
\sqrt[n]{a},\sqrt[n]{a}\cdot\MKcis\left(\frac{2\pi}{n}\right),\sqrt[n]{a}\cdot\MKcis\left(\frac{4\pi}{n}\right),\sqrt[n]{a}\cdot\MKcis\left(\frac{6\pi}{n}\right),\ldots,\sqrt[n]{a}\cdot\MKcis\left(\frac{2\left(n-1\right)\pi}{n}\right)
\]

\end_inset

או (כאשר 
\begin_inset Formula $a<0$
\end_inset

):
\begin_inset Formula 
\[
\sqrt[n]{\left|a\right|}\cdot\MKcis\left(\frac{\pi}{n}\right),\sqrt[n]{\left|a\right|}\cdot\MKcis\left(\frac{3\pi}{n}\right),\sqrt[n]{\left|a\right|}\cdot\MKcis\left(\frac{5\pi}{n}\right),\sqrt[n]{\left|a\right|}\cdot\MKcis\left(\frac{7\pi}{n}\right),\ldots,\sqrt[n]{\left|a\right|}\cdot\MKcis\left(\frac{\left(2n-1\right)\pi}{n}\right)
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 בפרט מעניינים אותנו בהקשר זה המספרים הנקראים 
\bar under
שורשי היחידה
\bar default
 שהם השורשים ה-
\begin_inset Formula $n$
\end_inset

-יים של 
\begin_inset Formula $1$
\end_inset

,
 כלומר:
\begin_inset Formula 
\[
\left\{ \begin{array}{c|c}
\begin{alignedat}{1}\sqrt[n]{1}\cdot\MKcis\left(\frac{2\pi k+0}{n}\right)\end{alignedat}
 & k\in\MKinteger\end{array}\right\} =\left\{ \begin{array}{c|c}
\begin{alignedat}{1}\MKcis\left(2\pi\cdot\frac{k}{n}\right)\end{alignedat}
 & n>k\in\MKnatural_{0}\end{array}\right\} 
\]

\end_inset

שורשי היחידה יוצרים מצולע משוכלל החסום ע"י מעגל היחידה שאחד מקודקודיו נמצא על החלק החיובי של ציר ה-
\begin_inset Formula $x$
\end_inset

 והוא 
\begin_inset Formula $1$
\end_inset

 עצמו כמובן.
\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset


\end_layout

\begin_layout Proof
העובדה שלכל 
\begin_inset Formula $k\in\MKinteger$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left(\sqrt[n]{r}\cdot\MKcis\left(\frac{2\pi k+\theta}{n}\right)\right)^{n}=r\cdot\MKcis\left(2\pi k+\theta\right)=r\cdot\MKcis\left(\theta\right)
\]

\end_inset

נובעת ישירות ממשפט דה-מואבר.
\begin_inset Newline newline
\end_inset

נוכיח שאין ל-
\begin_inset Formula $z$
\end_inset

 שורשים נוספים,
 אם 
\begin_inset Formula $z=0$
\end_inset

 אז הטענה טריוויאלית (בכל שדה יש ל-
\begin_inset Formula $0$
\end_inset

 שורש 
\begin_inset Formula $n$
\end_inset

-י יחיד והוא 
\begin_inset Formula $0$
\end_inset

) ולכן נוכל להניח ש-
\begin_inset Formula $z\neq0$
\end_inset

.
\begin_inset Newline newline
\end_inset

יהי 
\begin_inset Formula $w:=\tilde{r}\cdot\MKcis\left(\tilde{\theta}\right)\in\MKcomplex$
\end_inset

 כך ש-
\begin_inset Formula $w^{n}=z$
\end_inset

,
 ממשפט דה-מואבר נובע שמתקיים:
\begin_inset Formula 
\[
\tilde{r}^{n}\cdot\MKcis\left(n\cdot\tilde{\theta}\right)=w^{n}=z=r\cdot\MKcis\left(\theta\right)
\]

\end_inset

שוויון בין שני מספרים מרוכבים בהצגה קוטבית אומר שהרדיוסים שלהם שווים וגם הזוויות שלהם זהות (עד כדי הוספת כפולה של 
\begin_inset Formula $2\pi$
\end_inset

),
 מכאן שמתקיים 
\begin_inset Formula $\tilde{r}^{n}=r$
\end_inset

 ו-
\begin_inset Formula $n\cdot\tilde{\theta}=\theta+2\pi k$
\end_inset

 עבור 
\begin_inset Formula $k\in\MKinteger$
\end_inset

 כלשהו.
\begin_inset Newline newline
\end_inset

מהגדרה 
\begin_inset Formula $r$
\end_inset

 ו-
\begin_inset Formula $\tilde{r}$
\end_inset

 הם מספרים ממשיים חיוביים ולכן מהשורה הקודמת נובע ש-
\begin_inset Formula $\tilde{r}=\sqrt[n]{r}$
\end_inset

,
 בנוסף ניתן להסיק מהשורה הקודמת שקיים 
\begin_inset Formula $k\in\MKinteger$
\end_inset

 כך שמתקיים:
\begin_inset Formula 
\[
\tilde{\theta}=\frac{\theta+2\pi k}{n}
\]

\end_inset

כלומר 
\begin_inset Formula $w$
\end_inset

 אכן שייך לקבוצה הנ"ל ולכן מהיותו שרירותי נובע שהיא כוללת את כל השורשים ה-
\begin_inset Formula $n$
\end_inset

-יים של 
\begin_inset Formula $z$
\end_inset

.
\end_layout

