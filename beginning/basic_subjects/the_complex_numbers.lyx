\begin_layout Definition
יהי 
\begin_inset Formula $0\neq z:=x+yi\in\MKcomplex$
\end_inset

,
 
\bar under
הצגה קוטבית
\bar default
 (נקראת גם 
\bar under
הצגה פולרית
\bar default
) של 
\begin_inset Formula $z$
\end_inset

 היא ביטוי מהצורה 
\begin_inset Formula $z=r\cdot\left(\cos\theta+i\cdot\sin\theta\right)$
\end_inset

 כאשר 
\begin_inset Formula $r:=\left|z\right|=\sqrt{x^{2}+y^{2}}$
\end_inset

 ואילו 
\begin_inset Formula $\theta$
\end_inset

 מוגדרת ע"י:
\begin_inset Formula 
\[
\theta:=\begin{cases}
\arctan\left(\frac{y}{x}\right)+2\pi k & x>0\\
\arctan\left(\frac{y}{x}\right)\pm\pi+2\pi k & x<0\\
\frac{3\pi}{2}+2\pi k & x=0,\ y>0\\
\frac{\pi}{2}+2\pi k & x=0,\ y<0
\end{cases}
\]

\end_inset

עבור 
\begin_inset Formula $k\in\MKinteger$
\end_inset

 כלשהו.
\begin_inset Newline newline
\end_inset

ההצגה הקוטבית של 
\begin_inset Formula $0$
\end_inset

 בשדה המרוכבים היא 
\begin_inset Formula $0\cdot\left(\cos\theta+i\cdot\sin\theta\right)$
\end_inset

 עבור 
\begin_inset Formula $\theta\in\MKreal$
\end_inset

 כלשהי.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
