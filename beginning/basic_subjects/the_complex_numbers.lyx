\begin_layout Example
ניתן להוכיח את 
\series bold
הזהויות הטריגונומטריות
\series default
 של קוסינוס וסינוס של סכום זוויות
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
לכל 
\begin_inset Formula $\alpha,\beta\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\sin\left(\alpha\pm\beta\right) & =\sin\alpha\cdot\cos\beta\pm\cos\alpha\cdot\sin\beta\\
\cos\left(\alpha\pm\beta\right) & =\cos\alpha\cdot\cos\beta\mp\sin\alpha\cdot\sin\beta
\end{align*}

\end_inset


\end_layout

\end_inset

 באמצעות התובנה הבאה:
\end_layout

\begin_deeper
\begin_layout Itemize
כפל במספר מרוכב שקול לכפל במטריצת סיבוב ומתיחה,
 אם המספר המרוכב נמצא על מעגל היחידה אז הכפל בו שקול למטריצת סיבוב בלבד.
\end_layout

\begin_layout Itemize
כפל מטריצות מקיים את חוק הקיבוץ,
 מכאן נובע שהכפלה במספר מרוכב אחד ואחריה הכפלה במספר מרוכב שני שקולה לכפל במספר המרוכב שהמטריצה המתאימה לו היא המטריצה המתאימה לסיבוב בסכום הזוויות ומתיחה במכפלת הרדיוסים (זהו נימוק 
\series bold
גאומטרי
\series default
);
 אם שני המספרים נמצאים על מעגל היחידה הכפל של שניהם שקול למטריצת הסיבוב בסכום הזוויות המתאימות להם.
\end_layout

\begin_layout Itemize
קיימת העתקה חח"ע ועל בין מספרים מרוכבים למטריצות הסיבוב והמתיחה המתאימות להם,
 מכאן שלכל 
\begin_inset Formula $\theta_{1},\theta_{2}\in\MKreal$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\MKcis\left(\theta_{1}+\theta_{2}\right)=\MKcis\left(\theta_{1}\right)\cdot\MKcis\left(\theta_{2}\right)
\]

\end_inset


\end_layout

\begin_layout Itemize
כל שוויון בין שני מספרים מרוכבים מגדיר שני שוויונות בין מספרים ממשיים,
 וזאת משום שההצגה הקרטזית של מספר מרוכב היא יחידה ולמעשה היא מהווה זוג סדור של מספרים ממשיים;
 מסיבה זו ניתן לקחת כל משוואה מעל המרוכבים ולהפוך אותה לשתי משוואות מעל הממשיים.
\end_layout

\begin_deeper
\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\Rightarrow\cos\left(\theta_{1}+\theta_{2}\right)+i\cdot\sin\left(\theta_{1}+\theta_{2}\right) & =\left(\cos\theta_{1}+i\cdot\sin\theta_{1}\right)\cdot\left(\cos\theta_{2}+i\cdot\sin\theta_{2}\right)\\
\Rightarrow{\color{red}\cos\left(\theta_{1}+\theta_{2}\right)}+{\color{blue}i\cdot\sin\left(\theta_{1}+\theta_{2}\right)} & ={\color{red}\left(\cos\theta_{1}\cdot\cos\theta_{2}-\sin\theta_{1}\cdot\sin\theta_{2}\right)}+{\color{blue}i\cdot\left(\cos\theta_{1}\cdot\sin\theta_{2}+\sin\theta_{1}\cdot\cos\theta_{2}\right)}
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\Rightarrow{\color{red}\cos\left(\theta_{1}+\theta_{2}\right)} & {\color{red}=\cos\theta_{1}\cdot\cos\theta_{2}-\sin\theta_{1}\cdot\sin\theta_{2}}\\
\Rightarrow{\color{blue}\sin\left(\theta_{1}+\theta_{2}\right)} & {\color{blue}=\cos\theta_{1}\cdot\sin\theta_{2}+\sin\theta_{1}\cdot\cos\theta_{2}}
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\Rightarrow{\color{red}\cos\left(\theta_{1}\pm\theta_{2}\right)} & {\color{red}=\cos\theta_{1}\cdot\cos\left(\pm\theta_{2}\right)-\sin\theta_{1}\cdot\sin\left(\pm\theta_{2}\right)}\\
 & {\color{red}=\cos\theta_{1}\cdot\cos\theta_{2}-\sin\theta_{1}\cdot\left(-\sin\theta_{2}\right)}\\
 & {\color{red}=\cos\theta_{1}\cdot\cos\theta_{2}\mp\sin\theta_{1}\cdot\sin\theta_{2}}\\
\Rightarrow{\color{blue}\sin\left(\theta_{1}\pm\theta_{2}\right)} & {\color{blue}=\sin\theta_{1}\cdot\cos\left(\pm\theta_{2}\right)+\cos\theta_{1}\cdot\sin\left(\pm\theta_{2}\right)}\\
 & {\color{blue}=\sin\theta_{1}\cdot\cos\theta_{2}+\cos\theta_{1}\cdot\left(-\sin\theta_{2}\right)}\\
 & {\color{blue}=\cos\theta_{1}\cdot\sin\theta_{2}\pm\sin\theta_{1}\cdot\cos\theta_{2}}
\end{align*}

\end_inset


\end_layout

\end_deeper
\end_deeper
\begin_layout Labeling
