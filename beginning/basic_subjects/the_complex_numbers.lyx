את הסעיף הראשון ראינו כבר בקובץ ההגדרות מפני שהוא נובע ישירות מן ההגדרה.
\end_layout

\begin_layout Enumerate
לכל 
\begin_inset Formula $z,w\in\MKcomplex$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left|z\cdot w\right|^{2}=\left(z\cdot w\right)\cdot\left(\overline{z\cdot w}\right)=z\cdot w\cdot\bar{z}\cdot\bar{w}=z\cdot\bar{z}\cdot w\cdot\bar{w}=\left|z\right|^{2}\cdot\left|w\right|^{2}=\left(\left|z\right|\cdot\left|w\right|\right)^{2}
\]

\end_inset

וממילא:
\begin_inset Formula 
\[
\left|z\cdot w\right|=\sqrt{\left|z\cdot w\right|^{2}}=\sqrt{\left(\left|z\right|\cdot\left|w\right|\right)^{2}}=\left|z\right|\cdot\left|w\right|
\]

\end_inset


\end_layout

\begin_layout Enumerate
לכל 
\begin_inset Formula $z,w\in\MKcomplex$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\left|z+w\right|^{2} & =\left(z+w\right)\cdot\left(\overline{z+w}\right)=\left(z+w\right)\cdot\left(\bar{z}+\bar{w}\right)=z\cdot\bar{z}+z\cdot\bar{w}+\bar{z}\cdot w+w\cdot\bar{w}\\
 & =\left|z\right|^{2}+z\cdot\bar{w}+\overline{z\cdot\bar{w}}+\left|w\right|^{2}=\left|z\right|^{2}+2\cdot\MKre\left(z\cdot\bar{w}\right)+\left|w\right|^{2}\\
 & \leq\left|z\right|^{2}+2\cdot\left|z\cdot\bar{w}\right|+\left|w\right|^{2}=\left|z\right|^{2}+2\cdot\left|z\right|\cdot\left|\bar{w}\right|+\left|w\right|^{2}\\
 & =\left|z\right|^{2}+2\cdot\left|z\right|\cdot\left|w\right|+\left|w\right|^{2}=\left(\left|z\right|+\left|w\right|\right)^{2}
\end{align*}

\end_inset


\end_layout

