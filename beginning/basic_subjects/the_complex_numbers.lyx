\begin_inset Formula $\clubsuit$
\end_inset

 נשים לב לכך שמהגדרה,
 ההופכי של מספר מרוכב הוא בדיוק אותו מספר בחזקת 
\begin_inset Formula $-1$
\end_inset

 ולכן אין לנו בעיות בסימון (כמובן שזה היה המקור לסימון של הופכי).
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 ישנה בעייתיות מסוימת בהגדרת השורש ה-
\begin_inset Formula $n$
\end_inset

-י של מספר מורכב (
\begin_inset Formula $\sqrt[n]{z}$
\end_inset

) משום שיש יותר ממספר אחד המקיים את הדרישה 
\begin_inset Formula $x^{n}=z$
\end_inset

,
 ובניגוד לממשיים 
\begin_inset Formula $\MKcomplex$
\end_inset

 אינו שדה סדור ולכן איננו יכולים לדבר על השורש ה"חיובי".
\end_layout

\begin_layout Standard
\begin_inset space \space{}
\end_inset


\end_layout

\begin_layout Subsection
התחלה
\end_layout

\begin_layout Claim
יהי 
\begin_inset Formula $z:=r\cdot\MKcis\left(\theta\right)\in\MKcomplex$
\end_inset

,
 מתקיים:
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula $-z=r\cdot\MKcis\left(\theta\pm\pi\right)$
\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula $\overline{z}=r\cdot\MKcis\left(-\theta\right)$
\end_inset


\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula $z\neq0$
\end_inset

 אז 
\begin_inset Formula $z^{-1}=r^{-1}\cdot\MKcis\left(-\theta\right)$
\end_inset


\end_layout

\end_deeper
\begin_layout Proof
\begin_inset space \space{}
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
נשים לב לכך שמתקיים:
\begin_inset Formula 
\begin{align*}
\MKcis\left(\theta\right)+\MKcis\left(\theta\pm\pi\right) & ={\color{red}\cos\theta}+{\color{blue}i\cdot\sin\theta}+{\color{red}\cos\left(\theta\pm\pi\right)}+{\color{blue}i\cdot\sin\left(\theta\pm\pi\right)}\\
 & ={\color{red}\cos\theta}+{\color{blue}i\cdot\sin\theta}{\color{red}-\cos\theta}+{\color{blue}i\cdot\left(-\sin\theta\right)}=0
\end{align*}

\end_inset

ולכן גם:
\begin_inset Formula 
\[
r\cdot\MKcis\left(\theta\right)+r\cdot\MKcis\left(\theta\pm\pi\right)=r\cdot\left(\MKcis\left(\theta\right)+\MKcis\left(\theta\pm\pi\right)\right)=r\cdot0=0
\]

\end_inset

וממילא:
\begin_inset Formula 
\[
r\cdot\MKcis\left(\theta\pm\pi\right)=-r\cdot\MKcis\left(\theta\right)=-z
\]

\end_inset


\end_layout

\begin_layout Itemize
מהגדרה מתקיים:
\begin_inset Formula 
\[
\MKcis\left(-\theta\right)=\cos\left(-\theta\right)+i\cdot\sin\left(-\theta\right)=\cos\theta-i\cdot\sin\theta=\overline{\cos\theta+i\cdot\sin\theta}=\overline{\MKcis\left(\theta\right)}
\]

\end_inset

ולכן מהכפליות של פעולת ההצמדה נובע שגם:
\begin_inset Formula 
\[
r\cdot\MKcis\left(-\theta\right)=\overline{r}\cdot\MKcis\left(-\theta\right)=\overline{r}\cdot\overline{\MKcis\left(\theta\right)}=\overline{r\cdot\MKcis\left(\theta\right)}=\overline{z}
\]

\end_inset


\end_layout

\begin_layout Itemize
נניח ש-
\begin_inset Formula $z\neq0$
\end_inset

,
 ממסקנה 
\begin_inset CommandInset ref
LatexCommand ref
reference "corollary 1.4"
plural "false"
caps "false"
noprefix "false"

\end_inset

 ומהסעיף הקודם נובע שמתקיים:
\begin_inset Formula 
\[
z^{-1}=\frac{\overline{z}}{\left|z\right|^{2}}=\frac{r\cdot\MKcis\left(-\theta\right)}{r^{2}}=\frac{1}{r}\cdot\MKcis\left(-\theta\right)
\]

\end_inset


\end_layout

\end_deeper
\begin_layout Subsection
הקשר לכפל ולהעלאה בחזקה
\end_layout

\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "claim 2.2"

\end_inset

יהיו 
\begin_inset Formula $z:=r_{1}\cdot\MKcis\left(\theta_{1}\right)\in\MKcomplex$
\end_inset

 ו-
\begin_inset Formula $w:=r_{2}\cdot\MKcis\left(\theta_{2}\right)$
\end_inset

,
 מתקיים:
\begin_inset Formula 
\[
z\cdot w=\left(r_{1}\cdot r_{2}\right)\cdot\MKcis\left(\theta_{1}+\theta_{2}\right)
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 כלומר מה שכפל במספר מרוכב 
\begin_inset Formula $r\cdot\MKcis\left(\theta\right)$
\end_inset

 עושה הוא לסובב כל מספר מרוכב בזווית 
\begin_inset Formula $\theta$
\end_inset

 ולמתוח אותו פי 
\begin_inset Formula $r$
\end_inset

,
 זה לא אמור להפתיע אותנו משתי סיבות:
 בראש ובראשונה מפני שזו הייתה האינטואיציה שלנו לכפל כבר בהקדמה,
 ובנוסף מפני שראינו שכפל במספר מרוכב שקול לכפל במטריצת סיבוב ומתיחה.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 ההבנה שבהערה הקודמת גורמת לנו לחלק את המספרים המרוכבים לשלוש קבוצות:
\end_layout

