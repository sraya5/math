\begin_layout Claim
הצמדה היא פעולה כפלית וחיבורית,
 כלומר לכל 
\begin_inset Formula $z,w\in\MKcomplex$
\end_inset

 מתקיים 
\begin_inset Formula $\overline{z\cdot w}=\overline{z}\cdot\overline{w}$
\end_inset

 ו-
\begin_inset Formula $\overline{z+w}=\overline{z}+\overline{w}$
\end_inset

.
\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula $z:=a+bi\in\MKcomplex$
\end_inset

 ו-
\begin_inset Formula $w:=c+di$
\end_inset

.
\begin_inset Formula 
\begin{align*}
\Rightarrow\overline{z+w} & =\overline{\left(a+c\right)+\left(b+d\right)i}\\
 & =\left(a+c\right)-\left(b+d\right)i\\
 & =\left(a-bi\right)+\left(c-di\right)\\
 & =\overline{z}+\overline{w}\\
\Rightarrow\overline{z\cdot w} & =\overline{\left(ac-bd\right)+\left(ad+bc\right)i}\\
 & =\left(ac-{\color{red}bd}\right){\color{blue}-}\left(a{\color{blue}d}+{\color{blue}b}c\right)i\\
 & =\left(ac-{\color{red}\left(-b\right)\left(-d\right)}\right){\color{blue}+}\left(a\cdot{\color{blue}\left(-d\right)}+{\color{blue}\left(-b\right)}\cdot c\right)i\\
 & =\left(a-bi\right)\left(c-di\right)\\
 & =\overline{z}\cdot\overline{w}
\end{align*}

\end_inset


\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula $z\in\MKcomplex$
\end_inset

 מתקיים 
\begin_inset Formula $\left|z\right|^{2}=z\cdot\overline{z}$
\end_inset

.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula $z:=x+yi\in\MKcomplex$
\end_inset

 ,
 מהגדרה נובע ש-
\begin_inset Formula $\overline{z}=x-y\cdot i$
\end_inset

.
\begin_inset Formula 
\[
\Rightarrow z\cdot\overline{z}=\left(x+y\cdot i\right)\cdot\left(x-y\cdot i\right)=x^{2}-\left(yi\right)^{2}=x^{2}-y^{2}\cdot i^{2}=x^{2}-y^{2}\cdot\left(-1\right)=x^{2}+y^{2}=\left(\sqrt{x^{2}+y^{2}}\right)^{2}=\left|z\right|^{2}
\]

\end_inset


\end_layout

