\begin_inset Formula $0_{\MKcomplex}:=\begin{bmatrix}0\\
0
\end{bmatrix}$
\end_inset

,
 
\begin_inset Formula $1_{\MKcomplex}:=\begin{bmatrix}1\\
0
\end{bmatrix}$
\end_inset

 ו-
