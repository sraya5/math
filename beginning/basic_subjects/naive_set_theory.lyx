A_{1}\times A_{2}\times\ldots\times A_{n}:=\left\{ \left(a_{1},a_{2},\ldots,a_{n}\right)\mid\forall n\geq i\in\MKnatural:a_{i}\in A_{i}\right\} 
\]


\end_inset

\end_layout

