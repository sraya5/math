\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נשים לב לדמיון שבין חוקי דה-מורגן לשקילויות 
\begin_inset Formula
$\lnot\left(P\land Q\right)\Longleftrightarrow\lnot P\lor\lnot Q$
\end_inset
 (דומה לחוק הראשון) ו-
\begin_inset Formula
$\lnot\left(P\lor Q\right)\Longleftrightarrow\lnot P\land\lnot Q$
\end_inset
 (דומה לחוק השני), הדמיון הזה אינו מקרי: מה הקשר בין "
\begin_inset Formula
$\land$
\end_inset
" ל-"
\begin_inset Formula
$\cap$
\end_inset
", בין "
\begin_inset Formula
$\lor$
\end_inset
" ל-"
\begin_inset Formula
$\cup$
\end_inset
" ובין "
\begin_inset Formula
$^{c}$
\end_inset
" ל-"
\begin_inset Formula
$\lnot$
\end_inset
"? כמובן:
\begin_inset Formula
\begin{align*}
A\cap B & :=\left\{ x\mid x\in A\ \land\ x\in B\right\} \\
A\cup B & :=\left\{ x\mid x\in A\ \lor\ x\in B\right\} \\
A^{c} & :=\left\{ x\in U\mid\lnot\left(x\in A\right)\right\} 
\end{align*}


\end_inset
אני חושב שזוהי גם הסיבה לדמיון בין הסמלים המייצגים את הקשרים והפעולות.
\begin_inset Newline newline
\end_inset
ניתן למצוא אנלוגיה גם בין הגרירה להכלה וממילא גם בין השקילות של שני פסוקים (אם ורק אם - גרירה דו כיוונית) לשוויון בין שתי קבוצות (הכלה דו-כיוונית).
\end_layout

