\begin_deeper
\begin_layout Proof
יהי 
\begin_inset Formula
$0\neq a\in\MKfield_{p}$
\end_inset
 ונתבונן בקבוצה 
\begin_inset Formula
$\left\{ 1\cdot a,2\cdot a,\ldots,\left(p-1\right)\cdot a\right\} $
\end_inset
, אף אחד מן המספרים בקבוצה אינו מתחלק ב-
\begin_inset Formula
$p$
\end_inset
 ראשוני ובכל איבר אינו מחלק אף אחד משני המוכפלים, מכאן שאם הקבוצה הנ"ל בגודל 
\begin_inset Formula
$p-1$
\end_inset
 (כלומר אין בהצגתה חזרה על אותו איבר פעמיים) אז קיים 
\begin_inset Formula
$p>b\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$a\cdot b=1$
\end_inset
 ב-
\begin_inset Formula
$\MKfield_{p}$
\end_inset
.
\begin_inset Newline newline
\end_inset
נוכיח שזהו אכן המצב: יהיו 
\begin_inset Formula
$c,b\in\MKfield_{p}$
\end_inset
 כך ש-
\begin_inset Formula
$b\cdot a=c\cdot a$
\end_inset
, מכאן ש-
\begin_inset Formula
$\left(b-c\right)\cdot a=0$
\end_inset
 ב-
\begin_inset Formula
$\MKfield_{p}$
\end_inset
, כלומר המספר 
\begin_inset Formula
$\left(b-c\right)\cdot a$
\end_inset
 מתחלק ב-
\begin_inset Formula
$p$
\end_inset
 כשהוא ב-
\begin_inset Formula
$\MKinteger$
\end_inset
; אנחנו יודעים ש-
\begin_inset Formula
$p$
\end_inset
 אינו מחלק את 
\begin_inset Formula
$a$
\end_inset
 ולכן נובע מזה ש-
\begin_inset Formula
$p$
\end_inset
 מחלק את 
\begin_inset Formula
$b-c$
\end_inset
, כלומר השארית של חלוקת 
\begin_inset Formula
$b$
\end_inset
 ב-
\begin_inset Formula
$p$
\end_inset
 שווה לשארית של חלוקת 
\begin_inset Formula
$c$
\end_inset
 ב-
\begin_inset Formula
$p$
\end_inset
 ולכן ב-
\begin_inset Formula
$\MKfield_{p}$
\end_inset
 מתקיים 
\begin_inset Formula
$b=c$
\end_inset
, א"כ אין בקבוצה הנ"ל חזרות.
\end_layout

