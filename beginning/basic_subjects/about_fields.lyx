 & =\left[a{\color{blue}\cdot}a{\color{green}+}\left({\color{red}\pm}b\right){\color{blue}\cdot}a\right]{\color{purple}+}\left[\left({\color{red}\pm}b\right){\color{blue}\cdot}a{\color{green}+}b{\color{blue}\cdot}b\right]\\
 & =\left(\left[a{\color{blue}\cdot}a{\color{green}+}\left({\color{red}\pm}b\right){\color{blue}\cdot}a\right]{\color{purple}+}\left({\color{red}\pm}b\right){\color{blue}\cdot}a\right)+b{\color{blue}\cdot}b\\
 & =\left(a{\color{blue}\cdot}a{\color{purple}+}\left[\left({\color{red}\pm}b\right){\color{blue}\cdot}a{\color{green}+}\left({\color{red}\pm}b\right){\color{blue}\cdot}a\right]\right)+b{\color{blue}\cdot}b\\
 & =\left[a{\color{blue}\cdot}a{\color{violet}+}\left(\left[\left({\color{red}\pm}1\right){\color{blue}\cdot}b\right]{\color{green}\cdot}a{\color{purple}+}\left[\left({\color{red}\pm}1\right){\color{blue}\cdot}b\right]{\color{green}\cdot}a\right)\right]+b{\color{blue}\cdot}b\\
 & =\left[a{\color{blue}\cdot}a{\color{violet}+}\left(\left({\color{red}\pm}1\right){\color{blue}\cdot}\left[b{\color{red}\cdot}a\right]{\color{purple}+}\left({\color{red}\pm}1\right){\color{blue}\cdot}\left[b{\color{red}\cdot}a\right]\right)\right]+b{\color{blue}\cdot}b\\
 & =\left[a{\color{blue}\cdot}a{\color{purple}+}\left({\color{red}\pm}1{\color{red}\pm}1\right){\color{blue}\cdot}\left(b{\color{red}\cdot}a\right)\right]+b{\color{blue}\cdot}b\\
 & =\left[a{\color{blue}\cdot}a{\color{purple}\pm}\left(1{\color{red}+}1\right){\color{blue}\cdot}\left(b{\color{red}\cdot}a\right)\right]+b{\color{blue}\cdot}b\\
 & =\left[a{\color{blue}\cdot}a{\color{purple}\pm}\left(1{\color{red}+}1\right){\color{blue}\cdot}\left(a{\color{red}\cdot}b\right)\right]+b{\color{blue}\cdot}b\\
