\begin_layout Claim
\begin_inset Formula
$\MKcomplex$
\end_inset
 הוא שדה עם פעולות החיבור והכפל שהגדרנו.
\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula
${\color{red}a+bi},{\color{blue}c+di},{\color{green}e+fi}\in\MKcomplex$
\end_inset
, נוכיח שהכפל שהוגדר בקובץ ההגדרות מקיים את חוקי החילוף והקיבוץ, שלכל איבר יש איבר הופכי ושהוא מקיים את חוק הפילוג ביחס לחיבור, את הסיבות לכך ש-
\begin_inset Formula
$\MKcomplex$
\end_inset
 מקיים את שאר אקסיומות השדה כבר ראינו בקובץ ההגדרות.
\begin_inset Newline newline
\end_inset
לאורך כל ההוכחה נזכור שהחיבור והכפל של 
\begin_inset Formula
$a,b,c,d,e,f$
\end_inset
 הם חיבור וכפל ב-
\begin_inset Formula
$\MKreal$
\end_inset
 ולכן קומוטטיביים, אסוציאטיביים ודיסטריבוטיביים (הכפל דיסטריבוטיבי ביחס לחיבור).
\end_layout

\begin_deeper
\begin_layout Itemize
מהגדרה מתקיים:
\begin_inset Formula
\begin{align*}
{\color{red}\left(a+bi\right)}\cdot{\color{blue}\left(c+di\right)} & =\left({\color{red}a}{\color{blue}c}-{\color{red}b}{\color{blue}d}\right)+\left({\color{red}a}{\color{blue}d}+{\color{red}b}{\color{blue}c}\right)\cdot i\\
 & =\left({\color{blue}c}{\color{red}a}-{\color{blue}d}{\color{red}b}\right)+\left({\color{blue}d}{\color{red}a}+{\color{blue}c}{\color{red}b}\right)\cdot i={\color{blue}\left(c+di\right)}\cdot{\color{red}\left(a+bi\right)}
\end{align*}


\end_inset
ולכן הכפל מקיים את חוק החילוף.
\end_layout

\begin_layout Itemize
מהגדרה מתקיים:
\begin_inset Formula
\begin{align*}
\left({\color{red}\left(a+bi\right)}\cdot{\color{blue}\left(c+di\right)}\right)\cdot{\color{green}\left(e+fi\right)} & =\left(\left({\color{red}a}{\color{blue}c}-{\color{red}b}{\color{blue}d}\right)+\left({\color{red}a}{\color{blue}d}+{\color{red}b}{\color{blue}c}\right)\cdot i\right)\cdot{\color{green}\left(e+fi\right)}\\
 & =\left({\color{purple}\left(ac-bd\right)+\left(ad+bc\right)\cdot i}\right)\cdot{\color{green}\left(e+fi\right)}\\
 & =\left({\color{purple}\left(ac-bd\right)}\cdot{\color{green}e}-{\color{purple}\left(ad+bc\right)}\cdot{\color{green}f}\right)+\left({\color{purple}\left(ac-bd\right)}\cdot{\color{green}f}+{\color{purple}\left(ad+bc\right)}\cdot{\color{green}e}\right)\cdot i\\
 & =\left({\color{purple}ac}{\color{green}e}-{\color{purple}bd}{\color{green}e}-{\color{purple}ad}{\color{green}f}+{\color{purple}bc}{\color{green}f}\right)+\left({\color{purple}ac}{\color{green}f}-{\color{purple}bd}{\color{green}f}+{\color{purple}ad}{\color{green}e}+{\color{purple}bc}{\color{green}e}\right)\cdot i\\
 & =\left({\color{red}a}{\color{teal}ce}-{\color{red}b}{\color{teal}de}-{\color{red}a}{\color{teal}df}+{\color{red}b}{\color{teal}cf}\right)+\left({\color{red}a}{\color{teal}cf}-{\color{red}b}{\color{teal}df}+{\color{red}a}{\color{teal}de}+{\color{red}b}{\color{teal}ce}\right)\cdot i\\
 & =\left({\color{red}a}\cdot{\color{teal}\left(ce-df\right)}-{\color{red}b}\cdot{\color{teal}\left(cf+de\right)}\right)+\left({\color{red}a}\cdot{\color{teal}\left(cf+de\right)}+{\color{red}b}\cdot{\color{teal}\left(ce-df\right)}\right)\cdot i\\
 & ={\color{red}\left(a+bi\right)}\cdot\left({\color{teal}\left(ce-df\right)+\left(cf+de\right)\cdot i}\right)\\
 & ={\color{red}\left(a+bi\right)}\cdot\left(\left({\color{blue}c}{\color{green}e}-{\color{blue}d}{\color{green}f}\right)+\left({\color{blue}c}{\color{green}f}+{\color{blue}d}{\color{green}e}\right)\cdot i\right)\\
 & ={\color{red}\left(a+bi\right)}\cdot\left({\color{blue}\left(c+di\right)}\cdot{\color{green}\left(e+fi\right)}\right)
\end{align*}


\end_inset
ולכן הכפל מקיים את חוק הקיבוץ.
\end_layout

\begin_layout Itemize
מהגדרה מתקיים:
\begin_inset Formula
\begin{align*}
{\color{red}\left(a+bi\right)}\cdot\left({\color{blue}\left(c+di\right)}+{\color{green}\left(e+fi\right)}\right) & ={\color{red}\left(a+bi\right)}\cdot\left(\left({\color{blue}c}+{\color{green}e}\right)+\left({\color{blue}d}+{\color{green}f}\right)\cdot i\right)\\
 & ={\color{red}\left(a+bi\right)}\cdot\left({\color{teal}\left(c+e\right)+\left(d+f\right)\cdot i}\right)\\
 & =\left({\color{red}a}\cdot{\color{teal}\left(c+e\right)}-{\color{red}b}\cdot{\color{teal}\left(d+f\right)}\right)+\left({\color{red}a}\cdot{\color{teal}\left(d+f\right)}+{\color{red}b}\cdot{\color{teal}\left(c+e\right)}\right)\cdot i\\
 & ={\color{red}a}{\color{teal}c}+{\color{red}a}{\color{teal}e}-{\color{red}b}{\color{teal}d}-{\color{red}b}{\color{teal}f}+{\color{red}a}{\color{teal}d}\cdot i+{\color{red}a}{\color{teal}f}\cdot i+{\color{red}b}{\color{teal}c}\cdot i+{\color{red}b}{\color{teal}e}\cdot i\\
 & ={\color{purple}ac}+{\color{olive}ae}{\color{purple}-bd}{\color{olive}-bf}+{\color{purple}ad\cdot i}+{\color{olive}af\cdot i}+{\color{purple}bc\cdot i}+{\color{olive}be\cdot i}\\
 & ={\color{purple}\left(ac-bd\right)}+{\color{olive}\left(ae-bf\right)}+{\color{purple}\left(ad+bc\right)\cdot i}+{\color{olive}\left(af+be\right)\cdot i}\\
 & ={\color{purple}\left(\left(ac-bd\right)+\left(ad+bc\right)\cdot i\right)}+{\color{olive}\left(\left(ae-bf\right)+\left(af+be\right)\cdot i\right)}\\
 & =\left(\left({\color{red}a}{\color{blue}c}-{\color{red}b}{\color{blue}d}\right)+\left({\color{red}a}{\color{blue}d}+{\color{red}b}{\color{blue}c}\right)\cdot i\right)+\left(\left({\color{red}a}{\color{green}e}-{\color{red}b}{\color{green}f}\right)+\left({\color{red}a}{\color{green}f}+{\color{red}b}{\color{green}e}\right)\cdot i\right)\\
 & ={\color{red}\left(a+bi\right)}\cdot{\color{blue}\left(c+di\right)}+{\color{red}\left(a+bi\right)}\cdot{\color{green}\left(e+fi\right)}
\end{align*}


\end_inset
ולכן הכפל מקיים את חוק הפילוג ביחס לחיבור.
\end_layout

\begin_layout Itemize
נניח ש-
\begin_inset Formula
$a+bi\neq0$
\end_inset
, כלומר ש-
\begin_inset Formula
$\left(a,b\right)\neq\left(0,0\right)$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהגדרה מתקיים:
\begin_inset Formula
\begin{align*}
{\color{red}\left(a+bi\right)}\cdot\left(\frac{a}{a^{2}+b^{2}}+\frac{-b}{a^{2}+b^{2}}\cdot i\right) & =\left(a+bi\right)\cdot\left(\frac{a-bi}{a^{2}+b^{2}}\right)=\frac{\left(a+bi\right)\left(a-bi\right)}{a^{2}+b^{2}}=\frac{a\cdot a+bi\cdot a+a\cdot\left(-bi\right)+bi\cdot\left(-bi\right)}{a^{2}+b^{2}}\\
 & =\frac{a^{2}+ab\cdot i+a\cdot\left(-1\right)\cdot bi+bi\cdot\left(-1\right)\cdot bi}{a^{2}+b^{2}}=\frac{a^{2}+{\color{orange}ab\cdot i-ab\cdot i}-b^{2}\cdot i^{2}}{a^{2}+b^{2}}\\
 & =\frac{a^{2}-b^{2}\cdot\left(-1\right)}{a^{2}+b^{2}}=\frac{a^{2}+b^{2}}{a^{2}+b^{2}}=1_{\MKcomplex}
\end{align*}


\end_inset
ולכן לכל איבר שונה מ-
\begin_inset Formula
$0$
\end_inset
 יש הופכי.
\end_layout

\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 איך ידענו שדווקא המספר הנ"ל הוא ההופכי המבוקש? כאן בא לעזרתנו טריק הידוע בשם 
\bar under
כפל בצמוד
\bar default
, הרעיון הוא כדלהלן.
\begin_inset Newline newline
\end_inset
נחזור לרגע אל הממשיים ונניח שבאמצע הוכחה כלשהי הגענו לביטוי מהצורה (
\begin_inset Formula
$c>0$
\end_inset
):
\begin_inset Formula
\[
\frac{a}{b+\sqrt{c}}
\]


\end_inset
אנחנו אומרים לעצמנו "אוי ואבוי, שורש וחיבור לא עובדים טוב ביחד... איך נפשט את הביטוי הזה???
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
הסיבה השכיחה ביותר לכך שנרצה לפשט את הביטוי היא יצירת מכנה משותף עם ביטוי אחר.
\end_layout

\end_inset
 הלוואי שזה היה 
\begin_inset Formula
$b\cdot\sqrt{c}$
\end_inset
!"
\begin_inset Newline newline
\end_inset
כעת מגיע המורה או חבר שכבר מכיר את הטריק, נוטל מאיתנו את העיפרון וכותב:
\begin_inset Formula
\[
\frac{a}{b+\sqrt{c}}=\frac{a}{b+\sqrt{c}}\cdot\frac{b-\sqrt{c}}{b-\sqrt{c}}=\frac{a\cdot\left(b-\sqrt{c}\right)}{\left(b+\sqrt{c}\right)\left(b-\sqrt{c}\right)}=\frac{a\cdot\left(b-\sqrt{c}\right)}{b^{2}-c}
\]


\end_inset
גם כאן נתבקשנו למצוא את 
\begin_inset Formula
$\frac{1}{a+bi}$
\end_inset
, והבעיה היא דומה מאד - חיבור של מספר ממשי עם שורש של מספר שלילי הוא ביטוי שקשה לעבוד איתו ואנחנו עדיין לא יודעים לחלק במספר מרוכב.
\begin_inset Newline newline
\end_inset
למזלנו מתקיים 
\begin_inset Formula
$i^{2}=-1$
\end_inset
 ולכן אנחנו יכולים להפוך את המכנה לממשי:
\begin_inset Formula
\[
\frac{1}{a+bi}=\frac{1}{a+bi}\cdot\frac{a-bi}{a-bi}=\frac{a-bi}{a^{2}-b^{2}i^{2}}=\frac{a-bi}{a^{2}+b^{2}}
\]


\end_inset
ולחלק במספר ממשי אנחנו כבר יודעים...
\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Subsection
הצמוד המרוכב והערך המוחלט
\end_layout

\begin_layout Claim
הצמדה היא פעולה כפלית וחיבורית, כלומר לכל 
\begin_inset Formula
$z,w\in\MKcomplex$
\end_inset
 מתקיים 
\begin_inset Formula
$\overline{z\cdot w}=\overline{z}\cdot\overline{w}$
\end_inset
 ו-
\begin_inset Formula
$\overline{z+w}=\overline{z}+\overline{w}$
\end_inset
.
\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula
$z:=a+bi\in\MKcomplex$
\end_inset
 ו-
\begin_inset Formula
$w:=c+di$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\overline{z+w} & =\overline{\left(a+c\right)+\left(b+d\right)i}\\
 & =\left(a+c\right)-\left(b+d\right)i\\
 & =\left(a-bi\right)+\left(c-di\right)\\
 & =\overline{z}+\overline{w}\\
\Rightarrow\overline{z\cdot w} & =\overline{\left(ac-bd\right)+\left(ad+bc\right)i}\\
 & =\left(ac-{\color{red}bd}\right){\color{blue}-}\left(a{\color{blue}d}+{\color{blue}b}c\right)i\\
 & =\left(ac-{\color{red}\left(-b\right)\left(-d\right)}\right){\color{blue}+}\left(a\cdot{\color{blue}\left(-d\right)}+{\color{blue}\left(-b\right)}\cdot c\right)i\\
 & =\left(a-bi\right)\left(c-di\right)\\
 & =\overline{z}\cdot\overline{w}
\end{align*}


\end_inset

\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula
$z\in\MKcomplex$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|z\right|^{2}=z\cdot\overline{z}$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$z:=x+yi\in\MKcomplex$
\end_inset
 , מהגדרה נובע ש-
\begin_inset Formula
$\overline{z}=x-y\cdot i$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow z\cdot\overline{z}=\left(x+y\cdot i\right)\cdot\left(x-y\cdot i\right)=x^{2}-\left(yi\right)^{2}=x^{2}-y^{2}\cdot i^{2}=x^{2}-y^{2}\cdot\left(-1\right)=x^{2}+y^{2}=\left(\sqrt{x^{2}+y^{2}}\right)^{2}=\left|z\right|^{2}
\]


\end_inset

\end_layout

\begin_layout Corollary
\begin_inset CommandInset label
LatexCommand label
name "corollary 1.4"
\end_inset
לכל 
\begin_inset Formula
$0\neq z\in\MKcomplex$
\end_inset
 מתקיים:
\begin_inset Formula
\[
z^{-1}=\frac{\overline{z}}{\left|z\right|^{2}}
\]


\end_inset

\end_layout

\begin_layout Theorem
\series bold
הערך המוחלט הוא 
\begin_inset CommandInset href
