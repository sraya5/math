name "נורמה"
target https://he.wikipedia.org/wiki/%D7%A0%D7%95%D7%A8%D7%9E%D7%94_(%D7%90%D7%A0%D7%9C%D7%99%D7%96%D7%94)
literal false
\end_inset

\series default

\begin_inset Newline newline
\end_inset
לכל 
\begin_inset Formula
$z,w\in\MKcomplex$
\end_inset
 מתקיימים שלושת הפסוקים הבאים:
\end_layout

\begin_deeper
\begin_layout Enumerate
חיוביות בהחלט - 
\begin_inset Formula
$0\leq z$
\end_inset
 ובנוסף 
\begin_inset Formula
$\left|z\right|=0$
\end_inset
 אם"ם 
\begin_inset Formula
$z=0$
\end_inset
.
\end_layout

\begin_layout Enumerate
הומוגניות - 
\begin_inset Formula
$\left|z\cdot w\right|=\left|z\right|\cdot\left|w\right|$
\end_inset
.
\end_layout

\begin_layout Enumerate
אי-שוויון המשולש - 
\begin_inset Formula
$\left|z+w\right|\leq\left|z\right|+\left|w\right|$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Proof
\begin_inset space \space{}
\end_inset

\end_layout

\begin_deeper
\begin_layout Enumerate
את הסעיף הראשון ראינו כבר בקובץ ההגדרות מפני שהוא נובע ישירות מן ההגדרה.
\end_layout

\begin_layout Enumerate
לכל 
\begin_inset Formula
$z,w\in\MKcomplex$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|z\cdot w\right|^{2}=\left(z\cdot w\right)\cdot\left(\overline{z\cdot w}\right)=z\cdot w\cdot\bar{z}\cdot\bar{w}=z\cdot\bar{z}\cdot w\cdot\bar{w}=\left|z\right|^{2}\cdot\left|w\right|^{2}=\left(\left|z\right|\cdot\left|w\right|\right)^{2}
\]


\end_inset
וממילא:
\begin_inset Formula
\[
\left|z\cdot w\right|=\sqrt{\left|z\cdot w\right|^{2}}=\sqrt{\left(\left|z\right|\cdot\left|w\right|\right)^{2}}=\left|z\right|\cdot\left|w\right|
\]


\end_inset

\end_layout

\begin_layout Enumerate
לכל 
\begin_inset Formula
$z,w\in\MKcomplex$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\left|z+w\right|^{2} & =\left(z+w\right)\cdot\left(\overline{z+w}\right)=\left(z+w\right)\cdot\left(\bar{z}+\bar{w}\right)=z\cdot\bar{z}+z\cdot\bar{w}+\bar{z}\cdot w+w\cdot\bar{w}\\
 & =\left|z\right|^{2}+z\cdot\bar{w}+\overline{z\cdot\bar{w}}+\left|w\right|^{2}=\left|z\right|^{2}+2\cdot\MKre\left(z\cdot\bar{w}\right)+\left|w\right|^{2}\\
 & \leq\left|z\right|^{2}+2\cdot\left|z\cdot\bar{w}\right|+\left|w\right|^{2}=\left|z\right|^{2}+2\cdot\left|z\right|\cdot\left|\bar{w}\right|+\left|w\right|^{2}\\
 & =\left|z\right|^{2}+2\cdot\left|z\right|\cdot\left|w\right|+\left|w\right|^{2}=\left(\left|z\right|+\left|w\right|\right)^{2}
\end{align*}


\end_inset

\end_layout

\end_deeper

\begin_layout Standard
\begin_inset space \space{}
\end_inset

\end_layout

\begin_layout Section
ההצגה הקוטבית
\end_layout

\begin_layout Subsection
הגדרות
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 עד כה הצגנו את המספרים המרוכבים (שהם נקודות במישור המרוכב) בהצגה הקרטזית שלהם, אך בקובץ
\begin_inset Newline newline
\end_inset
"על קואורדינטות ומערכות צירים" 
\series bold
\color red
(עוד לא נכתב)
\color inherit

\series default
 ראינו שניתן לאפיין נקודות במישור גם ע"י ההצגה הקוטבית שלהן, כלומר ע"י מרחקן מראשית הצירים והזווית שהן יוצרות עם החלק החיובי של ציר ה-
\begin_inset Formula
$x$
\end_inset
, א"כ ניתן לדבר גם על ההצגה הקוטבית של המספרים המרוכבים ומכיוון שהגדרנו את הערך המוחלט כך שיהיה זהה למושג האוקלידי של מרחק נוכל לבטא את הרדיוס בהצגה הקוטבית כערך המוחלט של מהספר המרוכב.
\end_layout

\begin_layout Definition
יהי 
\begin_inset Formula
$0\neq z:=x+yi\in\MKcomplex$
\end_inset
, 
\bar under
הצגה קוטבית
\bar default
 (נקראת גם 
\bar under
הצגה פולרית
\bar default
) של 
\begin_inset Formula
$z$
\end_inset
 היא ביטוי מהצורה 
\begin_inset Formula
$z=r\cdot\left(\cos\theta+i\cdot\sin\theta\right)$
\end_inset
 כאשר 
\begin_inset Formula
$r:=\left|z\right|=\sqrt{x^{2}+y^{2}}$
\end_inset
 ואילו 
\begin_inset Formula
$\theta$
\end_inset
 מוגדרת ע"י:
\begin_inset Formula
\[
\theta:=\begin{cases}
\arctan\left(\frac{y}{x}\right)+2\pi k & x>0\\
\arctan\left(\frac{y}{x}\right)\pm\pi+2\pi k & x<0\\
\frac{3\pi}{2}+2\pi k & x=0,\ y>0\\
\frac{\pi}{2}+2\pi k & x=0,\ y<0
\end{cases}
\]


\end_inset
עבור 
\begin_inset Formula
$k\in\MKinteger$
\end_inset
 כלשהו.
\begin_inset Newline newline
\end_inset
ההצגה הקוטבית של 
\begin_inset Formula
$0$
\end_inset
 בשדה המרוכבים היא 
\begin_inset Formula
$0\cdot\left(\cos\theta+i\cdot\sin\theta\right)$
\end_inset
 עבור 
\begin_inset Formula
$\theta\in\MKreal$
\end_inset
 כלשהי.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מהגדרה 
\begin_inset Formula
$r\geq0$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כזכור אין שום בעיה בכך שיש יותר מהצגה קוטבית אחת למספר נתון משום ש-
\begin_inset Formula
$\cos$
\end_inset
 ו-
\begin_inset Formula
$\sin$
\end_inset
 הן פונקציות מחזוריות שאורך המחזור שלהן הוא 
\begin_inset Formula
$2\pi$
\end_inset
 והן מוגדרות על כל הישר הממשי, וגם אם אותו מספר הוא 
\begin_inset Formula
$0$
\end_inset
 אין כאן בעיה משום ש-
\begin_inset Formula
$0\cdot\left(\cos\theta_{1}+i\cdot\sin\theta_{1}\right)=0=0\cdot\left(\cos\theta_{2}+i\cdot\sin\theta_{2}\right)$
\end_inset
 לכל 
\begin_inset Formula
$\theta_{1},\theta_{2}\in\MKreal$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כעת ניתן לראות בבירור שהמטריצה המתאימה לכפל במספר מרוכב היא מטריצת מתיחה וסיבוב שכן המטריצה המתאימה ל-
\begin_inset Formula
$r\cdot\left(\cos\theta+i\cdot\sin\theta\right)$
\end_inset
 היא:
\begin_inset Formula
\[
r\cdot\left[\begin{array}{cc}
\cos\theta & -\sin\theta\\
\sin\theta & \cos\theta
\end{array}\right]=\left[\begin{array}{cc}
r\cdot\cos\theta & -r\cdot\sin\theta\\
r\cdot\sin\theta & r\cdot\cos\theta
\end{array}\right]
\]


\end_inset

\end_layout

\begin_layout Description
סימון: תהא 
\begin_inset Formula
$\theta\in\MKreal$
\end_inset
, נסמן 
\begin_inset Formula
$\MKcis\left(\theta\right):=\cos\theta+i\cdot\sin\theta$
\end_inset
; א"כ ההצגה הקוטבית של מספר מרוכב ניתנת לכתיבה בקצרה ע"י 
\begin_inset Formula
$r\cdot\MKcis\left(\theta\right)$
\end_inset
 כאשר 
\begin_inset Formula
$r$
\end_inset
 הוא הערך המוחלט שלו ו-
\begin_inset Formula
$\theta$
\end_inset
 מוגדרת כפי שהוגדרה לעיל.
\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Definition
\series bold
חזקה במעריך טבעי
\series default

\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$z\in\MKcomplex$
\end_inset
, נגדיר 
\begin_inset Formula
$z^{1}:=z$
\end_inset
 ולכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
 נגדיר 
\begin_inset Formula
$z^{n+1}:=z^{n}\cdot z$
\end_inset
.
\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

\end_layout

\begin_layout Definition
\series bold
חזקה במעריך שלם
\series default

\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$0\neq z\in\MKcomplex$
\end_inset
, לכל 
\begin_inset Formula
$m\in\MKinteger$
\end_inset
 נגדיר:
\begin_inset Formula
\[
z^{m}:=\begin{cases}
z^{m} & m>0\\
1 & m=0\\
\frac{1}{z^{-m}} & m<0
\end{cases}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נשים לב לכך שמהגדרה, ההופכי של מספר מרוכב הוא בדיוק אותו מספר בחזקת 
\begin_inset Formula
$-1$
\end_inset
 ולכן אין לנו בעיות בסימון (כמובן שזה היה המקור לסימון של הופכי).
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ישנה בעייתיות מסוימת בהגדרת השורש ה-
\begin_inset Formula
$n$
\end_inset
-י של מספר מורכב (
\begin_inset Formula
$\sqrt[n]{z}$
\end_inset
) משום שיש יותר ממספר אחד המקיים את הדרישה 
\begin_inset Formula
$x^{n}=z$
\end_inset
, ובניגוד לממשיים 
\begin_inset Formula
$\MKcomplex$
\end_inset
 אינו שדה סדור ולכן איננו יכולים לדבר על השורש ה"חיובי".
\end_layout

\begin_layout Standard
\begin_inset space \space{}
\end_inset

\end_layout

\begin_layout Subsection
התחלה
\end_layout

\begin_layout Claim
יהי 
\begin_inset Formula
$z:=r\cdot\MKcis\left(\theta\right)\in\MKcomplex$
\end_inset
, מתקיים:
\end_layout

\begin_deeper
\begin_layout Itemize
\begin_inset Formula
$-z=r\cdot\MKcis\left(\theta\pm\pi\right)$
\end_inset

\end_layout

\begin_layout Itemize
\begin_inset Formula
$\overline{z}=r\cdot\MKcis\left(-\theta\right)$
\end_inset

\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula
$z\neq0$
\end_inset
 אז 
\begin_inset Formula
$z^{-1}=r^{-1}\cdot\MKcis\left(-\theta\right)$
\end_inset

\end_layout

\end_deeper

\begin_layout Proof
\begin_inset space \space{}
\end_inset

\end_layout

\begin_deeper
\begin_layout Itemize
נשים לב לכך שמתקיים:
\begin_inset Formula
\begin{align*}
\MKcis\left(\theta\right)+\MKcis\left(\theta\pm\pi\right) & ={\color{red}\cos\theta}+{\color{blue}i\cdot\sin\theta}+{\color{red}\cos\left(\theta\pm\pi\right)}+{\color{blue}i\cdot\sin\left(\theta\pm\pi\right)}\\
 & ={\color{red}\cos\theta}+{\color{blue}i\cdot\sin\theta}{\color{red}-\cos\theta}+{\color{blue}i\cdot\left(-\sin\theta\right)}=0
\end{align*}


\end_inset
ולכן גם:
\begin_inset Formula
\[
r\cdot\MKcis\left(\theta\right)+r\cdot\MKcis\left(\theta\pm\pi\right)=r\cdot\left(\MKcis\left(\theta\right)+\MKcis\left(\theta\pm\pi\right)\right)=r\cdot0=0
\]


\end_inset
וממילא:
\begin_inset Formula
\[
r\cdot\MKcis\left(\theta\pm\pi\right)=-r\cdot\MKcis\left(\theta\right)=-z
\]


\end_inset

\end_layout

\begin_layout Itemize
מהגדרה מתקיים:
\begin_inset Formula
\[
\MKcis\left(-\theta\right)=\cos\left(-\theta\right)+i\cdot\sin\left(-\theta\right)=\cos\theta-i\cdot\sin\theta=\overline{\cos\theta+i\cdot\sin\theta}=\overline{\MKcis\left(\theta\right)}
\]


\end_inset
ולכן מהכפליות של פעולת ההצמדה נובע שגם:
\begin_inset Formula
\[
r\cdot\MKcis\left(-\theta\right)=\overline{r}\cdot\MKcis\left(-\theta\right)=\overline{r}\cdot\overline{\MKcis\left(\theta\right)}=\overline{r\cdot\MKcis\left(\theta\right)}=\overline{z}
\]


\end_inset

\end_layout

\begin_layout Itemize
נניח ש-
\begin_inset Formula
$z\neq0$
\end_inset
, ממסקנה 
\begin_inset CommandInset ref
LatexCommand ref
reference "corollary 1.4"
plural false
caps false
noprefix false
\end_inset
 ומהסעיף הקודם נובע שמתקיים:
\begin_inset Formula
\[
z^{-1}=\frac{\overline{z}}{\left|z\right|^{2}}=\frac{r\cdot\MKcis\left(-\theta\right)}{r^{2}}=\frac{1}{r}\cdot\MKcis\left(-\theta\right)
\]


\end_inset

\end_layout

\end_deeper

\begin_layout Subsection
הקשר לכפל ולהעלאה בחזקה
\end_layout

\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "claim 2.2"
\end_inset
יהיו 
\begin_inset Formula
$z:=r_{1}\cdot\MKcis\left(\theta_{1}\right)\in\MKcomplex$
\end_inset
 ו-
\begin_inset Formula
$w:=r_{2}\cdot\MKcis\left(\theta_{2}\right)$
\end_inset
, מתקיים:
\begin_inset Formula
\[
z\cdot w=\left(r_{1}\cdot r_{2}\right)\cdot\MKcis\left(\theta_{1}+\theta_{2}\right)
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר מה שכפל במספר מרוכב 
\begin_inset Formula
$r\cdot\MKcis\left(\theta\right)$
\end_inset
 עושה הוא לסובב כל מספר מרוכב בזווית 
\begin_inset Formula
$\theta$
\end_inset
 ולמתוח אותו פי 
\begin_inset Formula
$r$
\end_inset
, זה לא אמור להפתיע אותנו משתי סיבות: בראש ובראשונה מפני שזו הייתה האינטואיציה שלנו לכפל כבר בהקדמה, ובנוסף מפני שראינו שכפל במספר מרוכב שקול לכפל במטריצת סיבוב ומתיחה.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ההבנה שבהערה הקודמת גורמת לנו לחלק את המספרים המרוכבים לשלוש קבוצות:
\end_layout

\begin_deeper
\begin_layout Enumerate
מספרים שהרדיוס שלהם 
\series bold
גדול
\series default
 ממש מ-
\begin_inset Formula
$1$
\end_inset
 - בנוסף לסיבוב הם 
\series bold
מותחים
\series default
 את הרדיוס של המספר המורכב, כלומר 
\series bold
מגדילים
\series default
 אותו ע"י כפל באותו הרדיוס.
\begin_inset Newline newline
\end_inset
המספרים שבקבוצה זו הם אלו שמחוץ למעגל היחידה במישור המרוכב (לא כולל).
\end_layout

\begin_layout Enumerate
מספרים שהרדיוס שלהם 
\series bold
קטן
\series default
 ממש מ-
\begin_inset Formula
$1$
\end_inset
 - בנוסף לסיבוב הם 
\series bold
מכווצים
\series default
 את הרדיוס של המספר המורכב, כלומר 
\series bold
מקטינים
\series default
 אותו ע"י כפל באותו הרדיוס.
\begin_inset Newline newline
\end_inset
המספרים שבקבוצה זו הם אלו שבתוך מעגל היחידה במישור המרוכב (לא כולל).
\end_layout

\begin_layout Enumerate
מספרים שהרדיוס שלהם 
\series bold
שווה
\series default
 ל-
\begin_inset Formula
$1$
\end_inset
 - מבצעים סיבוב בלבד, ללא מתיחה/כיווץ של המספר המרוכב.
\begin_inset Newline newline
\end_inset
המספרים שבקבוצה זו הם אלו המהווים את מעגל היחידה במישור המרוכב.
\end_layout

\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 החלוקה שבהערה הקודמת נותנת לנו עוד קבוצה מיוחדת ב-
\begin_inset Formula
$\MKcomplex$
\end_inset
 מלבד הממשיים והמדומים - הקבוצה החדשה היא מעגל היחידה המרוכב, וכך מבחינה גאומטרית הקבוצות המיוחדות במישור הן הצירים ומעגל היחידה.
\end_layout

\begin_layout Proof
מהגדרת הכפל של מספרים מרוכבים ומהזהויות הטריגונומטריות של קוסינוס וסינוס של סכום זוויות
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
לכל 
\begin_inset Formula
$\alpha,\beta\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\sin\left(\alpha\pm\beta\right) & =\sin\alpha\cdot\cos\beta\pm\cos\alpha\cdot\sin\beta\\
\cos\left(\alpha\pm\beta\right) & =\cos\alpha\cdot\cos\beta\mp\sin\alpha\cdot\sin\beta
\end{align*}


\end_inset

\end_layout

\end_inset
 נובע כי:
\begin_inset Formula
\begin{align*}
\MKcis\left(\theta_{1}\right)\cdot\MKcis\left(\theta_{2}\right) & =\left(\cos\theta_{1}+i\cdot\sin\theta_{1}\right)\cdot\left(\cos\theta_{2}+i\cdot\sin\theta_{2}\right)\\
 & =\left(\cos\theta_{1}\cdot\cos\theta_{2}-\sin\theta_{1}\cdot\sin\theta_{2}\right)+i\cdot\left(\cos\theta_{1}\cdot\sin\theta_{2}+\sin\theta_{1}\cdot\cos\theta_{2}\right)\\
 & =\cos\left(\theta_{1}+\theta_{2}\right)+i\cdot\sin\left(\theta_{1}+\theta_{2}\right)=\MKcis\left(\theta_{1}+\theta_{2}\right)
\end{align*}


\end_inset
וממילא:
\begin_inset Formula
\[
z\cdot w=\left(r_{1}\cdot\MKcis\left(\theta_{1}\right)\right)\cdot\left(r_{2}\cdot\MKcis\left(\theta_{2}\right)\right)=\left(r_{1}\cdot r_{2}\right)\cdot\left(\MKcis\left(\theta_{1}\right)\cdot\MKcis\left(\theta_{2}\right)\right)=\left(r_{1}\cdot r_{2}\right)\cdot\MKcis\left(\theta_{1}+\theta_{2}\right)
\]


\end_inset

\end_layout

\begin_layout Corollary
יהיו 
\begin_inset Formula
$z:=r_{1}\cdot\MKcis\left(\theta_{1}\right)\in\MKcomplex$
\end_inset
 ו-
\begin_inset Formula
$0\neq w:=r_{2}\cdot\MKcis\left(\theta_{2}\right)$
\end_inset
, מתקיים:
\begin_inset Formula
\[
\frac{z}{w}=\frac{r_{1}}{r_{2}}\cdot\MKcis\left(\theta_{1}-\theta_{2}\right)
\]


\end_inset

\end_layout

\begin_layout Standard
\begin_inset Separator plain
\end_inset

\end_layout

\begin_layout Corollary
\series bold
משפט דה-מואבר
\series default

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
ערך בוויקיפדיה: 
\begin_inset CommandInset href
LatexCommand href
name "אברהם דה-מואבר"
target https://he.wikipedia.org/wiki/%D7%90%D7%91%D7%A8%D7%94%D7%9D_%D7%93%D7%94_%D7%9E%D7%95%D7%90%D7%91%D7%A8
literal false
\end_inset

\end_layout

\end_inset

\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$0\neq z:=r\cdot\MKcis\left(\theta\right)\in\MKcomplex$
\end_inset
, מתקיים (לכל 
\begin_inset Formula
$n\in\MKinteger$
\end_inset
):
\begin_inset Formula
\[
z^{n}=r^{n}\cdot\MKcis\left(n\cdot\theta\right)
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כמובן שהנוסחה תקפה גם עבור 
\begin_inset Formula
$0$
\end_inset
 בחזקה טבעית.
\end_layout

\begin_layout Corollary
\series bold
הוצאת שורש מרוכב באמצעות הצגה קוטבית
\series default

\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$z:=r\cdot\MKcis\left(\theta\right)\in\MKcomplex$
\end_inset
 מתקיים (לכל 
\begin_inset Formula
$n\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\left\{ x\in\MKcomplex\mid x^{n}=z\right\} =\left\{ \begin{array}{c|c}
\begin{alignedat}{1}\sqrt[n]{r}\cdot\MKcis\left(\frac{\theta+2\pi k}{n}\right)\end{alignedat}
 & k\in\MKinteger\end{array}\right\} 
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר קיימים בדיוק 
\begin_inset Formula
$n$
\end_inset
 מספרים מרוכבים המהווים שורש 
\begin_inset Formula
$n$
\end_inset
-י של מספר מרוכב נתון שאינו 
\begin_inset Formula
$0$
\end_inset
, והם נתונים ע"י הנוסחה:
\begin_inset Formula
\[
z_{k}=\sqrt[n]{r}\cdot\MKcis\left(\frac{\theta+2\pi k}{n}\right)
\]


\end_inset
עבור 
\begin_inset Formula
$n>k\in\MKnatural_{0}$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מבחינה גאומטרית השורשים מהווים את קודקודיו של מצולע משוכלל בעל 
\begin_inset Formula
$n$
\end_inset
