\sigma^{i}\cdot\sigma^{j}\tau\cdot\left(\sigma^{i}\right)^{-1} & =\sigma^{j+2i}\tau\\
\left(\sigma^{i}\tau\right)\cdot\sigma^{j}\tau\cdot\left(\sigma^{i}\tau\right)^{-1} & =\sigma^{-j+2i}\tau
