\begin_layout Description
סימון:
 לכל 
\begin_inset Formula $m\in\MKinteger$
\end_inset

 נסמן 
\begin_inset Formula $m\MKinteger:=m\cdot\MKinteger:=\left\{ mk\in\MKinteger:k\in\MKinteger\right\} $
\end_inset

.
\end_layout

\begin_layout Claim
לכל 
\begin_inset Formula $m\in\MKinteger$
\end_inset

 מתקיים 
\begin_inset Formula $\left\langle m\right\rangle =m\cdot\MKinteger$
\end_inset

.
\end_layout

\begin_layout Theorem
לכל תת-חבורה 
\begin_inset Formula $H\leqslant\MKinteger$
\end_inset

 קיים 
\begin_inset Formula $d\in\MKinteger$
\end_inset

 יחיד כך ש-
\begin_inset Formula $H=\left\langle d\right\rangle $
\end_inset

,
 ואותו 
\begin_inset Formula $d$
\end_inset

 הוא:
\begin_inset Formula 
\[
d:=\min\left\{ m\in\MKnatural_{0}\mid m\in H\right\} 
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 כלומר אין ל-
\begin_inset Formula $\MKinteger$
\end_inset

 תתי-חבורות שאינן מהצורה 
\begin_inset Formula $m\MKinteger$
\end_inset

.
\end_layout

\begin_layout Theorem
יהיו 
\begin_inset Formula $a_{1},a_{2},\ldots,a_{n}\in\MKinteger$
\end_inset

 כך שלפחות אחד מהם שונה מ-
\begin_inset Formula $0$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left\langle a_{1},a_{2},\ldots,a_{n}\right\rangle =\left\langle \gcd\left(a_{1},a_{2},\ldots,a_{n}\right)\right\rangle 
\]

\end_inset


\end_layout

