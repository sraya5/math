לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 מתקיים 
\begin_inset Formula $\left\Vert v+w\right\Vert \leq\left\Vert v\right\Vert +\left\Vert w\right\Vert $
\end_inset

,
 ומתקיים שוויון אם"ם קיים 
\begin_inset Formula $0\leq c\in\MKreal$
\end_inset

 כך ש-
\begin_inset Formula $v=c\cdot w$
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Branch proofs
inverted 0
status collapsed

\begin_layout Proof
יהיו 
\begin_inset Formula $v,w\in V$
\end_inset

,
 מתקיים:
\begin_inset Formula 
\begin{align*}
\left\Vert v+w\right\Vert ^{2} & =\left\langle v+w\mid v+w\right\rangle =\left\langle v\mid v\right\rangle +\left\langle v\mid w\right\rangle +\left\langle w\mid v\right\rangle +\left\langle w\mid w\right\rangle \\
 & =\left\langle v\mid v\right\rangle +\left\langle v\mid w\right\rangle +\overline{\left\langle v\mid w\right\rangle }+\left\langle w\mid w\right\rangle \\
 & =\left\Vert v\right\Vert ^{2}+2\cdot{\color{red}\text{Re}\left\langle v\mid w\right\rangle }+\left\Vert w\right\Vert ^{2}\\
 & {\color{red}\leq}\left\Vert v\right\Vert ^{2}+2\cdot{\color{red}\left|\left\langle v\mid w\right\rangle \right|}+\left\Vert w\right\Vert ^{2}\\
 & {\color{red}\leq}\left\Vert v\right\Vert ^{2}+2\cdot{\color{red}\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert }+\left\Vert w\right\Vert ^{2}\\
 & =\left(\left\Vert v\right\Vert +\left\Vert w\right\Vert \right)^{2}
\end{align*}

\end_inset


\begin_inset Formula 
\[
\Rightarrow\left\Vert v+w\right\Vert \leq\left\Vert v\right\Vert +\left\Vert w\right\Vert 
\]

\end_inset

נשים לב שמתקיים שוויון אם"ם 
\begin_inset Formula $\text{Re}\left\langle v\mid w\right\rangle =\left|\left\langle v\mid w\right\rangle \right|=\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert $
\end_inset

;
 השוויון הימני מתקיים אם"ם 
\begin_inset Formula $v$
\end_inset

 ו-
\begin_inset Formula $w$
\end_inset

 תלויים ליניארית (א"ש קושי-שוורץ),
 והשמאלי מתקיים אם"ם 
\begin_inset Formula $0\leq\text{Re}\left\langle v\mid w\right\rangle $
\end_inset

 וגם 
\begin_inset Formula $v$
\end_inset

 ו-
\begin_inset Formula $w$
\end_inset

 תלויים ליניארית (שאז 
\begin_inset Formula $\left\langle v\mid w\right\rangle \in\MKreal$
\end_inset

 ולכן 
\begin_inset Formula $\text{Re}\left\langle v\mid w\right\rangle =\left\langle v\mid w\right\rangle $
\end_inset

),
 וזה קורה אם"ם קיים 
\begin_inset Formula $0\leq c\in\MKreal$
\end_inset

