\begin_inset Formula $\left(u_{k+1},u_{k+2},\ldots,u_{n}\right)$
\end_inset

 בסיס אורתוגונלי של 
\begin_inset Formula $W^{\perp}$
\end_inset

,
 אם כן 
\begin_inset Formula $\left(w_{1},w_{2},\ldots,w_{k};u_{k+1},u_{2},\ldots,u_{n}\right)$
\end_inset

 הוא בסיס אורתוגונלי של 
\begin_inset Formula $V$
\end_inset

 ולכן מתקיים:
\begin_inset Formula 
\begin{align*}
p_{W}\left(v\right) & =p_{W}\left(\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot w_{i}+\sum_{j=k+1}^{n}\frac{\left\langle u_{j}\mid v\right\rangle }{\left\langle u_{j}\mid u_{j}\right\rangle }\cdot u_{j}\right)\\
 & =\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot p_{W}\left(w_{i}\right)+\sum_{j=k+1}^{n}\frac{\left\langle u_{j}\mid v\right\rangle }{\left\langle u_{j}\mid u_{j}\right\rangle }\cdot p_{W}\left(u_{j}\right)\\
 & =\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot w_{i}+\sum_{j=k+1}^{n}\frac{\left\langle u_{j}\mid v\right\rangle }{\left\langle u_{j}\mid u_{j}\right\rangle }\cdot0_{V}\\
 & =\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot w_{i}=\sum_{i=1}^{k}p_{w_{i}}\left(v\right)
\end{align*}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Theorem
יהי 
\begin_inset Formula $W\subseteq V$
\end_inset

 תמ"ו,
 לכל 
\begin_inset Formula $v\in V$
\end_inset

 מתקיים 
\begin_inset Formula $d\left(v,W\right)=\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

.
\end_layout

\begin_layout Standard
\begin_inset Branch proofs
inverted 0
status collapsed

\begin_layout Proof
יהי 
\begin_inset Formula $v\in V$
\end_inset

,
 לכל 
\begin_inset Formula $w\in W$
\end_inset

 מתקיים 
\begin_inset Formula $p_{W^{\perp}}\left(v\right)\perp\left(p_{W}\left(v\right)-w\right)$
\end_inset

 ולכן ע"פ 
\begin_inset CommandInset ref
LatexCommand nameref
reference "Pythagorean_theorem"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 מתקיים גם:
\begin_inset Formula 
\begin{align*}
\left\Vert v-w\right\Vert ^{2} & =\left\Vert p_{W^{\perp}}\left(v\right)+p_{W}\left(v\right)-w\right\Vert ^{2}\\
 & =\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert ^{2}+\left\Vert p_{W}\left(v\right)-w\right\Vert \geq\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert ^{2}
\end{align*}

\end_inset

כלומר לכל 
\begin_inset Formula $w\in W$
\end_inset

 מתקיים 
\begin_inset Formula $d\left(v,w\right)=\left\Vert v-w\right\Vert \geq\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

,
 ולכן 
\begin_inset Formula $d\left(v,W\right)=\inf\left\{ d\left(v,w\right)\mid w\in W\right\} \geq\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

.
 מצד שני 
\begin_inset Formula $d\left(v,p_{W}\left(v\right)\right)=\left\Vert v-p_{W}\left(v\right)\right\Vert =\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

,
 ומכאן ש-
\begin_inset Formula $d\left(v,W\right)=\inf\left\{ d\left(v,w\right)\mid w\in W\right\} =\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

 (שהרי 
\begin_inset Formula $p_{W}\left(v\right)\in W$
\end_inset

).
\end_layout

\end_inset


\end_layout

