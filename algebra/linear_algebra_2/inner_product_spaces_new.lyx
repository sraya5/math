\begin_inset Formula $T$
\end_inset

 ל-
\begin_inset Formula $\MKim T^{*}$
\end_inset

 (
\begin_inset Formula $T\mid_{\MKim T^{*}}:\MKim T^{*}\rightarrow\MKim T$
\end_inset

) הוא העתקה חח"ע ועל.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 למעשה רק הצמצום הזה מעניין אותנו משום ש-
\begin_inset Formula $\left(\MKim T^{*}\right)^{\perp}=\ker T$
\end_inset

.
\end_layout

\begin_layout Corollary

\series bold
נוסחה מפורשת להעתקה הצמודה
\series default

\begin_inset Newline newline
\end_inset

יהי 
\begin_inset Formula $\left(u_{1},u_{2},\ldots,u_{n}\right)$
\end_inset

 בסיס אורתונורמלי של 
\begin_inset Formula $V$
\end_inset

,
 לכל 
\begin_inset Formula $w\in W$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
T^{*}\left(w\right)=\sum_{i=1}^{n}\left\langle T\left(u_{i}\right)\mid w\right\rangle _{W}\cdot u_{i}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Branch proofs
inverted 0
status collapsed

\begin_layout Proof
יהי 
\begin_inset Formula $w\in W$
\end_inset

,
 ממשפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem_1.33"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 נובע שמתקיים:
\begin_inset Formula 
\[
T^{*}\left(w\right)=\sum_{i=1}^{n}\left\langle u_{i}\mid T^{*}\left(w\right)\right\rangle _{V}\cdot u_{i}
\]

\end_inset

ולכן ע"פ טענה 
\begin_inset CommandInset ref
LatexCommand ref
reference "claim 2.15"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 מתקיים:
\begin_inset Formula 
\[
T^{*}\left(w\right)=\sum_{i=1}^{n}\left\langle T\left(u_{i}\right)\mid w\right\rangle _{W}\cdot u_{i}
\]

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Corollary
\begin_inset CommandInset label
LatexCommand label
name "corollary 2.19"

\end_inset

נניח ש-
\begin_inset Formula $V$
\end_inset

 ו-
\begin_inset Formula $W$
\end_inset

 נ"ס ויהיו 
\begin_inset Formula $\MKclb$
\end_inset

 ו-
\begin_inset Formula $\MKclc$
\end_inset

 בסיסים אורתונורמליים של 
\begin_inset Formula $V$
\end_inset

 ו-
\begin_inset Formula $U$
\end_inset

 בהתאמה,
 מתקיים:
\begin_inset Formula 
\[
\left[T^{*}\right]_{\MKclb}^{\MKclc}=\left(\left[T\right]_{\MKclc}^{\MKclb}\right)^{*}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Branch proofs
inverted 0
status collapsed

\begin_layout Proof
נגדיר 
\begin_inset Formula $\left(v_{1},v_{2},\ldots,v_{n}\right):=\MKclb$
\end_inset

 ו-
\begin_inset Formula $\left(w_{1},w_{2},\ldots,w_{m}\right):=\MKclc$
\end_inset

.
\begin_inset Newline newline
\end_inset

ממשפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem_1.33"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 ומהגדרת המטריצה המייצגת נובע שהשורה ה-
\begin_inset Formula $i$
\end_inset

 ב-
\begin_inset Formula $\left(\left[T\right]_{\MKclc}^{\MKclb}\right)^{*}$
\end_inset

 היא (לכל 
\begin_inset Formula $n\geq i\in\MKnatural$
\end_inset

 ):
\begin_inset Formula 
\begin{align*}
\left(\left[T\left(v_{i}\right)\right]_{\MKclc}\right)^{*} & =\left(\begin{bmatrix}\left\langle w_{1}\mid T\left(v_{i}\right)\right\rangle _{W}\\
\left\langle w_{2}\mid T\left(v_{i}\right)\right\rangle _{W}\\
\vdots\\
\left\langle w_{m}\mid T\left(v_{i}\right)\right\rangle _{W}
\end{bmatrix}\right)^{*}=\left[\begin{array}{cccc}
\overline{\left\langle w_{1}\mid T\left(v_{i}\right)\right\rangle _{W}} & \overline{\left\langle w_{2}\mid T\left(v_{i}\right)\right\rangle _{W}} & \cdots & \overline{\left\langle w_{m}\mid T\left(v_{i}\right)\right\rangle _{W}}\end{array}\right]\\
 & =\left[\begin{array}{cccc}
\left\langle T\left(v_{i}\right)\mid w_{1}\right\rangle _{W} & \left\langle T\left(v_{i}\right)\mid w_{2}\right\rangle _{W} & \cdots & \left\langle T\left(v_{i}\right)\mid w_{m}\right\rangle _{W}\end{array}\right]
\end{align*}

\end_inset

אם כן הקואורדינטה ה-
\begin_inset Formula $ij$
\end_inset

 במטריצה 
\begin_inset Formula $\left(\left[T\right]_{\MKclc}^{\MKclb}\right)^{*}$
\end_inset

 היא 
\begin_inset Formula $\left\langle T\left(v_{i}\right)\mid w_{j}\right\rangle $
\end_inset

 (לכל 
\begin_inset Formula $n\geq i\in\MKnatural$
\end_inset

 ולכל 
\begin_inset Formula $m\geq j\in\MKnatural$
\end_inset

).
\begin_inset Newline newline
\end_inset

מצד שני ע"פ הנוסחה המפורשת של ההעתקה הצמודה ומהגדרת המטריצה המייצגת נובע שהעמודה ה-
\begin_inset Formula $j$
\end_inset

 ב-
\begin_inset Formula $\left[T^{*}\right]_{\MKclb}^{\MKclc}$
\end_inset

 היא (לכל 
\begin_inset Formula $m\geq j\in\MKnatural$
\end_inset

):
\begin_inset Formula 
\[
\left[T^{*}\left(w_{j}\right)\right]_{\MKclb}=\begin{bmatrix}\left\langle T\left(v_{1}\right)\mid w_{j}\right\rangle _{W}\\
\left\langle T\left(v_{2}\right)\mid w_{j}\right\rangle _{W}\\
\vdots\\
\left\langle T\left(v_{n}\right)\mid w_{j}\right\rangle _{W}
\end{bmatrix}
\]

\end_inset

ולכן הקואורדינטה ה-
\begin_inset Formula $ij$
\end_inset

 במטריצה 
\begin_inset Formula $\left[T^{*}\right]_{\MKclb}^{\MKclc}$
\end_inset

 היא 
\begin_inset Formula $\left\langle T\left(v_{i}\right)\mid w_{j}\right\rangle _{W}$
\end_inset

 (לכל 
\begin_inset Formula $n\geq i\in\MKnatural$
\end_inset

 ולכל 
\begin_inset Formula $m\geq j\in\MKnatural$
\end_inset

) ולכן המטריצות שוות.
\end_layout

\end_inset


\end_layout

