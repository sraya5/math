\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 ניתן לראות בקלות יחסית שלכל בסיס 
\begin_inset Formula $\left(u_{1},u_{2},\ldots,u_{n}\right)$
\end_inset

 של 
\begin_inset Formula $\MKfield^{n}$
\end_inset

 יש מכפלה פנימית המגדירה אותו כבסיס אורתונורמלי,
 השיטה היא כזו:
 נשים את וקטורי הבסיס בעמודות מטריצה 
\begin_inset Formula $U\in M_{n}\left(\MKfield\right)$
\end_inset

 ונגדיר את הפונקציה 
\begin_inset Formula $\left\langle \cdot\mid\cdot\right\rangle _{U}:\MKfield^{n}\times\MKfield^{n}\rightarrow\MKfield$
\end_inset

 ע"י (לכל 
\begin_inset Formula $v,w\in\MKfield^{n}$
\end_inset

):
\begin_inset Formula 
\[
\left\langle v\mid w\right\rangle _{U}:=v^{*}\cdot\left(U^{-1}\right)^{*}\cdot U^{-1}\cdot w
\]

\end_inset

כאשר אנו משתמשים באיזומורפיזם בין 
\begin_inset Formula $M_{1}\left(\MKfield\right)$
\end_inset

 ל-
\begin_inset Formula $\MKfield$
\end_inset

.
 מהגדרת כפל מטריצות מתקיימת תכונת הבי-לינאריות / לינאריות ברכיב הימני,
 הסימטריה נובעת מן התכונות של שחלוף מטריצות
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
לכל 
\begin_inset Formula $A\in M_{1}\left(\MKfield\right)$
\end_inset

 מתקיים 
\begin_inset Formula $A^{t}=A$
\end_inset

.
\end_layout

\end_inset

:
\begin_inset Formula 
\begin{align*}
\left\langle w\mid v\right\rangle _{U} & =w^{*}\cdot\left(U^{-1}\right)^{*}\cdot U^{-1}\cdot v\\
 & =\left(w^{*}\cdot\left(U^{-1}\right)^{*}\cdot U^{-1}\cdot v\right)^{t}\\
 & =v^{t}\cdot\left(U^{-1}\right)^{t}\cdot\left(\left(U^{-1}\right)^{*}\right)^{t}\cdot\left(w^{*}\right)^{t}\\
 & =\overline{v^{*}\cdot\left(U^{-1}\right)^{*}\cdot U^{-1}\cdot w}=\overline{\left\langle v\mid w\right\rangle _{U}}
\end{align*}

\end_inset

את תכונת החיוביות בהחלט נוכיח בעוד רגע,
 אך נשים לב כבר עכשיו לכך שמתקיים:
\begin_inset Formula 
\[
U^{*}\cdot\left(U^{-1}\right)^{*}\cdot U^{-1}\cdot U=\left(U^{-1}\cdot U\right)^{*}\cdot\left(U^{-1}\cdot U\right)=I_{n}
\]

\end_inset

ולכן 
\begin_inset Formula $\left\langle u_{i}\mid u_{j}\right\rangle _{U}=\delta_{ij}$
\end_inset

 לכל 
\begin_inset Formula $n\geq i,j\in\MKnatural$
\end_inset

,
 כלומר 
\begin_inset Formula $\left(u_{1},u_{2},\ldots,u_{n}\right)$
\end_inset

 הוא בסיס אורתונורמלי (בהנחה שאכן מדובר במכפלה פנימית).
\begin_inset Newline newline
\end_inset

כעת נסיים להוכיח שמדובר במכפלה פנימית,
 לשם כך עלינו להוכיח את תכונת החיוביות בהחלט,
 נציג את 
\begin_inset Formula $v$
\end_inset

 כצר"ל של 
\begin_inset Formula $\left(u_{1},u_{2},\ldots,u_{n}\right)$
\end_inset

 - 
\begin_inset Formula $v=\sum_{i=1}^{n}z_{i}\cdot u_{i}$
\end_inset

 ומכאן שמתקיים:
\begin_inset Formula 
\begin{align*}
\left\langle v\mid v\right\rangle _{U} & =\left\langle \begin{array}{c|c}
\begin{alignedat}{1}\sum_{i=1}^{n}z_{i}\cdot u_{i}\end{alignedat}
 & \sum_{j=1}^{n}z_{j}\cdot u_{j}\end{array}\right\rangle \\
 & =\sum_{i=1}^{n}\sum_{j=1}^{n}\overline{z_{i}}\cdot z_{j}\cdot\left\langle u_{i}\mid u_{j}\right\rangle \\
 & =\sum_{i=1}^{n}\overline{z_{i}}\cdot z_{i}=\sum_{i=1}^{n}\left|z_{i}\right|^{2}\geq0
\end{align*}

\end_inset

כמו כן ניתן לראות מהשורה הקודמת ש-
\begin_inset Formula $\left\langle v\mid v\right\rangle =0\Longleftrightarrow v=0_{V}$
\end_inset

.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 ההערה הקודמת נותנת לנו אינטואיציה כיצד למצוא - בכל מ"ו נ"ס 
\begin_inset Formula $V$
\end_inset

 מעל לשדה 
\begin_inset Formula $\MKfield$
\end_inset

 (כאשר 
\begin_inset Formula $\MKfield=\MKreal$
\end_inset

 או 
\begin_inset Formula $\MKfield=\MKcomplex$
\end_inset

),
 ולכל בסיס 
\begin_inset Formula $\MKclb$
\end_inset

 של 
\begin_inset Formula $V$
\end_inset

 - מכפלה פנימית על 
\begin_inset Formula $V$
\end_inset

 כך ש-
\begin_inset Formula $\MKclb$
\end_inset

 הוא בסיס אורתונורמלי;
 נגדיר את הפונקציה 
\begin_inset Formula $\left\langle \cdot\mid\cdot\right\rangle _{\MKclb}:V\times V\rightarrow\MKfield$
\end_inset

 ע"י (לכל 
