\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 בקובץ ההקדמה ראינו שעבור המכפלה הסקלרית מעל הממשיים מתקיים 
\begin_inset Formula $\left\langle v\mid w\right\rangle =\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert \cdot\cos\theta$
\end_inset

,
 כאשר 
\begin_inset Formula $\theta$
\end_inset

 היא הזווית שבין 
\begin_inset Formula $v$
\end_inset

 ל-
\begin_inset Formula $w$
\end_inset

.
 מכאן שבמשולש שקודקודיו הם 
\begin_inset Formula $0_{V},v,w$
\end_inset

,
 אורך הצלע שממול לזווית זו הוא 
\begin_inset Formula $\left\Vert v-w\right\Vert $
\end_inset

,
 ולכן ע"פ 
\begin_inset CommandInset href
LatexCommand href
name "משפט הקוסינוסים הטריגונומטרי"
target "https://he.wikipedia.org/wiki/%D7%9E%D7%A9%D7%A4%D7%98_%D7%94%D7%A7%D7%95%D7%A1%D7%99%D7%A0%D7%95%D7%A1%D7%99%D7%9D"
literal "false"

\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\left\Vert v-w\right\Vert ^{2} & =\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}-2\cdot\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert \cdot\cos\theta\\
 & =\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}-2\cdot\left\langle v\mid w\right\rangle \\
 & =\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}-2\cdot\MKre\left\langle v\mid w\right\rangle 
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Branch proofs
inverted 0
status collapsed

\begin_layout Proof
לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\left\Vert v\pm w\right\Vert ^{2} & =\left(\sqrt{\left\langle v\pm w\mid v\pm w\right\rangle }\right)^{2}=\left\langle v\pm w\mid v\pm w\right\rangle \\
 & =\left\langle v\mid v\pm w\right\rangle \pm\left\langle w\mid v\pm w\right\rangle \\
 & =\left\langle v\mid v\right\rangle \pm\left<v\mid w\right>\pm\left<w\mid v\right>+\left\langle w\mid w\right\rangle \\
 & =\left\langle v\mid v\right\rangle \pm{\color{red}\left(\left\langle v\mid w\right\rangle +\overline{\left\langle v\mid w\right\rangle }\right)}+\left\langle w\mid w\right\rangle \\
 & =\left(\sqrt{\left\langle v\mid v\right\rangle }\right)^{2}\pm{\color{red}2\cdot\MKre\left\langle v\mid w\right\rangle }+\left(\sqrt{\left\langle w\mid w\right\rangle }\right)^{2}\\
 & =\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}\pm2\cdot\MKre\left\langle v\mid w\right\rangle 
\end{align*}

\end_inset


\end_layout

\end_inset


