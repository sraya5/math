.
\end_layout

\end_inset

,
 והוא מאפשר לנו להגדיר זווית בממ"פ כללי (לא עשינו זאת בכיתה):
\begin_inset Formula 
\[
\theta:=\arccos\left(\frac{\left\langle v\mid w\right\rangle }{\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert }\right)
\]

