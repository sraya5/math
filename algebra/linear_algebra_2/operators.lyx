\begin_inset Formula
$\left(C_{P}\right)_{k,n}$
\end_inset
 היא 
\begin_inset Formula
$x^{k-1}$
\end_inset

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
הדטרמיננטה של מטריצה אלכסונית לפי בלוקים היא מכפלת הדטרמיננטות ששל בלוקים על האלכסון.
\end_layout

\end_inset
. לכל 
\begin_inset Formula
$n>k\in\MKnatural$
\end_inset
 האיבר שבשורה ה-
\begin_inset Formula
$k$
\end_inset
 בעמודה ה-
\begin_inset Formula
$n$
\end_inset
 של 
\begin_inset Formula
$x\cdot I_{n}-C_{P}$
\end_inset
 הוא 
\begin_inset Formula
$a_{k-1}$
\end_inset
 ואילו האיבר שבשורה ה-
\begin_inset Formula
$n$
\end_inset
 בעמודה ה-
\begin_inset Formula
$n$
\end_inset
 הוא 
\begin_inset Formula
$x+a_{n-1}$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\det\left(x\cdot I_{n}-C_{P}\right) & =\left(x+a_{n-1}\right)\cdot\det\left(\left(C_{P}\right)_{n,n}\right)+\sum_{k=1}^{n-1}a_{k-1}\cdot\det\left(\left(C_{P}\right)_{k,n}\right)\\
 & =\left(x+a_{n-1}\right)\cdot x^{n-1}+\sum_{k=1}^{n-1}a_{k-1}\cdot x^{k-1}\\
 & =x^{n}+a_{n-1}\cdot x^{n-1}+\sum_{k=0}^{n-2}a_{k}\cdot x^{k}\\
 & =x^{n}+\sum_{k=0}^{n-1}a_{k}\cdot x^{k}=P\left(x\right)
\end{align*}


\end_inset

