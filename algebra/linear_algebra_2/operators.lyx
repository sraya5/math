\end_inset
 אז מדובר בשרשרת אחת באורך 
\begin_inset Formula
$1$
\end_inset
 המכילה וקטור יחיד שונה מ-
\begin_inset Formula
$0$
\end_inset
 וממילא מדובר בסדרה בת"ל
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
למעשה בסיס האינדוקציה כלול במקרה הקודם.
\end_layout

\end_inset
.
\begin_inset Newline newline
\end_inset

\bar under
צעד האינדוקציה
\bar default

\begin_inset Newline newline
\end_inset
מספיק להראות שנוכל להקטין את סכום אורכי השרשראות (ע"י "ויתור" על שרשרת או החלפתה בשרשרת קצרה יותר) תוך שמירה על הפרוש שלהן.
\begin_inset Newline newline
\end_inset
מהמשפט הקודם (
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 4.3"
plural false
caps false
noprefix false
\end_inset
) ומההנחה נובע ש-
\begin_inset Formula
$\left(g^{h_{1}-1}\left(v_{1}\right),g^{h_{2}-1}\left(v_{2}\right),\ldots,g^{h_{s}-1}\left(v_{n}\right)\right)$
\end_inset
 תלויה ליניארית, יהי 
\begin_inset Formula
$\sum_{i=1}^{n}a_{i}\cdot g^{h_{i}-1}\left(v_{i}\right)$
\end_inset
 צר"ל מתאפס לא טריוויאלי של סדרה זו (למעשה קיימים שני אינדקסים שהמקדם שלהם שונה מ-
\begin_inset Formula
$0$
\end_inset
).
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
 האינדקס המקיים 
\begin_inset Formula
$h_{j}=\min\left\{ h_{i}\mid a_{i}\neq0,\ n\geq i\in\MKnatural\right\} $
\end_inset
.
\begin_inset Formula
\[
\Rightarrow g^{h_{j}-1}\left(\sum_{i=1}^{n}a_{i}\cdot g^{h_{i}-h_{j}}\left(v_{i}\right)\right)=\sum_{i=1}^{n}a_{i}\cdot g^{h_{i}-1}\left(v_{i}\right)=0_{V}
\]


\end_inset
נגדיר:
\begin_inset Formula
\[
{\color{blue}v'}:=\sum_{i=1}^{n}a_{i}\cdot g^{h_{i}-h_{j}}\left(v_{i}\right)=a_{1}\cdot g^{h_{1}-h_{j}}\left(v_{1}\right)+a_{2}\cdot g^{h_{2}-h_{j}}\left(v_{2}\right)+\ldots+{\color{red}a_{j}\cdot v_{j}}+\ldots+a_{n}\cdot g^{h_{n}-h_{j}}\left(v_{n}\right)
\]


\end_inset

\begin_inset Formula
\begin{align*}
