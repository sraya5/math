\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 נשים לב לכך שלכל 
\begin_inset Formula $x\in\MKreal^{n}$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
x\cdot x=\sum_{i=1}^{n}\left(x_{i}\right)^{2}=\left\Vert x\right\Vert ^{2}
\]

\end_inset

ולכן 
\begin_inset Formula $\left\Vert x\right\Vert =\sqrt{x\cdot x}$
\end_inset

.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 כמו כן לכל 
\begin_inset Formula $0\neq v,w\in\MKreal^{n}$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\theta=\arccos\left(\frac{v\cdot w}{\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert }\right)
\]

\end_inset

כאשר 
\begin_inset Formula $\theta$
\end_inset

 היא הזווית הקטנה שבין 
\begin_inset Formula $v$
\end_inset

 ל-
\begin_inset Formula $w$
\end_inset

,
 בפרט מתקיים 
\begin_inset Formula $\theta=\frac{\pi}{2}$
\end_inset

 (כלומר 
\begin_inset Formula $v$
\end_inset

 ו-
\begin_inset Formula $w$
\end_inset

 
\series bold
מאונכים
\series default
 זה לזה) אם"ם 
\begin_inset Formula $v\cdot w=0$
\end_inset

.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 אם נזכור שכל הסיפור הזה התחיל ממשפט פיתגורס נבין מהי הסיבה לכך שהמכפלה הסקלרית מגדירה אורכים וזוויות יחדיו.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 הבחירה להגדיר את המכפלה הסקלרית בצורה 
\begin_inset Formula $\left\Vert \vec{a}\right\Vert \cdot\left\Vert \vec{b}\right\Vert \cdot\cos\theta$
\end_inset

 נראית קצת מוזרה במבט ראשון,
 אני הייתי רוצה לדבר על הטלה של וקטור אחד בכיוון של וקטור שני מבלי להתייחס לאורכו של הווקטור השני - כלומר הייתי רוצה לדבר על 
\begin_inset Formula $\left\Vert \vec{b}\right\Vert \cdot\cos\theta$
\end_inset

 שהיא ההטלה של 
\begin_inset Formula $\vec{b}$
\end_inset

 בכיוון של 
\begin_inset Formula $\vec{a}$
\end_inset

;
 לעיל הבאנו סיבה אחת שמתקבלת על הדעת וכאן אני רוצה להביא אחת נוספת:
 המכפלה הסקלרית בודקת עד כמה שני וקטורים מצביעים לאותו כיוון ועד כמה "חזק" הם מצביעים לכיוון זה.
\begin_inset Newline newline
\end_inset

אבל הנימוק הזה עדיין לא מספיק - מה שאמרתי כאן הוא שאני מבצע מן "ממוצע משוקלל" שבו אני משקלל את ההבדל בכיוון של שני הווקטורים (הזווית שביניהם) עם הגודל של שניהם,
 זה אמנם הגיוני לתת לשני הווקטורים את אותו המשקל אך מדוע בחרתי לשקלל את הזווית והאורכים דווקא בצורה זו?
\begin_inset Newpage newpage
\end_inset

למי שמתקשה לחשוב על דרך נוספת לבצע את השקלול הזה הנה פונקציה נוספת שיכולה להחליף את 
\begin_inset Formula $\cos$
\end_inset

 במכפלה הסקלרית
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
כלומר 
\begin_inset Formula $f$
\end_inset

 היא בעצם חיקוי ליניארי של 
\begin_inset Formula $\cos$
\end_inset

 (על הקטע 
\begin_inset Formula $\left[0,2\pi\right]$
\end_inset

) - היא מקבלת את הערכים 
\begin_inset Formula $1,0,-1$
\end_inset

 בדיוק במקומות שבהם 
\begin_inset Formula $\cos$
\end_inset

 מקבלת אותם (ובפרט 
\begin_inset Formula $f\left(\frac{\pi}{2}\right)=0$
\end_inset

) אך בין הנקודות הללו היא מותחת קו ישר במקום העיקול ש-
\begin_inset Formula $\cos$
\end_inset

 עושה.
\end_layout

\end_inset

:
\begin_inset Formula 
\[
f\left(\theta\right):=\begin{cases}
1-\frac{2\theta}{\pi} & \theta\in\left[0,\pi\right]\\
-1+\frac{2\theta}{\pi} & \theta\in\left[\pi,2\pi\right]
\end{cases}
\]

\end_inset

ובכן חברים,
 המתמטיקה לא נולדה מהחלל הריק,
 לא ירדה כתורה למשה מסיני ולא ניתנה לנו מגזע חייזרים תבוני עלום - המתמטיקה תמיד נוצרה ותמיד תיווצר מתוך צרכים מהשטח ובפרט צרכים פיזיקליים;
 הסיבה האמיתית להגדרה של המכפלה הסקלרית היא הפיזיקה:
 אם אני מפעיל על גוף 
\begin_inset Formula $\boldsymbol{A}$
\end_inset

 
