\begin_layout Enumerate
\begin_inset Formula 
\[
\left\langle \MKid_{V}^{*}\left(v\right)\mid v'\right\rangle =\left\langle v\mid\MKid_{V}\left(v'\right)\right\rangle 
\]

\end_inset


