\begin_layout Enumerate
לכל 
\begin_inset Formula $v_{1},v_{2}\in V$
\end_inset

 מתקיים 
\begin_inset Formula $\left\langle f\left(v_{1}\right)\mid f\left(v_{2}\right)\right\rangle _{W}=\left\langle v_{1}\mid v_{2}\right\rangle _{V}$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Proof
נניח ש-
\begin_inset Formula $f$
\end_inset

 מקיימת את שני התנאים ויהי 
\begin_inset Formula $U:=\left\{ u_{1},u_{2},\ldots,u_{n}\right\} $
\end_inset

 בסיס אורתונורמלי של 
\begin_inset Formula $V$
\end_inset

 כך ש-
\begin_inset Formula $f\left(U\right)$
\end_inset

 הוא בסיס אורתונורמלי של 
\begin_inset Formula $W$
\end_inset

.
\begin_inset Newline newline
\end_inset

מההנחה וממשפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 1.12"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 נובע שלכל 
\begin_inset Formula $v\in V$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
v & =\sum_{i=1}^{n}\left\langle u_{i}\mid v\right\rangle _{V}\cdot u_{i}\\
f\left(v\right) & =\sum_{i=1}^{n}\left\langle f\left(u_{i}\right)\mid f\left(v\right)\right\rangle _{W}\cdot f\left(u_{i}\right)\\
 & =\sum_{i=1}^{n}\left\langle u_{i}\mid v\right\rangle _{V}\cdot f\left(u_{i}\right)
\end{align*}

\end_inset

מכאן שלכל 
\begin_inset Formula $v,v_{0}\in V$
\end_inset

 ולכל 
\begin_inset Formula $\lambda\in\MKfield$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
f\left(v+v_{0}\right) & =\sum_{i=1}^{n}\left\langle u_{i}\mid v+v_{0}\right\rangle _{V}\cdot f\left(u_{i}\right)=\sum_{i=1}^{n}\left(\left\langle u_{i}\mid v\right\rangle _{V}+\left\langle u_{i}\mid v_{0}\right\rangle _{V}\right)\cdot f\left(u_{i}\right)\\
 & =\sum_{i=1}^{n}\left\langle u_{i}\mid v\right\rangle _{V}\cdot f\left(u_{i}\right)+\sum_{i=1}^{n}\left\langle u_{i}\mid v_{0}\right\rangle _{V}\cdot f\left(u_{i}\right)=f\left(v\right)+f\left(v_{0}\right)\\
f\left(\lambda\cdot v\right) & =\sum_{i=1}^{n}\left\langle u_{i}\mid\lambda\cdot v\right\rangle _{V}\cdot f\left(u_{i}\right)=\sum_{i=1}^{n}\lambda\cdot\left\langle u_{i}\mid v\right\rangle _{V}\cdot f\left(u_{i}\right)\\
 & =\lambda\cdot\sum_{i=1}^{n}\left\langle u_{i}\mid v\right\rangle _{V}\cdot f\left(u_{i}\right)=\lambda\cdot f\left(v\right)
\end{align*}

\end_inset


