\begin_layout Proof
נניח ש-
\begin_inset Formula $\sigma\left(f\right)\neq\emptyset$
\end_inset

 (אחרת הטענה טריוויאלית) ויהי 
\begin_inset Formula $v\in V$
\end_inset

 וקטור עצמי של 
\begin_inset Formula $f$
\end_inset

 בעל ערך עצמי 
\begin_inset Formula $\lambda\in\MKfield$
\end_inset

 (מהגדרה 
\begin_inset Formula $v\neq0_{V}$
\end_inset

 ולכן 
\begin_inset Formula $\left\langle v\mid v\right\rangle \neq0$
\end_inset

).
\begin_inset Formula 
\[
\Rightarrow\left\langle v\mid v\right\rangle =\left\langle f\left(v\right)\mid f\left(v\right)\right\rangle =\left\langle \lambda\cdot v\mid\lambda\cdot v\right\rangle =\overline{\lambda}\cdot\lambda\cdot\left\langle v\mid v\right\rangle 
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow\left|\lambda\right|^{2}=\overline{\lambda}\cdot\lambda=\frac{\left\langle v\mid v\right\rangle }{\left\langle v\mid v\right\rangle }=1
\]

\end_inset

כעת נזכור שמהגדרת הערך המוחלט 
\begin_inset Formula $0\leq\left|\lambda\right|\in\MKreal$
\end_inset

 ולכן מהעובדה ש-
\begin_inset Formula $\left|\lambda\right|^{2}=1$
\end_inset

 נובע ש-
\begin_inset Formula $\left|\lambda\right|=1$
\end_inset

.
\end_layout

