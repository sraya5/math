\begin_layout Proof
ההפיכות של 
\begin_inset Formula $\varphi$
\end_inset

 נובעת ישירות ממשפט ההצגה של ריס,
 אם כן נעבור להוכיח שאם 
\begin_inset Formula $\MKfield=\MKreal$
\end_inset

 אז 
\begin_inset Formula $\varphi$
\end_inset

 היא העתקה ליניארית ואם 
\begin_inset Formula $\MKfield=\MKcomplex$
\end_inset

 אז היא העתקה אנטי-ליניארית.
\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $v,w,u\in V$
\end_inset

,
 לכל 
\begin_inset Formula $\lambda\in\MKfield$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
l_{v+w}\left(u\right) & =\left\langle v+w\mid u\right\rangle =\left\langle v\mid u\right\rangle +\left\langle w\mid u\right\rangle =l_{v}\left(u\right)+l_{w}\left(u\right)\\
l_{\lambda\cdot v}\left(w\right) & =\left\langle \lambda\cdot v\mid w\right\rangle =\overline{\lambda}\cdot\left\langle v\mid w\right\rangle =\overline{\lambda}\cdot l_{v}\left(w\right)
\end{align*}

\end_inset

ומכאן שלכל 
\begin_inset Formula $v,w\in V$
\end_inset

 ולכל 
\begin_inset Formula $\lambda\in\MKfield$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\varphi\left(v+w\right) & =l_{v+w}=l_{v}+l_{w}=\varphi\left(v\right)+\varphi\left(w\right)\\
\varphi\left(\lambda\cdot v\right) & =l_{\lambda\cdot v}=\overline{\lambda}\cdot l_{v}=\overline{\lambda}\cdot\varphi\left(v\right)
\end{align*}

\end_inset


\end_layout

