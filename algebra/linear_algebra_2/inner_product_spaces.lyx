\begin_layout Proof
למעשה ההסבר שניתן בגוף האלגוריתם אמור להספיק,
 מי שמתעקש לקבל הסבר פורמלי מלא מתבקש להמשיך לקרוא.
\begin_inset Newline newline
\end_inset

ע"פ המשפט הקודם (
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 1.12"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 בכל שלב של הלולאה מתקיים 
\begin_inset Formula $v_{k}'\perp\MKspan\left(u_{1},u_{2},\ldots,u_{k-1}\right)$
\end_inset

 ולכן גם 
\begin_inset Formula $u_{k}\perp\MKspan\left(u_{1},u_{2},\ldots,u_{k-1}\right)$
\end_inset

 ומכאן ש-
\begin_inset Formula $\left(u_{1},u_{2},\ldots,u_{k}\right)$
\end_inset

 היא סדרה אורתונורמלית ובפרט בת"ל,
 אך מהגדרה מתקיים:
\begin_inset Formula 
\begin{align*}
\MKspan\left(u_{1},u_{2},\ldots,u_{k}\right) & \subseteq\MKspan\left(u_{1},u_{2},\ldots,u_{k-1},v_{k}\right)\subseteq\MKspan\left(u_{1},u_{2},\ldots u_{k-2},v_{k-1},v_{k}\right)\\
 & \subseteq\ldots\subseteq\MKspan\left(u_{1},u_{2},\ldots u_{i},v_{i+1},v_{i+2},\ldots,v_{k}\right)\subseteq\MKspan\left(v_{1},v_{2},\ldots,v_{k}\right)
\end{align*}

\end_inset

ומכיוון ש-
\begin_inset Formula $\dim\left(\MKspan\left(u_{1},u_{2},\ldots,u_{k}\right)\right)=k=\dim\left(\MKspan\left(v_{1},v_{2},\ldots,v_{k}\right)\right)$
\end_inset


\begin_inset Newline newline
\end_inset

נדע שמתקיים 
\begin_inset Formula $\MKspan\left(u_{1},u_{2},\ldots,u_{k}\right)=\MKspan\left(v_{1},v_{2},\ldots,v_{k}\right)$
\end_inset

.
\end_layout

\begin_layout Corollary
