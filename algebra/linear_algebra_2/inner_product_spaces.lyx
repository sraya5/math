 לעומתו ראינו שם שכל אופרטור אוניטרי מעל המרוכבים דווקא לכסין תמיד.
 הסיבה להבדל הזה היא שבעוד שבממשיים אי אפשר לתאר סיבוב ככפל בסקלר הרי שבמרוכבים כל כפל בסקלר הוא סיבוב ומתיחה של המרחב,
 בואו נתבונן בזה מקרוב.
\begin_inset Newline newline
\end_inset

כשהגדרנו את המרוכבים אמרנו ש-
\begin_inset Formula $\MKcomplex$
\end_inset

 הוא 
\begin_inset Formula $\MKreal^{2}$
\end_inset

 עם פעולת החיבור הווקטורי שלו שעליו אנו מגדירים פעולת כפל חדשה:
\begin_inset Formula 
\[
\begin{bmatrix}c\\
s
\end{bmatrix}\cdot\begin{bmatrix}x\\
y
\end{bmatrix}:=\left(c+is\right)\left(x+iy\right)=\left(cx+sy\right)+i\cdot\left(sx+cy\right)=\begin{bmatrix}cx-sy\\
sx+cy
\end{bmatrix}=\left[\begin{array}{cc}
c & -s\\
s & c
\end{array}\right]\cdot\begin{bmatrix}x\\
y
\end{bmatrix}
\]

\end_inset

כלומר כל פונקציית כפל בקבוע 
\begin_inset Formula $z\in\MKcomplex$
\end_inset


\begin_inset Foot
status collapsed

\begin_layout Plain Layout
יהי 
\begin_inset Formula $z\in\MKcomplex$
\end_inset

 ותהא 
\begin_inset Formula $f_{z}:\MKcomplex\rightarrow\MKcomplex$
\end_inset

 פונקציה המוגדרת ע"י 
\begin_inset Formula $f_{z}\left(w\right):=z\cdot w$
\end_inset

 לכל 
\begin_inset Formula $w\in\MKcomplex$
\end_inset

.
\end_layout

\end_inset

 שקולה כפל במטריצת הסיבוב והמתיחה 
\begin_inset Formula $r\cdot\left[\begin{array}{cc}
\cos\theta & -\sin\theta\\
\sin\theta & \cos\theta
\end{array}\right]$
\end_inset

 כאשר 
\begin_inset Formula $z=r\cdot\MKcis\theta$
\end_inset

,
 עם קצת עבודה נוספת ניתן להראות שהשקילות הנ"ל מגדירה איזומורפיזם מ-
\begin_inset Formula $\MKcomplex$
\end_inset

 לקבוצת מטריצות הסיבוב והמתיחה על 
\begin_inset Formula $\MKreal^{2}$
\end_inset

:
\begin_inset Formula 
\[
\left\{ \begin{array}{c|c}
r\cdot\left[\begin{array}{cc}
\cos\theta & -\sin\theta\\
\sin\theta & \cos\theta
\end{array}\right] & 0\leq r\in\MKreal,\ \end{array}\theta\in\left[0,2\pi\right)\right\} 
\]

\end_inset

בשדה המרוכבים יש לנו שלוש קבוצות מיוחדות:
 הממשיים הטהורים,
 המדומים הטהורים ומעגל היחידה מרוכב,
 איך זה מתבטא במטריצת הסיבוב שלהם?
\begin_inset Newline newline
\end_inset

יהי 
\begin_inset Formula $z\in\MKcomplex$
\end_inset

 ויהיו 
\begin_inset Formula $0\leq r\in\MKreal$
\end_inset

 ו-
\begin_inset Formula $\theta\in\left[0,2\pi\right)$
\end_inset

 כך ש-
\begin_inset Formula $z=r\cdot\MKcis\theta$
\end_inset

,
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula $z$
\end_inset

 הוא ממשי טהור אז 
\begin_inset Formula $\theta=0$
\end_inset

 או ש-
\begin_inset Formula $\theta=\pi$
\end_inset

 ולכן המטריצה המתאימה היא:
\begin_inset Formula 
\[
\left[\begin{array}{cc}
\pm r & 0\\
0 & \pm r
\end{array}\right]
\]

\end_inset

נשים לב לכך שכל מטריצות הסיבוב הסימטריות מוכרחות להיות מהצורה הזו.
\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula $z$
\end_inset

 הוא מדומה טהור אז 
\begin_inset Formula $\theta=\frac{\pi}{2}$
\end_inset

 או ש-
\begin_inset Formula $\theta=\frac{3\pi}{2}$
\end_inset

 ולכן המטריצה מתאימה היא:
\begin_inset Formula 
\[
\left[\begin{array}{cc}
0 & \mp r\\
\pm r & 0
\end{array}\right]
\]

\end_inset

נשים לב לכך שכל מטריצות הסיבוב האנטי-סימטריות מוכרחות להיות מהצורה הזו.
\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula $z$
\end_inset

 נמצא על מעגל היחידה המרוכב אז 
\begin_inset Formula $r=1$
\end_inset

 ולכן המטריצה המתאימה היא:
\begin_inset Formula 
\[
\left[\begin{array}{cc}
\cos\theta & -\sin\theta\\
\sin\theta & \cos\theta
\end{array}\right]
\]

\end_inset

נשים לב לכך שאלו כל מטריצות הסיבוב שאינן מבצעות מתיחה ובכך הן שומרות על הערך המוחלט של המספר המרוכב ועל הזוויות שלו ביחס למספרים מרוכבים אחרים.
\begin_inset Newline newline
\end_inset

אחד הדברים שמייחדים את מעגל היחידה המרוכב משאר המישור הוא שלכל איבר במעגל היחידה ההופכי שלו הוא גם הצמוד שלו,
 כעת הדמיון לעולם האופרטורים זועק לשמיים:
 לא רק שכבר ראינו שכל מטריצה כזו היא אופרטור אוניטרי על 
\begin_inset Formula $\MKreal^{2}$
\end_inset

 אלא גם ההופכית שלה היא בדיוק המטריצה המתאימה לצמוד המרוכב ממש כמו שעבור אופרטור אוניטרי ההופכי שלו הוא האופרטור הצמוד.
\end_layout

