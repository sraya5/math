\begin_layout Standard
כשמדובר ב-
\begin_inset Formula $\MKreal$
\end_inset

 ההצמדה של הסימטריה ההרמיטית אינה משנה דבר ומדובר בסימטריה רגילה,
 אנחנו נשתמש בקיצור הדרך הזה פעמים רבות מבלי להזכיר זאת.
\begin_inset Newline newline
\end_inset

את הליניאריות למחצה ברכיב השמאלי היינו מקבלים מהליניאריות ברכיב הימני ומהסימטריה ההרמיטית:
\begin_inset Formula 
\begin{align*}
\left\langle v+u\mid w\right\rangle  & =\overline{\left\langle w\mid v+u\right\rangle }=\overline{\left\langle w\mid v\right\rangle +\left\langle w\mid u\right\rangle }=\overline{\left\langle w\mid v\right\rangle }+\overline{\left\langle w\mid u\right\rangle }=\left\langle v\mid w\right\rangle +\left\langle u\mid w\right\rangle \\
\left\langle \lambda\cdot v\mid w\right\rangle  & =\overline{\left\langle w\mid\lambda\cdot v\right\rangle }=\overline{\lambda\cdot\left\langle w\mid v\right\rangle }=\overline{\lambda}\cdot\overline{\left\langle w\mid v\right\rangle }=\overline{\lambda}\cdot\left\langle v\mid w\right\rangle 
\end{align*}

\end_inset

למעשה זוהי הסיבה לכך שלא היינו יכולים לדרוש ליניאריות מלאה ברכיב השמאלי (במכפלה ההרמיטית),
 היינו מקבלים סתירה.
\end_layout

\end_deeper
\end_deeper
\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 א"א אפשר לדרוש סימטריה רגילה במקום סימטריה הרמיטית (מעל 
\begin_inset Formula $\MKcomplex$
\end_inset

) מפני שתכונת החיוביות במכפלה הפנימית מחייבת ש-
\begin_inset Formula $\left\langle v\mid v\right\rangle \in\MKreal\subseteq\MKcomplex$
\end_inset

 לכל 
\begin_inset Formula $v\in V$
\end_inset

 (שהרי 
\begin_inset Formula $\MKcomplex$
\end_inset

 אינו שדה סדור),
 ולכן הדרישה לסימטריה רגילה תוביל לדרישת הסימטריה ההרמיטית שכן לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 יתקיים:
 
\begin_inset Formula 
\[
\overline{\left\langle v\mid v\right\rangle }+\overline{\left\langle v\mid w\right\rangle }+\overline{\left\langle w\mid v\right\rangle }+\overline{\left\langle w\mid w\right\rangle }=\overline{\left\langle v+w\mid v+w\right\rangle }=\left\langle v+w\mid v+w\right\rangle =\left\langle v\mid v\right\rangle +\left\langle v\mid w\right\rangle +\left\langle w\mid v\right\rangle +\left\langle w\mid w\right\rangle 
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow\overline{\left\langle v\mid w\right\rangle }+\overline{\left\langle w\mid v\right\rangle }=\left\langle v\mid w\right\rangle +\left\langle w\mid v\right\rangle 
\]

\end_inset

סימטריה רגילה תיתן כאן 
\begin_inset Formula $2\cdot\overline{\left\langle v\mid w\right\rangle }=2\cdot\left\langle v\mid w\right\rangle $
\end_inset

 ומכאן שנקבל סימטריה הרמיטית.
\end_layout

