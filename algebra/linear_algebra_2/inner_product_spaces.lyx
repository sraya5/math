\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "claim 2.10"

\end_inset

תהיינה 
\begin_inset Formula $T:V\rightarrow W$
\end_inset

 ו-
\begin_inset Formula $S:W\rightarrow V$
\end_inset

 העתקות לינאריות,
 אם מתקיים 
\begin_inset Formula $\left\langle S\left(w\right)\mid v\right\rangle _{V}=\left\langle w\mid T\left(v\right)\right\rangle _{W}$
\end_inset

 לכל 
\begin_inset Formula $v\in V$
\end_inset

 ולכל 
\begin_inset Formula $w\in W$
\end_inset

 אז 
\begin_inset Formula $S=T^{*}$
\end_inset

.
\end_layout

\begin_layout Proof
לכל 
\begin_inset Formula $v\in V$
\end_inset

 ולכל 
\begin_inset Formula $w\in W$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left\langle T^{*}\left(w\right)-S\left(w\right)\mid v\right\rangle _{V}=\left\langle T^{*}\left(w\right)\mid v\right\rangle _{V}-\left\langle S\left(w\right)\mid v\right\rangle _{V}=\left\langle w\mid T\left(v\right)\right\rangle _{W}-\left\langle w\mid T\left(v\right)\right\rangle _{W}=0
\]

\end_inset

מכאן שלכל 
\begin_inset Formula $w\in W$
\end_inset

 מתקיים 
\begin_inset Formula $S\left(w\right)=T^{*}\left(w\right)$
\end_inset

,
 כלומר 
\begin_inset Formula $S=T^{*}$
\end_inset

.
\end_layout

