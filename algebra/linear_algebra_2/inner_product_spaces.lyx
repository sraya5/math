נוסחת הפולריזציה
\series default

\begin_inset Newline newline
\end_inset

אם 
\begin_inset Formula $\MKfield=\MKreal$
\end_inset

 אז לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\left\langle v\mid w\right\rangle  & =\frac{\left\Vert v+w\right\Vert ^{2}-\left(\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}\right)}{2}\\
\left\langle v\mid w\right\rangle  & =\frac{\left\Vert v+w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2}}{4}
\end{align*}

\end_inset

ואם 
\begin_inset Formula $\MKfield=\MKcomplex$
\end_inset

 אז לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left\langle v\mid w\right\rangle =\frac{\left\Vert v+w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2}-i\cdot\left(\left\Vert v+i\cdot w\right\Vert ^{2}-\left\Vert v-i\cdot w\right\Vert ^{2}\right)}{4}
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 כל האלגברה הזו לא באמת מעניינת,
 הנקודה שצריך לקחת בכאן היא שהעתקה ליניארית היא אוניטרית (כלומר שומרת על המכפלה הפנימית) אם"ם היא שומרת על הנורמה.
\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula $v,w\in V$
\end_inset

,
 מחוק המקבילית נובע שמתקיים:
\begin_inset Formula 
\begin{align*}
\left\Vert v+w\right\Vert ^{2}-\left\Vert v\right\Vert ^{2}-\left\Vert w\right\Vert ^{2} & =\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2}\\
 & =\left\langle v\mid v\right\rangle +\left\langle w\mid w\right\rangle -\left\langle v-w\mid v-w\right\rangle \\
 & ={\color{red}\left\langle v\mid v\right\rangle +\left\langle w\mid w\right\rangle }-\left({\color{red}\left\langle v\mid v\right\rangle }-\left\langle v\mid w\right\rangle -\left\langle w\mid v\right\rangle +{\color{red}\left\langle w\mid w\right\rangle }\right)\\
 & =\left\langle v\mid w\right\rangle +\left\langle w\mid v\right\rangle 
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\Rightarrow\left\Vert v+w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2} & =2\cdot\left(\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}\right)-2\cdot\left\Vert v-w\right\Vert ^{2}\\
 & =2\cdot\left(\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2}\right)\\
 & =2\cdot\left(\left\langle v\mid w\right\rangle +\left\langle w\mid v\right\rangle \right)
\end{align*}

\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
נניח ש-
\begin_inset Formula $\MKfield=\MKreal$
\end_inset

,
 כלומר 
\begin_inset Formula $\left\langle v\mid w\right\rangle =\left\langle w\mid v\right\rangle $
\end_inset

 ולכן:
\begin_inset Formula 
\begin{align*}
\left\Vert v+w\right\Vert ^{2}-\left\Vert v\right\Vert ^{2}-\left\Vert w\right\Vert ^{2} & =2\cdot\left\langle v\mid w\right\rangle \\
\left\Vert v+w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2} & =4\cdot\left\langle v\mid w\right\rangle 
\end{align*}

\end_inset

וממילא:
\begin_inset Formula 
\begin{align*}
\left\langle v\mid w\right\rangle  & =\frac{\left\Vert v+w\right\Vert ^{2}-\left\Vert v\right\Vert ^{2}-\left\Vert w\right\Vert ^{2}}{2}\\
\left\langle v\mid w\right\rangle  & =\frac{\left\Vert v+w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2}}{4}
\end{align*}

\end_inset


\end_layout

\begin_layout Itemize
נניח ש-
\begin_inset Formula $\MKfield=\MKcomplex$
\end_inset

,
 אם כן ע"פ מה שהוכחנו לעיל מתקיים:
\begin_inset Formula 
\begin{align*}
-i\cdot\left(\left\Vert v+i\cdot w\right\Vert ^{2}-\left\Vert v-i\cdot w\right\Vert ^{2}\right) & =-i\cdot2\cdot\left(\left\langle v\mid i\cdot w\right\rangle +\left\langle i\cdot w\mid v\right\rangle \right)\\
 & =-i\cdot2\cdot\left(i\cdot\left\langle v\mid w\right\rangle -i\cdot\left\langle w\mid v\right\rangle \right)\\
 & =2\cdot\left(-i^{2}\cdot\left\langle v\mid w\right\rangle +i^{2}\cdot\left\langle w\mid v\right\rangle \right)\\
 & =2\cdot\left(\left\langle v\mid w\right\rangle -\left\langle w\mid v\right\rangle \right)
\end{align*}

\end_inset


\begin_inset Formula 
\[
\Rightarrow\left\Vert v+w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2}-i\cdot\left(\left\Vert v+i\cdot w\right\Vert ^{2}-\left\Vert v-i\cdot w\right\Vert ^{2}\right)=2\cdot\left(\left\langle v\mid w\right\rangle +{\color{red}\left\langle w\mid v\right\rangle }+\left\langle v\mid w\right\rangle {\color{red}-\left\langle w\mid v\right\rangle }\right)=4\cdot\left\langle v\mid w\right\rangle 
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow\left\langle v\mid w\right\rangle =\frac{\left\Vert v+w\right\Vert ^{2}-\left\Vert v-w\right\Vert ^{2}-i\cdot\left(\left\Vert v+i\cdot w\right\Vert ^{2}-\left\Vert v-i\cdot w\right\Vert ^{2}\right)}{4}
\]

\end_inset


\end_layout

