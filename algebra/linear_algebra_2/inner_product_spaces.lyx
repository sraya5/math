\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 זה לא כל כך מפתיע כשזוכרים שפונקציונל 
\begin_inset Formula $f:\MKfield^{n}\rightarrow\MKfield$
\end_inset

 הוא בעצם כפל במטריצה מגודל 
\begin_inset Formula $1\times n$
\end_inset

 (וקטור שורה) וכפל מטריצות כזה שקול לחלוטין למכפלה הסקלרית עם המשוחלפת שלה (כווקטור עמודה),
 כלומר כל פונקציונל הוא בעצם הטלה על הכיוון של וקטור מסוים (כדי לקבל איבר ב-
\begin_inset Formula $\MKfield$
\end_inset

) ואז כפל בגודל של אותו וקטור (ראו בקובץ ההקדמה).
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula $l\in V^{*}$
\end_inset

,
 יהי 
\begin_inset Formula $\left(u_{1},u_{2},\ldots,u_{n}\right)$
\end_inset

 בסיס אורתונורמלי של 
\begin_inset Formula $V$
\end_inset

 ונסמן:
\begin_inset Formula 
\[
v:=\sum_{i=1}^{n}\overline{l\left(u_{i}\right)}\cdot u_{i}
\]

\end_inset

מכאן שלכל 
\begin_inset Formula $n\geq j\in\MKnatural$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left\langle v\mid u_{j}\right\rangle =\left\langle \begin{array}{c|c}
\begin{alignedat}{1}\sum_{i=1}^{n}\overline{l\left(u_{i}\right)}\cdot u_{i}\end{alignedat}
 & u_{j}\end{array}\right\rangle =\sum_{i=1}^{n}l\left(u_{i}\right)\cdot\left\langle u_{i}\mid u_{j}\right\rangle =l\left(u_{j}\right)
\]

\end_inset

מכאן שלכל 
\begin_inset Formula $w\in V$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
l\left(w\right)=l\left(\sum_{i=1}^{n}\left\langle u_{i}\mid w\right\rangle \cdot u_{i}\right)=\sum_{i=1}^{n}\left\langle u_{i}\mid w\right\rangle \cdot l\left(u_{i}\right)=\sum_{i=1}^{n}\left\langle u_{i}\mid w\right\rangle \cdot\left\langle v\mid u_{i}\right\rangle =\left\langle v\mid w\right\rangle 
\]

\end_inset

אם כן הוכחנו את הקיום של 
\begin_inset Formula $v$
\end_inset

 כנ"ל;
 נוכיח כעת את היחידות,
 יהיו 
\begin_inset Formula $v_{1},v_{2}\in V$
\end_inset

 כך ש-
\begin_inset Formula $l\left(w\right)=\left\langle v_{1}\mid w\right\rangle =\left\langle v_{2}\mid w\right\rangle $
\end_inset

 לכל 
\begin_inset Formula $w\in V$
\end_inset

,
 מכאן שלכל 
\begin_inset Formula $w\in W$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
0=\left\langle v_{1}\mid w\right\rangle -\left\langle v_{2}\mid w\right\rangle =\left\langle v_{1}-v_{2}\mid w\right\rangle 
\]

\end_inset

ולכן 
\begin_inset Formula $v_{1}-v_{2}=0_{V}$
\end_inset

,
 כלומר 
\begin_inset Formula $v_{1}=v_{2}$
\end_inset

.
\end_layout

