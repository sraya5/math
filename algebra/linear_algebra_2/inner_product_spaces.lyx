\begin_deeper
\begin_layout Itemize
ההעתקה הצמודה של העתקה 
\begin_inset Formula $T:V\rightarrow W$
\end_inset

 היא ההעתקה 
\begin_inset Formula $T^{*}:W^{*}\rightarrow V^{*}$
\end_inset

 המוגדרת ע"י 
\begin_inset Formula $T^{*}\left(f\right)=f\circ T$
\end_inset

 לכל 
\begin_inset Formula $f\in W^{*}$
\end_inset

.
\begin_inset Newline newline
\end_inset

מעל ממ"פ כל 
\begin_inset Formula $v\in V$
\end_inset

 וכל 
\begin_inset Formula $w\in W$
\end_inset

 מגדירים פונקציות ע"י המכפלה הפנימית - 
\begin_inset Formula $l_{v}\left(\cdot\right):=\left\langle v\mid\cdot\right\rangle _{V}$
\end_inset

 ו-
\begin_inset Formula $l_{w}\left(\cdot\right):=\left\langle w\mid\cdot\right\rangle _{W}$
\end_inset

,
 וכל האיברים ב-
\begin_inset Formula $V^{*}$
\end_inset

 וב-
\begin_inset Formula $W^{*}$
\end_inset

 הם מצורה זו;
 מה ש-
\begin_inset Formula $T^{*}$
\end_inset

 עושה במקרה כזה הוא:
\begin_inset Formula 
\[
\left\langle T^{*}\left(w\right)\mid\cdot\right\rangle _{V}=T^{*}\left(\left\langle w\mid\cdot\right\rangle _{W}\right)=T^{*}\left(l_{w}\right)=l_{w}\circ T=\left\langle w\mid T\left(\cdot\right)\right\rangle _{W}=\overline{\left\langle T\left(\cdot\right)\mid w\right\rangle _{W}}
\]

\end_inset


\end_layout

\begin_layout Itemize
המטריצה הצמודה מוגדרת ע"י 
\begin_inset Formula $\left[A^{*}\right]_{ij}=\overline{\left[A^{t}\right]_{ij}}=\overline{\left[A\right]_{ji}}$
\end_inset

.
\end_layout

\begin_layout Itemize
הצמוד המרוכב של מספר 
\begin_inset Formula $x+iy=r\cdot\MKcis\left(\theta\right)$
\end_inset

 הוא 
\begin_inset Formula $x-iy=r\cdot\MKcis\left(-\theta\right)$
\end_inset

.
\end_layout

\end_deeper
