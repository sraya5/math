,
\begin_inset Formula 
\begin{align*}
\left\langle \left(T^{*}\circ S^{*}\right)\left(u\right)\mid v\right\rangle _{V} & =\left\langle T^{*}\left(S^{*}\left(u\right)\right)\mid v\right\rangle _{V}=\left\langle S^{*}\left(u\right)\mid T\left(v\right)\right\rangle _{W}\\
 & =\left\langle u\mid S\left(T\left(v\right)\right)\right\rangle _{U}=\left\langle u\mid\left(S\circ T\right)\left(v\right)\right\rangle _{U}
\end{align*}

