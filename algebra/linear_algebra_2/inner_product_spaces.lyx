\begin_layout Claim
יהי 
\begin_inset Formula $0_{V}\neq w\in V$
\end_inset

,
 לכל 
\begin_inset Formula $v\in V$
\end_inset

 קיים 
\begin_inset Formula $c\in\MKfield$
\end_inset

 יחיד כך שמתקיים 
\begin_inset Formula $\left(v-c\cdot w\right)\perp w$
\end_inset

,
 את אותו 
\begin_inset Formula $c$
\end_inset

 ניתן לחשב ע"י:
\begin_inset Formula 
\[
c=\frac{\left\langle w\mid v\right\rangle }{\left\langle w\mid w\right\rangle }
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 נשים לב:
 
\begin_inset Formula $v=\left(v-c\cdot w\right)+c\cdot w$
\end_inset

,
 כלומר 
\begin_inset Formula $c\cdot w$
\end_inset

 הוא הרכיב של 
\begin_inset Formula $v$
\end_inset

 בכיוון של 
\begin_inset Formula $w$
\end_inset

 ו-
\begin_inset Formula $v-c\cdot w$
\end_inset

 הוא הרכיב של 
\begin_inset Formula $v$
\end_inset

 בכיוון המאונך על המישור שפורשים שניהם.
\end_layout

\begin_layout Proof
לכל 
\begin_inset Formula $c\in\MKfield$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
0=\left\langle w\mid v-c\cdot w\right\rangle =\left\langle w\mid v\right\rangle -c\cdot\left\langle w\mid w\right\rangle \Longleftrightarrow c=\frac{\left\langle w\mid v\right\rangle }{\left\langle w\mid w\right\rangle }
\]

\end_inset


\end_layout

\begin_layout Definition

\bar under
פונקציית ההטלה האורתוגונלית
\bar default
 של וקטור 
\begin_inset Formula $0_{V}\neq w\in V$
\end_inset

 היא הפונקציה 
\begin_inset Formula $p_{w}:V\rightarrow V$
\end_inset

 המוגדרת ע"י (לכל 
\begin_inset Formula $v\in V$
\end_inset

):
\begin_inset Formula 
\[
p_{w}\left(v\right):=\frac{\left\langle w\mid v\right\rangle }{\left\langle w\mid w\right\rangle }\cdot w
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 זוהי אכן הטלה שכן לכל 
\begin_inset Formula $v\in V$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
p_{w}\left(p_{w}\left(v\right)\right) & =\frac{\left\langle w\mid p_{w}\left(v\right)\right\rangle }{\left\langle w\mid w\right\rangle }\cdot w=\frac{\left\langle \begin{array}{c|c}
w & \begin{alignedat}{1}\frac{\left\langle w\mid v\right\rangle }{\left\langle w\mid w\right\rangle }\cdot w\end{alignedat}
\end{array}\right\rangle }{\left\langle w\mid w\right\rangle }\cdot w\\
 & =\frac{\left\langle w\mid v\right\rangle }{\left\langle w\mid w\right\rangle }\cdot\frac{\left\langle w\mid w\right\rangle }{\left\langle w\mid w\right\rangle }\cdot w=\frac{\left\langle w\mid v\right\rangle }{\left\langle w\mid w\right\rangle }\cdot w=p_{w}\left(v\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection
נורמה ומרחק
\end_layout

\begin_layout Theorem

\series bold
משפט הקוסינוסים
\series default

\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 מתקיים:
\begin_inset Formula 
\[
\left\Vert v+w\right\Vert ^{2}=\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}+2\cdot\MKre\left\langle v\mid w\right\rangle 
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 בקובץ ההקדמה ראינו שעבור המכפלה הסקלרית מעל הממשיים מתקיים 
\begin_inset Formula $\left\langle v\mid w\right\rangle =\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert \cdot\cos\theta$
\end_inset

 כאשר 
\begin_inset Formula $\theta$
\end_inset

 היא הזווית שבין 
\begin_inset Formula $v$
\end_inset

 ל-
\begin_inset Formula $w$
\end_inset

.
\end_layout

\begin_layout Proof
לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\left\Vert v+w\right\Vert ^{2} & =\left(\sqrt{\left\langle v+w\mid v+w\right\rangle }\right)^{2}=\left\langle v+w\mid v+w\right\rangle \\
 & =\left\langle v\mid v+w\right\rangle +\left\langle w\mid v+w\right\rangle \\
 & =\left\langle v\mid v\right\rangle +{\color{red}\left\langle v\mid w\right\rangle +\overline{\left\langle v\mid w\right\rangle }}+\left\langle w\mid w\right\rangle \\
 & =\left(\sqrt{\left\langle v\mid v\right\rangle }\right)^{2}+{\color{red}2\cdot\MKre\left\langle v\mid w\right\rangle }+\left(\sqrt{\left\langle w\mid w\right\rangle }\right)^{2}\\
 & =\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}+2\cdot\MKre\left\langle v\mid w\right\rangle 
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset


\end_layout

\begin_layout Corollary

\series bold
משפט פיתגורס
\series default

\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 מתקיימים שני הפסוקים הבאים:
\end_layout

\begin_deeper
\begin_layout Itemize
אם 
\begin_inset Formula $v\perp w$
\end_inset

 אז 
\begin_inset Formula $\left\Vert v+w\right\Vert ^{2}=\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}$
\end_inset

.
\end_layout

\begin_layout Itemize
אם 
\begin_inset Formula $\MKfield=\MKreal$
\end_inset

 אז 
\begin_inset Formula $\left\Vert v+w\right\Vert ^{2}=\left\Vert v\right\Vert ^{2}+\left\Vert w\right\Vert ^{2}\Longleftrightarrow v\perp w$
\end_inset

.
\end_layout

\end_deeper
\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 למי שתהה לעצמו:
 המשפט והמסקנה האחרונים אינם מאפשרים להוכיח את משפט פיתגורס הגאומטרי ואת משפט הקוסינוסים הטריגונומטרי,
 הרי הגדרנו את הנורמה ע"פ משפט פיתגורס (
\begin_inset Formula $\left\Vert v\right\Vert :=\sqrt{\left\langle v\mid v\right\rangle }$
\end_inset

).
\end_layout

\begin_layout Corollary
יהי 
\begin_inset Formula $0_{V}\neq w\in V$
\end_inset

,
 לכל 
\begin_inset Formula $v\in V$
\end_inset

 מתקיים 
\begin_inset Formula $\left\Vert v\right\Vert ^{2}=\left\Vert v-p_{w}\left(v\right)\right\Vert ^{2}+\left\Vert p_{w}\left(v\right)\right\Vert ^{2}$
\end_inset

.
\end_layout

\begin_layout Theorem

\series bold
אי-שוויון קושי-שוורץ
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
ערך בוויקיפדיה:
 
\begin_inset CommandInset href
LatexCommand href
name "הרמן שוורץ"
target "https://he.wikipedia.org/wiki/%D7%94%D7%A8%D7%9E%D7%9F_%D7%A9%D7%95%D7%95%D7%A8%D7%A5"
literal "false"

\end_inset

.
\end_layout

\end_inset


\series default

\begin_inset Newline newline
\end_inset

לכל 
\begin_inset Formula $v,w\in V$
\end_inset

 מתקיים 
\begin_inset Formula $\left|\left\langle v\mid w\right\rangle \right|\leq\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert $
\end_inset

 ומתקיים שוויון אם"ם 
\begin_inset Formula $v$
\end_inset

 ו-
\begin_inset Formula $w$
\end_inset

 תלויים ליניארית.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 א"ש קושי-שוורץ הוא בעצם ההכללה של השוויון 
\begin_inset Formula $v\cdot w=\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert \cdot\cos\theta$
\end_inset

 ב-
\begin_inset Formula $\MKreal^{n}$
\end_inset

 (כאשר 
\begin_inset Formula $\theta$
\end_inset

 היא הזווית הקטנה בין 
\begin_inset Formula $v$
\end_inset

 ל-
\begin_inset Formula $w$
\end_inset

)
\begin_inset Foot
status collapsed

\begin_layout Plain Layout
וזאת מכיוון ש-
\begin_inset Formula $\left|\cos\theta\right|\leq1$
\end_inset

 ו-
\begin_inset Formula $\theta>\frac{\pi}{2}$
\end_inset

 (מה שגורר את 
\begin_inset Formula $\cos\theta<0$
\end_inset

) אם"ם 
\begin_inset Formula $v\cdot w<0$
\end_inset

.
\end_layout

\end_inset

,
 והוא מאפשר לנו להגדיר זווית בממ"פ כללי (לא עשינו זאת בכיתה):
\begin_inset Formula 
\[
\theta:=\arccos\left(\frac{\left\langle v\mid w\right\rangle }{\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert }\right)
\]

\end_inset


\end_layout

\begin_layout Proof
אם 
\begin_inset Formula $w=0_{V}$
\end_inset

 אז המשפט טריוויאלי,
 אחרת ממסקנה קיים 
\begin_inset Formula $c\in\MKfield$
\end_inset

 כך ש-
\begin_inset Formula $\left\Vert v\right\Vert ^{2}=\left\Vert v-c\cdot w\right\Vert ^{2}+\left\Vert c\cdot w\right\Vert ^{2}$
\end_inset

,
 
\begin_inset Formula 
\[
\Rightarrow\left\Vert c\cdot w\right\Vert ^{2}\leq\left\Vert v\right\Vert ^{2}
\]

\end_inset

נשים לב שמתקיים 
\begin_inset Formula $\left\Vert c\cdot w\right\Vert ^{2}=\left\Vert v\right\Vert ^{2}$
\end_inset

 אם"ם 
\begin_inset Formula $\left\Vert v-c\cdot w\right\Vert ^{2}=0$
\end_inset

 וזה קורה אם"ם 
\begin_inset Formula $v-c\cdot w=0_{V}$
\end_inset

,
 כלומר כאשר 
\begin_inset Formula $v$
\end_inset

 ו-
\begin_inset Formula $w$
\end_inset

 תלויים ליניארית.
\begin_inset Formula 
\begin{align*}
\left\Vert c\cdot w\right\Vert ^{2} & =\left|c\right|^{2}\cdot\left\Vert w\right\Vert ^{2}=\left|\frac{\left\langle w\mid v\right\rangle }{\left\langle w\mid w\right\rangle }\right|^{2}\cdot\left\Vert w\right\Vert ^{2}\\
 & =\left|\frac{\left\langle w\mid v\right\rangle }{\left\Vert w\right\Vert ^{2}}\right|^{2}\cdot\left\Vert w\right\Vert ^{2}=\frac{\left|\left\langle w\mid v\right\rangle \right|^{2}}{\left\Vert w\right\Vert ^{2}}
\end{align*}

\end_inset


\begin_inset Formula 
\[
\Rightarrow\frac{\left|\left\langle w\mid v\right\rangle \right|^{2}}{\left\Vert w\right\Vert ^{2}}\leq\left\Vert v\right\Vert ^{2}\Rightarrow\left|\left\langle w\mid v\right\rangle \right|^{2}\leq\left\Vert v\right\Vert ^{2}\cdot\left\Vert w\right\Vert ^{2}
\]

\end_inset


\begin_inset Formula 
\[
\Rightarrow\left|\left\langle v\mid w\right\rangle \right|=\left|\left\langle w\mid v\right\rangle \right|\leq\left\Vert v\right\Vert \cdot\left\Vert w\right\Vert 
\]

\end_inset


