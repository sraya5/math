 & =\sum_{i=1}^{k}\left\langle u_{i}\mid v\right\rangle \cdot u_{i}+\sum_{i=k+1}^{n}{\color{blue}0}\cdot u_{i}=\sum_{i=1}^{k}\left\langle u_{i}\mid{\color{red}v}\right\rangle \cdot u_{i}=\sum_{i=1}^{k}\left\langle u_{i}\mid w+{\color{red}w^{\perp}}\right\rangle \cdot u_{i}\\
