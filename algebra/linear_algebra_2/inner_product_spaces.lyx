\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "claim 1.17"

\end_inset

יהי 
\begin_inset Formula $W\subseteq V$
\end_inset

 תמ"ו,
 מתקיים 
\begin_inset Formula $V=W\oplus W^{\perp}$
\end_inset

.
\end_layout

\begin_layout Proof
ניקח בסיס של 
\begin_inset Formula $W$
\end_inset

,
 נרחיב אותו לבסיס של 
\begin_inset Formula $V$
\end_inset

 ונפעיל על הבסיס המורחב את אלגוריתם גרם-שמידט,
 אם כן קיבלנו סדרה אורתונורמלית 
\begin_inset Formula $\left(w_{1},w_{2},\ldots,w_{k};u_{k+1},u_{2},\ldots,u_{n}\right)$
\end_inset

 כך ש-
\begin_inset Formula $W=\MKspan\left(w_{1},w_{2},\ldots,w_{k}\right)$
\end_inset


\begin_inset Newline newline
\end_inset

ו-
\begin_inset Formula $V=\MKspan\left(w_{1},w_{2},\ldots,w_{k},u_{k+1},u_{2},\ldots,u_{n}\right)$
\end_inset

;
 נשים לב לכך שמהגדרה מתקיים
\begin_inset Newline newline
\end_inset


\begin_inset Formula $V=\MKspan\left(w_{1},w_{2},\ldots,w_{k}\right)\oplus\MKspan\left(u_{k+1},u_{2},\ldots,u_{n}\right)$
\end_inset

 ו-
\begin_inset Formula $\MKspan\left(w_{1},w_{2},\ldots,w_{k}\right)\perp\MKspan\left(u_{k+1},u_{2},\ldots,u_{n}\right)$
\end_inset


\begin_inset Newline newline
\end_inset

ומכאן ש-
\begin_inset Formula $\MKspan\left(u_{k+1},u_{2},\ldots,u_{n}\right)\subseteq W^{\perp}$
\end_inset

,
 מצד שני לכל 
\begin_inset Formula $v\in W^{\perp}$
\end_inset

 מתקיים (משפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 1.12"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

):
\begin_inset Formula 
\[
v=\sum_{i=1}^{k}\left\langle w_{i}\mid v\right\rangle \cdot w_{i}+\sum_{j=k+1}^{n}\left\langle u_{j}\mid v\right\rangle \cdot u_{j}=\sum_{j=k+1}^{n}\left\langle u_{j}\mid v\right\rangle \cdot u_{j}\in\MKspan\left(u_{k+1},u_{2},\ldots,u_{n}\right)
\]

\end_inset

ולכן 
\begin_inset Formula $\MKspan\left(u_{k+1},u_{2},\ldots,u_{n}\right)\supseteq W^{\perp}$
\end_inset

,
 כלומר 
\begin_inset Formula $\MKspan\left(u_{k+1},u_{2},\ldots,u_{n}\right)=W^{\perp}$
\end_inset


\begin_inset Newline newline
\end_inset

ו-
\begin_inset Formula $V=\MKspan\left(w_{1},w_{2},\ldots,w_{k}\right)\oplus\MKspan\left(u_{k+1},u_{2},\ldots,u_{n}\right)=W\oplus W^{\perp}$
\end_inset

.
\end_layout

\begin_layout Corollary
יהי 
\begin_inset Formula $W\subseteq V$
\end_inset

 תמ"ו,
 מתקיים 
\begin_inset Formula $\left(W^{\perp}\right)^{\perp}=W$
\end_inset

.
\end_layout

\begin_layout Theorem
יהי 
\begin_inset Formula $W\subseteq V$
\end_inset

 תמ"ו,
 בהינתן בסיס אורתוגונלי 
\begin_inset Formula $\left(w_{1},w_{2},\ldots,w_{k}\right)$
\end_inset

 של 
\begin_inset Formula $W$
\end_inset

 מתקיים (לכל 
\begin_inset Formula $v\in V$
\end_inset

):
\begin_inset Formula 
\[
p_{W}\left(v\right)=\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot w_{i}=\sum_{i=1}^{k}p_{w_{i}}\left(v\right)
\]

\end_inset


\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000
\begin_inset Formula $\clubsuit$
\end_inset

 אם 
\begin_inset Formula $\left(w_{1},w_{2},\ldots,w_{k}\right)$
\end_inset

 אורתונורמלי נקבל:
\begin_inset Formula 
\[
p_{W}\left(v\right)=\sum_{i=1}^{k}\left\langle w_{i}\mid v\right\rangle \cdot w_{i}
\]

\end_inset


\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula $v\in V$
\end_inset

 ויהי 
\begin_inset Formula $\left(u_{k+1},u_{k+2},\ldots,u_{n}\right)$
\end_inset

 בסיס אורתוגונלי של 
\begin_inset Formula $W^{\perp}$
\end_inset

,
 אם כן 
\begin_inset Formula $\left(w_{1},w_{2},\ldots,w_{k};u_{k+1},u_{2},\ldots,u_{n}\right)$
\end_inset

 הוא בסיס אורתוגונלי של 
\begin_inset Formula $V$
\end_inset

 ולכן מתקיים:
\begin_inset Formula 
\begin{align*}
p_{W}\left(v\right) & =p_{W}\left(\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot w_{i}+\sum_{j=k+1}^{n}\frac{\left\langle u_{j}\mid v\right\rangle }{\left\langle u_{j}\mid u_{j}\right\rangle }\cdot u_{j}\right)\\
 & =\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot p_{W}\left(w_{i}\right)+\sum_{j=k+1}^{n}\frac{\left\langle u_{j}\mid v\right\rangle }{\left\langle u_{j}\mid u_{j}\right\rangle }\cdot p_{W}\left(u_{j}\right)\\
 & =\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot w_{i}+\sum_{j=k+1}^{n}\frac{\left\langle u_{j}\mid v\right\rangle }{\left\langle u_{j}\mid u_{j}\right\rangle }\cdot0_{V}=\sum_{i=1}^{k}\frac{\left\langle w_{i}\mid v\right\rangle }{\left\langle w_{i}\mid w_{i}\right\rangle }\cdot w_{i}
\end{align*}

\end_inset


\end_layout

\begin_layout Theorem
יהי 
\begin_inset Formula $W\subseteq V$
\end_inset

 תמ"ו,
 לכל 
\begin_inset Formula $v\in V$
\end_inset

 מתקיים 
\begin_inset Formula $d\left(v,W\right)=\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula $v\in V$
\end_inset

,
 לכל 
\begin_inset Formula $w\in W$
\end_inset

 מתקיים:
\begin_inset Formula 
\begin{align*}
\left\Vert v-w\right\Vert ^{2} & =\left\Vert p_{W^{\perp}}\left(v\right)+p_{W}\left(v\right)-w\right\Vert ^{2}=\left\langle p_{W^{\perp}}\left(v\right)+p_{W}\left(v\right)-w\mid p_{W^{\perp}}\left(v\right)+p_{W}\left(v\right)-w\right\rangle \\
 & =\left\langle p_{W^{\perp}}\left(v\right)\mid p_{W^{\perp}}\left(v\right)\right\rangle +{\color{red}\left\langle p_{W^{\perp}}\left(v\right)\mid p_{W}\left(v\right)-w\right\rangle +\left\langle p_{W}\left(v\right)-w\mid p_{W^{\perp}}\left(v\right)\right\rangle }+\left\langle p_{W}\left(v\right)-w\mid p_{W}\left(v\right)-w\right\rangle \\
 & =\left\langle p_{W^{\perp}}\left(v\right)\mid p_{W^{\perp}}\left(v\right)\right\rangle +{\color{red}0}+\left\langle p_{W}\left(v\right)-w\mid p_{W}\left(v\right)-w\right\rangle \geq\left\langle p_{W^{\perp}}\left(v\right)\mid p_{W^{\perp}}\left(v\right)\right\rangle =\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert ^{2}
\end{align*}

\end_inset

כלומר לכל 
\begin_inset Formula $w\in W$
\end_inset

 מתקיים 
\begin_inset Formula $d\left(v,w\right)=\left\Vert v-w\right\Vert \geq\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

 ולכן 
\begin_inset Formula $d\left(v,W\right)=\inf\left\{ d\left(v,w\right)\mid w\in W\right\} \geq\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

,
 מצד שני 
\begin_inset Formula $d\left(v,p_{W}\left(v\right)\right)=\left\Vert v-p_{W}\left(v\right)\right\Vert =\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

 ומכאן ש-
\begin_inset Formula $d\left(v,W\right)=\inf\left\{ d\left(v,w\right)\mid w\in W\right\} =\left\Vert p_{W^{\perp}}\left(v\right)\right\Vert $
\end_inset

 (שהרי 
\begin_inset Formula $p_{W}\left(v\right)\in W$
\end_inset

).
\end_layout

