\begin_inset Formula
\begin{align*}
\left(gH\right)^{-1} & =\left\{ \left(gh\right)^{-1}\mid h\in H\right\} =\left\{ h^{-1}g^{-1}\mid h\in H\right\} =\left\{ h^{-1}\mid h\in H\right\} \cdot g^{-1}=Hg^{-1}\\
\left(Hg\right)^{-1} & =\left\{ \left(hg\right)^{-1}\mid h\in H\right\} =\left\{ g^{-1}h^{-1}\mid h\in H\right\} =g^{-1}\cdot\left\{ h^{-1}\mid h\in H\right\} =g^{-1}H
