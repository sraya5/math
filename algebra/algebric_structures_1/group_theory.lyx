\begin_inset Formula
\begin{align*}
a*b & =e*\left(a*b\right)=\left(c*b\right)*\left(a*b\right)=c*\left(b*\left(a*b\right)\right)\\
 & =c*\left(\left(b*a\right)*b\right)=c*\left(e*b\right)=c*b=e
\end{align*}




