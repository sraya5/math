\end_inset
,
\begin_inset Formula
\[
\Rightarrow\left(r\circ r\right)\left(v\right)=r\left(r\left(w+u\right)\right)=r\left(w-u\right)=r\left(w+\left(-u\right)\right)=w-\left(-u\right)=w+u=v=\MKid_{V}\left(v\right)
\]


\end_inset

\begin_inset Formula
$v$
