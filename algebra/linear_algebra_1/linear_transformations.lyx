\begin_inset Newline newline
\end_inset
מהגדרת המטריצה המייצגת ומהגדרת כפל מטריצה בווקטור נובע כי:
\begin_inset Formula
\begin{align*}
\left[T\right]_{\MKclc}^{\MKclb}\cdot\left[v\right]_{\MKclb} & =\sum_{i=1}^{n}a_{i}\cdot\left[T\left(v_{i}\right)\right]_{\MKclc}=\sum_{i=1}^{n}a_{i}\cdot\omega_{\MKclc}\left(T\left(v_{i}\right)\right)=\sum_{i=1}^{n}\omega_{\MKclc}\left(a_{i}\cdot T\left(v_{i}\right)\right)\\
 & =\sum_{i=1}^{n}\omega_{\MKclc}\left(T\left(a_{i}\cdot v_{i}\right)\right)=\omega_{\MKclc}\left(\sum_{i=1}^{n}T\left(a_{i}\cdot v_{i}\right)\right)\\
 & =\omega_{\MKclc}\left(T\left(\sum_{i=1}^{n}a_{i}\cdot v_{i}\right)\right)=\omega_{\MKclc}\left(T\left(v\right)\right)=\left[T\left(v\right)\right]_{\MKclc}
\end{align*}


\end_inset

\end_layout

