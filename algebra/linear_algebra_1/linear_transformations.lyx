{\color{purple}\left[\begin{array}{cc}
\cos\left(\alpha+\beta\right) & -\sin\left(\alpha+\beta\right)\\
\sin\left(\alpha+\beta\right) & \cos\left(\alpha+\beta\right)
\end{array}\right]}={\color{red}\left[\begin{array}{cc}
\cos\alpha & -\sin\alpha\\
\sin\alpha & \cos\alpha
\end{array}\right]}\cdot{\color{blue}\left[\begin{array}{cc}
