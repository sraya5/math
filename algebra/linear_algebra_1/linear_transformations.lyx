\end_inset
.
\end_layout

\begin_layout Itemize
\begin_inset Formula
$p\circ q=0=q\circ p$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Proof
יהי 
\begin_inset Formula
$v\in V$
\end_inset
 ויהיו 
\begin_inset Formula
$w\in W$
\end_inset
 ו-
\begin_inset Formula
$u\in U$
\end_inset
 אותם וקטורים יחידים המקיימים 
\begin_inset Formula
$v=w+u$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow\left(\MKid_{V}-p\right)\left(v\right) & =\MKid_{V}\left(v\right)-p\left(v\right)=v-w=u\\
\Rightarrow\left(p+q\right)\left(v\right) & =p\left(v\right)+q\left(v\right)=w+u=v\\
\Rightarrow\left(p\circ q\right)\left(v\right) & =p\left(q\left(v\right)\right)=p\left(u\right)=0_{V}\\
 & =q\left(w\right)=q\left(p\left(v\right)\right)=\left(q\circ p\right)\left(v\right)
\end{align*}


\end_inset

\begin_inset Formula
$v$
\end_inset
 הנ"ל היה שרירותי ולכן הנ"ל מתקיים לכל 
\begin_inset Formula
$v\in V$
