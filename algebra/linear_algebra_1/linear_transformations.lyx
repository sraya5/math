\end_inset
.
\begin_inset Newline newline
\end_inset
ראינו ש-
\begin_inset Formula
$T^{-1}\left(U\right)$
\end_inset
 הוא תמ"ו ולכן אם נוכיח ש-
\begin_inset Formula
$T^{-1}\left(S\right)=\left\{ v_{0}\right\} +T^{-1}\left(U\right)$
\end_inset
 נקבל את המבוקש.
\begin_inset Newline newline
\end_inset
יהי 
\begin_inset Formula
$v_{1}\in T^{-1}\left(S\right)$
\end_inset
, א"כ 
\begin_inset Formula
$T\left(v_{1}\right)\in S$
\end_inset
 ולכן 
\begin_inset Formula
$T\left(v_{1}-v_{0}\right)=T\left(v_{1}\right)-T\left(v_{0}\right)\in U$
\end_inset
 וממילא 
\begin_inset Formula
$v_{1}-v_{0}\in T^{-1}\left(U\right)$
\end_inset
 ו-
\begin_inset Formula
$v_{1}\in\left\{ v_{0}\right\} +T^{-1}\left(U\right)$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow T^{-1}\left(S\right)\subseteq\left\{ v_{0}\right\} +T^{-1}\left(U\right)
\]


\end_inset
יהי 
\begin_inset Formula
$v_{2}\in\left\{ v_{0}\right\} +T^{-1}\left(U\right)$
\end_inset
, א"כ 
\begin_inset Formula
$v_{2}-v_{0}\in T^{-1}\left(U\right)$
\end_inset
 ולכן 
\begin_inset Formula
$T\left(v_{2}\right)-T\left(v_{0}\right)=T\left(v_{2}-v_{0}\right)\in U$
\end_inset
 וממילא 
\begin_inset Formula
$T\left(v_{2}\right)\in S$
\end_inset
 ו-
\begin_inset Formula
$v_{2}\in T^{-1}\left(S\right)$
\end_inset
.
\begin_inset Formula
\begin{align*}
 & \Rightarrow T^{-1}\left(S\right)\supseteq\left\{ v_{0}\right\} +T^{-1}\left(U\right)\\
 & \Rightarrow T^{-1}\left(S\right)=\left\{ v_{0}\right\} +T^{-1}\left(U\right)
\end{align*}


\end_inset

