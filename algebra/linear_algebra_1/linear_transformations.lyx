\begin_layout Itemize
\begin_inset Formula
$\Rightarrow$
\end_inset

\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$p^{2}=p$
\end_inset
 ויהי 
\begin_inset Formula
$v'\in V$
\end_inset
, נסמן 
\begin_inset Formula
$w':=p\left(v'\right)$
\end_inset
 ו-
\begin_inset Formula
$u':=v'-w'$
\end_inset
 (מהגדרה 
\begin_inset Formula
$v'=w'+u'$
\end_inset
).
\begin_inset Formula
\begin{align*}
 & \Rightarrow p\left(w'\right)=p^{2}\left(v'\right)=p\left(v'\right)\\
 & \Rightarrow p\left(u'\right)=p\left(v'-w'\right)=p\left(v'\right)-p\left(w'\right)=0_{V}
\end{align*}


\end_inset

\begin_inset Formula
$v'$
\end_inset
