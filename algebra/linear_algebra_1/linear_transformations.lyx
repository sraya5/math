\begin_deeper
\begin_layout Itemize
\begin_inset Formula
$\Leftarrow$
\end_inset

\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$p$
\end_inset
 היא הטלה על תמ"ו 
\begin_inset Formula
$W\subseteq V$
\end_inset
