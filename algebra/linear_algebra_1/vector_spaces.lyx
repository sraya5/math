$W\subseteq V$
\end_inset
 תמ"ו ויהיו 
\begin_inset Formula
$v_{1},v_{2}\in V$
\end_inset
, מתקיים 
\begin_inset Formula
$\left\{ v_{1}\right\} +W=\left\{ v_{2}\right\} +W$
\end_inset
 אם"ם 
\begin_inset Formula
$v_{1}-v_{2}\in W$
\end_inset
.
\end_layout

\begin_layout Proof
את הגרירה מימין לשמאל כבר הוכחנו כחלק מההוכחה של הטענה הקודמת, נוכיח כעת את הכיוון ההפוך.
\begin_inset Newline newline
\end_inset
נניח ש-
\begin_inset Formula
$v_{1}-v_{2}\in W$
\end_inset
 ויהי 
\begin_inset Formula
$u\in\left\{ v_{1}\right\} +W$
\end_inset
, א"כ קיים 
\begin_inset Formula
$w\in W$
\end_inset
 כך ש-
\begin_inset Formula
$u=v_{1}+w$
\end_inset
, מההנחה נובע שעבור אותו 
\begin_inset Formula
$w$
\end_inset
 מתקיים 
\begin_inset Formula
$w':=v_{1}-v_{2}+w\in W$
\end_inset
 וממילא גם 
\begin_inset Formula
$u=v_{1}+w=v_{2}+w'\in\left\{ v_{2}\right\} +W$
\end_inset
.
\end_layout

