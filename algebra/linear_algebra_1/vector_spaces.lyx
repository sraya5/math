\begin_inset CommandInset label
LatexCommand label
name "claim 4.7"
\end_inset
תהא 
\begin_inset Formula
$S\subseteq V$
\end_inset
 ישריה ויהיו 
\begin_inset Formula
$W\subseteq V$
\end_inset
 ו-
\begin_inset Formula
$v\in V$
\end_inset
 כך ש-
\begin_inset Formula
$S=\left\{ v\right\} +W$
\end_inset
, לכל 
\begin_inset Formula
$u\in S$
\end_inset
 מתקיים 
\begin_inset Formula
$S=\left\{ u\right\} +W$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$u\in S$
\end_inset
 ויהי 
\begin_inset Formula
$w\in W$
\end_inset
 כך ש-
\begin_inset Formula
$u=v+w$
\end_inset
, מכאן ש-
\begin_inset Formula
$u-v=w$
\end_inset
 וע"פ הטענה הקודמת (
\begin_inset CommandInset ref
LatexCommand ref
reference "claim 4.6"
plural false
caps false
noprefix false
\end_inset
) מתקיים 
\begin_inset Formula
$S=\left\{ v\right\} +W=\left\{ u\right\} +W$
\end_inset
.
\end_layout

