\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מה הקשר של מערכות משוואות ליניאריות לגאומטריה? פשוט מאד - הן מתארות ישריות במרחב: כבר בתיכון ראינו שכל ישר במישור ניתן לתיאור באמצעות משוואה מהצורה 
\begin_inset Formula
$ax+by=c$
\end_inset
, וכל מישור במרחב התלת-ממדי מיוצג ע"י משוואה מהצורה 
\begin_inset Formula
$ax+by+cz=d$
\end_inset
. א"כ אוסף הפתרונות של ממ"ל הוא החיתוך של כל הישריות המתאימות שהוא בעצמו ישריה, ההבנה הזו נותנת לנו נקודת מבט חדשה על משוואות ליניאריות, כך למשל אם שתי משוואות ליניאריות מתארות ישריות שמרחב הכיוונים שלהן זהה אז מתקיים אחד מן השניים: או שהמשוואות זהות או שאין למערכת פתרון מפני שהחיתוך של ישריות מקבילות הוא ריק.
\begin_inset Newline newline
\end_inset
בעצם הדרך היחידה שבה אוסף הפתרונות יהיה ריק היא שתהיינה שתי קבוצות של ישריות שהחיתוכים של כל אחת מהן בנפרד הם ישריות מקבילות, וזה קורה כאשר יש 
\series bold
תלות ליניארית
\series default
 בין המשוואות השונות כווקטורים ב-
\begin_inset Formula
$\MKfield^{m}$
\end_inset
 (אנחנו לא כוללים כאן את עמודת המקדמים החופשיים), כלומר השורות של מטריצת המערכת תלויות לינארית - ניתן לבטא אחת מהן באמצעות האחרות ואז היא "מסכימה" עם האחרות על מרחב הכיוונים של הישרייה אך המקדם החופשי והיחסים בינו למקדמים האחרים הם שקובעים לאן נזיז את מרחב הכיוונים כדי לקבל את הישרייה וכבר ראינו שישריות בעלות מרחב כיוונים זהה אין זהות או זרות.
\end_layout

\begin_layout Definition
מערכת משוואות ליניאריות תקרא 
\bar under
הומוגנית
\bar default
 אם כל המקדמים החופשיים שלה הם אפסים.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 הסיבה לעניין במערכת הומוגנית היא שלמערכת כזו יש תמיד פתרון: אם נציב בכל נעלם את 
\begin_inset Formula
$0$
\end_inset
 נקבל פתרון, כלומר וקטור האפס של 
\begin_inset Formula
$\MKfield^{n}$
\end_inset
 הוא פתרון; ניתן להסיק מכאן שבמקרה כזה אוסף הפתרונות של ממ"ל הומוגנית הוא ישרייה המכילה את וקטור האפס ומכאן שהוא תמ"ו של 
\begin_inset Formula
$\MKfield^{n}$
\end_inset
.
\end_layout

\begin_layout Standard
\begin_inset Newpage newpage
\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כעת נרצה לעבור ממטריצה שממנה קשה לראות את הפתרונות למטריצה שתקל על המלאכה, אך עלינו לעשות זאת בצורה שלא תשנה את אוסף הפתרונות.
\end_layout

