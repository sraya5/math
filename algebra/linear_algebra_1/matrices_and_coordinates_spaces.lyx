\begin_layout Proof
ראינו בקובץ ההגדרות שלכל 
\begin_inset Formula
$x\in\MKfield^{n}$
\end_inset
 הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$A\cdot x$
\end_inset
 היא (לכל 
\begin_inset Formula
$m\geq i\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\sum_{j=1}^{n}a_{ij}\cdot x_{j}
\]


\end_inset

\end_layout

\begin_deeper
\begin_layout Itemize
מנוסחה זו נובע שהקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$A\cdot\left(x+y\right)$
\end_inset
 היא (לכל 
\begin_inset Formula
$m\geq i\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\sum_{j=1}^{n}a_{ij}\cdot\left(x_{j}+y_{j}\right)=\sum_{j=1}^{n}a_{ij}\cdot x_{j}+\sum_{j=1}^{n}a_{ij}\cdot y_{j}
\]


\end_inset
נשים לב לכך שע"פ הנוסחה הנ"ל האגף הימני הוא הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$A\cdot x+A\cdot y$
\end_inset
 ולכן מתקיים 
\begin_inset Formula
$A\cdot\left(x+y\right)=A\cdot x+A\cdot y$
\end_inset
.
\end_layout

\begin_layout Itemize
מנוסחה זו נובע שהקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$\left(A+B\right)\cdot x$
\end_inset
 היא (לכל 
\begin_inset Formula
$m\geq i\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\sum_{j=1}^{n}\left(a_{ij}+b_{ij}\right)\cdot x_{j}=\sum_{j=1}^{n}a_{ij}\cdot x_{j}+\sum_{j=1}^{n}b_{ij}\cdot x_{j}
\]


\end_inset
נשים לב לכך שע"פ הנוסחה הנ"ל האגף הימני הוא הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$A\cdot x+B\cdot x$
\end_inset
 ולכן מתקיים 
\begin_inset Formula
$\left(A+B\right)\cdot x=A\cdot x+B\cdot x$
\end_inset
.
\end_layout

\begin_layout Itemize
מנוסחה זו נובע שהקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$A\cdot\left(c\cdot x\right)$
\end_inset
 היא (לכל 
\begin_inset Formula
$m\geq i\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\sum_{j=1}^{n}a_{ij}\cdot\left(c\cdot x_{j}\right)=\sum_{j=1}^{n}\left(c\cdot a_{ij}\right)\cdot x_{j}=c\cdot\sum_{j=1}^{n}a_{ij}\cdot x_{j}
\]


\end_inset
נשים לב לכך שע"פ הנוסחה הנ"ל האגף האמצעי הוא הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$\left(c\cdot A\right)\cdot x$
\end_inset
 והאגף הימני הוא הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$c\cdot\left(A\cdot x\right)$
\end_inset
 ולכן מתקיים 
\begin_inset Formula
$A\cdot\left(c\cdot x\right)=\left(c\cdot A\right)\cdot x=c\cdot\left(A\cdot x\right)$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Corollary
תהא 
\begin_inset Formula
$A\in M_{m\times n}\left(\MKfield\right)$
\end_inset
, לכל 
\begin_inset Formula
$v_{1},v_{2},\ldots,v_{r}\in\MKfield^{n}$
\end_inset
 ולכל 
\begin_inset Formula
$a_{1},a_{2},\ldots,a_{n}\in\MKfield$
\end_inset
 מתקיים:
\begin_inset Formula
\[
T_{A}\left(\sum_{i=1}^{r}a_{i}\cdot v_{i}\right)=A\cdot\left(\sum_{i=1}^{r}a_{i}\cdot v_{i}\right)=\sum_{i=1}^{r}a_{i}\cdot A\cdot v_{i}=\sum_{i=1}^{r}a_{i}\cdot T_{A}\left(v_{i}\right)
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 בפרט לכל 
\begin_inset Formula
