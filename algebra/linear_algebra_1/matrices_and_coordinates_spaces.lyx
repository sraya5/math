\end_deeper

\begin_layout Definition
\series bold
כפל מטריצה בווקטור
\series default

\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$x\in\MKfield^{n}$
\end_inset
 ו-
\begin_inset Formula
