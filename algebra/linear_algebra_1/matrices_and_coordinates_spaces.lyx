LatexCommand ref
reference "corollary 2.3"
plural false
caps false
noprefix false
nolink false
\end_inset
) נובע שמתקיים:
\begin_inset Formula
\[
T_{P}\circ T_{Q}=T_{P\cdot Q}=T_{I_{n}}=\MKid=T_{I_{n}}=T_{Q\cdot P}=T_{Q}\circ T_{P}
\]


\end_inset
כלומר 
\begin_inset Formula
$T_{Q}$
\end_inset
 היא ההופכית של 
\begin_inset Formula
$T_{P}$
\end_inset
 ובפרט 
\begin_inset Formula
$T_{P}$
\end_inset
 הפיכה.
\end_layout

\begin_layout Corollary
תהא 
\begin_inset Formula
$P\in M_{n}\left(\MKfield\right)$
\end_inset
 מטריצה הפיכה, קיימת 
\begin_inset Formula
$Q\in M_{n}\left(\MKfield\right)$
\end_inset
 יחידה כך ש-
\begin_inset Formula
$P\cdot Q=I_{n}=Q\cdot P$
\end_inset
.
\end_layout

\begin_layout Proof
בהוכחת הטענה הקודמת (
\begin_inset CommandInset ref
LatexCommand ref
reference "corollary 2.4"
plural false
caps false
noprefix false
nolink false
\end_inset
) ראינו שלכל מטריצה 
\begin_inset Formula
$Q\in M_{n}\left(\MKfield\right)$
\end_inset
 שהיא הופכית של 
\begin_inset Formula
$P$
\end_inset
 ההעתקה 
\begin_inset Formula
$T_{Q}$
\end_inset
 היא הופכית של 
\begin_inset Formula
$T_{P}$
\end_inset
, אך מכיוון שהפונקציה ההופכית היא תמיד יחידה נובע מזה וממסקנה 
\begin_inset CommandInset ref
