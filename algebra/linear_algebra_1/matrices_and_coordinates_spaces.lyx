\begin_inset Foot
status collapsed
\begin_layout Plain Layout
כפל מטריצה בווקטור מוגדר אך ורק כאשר מספר השורות בווקטור שווה למספר העמודות במטריצה.
\end_layout

\end_inset
.
\begin_inset Newline newline
\end_inset
נסמן ב-
\begin_inset Formula
$c_{j}$
\end_inset
 את העמודה ה-
\begin_inset Formula
$j$
\end_inset
 של 
\begin_inset Formula
$A$
\end_inset
, כלומר 
\begin_inset Formula
$A=:\left[\begin{array}{c|c|c|c}
| & | & | & |\\
c_{1} & c_{2} & \cdots & c_{n}\\
| & | & | & |
\end{array}\right]$

\end_inset
 (נחלק את 
\begin_inset Formula
$A$
\end_inset
 לעמודות ונסמן את העמודה הראשונה ב-
\begin_inset Formula
$c_{1}$
\end_inset
, את השנייה ב-
\begin_inset Formula
$c_{2}$
\end_inset
 וכן הלאה), ונגדיר את הכפל של המטריצה 
\begin_inset Formula
$A$
\end_inset
 בווקטור 
\begin_inset Formula
$x$
\end_inset
 ע"י:
\begin_inset Formula
\[
A\cdot x:=x_{1}\cdot c_{1}+x_{2}\cdot c_{2}+...+x_{n}\cdot c_{n}
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 נשים לב: הכפל באגף שמאל הוא זה שאנו מגדירים ואילו החיבור והכפל באגף שמאל הם החיבור הווקטורי והכפל בסקלר של 
\begin_inset Formula
$\MKfield^{m}$
\end_inset
 - כלומר התוצאה של כפל מטריצה בווקטור היא וקטור שמספר איבריו כמספר השורות במטריצה; אני נוטה להאמין שזוהי הגדרה מבלבלת למדי כאשר נתקלים בה לראשונה ולכן אביא כאן דוגמה לחישוב של כפל מטריצה בווקטור.
\end_layout

\begin_layout Example
יהיו 
\begin_inset Formula
$A\in M_{3\times2}\left(\MKreal\right)$
\end_inset
 ו-
\begin_inset Formula
$v\in\MKreal^{2}$
\end_inset
 המוגדרים ע"י:
\begin_inset Formula
\[
{\color{red}A:=\left[\begin{array}{cc}
1 & 2\\
0 & 3\\
4 & 0
\end{array}\right]},\ {\color{blue}v:=\begin{bmatrix}-2\\
3
\end{bmatrix}}
\]


\end_inset

\begin_inset Formula
\begin{align*}
\Rightarrow{\color{red}A}\cdot{\color{blue}v} & ={\color{red}\left[\begin{array}{cc}
1 & 2\\
0 & 3\\
4 & 0
\end{array}\right]}\cdot{\color{blue}\begin{bmatrix}-2\\
3
\end{bmatrix}}={\color{blue}-2}\cdot{\color{red}\begin{bmatrix}1\\
0\\
4
\end{bmatrix}}+{\color{blue}3}\cdot{\color{red}\begin{bmatrix}2\\
3\\
0
\end{bmatrix}}\\
 & =\begin{bmatrix}{\color{blue}-2}\cdot{\color{red}1}\\
{\color{blue}-2}\cdot{\color{red}0}\\
{\color{blue}-2}\cdot{\color{red}4}
\end{bmatrix}+\begin{bmatrix}{\color{blue}3}\cdot{\color{red}2}\\
{\color{blue}3}\cdot{\color{red}3}\\
{\color{blue}3}\cdot{\color{red}0}
\end{bmatrix}=\begin{bmatrix}{\color{blue}-2}\cdot{\color{red}1}+{\color{blue}3}\cdot{\color{red}2}\\
{\color{blue}-2}\cdot{\color{red}0}+{\color{blue}3}\cdot{\color{red}3}\\
{\color{blue}-2}\cdot{\color{red}4}+{\color{blue}3}\cdot{\color{red}0}
\end{bmatrix}=\begin{bmatrix}4\\
9\\
-8
\end{bmatrix}
\end{align*}


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ניתן להבין מן הדוגמה שניתן לפשט את התהליך: 
\begin_inset Formula
${\color{red}\left[\begin{array}{cc}
1 & 2\\
0 & 3\\
4 & 0
\end{array}\right]}\cdot{\color{blue}\begin{bmatrix}-2\\
3
\end{bmatrix}}=\begin{bmatrix}{\color{blue}-2}\cdot{\color{red}1}+{\color{blue}3}\cdot{\color{red}2}\\
{\color{blue}-2}\cdot{\color{red}0}+{\color{blue}3}\cdot{\color{red}3}\\
{\color{blue}-2}\cdot{\color{red}4}+{\color{blue}3}\cdot{\color{red}0}
\end{bmatrix}=\begin{bmatrix}4\\
9\\
-8
\end{bmatrix}$

\end_inset
, כלומר הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של הווקטור 
\begin_inset Formula
$A\cdot x$
\end_inset
 היא:
\begin_inset Formula
\[
\sum_{j=1}^{n}a_{ij}\cdot x_{j}
\]


\end_inset
