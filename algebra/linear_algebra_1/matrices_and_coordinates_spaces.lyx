\begin_layout Theorem
\series bold
תכונות של כפל מטריצה בווקטור
\series default

\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$A,B\in M_{m\times n}\left(\MKfield\right)$
\end_inset
, 
\begin_inset Formula
$x,y\in\MKfield^{n}$
\end_inset
 ו-
\begin_inset Formula
$c\in\MKfield$
\end_inset
; מתקיימים שלושת הפסוקים הבאים:
\end_layout

\begin_deeper
\begin_layout Itemize
פילוג (דיסטריבוטיביות) ביחס לחיבור וקטורי - 
\begin_inset Formula
$T_{A}\left(x+y\right)=A\cdot\left(x+y\right)=A\cdot x+A\cdot y=T_{A}\left(x\right)+T_{A}\left(y\right)$
\end_inset
.
\end_layout

\begin_layout Itemize
פילוג (דיסטריבוטיביות) ביחס לחיבור מטריצות - 
\begin_inset Formula
$T_{A+B}\left(x\right)=\left(A+B\right)\cdot x=A\cdot x+B\cdot x=T_{A}\left(x\right)+T_{B}\left(x\right)$
\end_inset
.
\end_layout

\begin_layout Itemize
קיבוץ וחילוף ביחס לכפל בסקלר
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
לא כתבנו את הביטוי 
\begin_inset Formula
$\left(A\cdot c\right)\cdot x$
\end_inset
 מפני שהכפל בסקלר מוגדר משמאל בלבד.
\end_layout

\end_inset
 - 
\begin_inset Formula
$T_{A}\left(c\cdot x\right)=A\cdot\left(c\cdot x\right)=\left(c\cdot A\right)\cdot x=c\cdot\left(A\cdot x\right)=c\cdot T_{A}\left(x\right)$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 שתי התכונות הללו אומרות שכפל מטריצה בווקטור 
\series bold
שומר על המבנה
\series default
 של 
\begin_inset Formula
$\MKfield^{n}$
\end_inset
 כמרחב קואורדינטות עם פעולות החיבור הווקטורי והכפל בסקלר, מכאן שכפל מטריצה בווקטור מעתיק תתי-מרחבים של 
\begin_inset Formula
$\MKfield^{n}$
\end_inset
 לתתי-מרחבים של 
\begin_inset Formula
$\MKfield^{m}$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 בגלל התכונה השנייה לא נטרח לכתוב סוגריים בביטויים כגון 
\begin_inset Formula
$c\cdot A\cdot x$
\end_inset
 או 
\begin_inset Formula
$A\cdot c\cdot x$
\end_inset
.
