\begin_layout Theorem
\series bold
תכונות של כפל מטריצות
\series default

\begin_inset Newline newline
\end_inset
תהיינה 
\begin_inset Formula
$A,A_{0}\in M_{m\times n}\left(\MKfield\right)$
\end_inset
, 
\begin_inset Formula
$B,B_{0}\in M_{l\times m}\left(\MKfield\right)$
\end_inset
 ו-
\begin_inset Formula
$C\in M_{k\times l}\left(\MKfield\right)$
\end_inset
 ו-
\begin_inset Formula
$x\in\MKfield$
\end_inset
, מתקיים:
\end_layout

\begin_deeper
\begin_layout Itemize
קיבוץ (אסוציאטיביות) - 
\begin_inset Formula
$\left(C\cdot B\right)\cdot A=C\cdot\left(B\cdot A\right)$
\end_inset
.
\end_layout

\begin_layout Itemize
פילוג (דיסטריבוטיביות) ביחס לחיבור מטריצות - 
\begin_inset Formula
$B\cdot\left(A+A_{0}\right)=B\cdot A+B\cdot A_{0}$
\end_inset
 ו-
\begin_inset Formula
$\left(B+B_{0}\right)\cdot A=B\cdot A+B_{0}\cdot A$
\end_inset
.
\end_layout

\begin_layout Itemize
קיבוץ וחילוף ביחס לכפל בסקלר - 
\begin_inset Formula
$B\cdot\left(x\cdot A\right)=\left(x\cdot B\right)\cdot A=x\cdot\left(B\cdot A\right)$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 בגלל התכונה הראשונה לא נטרח לכתוב סוגריים בביטוי כגון 
\begin_inset Formula
$C\cdot B\cdot A$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מכיוון שראינו את השקילות בין חיבור/כפל מטריצות לחיבור/הרכבת הפונקציות המוגדרות על ידן נוכל לנסח את המשפט בשפה של פונקציות:
\end_layout

\begin_deeper
\begin_layout Itemize
קיבוץ (אסוציאטיביות) - בתכונה זו הכיוון הוא הפוך: אנחנו יודעים שכפל מטריצות מקיים חוק הקיבוץ מפני שהוא שקול להרכבת פונקציות וכל הרכבת פונקציות מקיימת קיבוץ.
\end_layout

\begin_layout Itemize
פילוג (דיסטריבוטיביות) ביחס לחיבור פונקציות - 
\begin_inset Formula
$T_{A}\circ\left(T_{B}+T_{C}\right)=T_{A}\circ T_{B}+T_{A}\circ T_{C}$
\end_inset
.
\end_layout

\begin_layout Itemize
קיבוץ וחילוף ביחס לכפל בסקלר - 
\begin_inset Formula
$T_{A}\circ\left(x\cdot T_{B}\right)=\left(x\cdot T_{A}\right)\circ T_{B}=x\cdot\left(T_{A}\circ T_{B}\right)$
\end_inset
.
\end_layout

\end_deeper

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כפל מטריצות אינו מקיים חילוף, לדוגמה:
\begin_inset Formula
\[
\left[\begin{array}{cc}
1 & 5\\
2 & 1
\end{array}\right]\cdot\left[\begin{array}{cc}
1 & -3\\
0 & 4
\end{array}\right]=\left[\begin{array}{cc}
1 & 17\\
2 & -2
\end{array}\right]\neq\left[\begin{array}{cc}
-5 & 2\\
8 & 4
\end{array}\right]=\left[\begin{array}{cc}
1 & -3\\
0 & 4
\end{array}\right]\cdot\left[\begin{array}{cc}
1 & 5\\
2 & 1
\end{array}\right]
\]


\end_inset

\end_layout

\begin_layout Standard
