\begin_layout Claim
לכל 
\begin_inset Formula
${\color{green}A}\in M_{m\times n}$
\end_inset
 מתקיים 
\begin_inset Formula
${\color{red}I_{m}}\cdot{\color{green}A}={\color{green}A}={\color{green}A}\cdot{\color{red}{\color{blue}I_{n}}}$
\end_inset
.
\end_layout

\begin_layout Proof
לכל 
\begin_inset Formula
$m\geq i\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
 מתקיים:
\begin_inset Formula
\begin{align*}
\left[{\color{red}I_{m}}\cdot{\color{green}A}\right]_{ij} & =\sum_{k=1}^{m}{\color{blue}\left[I_{m}\right]_{ik}}\cdot{\color{green}\left[A\right]_{kj}}=\sum_{k=1}^{m}{\color{red}\delta_{ik}}\cdot{\color{green}\left[A\right]_{kj}}\\
 & =\sum_{k=1}^{i-1}{\color{red}0}\cdot{\color{green}\left[A\right]_{kj}}+{\color{red}1}\cdot{\color{green}\left[A\right]_{kj}}+\sum_{k=i+1}^{m}{\color{red}0}\cdot{\color{green}\left[A\right]_{kj}}={\color{green}\left[A\right]_{kj}}\\
\left[{\color{green}A}\cdot{\color{red}{\color{blue}I_{n}}}\right]_{ij} & =\sum_{k=1}^{n}{\color{green}\left[A\right]_{ik}}\cdot{\color{blue}\left[I_{n}\right]_{kj}}=\sum_{k=1}^{m}{\color{green}\left[A\right]_{ik}}\cdot{\color{blue}\delta_{kj}}\\
 & =\sum_{k=1}^{j-1}{\color{green}\left[A\right]_{ik}}\cdot{\color{blue}0}+{\color{green}\left[A\right]_{ik}}\cdot{\color{blue}1}+\sum_{k=j+1}^{n}{\color{green}\left[A\right]_{ik}}\cdot{\color{blue}0}=\left[{\color{green}A}\right]_{ij}
\end{align*}


\end_inset
ומכאן ש-
\begin_inset Formula
${\color{red}I_{m}}\cdot{\color{green}A}={\color{green}A}={\color{green}A}\cdot{\color{red}{\color{blue}I_{n}}}$
\end_inset
.
\end_layout

\begin_layout Corollary
\begin_inset CommandInset label
LatexCommand label
name "corollary 2.3"
\end_inset
לכל 
\begin_inset Formula
$v\in\MKfield^{n}$
\end_inset
 מתקיים 
\begin_inset Formula
$T_{I_{n}}\left(v\right)=I_{n}\cdot v=v=\MKid\left(v\right)$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 מסקנה זו היא הסיבה לכך שמטריצת היחידה נקראת גם מטריצת הזהות.
\end_layout

\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "corollary 2.4"
\end_inset
תהא 
\begin_inset Formula
$P\in M_{n}\left(\MKfield\right)$
\end_inset
 מטריצה הפיכה, גם 
\begin_inset Formula
$T_{P}$
\end_inset
 הפיכה.
\end_layout

\begin_layout Proof
תהא 
\begin_inset Formula
$Q\in M_{n}\left(\MKfield\right)$
\end_inset
 כך ש-
\begin_inset Formula
$P\cdot Q=I_{n}=Q\cdot P$
\end_inset
, ממשפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 1.8"
plural false
caps false
noprefix false
nolink false
\end_inset
 ומהמסקנה האחרונה (
