\begin_layout Theorem
\begin_inset CommandInset label
LatexCommand label
name "theorem 1.8"
\end_inset
תהיינה 
\begin_inset Formula
$A\in M_{m\times n}\left(\MKfield\right)$
\end_inset
 ו-
\begin_inset Formula
$B\in M_{l\times m}\left(\MKfield\right)$
\end_inset
, לכל 
\begin_inset Formula
$x\in\MKfield^{n}$
\end_inset
 מתקיים 
\begin_inset Formula
$T_{B}\left(T_{A}\left(x\right)\right)=B\cdot\left(A\cdot x\right)=\left(B\cdot A\right)\cdot x=T_{B\cdot A}\left(x\right)$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר כפל מטריצות שקול להרכבת ההעתקות המוגדרות על ידן - מתקיים 
\begin_inset Formula
$T_{B}\circ T_{A}=T_{B\cdot A}$
\end_inset
.
\end_layout

\begin_layout Proof
יהי 
\begin_inset Formula
$x\in\MKfield^{n}$
\end_inset
, הקואורדינטה ה-
\begin_inset Formula
$k$
\end_inset
 של 
\begin_inset Formula
$A\cdot x$
\end_inset
 היא (לכל 
\begin_inset Formula
$m\geq k\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\sum_{j=1}^{n}\left[A\right]_{kj}\cdot x_{j}
\]


\end_inset
ומכאן שהקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של 
\begin_inset Formula
$B\cdot\left(A\cdot x\right)$
\end_inset
 היא (לכל 
\begin_inset Formula
$l\geq i\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\sum_{k=1}^{m}\left[B\right]_{ik}\cdot\left(\sum_{j=1}^{n}\left[A\right]_{kj}\cdot x_{j}\right)=\sum_{k=1}^{m}\left(\sum_{j=1}^{n}\left[B\right]_{ik}\cdot\left[A\right]_{kj}\cdot x_{j}\right)=\sum_{j=1}^{n}\left(\sum_{k=1}^{m}\left[B\right]_{ik}\cdot\left[A\right]_{kj}\cdot x_{j}\right)=\sum_{j=1}^{n}\left(\sum_{k=1}^{m}\left[B\right]_{ik}\cdot\left[A\right]_{kj}\right)\cdot x_{j}
\]


\end_inset
בקובץ ההגדרות ראינו שמתקיים (לכל 
\begin_inset Formula
$l\geq i\in\MKnatural$
\end_inset
 ולכל 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\left[B\cdot A\right]_{ij}=\sum_{k=1}^{m}\left[B\right]_{ik}\cdot\left[A\right]_{kj}
\]


\end_inset
ומכאן שמתקיים (לכל 
\begin_inset Formula
$l\geq i\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
\sum_{k=1}^{m}\left[B\right]_{ik}\cdot\left(\sum_{j=1}^{n}\left[A\right]_{kj}\cdot x_{j}\right)=\sum_{j=1}^{n}\left[B\cdot A\right]_{ij}\cdot x_{j}
\]


\end_inset
כלומר הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של 
\begin_inset Formula
$B\cdot\left(A\cdot x\right)$
\end_inset
 היא בדיוק הקואורדינטה ה-
\begin_inset Formula
$i$
\end_inset
 של 
\begin_inset Formula
$\left(B\cdot A\right)\cdot x$
\end_inset
 (לכל 
\begin_inset Formula
$l\geq i\in\MKnatural$
\end_inset
) ולכן מתקיים 
\begin_inset Formula
$B\cdot\left(A\cdot x\right)=\left(B\cdot A\right)\cdot x$
\end_inset
.
