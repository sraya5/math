\begin_layout Proof
נניח שהסדרה 
\begin_inset Formula
$\left(v_{1},v_{2},\ldots,v_{n}\right)$
\end_inset
 תלויה ליניארית ובהג"כ נניח ש-
\begin_inset Formula
$v_{n}$
\end_inset
 ניתן להצגה כצר"ל של שאר הווקטורים בסדרה.
\begin_inset Newline newline
\end_inset
יהיו 
\begin_inset Formula
$a_{1},a_{2},\ldots,a_{n-1}\in\MKfield$
\end_inset
 כך שמתקיים 
\begin_inset Formula
$v_{n}=\sum_{i=1}^{n-1}a_{i}\cdot v_{i}$
\end_inset
, מהתכונה השנייה של פונקציות נפח נובע כי:
\begin_inset Formula
\begin{align*}
D\left(v_{1},v_{2},\ldots,v_{n}\right) & =D\left(v_{1},v_{2},\ldots,v_{n-1},\sum_{i=1}^{{\color{red}n-1}}a_{i}\cdot v_{i}\right)=D\left(v_{1},v_{2},\ldots,v_{n-1},\sum_{i=1}^{{\color{red}n-2}}a_{i}\cdot v_{i}\right)\\
 & =D\left(v_{1},v_{2},\ldots,v_{n-1},\sum_{i=1}^{{\color{red}n-3}}a_{i}\cdot v_{i}\right)=\ldots=D\left(v_{1},v_{2},\ldots,v_{n-1},0_{V}+a_{{\color{red}1}}\cdot v_{{\color{red}1}}\right)=D\left(v_{1},v_{2},\ldots,v_{n-1},0_{V}\right)
\end{align*}


\end_inset
ולכן מהטענה הקודמת (
\begin_inset CommandInset ref
LatexCommand ref
reference "claim 1.1"
plural false
caps false
noprefix false
nolink false
\end_inset
) נובע ש-
\begin_inset Formula
$D\left(v_{1},v_{2},\ldots,v_{n}\right)=0$
\end_inset
.
\end_layout

\begin_layout Claim
\begin_inset CommandInset label
LatexCommand label
name "claim 1.3"
\end_inset
יהיו 
\begin_inset Formula
$n\geq i,j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$i<j$
\end_inset
, מתקיים:
\begin_inset Formula
\[
D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{blue}v_{j}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{red}v_{i}}},v_{j+1},\ldots,v_{n}\right)=-D\left(v_{1},v_{2},\ldots,v_{n}\right)
\]


\end_inset

\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר החלפה של שני וקטורים זה בזה משנה את הסימן של נפח ה"מקבילון", הטענה הזו אינטואיטיבית למדי: החלפה של שני וקטורים שקולה לשיקוף סביב ציר הסימטרייה שלהם (בסימוני הטענה ציר הסימטרייה הוא 
\begin_inset Formula
$\MKspan\left(\boldsymbol{{\color{red}v_{i}}}+\boldsymbol{{\color{blue}v_{j}}}\right)$
\end_inset
) ושיקוף אכן משנה את הסימן של שטח/נפח מכוון. מי שזה לא מספיק לו מוזמן להסתכל על החלפה של שני צירים כהכפלת אחד מהם ב-
\begin_inset Formula
$-1$
\end_inset
 ואז סיבוב ב-
\begin_inset Formula
$90^{\circ}$
\end_inset
, אין ספק שהכפל ב-
\begin_inset Formula
$-1$
\end_inset
 צריך לשנות את הסימן ושהסיבוב אינו משנה דבר בכל הקשור לשטחים ונפחים.
\end_layout

\begin_layout Proof
מהתכונה השנייה של פונקציות נפח נפח נובע כי:
\begin_inset Formula
\begin{align*}
D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{blue}v_{j}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{red}v_{i}}},v_{j+1},\ldots,v_{n}\right) & =D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{blue}v_{j}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{red}v_{i}}}+\boldsymbol{{\color{blue}v_{j}}},v_{j+1},\ldots,v_{n}\right)\\
 & =D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{blue}v_{j}}}-\left(\boldsymbol{{\color{red}v_{i}}}+\boldsymbol{{\color{blue}v_{j}}}\right),v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{red}v_{i}}}+\boldsymbol{{\color{blue}v_{j}}},v_{j+1},\ldots,v_{n}\right)\\
 & =D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{red}-v_{i}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{red}v_{i}}}+\boldsymbol{{\color{blue}v_{j}}},v_{j+1},\ldots,v_{n}\right)\\
 & =D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{red}-v_{i}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{red}v_{i}}}+\boldsymbol{{\color{blue}v_{j}}}+\left(\boldsymbol{{\color{red}-v_{i}}}\right),v_{j+1},\ldots,v_{n}\right)\\
 & =D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{red}-v_{i}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{blue}v_{j}}},v_{j+1},\ldots,v_{n}\right)
\end{align*}


\end_inset
ולכן מהתכונה הראשונה נקבל:
\begin_inset Formula
\begin{align*}
D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{blue}v_{j}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{red}v_{i}}},v_{j+1},\ldots,v_{n}\right) & =D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{green}-1}}\cdot\boldsymbol{{\color{red}v_{i}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{blue}v_{j}}},v_{j+1},\ldots,v_{n}\right)\\
 & =\boldsymbol{{\color{green}-1}}\cdot D\left(v_{1},v_{2},\ldots v_{i-1},\boldsymbol{{\color{red}v_{i}}},v_{i+1}\ldots,v_{j-1},\boldsymbol{{\color{blue}v_{j}}},v_{j+1},\ldots,v_{n}\right)\\
 & =-D\left(v_{1},v_{2},\ldots,v_{n}\right)
\end{align*}


\end_inset

\end_layout

