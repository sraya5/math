\begin_layout Proof
נוכיח את הטענה באינדוקציה על 
\begin_inset Formula
$n$
\end_inset
, את בסיס האינדוקציה ראינו בלמה 
\begin_inset CommandInset ref
LatexCommand ref
reference "lemma 2.1"
plural false
caps false
noprefix false
nolink false
\end_inset
 ולכן נעבור ישירות לצעד האינדוקציה.
\begin_inset Newline newline
\end_inset
נניח שקיימת פונקציית נפח מנורמלת 
\begin_inset Formula
$\left|\cdot\right|:M_{n-1}\left(\MKfield\right)\rightarrow\MKfield$
\end_inset
 ויהי 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
. תהא 
\begin_inset Formula
$D_{n}:M_{n}\left(\MKfield\right)\rightarrow\MKfield$
\end_inset
 פונקציה המוגדרת ע"י (לכל 
\begin_inset Formula
$A\in M_{n}\left(\MKfield\right)$
\end_inset
):
\begin_inset Formula
\[
D_{n}\left(A\right):=\sum_{j=1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[A\right]_{ij}\cdot\left|A_{ij}\right|\right)
\]


\end_inset

\end_layout

\begin_deeper
\begin_layout Itemize
נוכיח ש-
\begin_inset Formula
$D_{n}$
\end_inset
 מולטי-ליניארית:
\end_layout

\begin_deeper
\begin_layout Itemize
תהא 
\begin_inset Formula
$A\in M_{n}\left(\MKfield\right)$
\end_inset
, יהיו 
\begin_inset Formula
$n\geq k\in\MKnatural$
\end_inset
 ו-
\begin_inset Formula
$c\in\MKfield$
\end_inset
, ונסמן ב-
\begin_inset Formula
$B$
\end_inset
 את המטריצה המתקבלת מ-
\begin_inset Formula
$A$
\end_inset
 ע"י הכפלת העמודה ה-
\begin_inset Formula
$k$
\end_inset
 ב-
\begin_inset Formula
$c$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהגדרה לכל 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$j\neq k$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|B_{ij}\right|=c\cdot\left|A_{ij}\right|$
\end_inset
 ו-
\begin_inset Formula
$\left[B\right]_{ij}=\left[A\right]_{ij}$
\end_inset
, וכמו כן מתקיים גם 
\begin_inset Formula
$\left|B_{ik}\right|=\left|A_{ik}\right|$
\end_inset
 ו-
\begin_inset Formula
$\left[B\right]_{ik}=c\cdot\left[A\right]_{ik}$
\end_inset
.
\begin_inset Newline newline
\end_inset
מכאן שלכל 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
 מתקיים 
\begin_inset Formula
$\left(-1\right)^{i+j}\cdot\left[B\right]_{ij}\cdot\left|B_{ij}\right|=c\cdot\left(-1\right)^{i+j}\cdot\left[A\right]_{ij}\cdot\left|A_{ij}\right|$
\end_inset
 וממילא:
\begin_inset Formula
\[
D_{n}\left(B\right)=\sum_{j=1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[B\right]_{ij}\cdot\left|B_{ij}\right|\right)=\sum_{j=1}^{n}\left(c\cdot\left(-1\right)^{i+j}\cdot\left[A\right]_{ij}\cdot\left|A_{ij}\right|\right)=c\cdot\sum_{j=1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[A\right]_{ij}\cdot\left|A_{ij}\right|\right)
\]


\end_inset

\end_layout

\begin_layout Itemize
יהי 
\begin_inset Formula
$x\in\MKfield^{n}$
\end_inset
 ונסמן ב-
\begin_inset Formula
$C$
\end_inset
 את המטריצה המתקבלת ע"י הוספת 
\begin_inset Formula
$x$
\end_inset
 לעמודה ה-
\begin_inset Formula
$k$
\end_inset
, כמו כן נסמן ב-
\begin_inset Formula
$\tilde{C}$
\end_inset
 את המטריצה המתקבלת מ-
\begin_inset Formula
$A$
\end_inset
 ע"י החלפת העמודה ה-
\begin_inset Formula
$k$
\end_inset
 ב-
\begin_inset Formula
$x$
\end_inset
.
\begin_inset Newline newline
\end_inset
מהגדרה לכל 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$j\neq k$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|C_{ij}\right|=\left|A_{ij}\right|+\left|\tilde{C}_{ij}\right|$
\end_inset
 ו-
\begin_inset Formula
$\left[\tilde{C}\right]_{ij}=\left[C\right]_{ij}=\left[A\right]_{ij}$
\end_inset
, וכמו כן מתקיים גם 
\begin_inset Formula
$\left|\tilde{C}_{ik}\right|=\left|C_{ik}\right|=\left|A_{ik}\right|$
\end_inset
 ו-
\begin_inset Formula
$\left[C\right]_{ik}=\left[A\right]_{ik}+\left[\tilde{C}\right]_{ik}$
\end_inset
.
\begin_inset Newline newline
\end_inset
נניח בהג"כ ש-
\begin_inset Formula
$k=1$
\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow & D_{n}\left(C\right)=\sum_{j=1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[C\right]_{ij}\cdot\left|C_{ij}\right|\right)\\
 & =\left(-1\right)^{i+k}\cdot\left[C\right]_{ik}\cdot\left|C_{ik}\right|+\sum_{j=k+1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[C\right]_{ij}\cdot\left|C_{ij}\right|\right)\\
 & =\left(-1\right)^{i+k}\cdot\left(\left[A\right]_{ik}+\left[\tilde{C}\right]_{ik}\right)\cdot\left|C_{ik}\right|+\sum_{j=k+1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[C\right]_{ij}\cdot\left(\left|A_{ij}\right|+\left|\tilde{C}_{ij}\right|\right)\right)\\
 & =\left(-1\right)^{i+k}\cdot\left[A\right]_{ik}\cdot\left|C_{ik}\right|+\left(-1\right)^{i+k}\cdot\left[\tilde{C}\right]_{ik}\cdot\left|C_{ik}\right|+\sum_{j=k+1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[C\right]_{ij}\cdot\left|A_{ij}\right|\right)+\sum_{j=k+1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[C\right]_{ij}\cdot\left|\tilde{C}_{ij}\right|\right)\\
 & =\left(-1\right)^{i+k}\cdot\left[A\right]_{ik}\cdot\left|A_{ik}\right|+\left(-1\right)^{i+k}\cdot\left[\tilde{C}\right]_{ik}\cdot\left|\tilde{C}_{ik}\right|+\sum_{j=k+1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[A\right]_{ij}\cdot\left|A_{ij}\right|\right)+\sum_{j=k+1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[\tilde{C}\right]_{ij}\cdot\left|\tilde{C}_{ij}\right|\right)\\
 & =\sum_{j=1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[A\right]_{ij}\cdot\left|A_{ij}\right|\right)+\sum_{j=1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[\tilde{C}\right]_{ij}\cdot\left|\tilde{C}_{ij}\right|\right)=D_{n}\left(A\right)+D_{n}\left(\tilde{C}\right)
\end{align*}


\end_inset

\end_layout

\end_deeper

\begin_layout Itemize
נוכיח ש-
\begin_inset Formula
$D_{n}$
\end_inset
 מתחלפת: יהי 
\begin_inset Formula
$n\geq k'\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$k\neq k'$
\end_inset
 ונניח שהעמודות ה-
\begin_inset Formula
$k$
\end_inset
 וה-
\begin_inset Formula
$k'$
\end_inset
 ב-
\begin_inset Formula
$A$
\end_inset
 שוות.
\begin_inset Newline newline
\end_inset
מהגדרה לכל 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$j\neq k$
\end_inset
 ו-
\begin_inset Formula
$j\neq k'$
\end_inset
 מתקיים 
\begin_inset Formula
$\left|A_{ij}\right|=0$
\end_inset
, כמו כן מתקיים 
\begin_inset Formula
$\left[A\right]_{ik}=\left[A\right]_{ik'}$
\end_inset
 ומכיוון ש-
\begin_inset Formula
$\left|\cdot\right|$
\end_inset
 (הדטרמיננטה עבור 
\begin_inset Formula
$M_{n-1}\left(\MKfield\right)$
\end_inset
) מתחלפת מתקיים גם 
\begin_inset Formula
$\left|A_{ik'}\right|=\left(-1\right)^{k-k'+1}\cdot\left|A_{ik}\right|$
\end_inset

\begin_inset Foot
status collapsed
\begin_layout Plain Layout
אם 
\begin_inset Formula
$k-k'=\pm1$
\end_inset
 אז 
\begin_inset Formula
$A_{ik}=A_{ik'}$
\end_inset
, לכן אם 
\begin_inset Formula
$k-k'$
\end_inset
 אי-זוגי אז 
\begin_inset Formula
$\left|A_{ik'}\right|=\left|A_{ik}\right|$
\end_inset
 ואם 
\begin_inset Formula
$k-k'$
\end_inset
 זוגי אז 
\begin_inset Formula
$\left|A_{ik'}\right|=-\left|A_{ik}\right|$
\end_inset
.
\end_layout

\end_inset
.
\begin_inset Formula
\begin{align*}
\Rightarrow D_{n}\left(A\right) & =\sum_{j=1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[A\right]_{ij}\cdot\left|A_{ij}\right|\right)=\left(-1\right)^{i+k}\cdot\left[A\right]_{ik}\cdot\left|A_{ik}\right|+\left(-1\right)^{i+k'}\cdot\left[A\right]_{ik'}\cdot\left|A_{ik'}\right|\\
 & =\left(-1\right)^{i+k}\cdot\left[A\right]_{ik}\cdot\left|A_{ik}\right|+\left(-1\right)^{i+k'}\cdot\left[A\right]_{ik}\cdot\left(-1\right)^{k-k'+1}\cdot\left|A_{ik}\right|\\
 & =\left(-1\right)^{i+k}\cdot\left[A\right]_{ik}\cdot\left|A_{ik}\right|+\left(-1\right)^{i+k+1}\cdot\left[A\right]_{ik}\cdot\left|A_{ik}\right|=0
\end{align*}


\end_inset

\end_layout

\end_deeper

\begin_layout Proof
במשפט 
\begin_inset CommandInset ref
LatexCommand ref
reference "theorem 1.13"
plural false
caps false
noprefix false
nolink false
\end_inset
 ראינו שכל פונקציה מולטי-ליניארית ומתחלפת היא פונקציית נפח, א"כ 
\begin_inset Formula
$D_{n}$
\end_inset
 היא פונקציית נפח.
\begin_inset Newline newline
\end_inset
נוכיח ש-
\begin_inset Formula
$D_{n}$
\end_inset
 מנורמלת: לכל 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$i\neq j$
\end_inset
 המינור 
\begin_inset Formula
$\left(I_{n}\right)_{ij}$
\end_inset
 הוא מטריצה שבה השורה ה-
\begin_inset Formula
$j$
\end_inset
 והעמודה 
\begin_inset Formula
$i$
\end_inset
 הן שורת/עמודת אפסים ולכן 
\begin_inset Formula
$\left|\left(I_{n}\right)_{ij}\right|=0$
\end_inset
, ובנוסף מתקיים 
\begin_inset Formula
$\left(I_{n}\right)_{ii}=I_{n-1}$
\end_inset
 ולכן 
\begin_inset Formula
$\left|\left(I_{n}\right)_{ii}\right|=1$
\end_inset
.
\begin_inset Formula
\[
\Rightarrow D_{n}\left(I_{n}\right):=\sum_{j=1}^{n}\left(\left(-1\right)^{i+j}\cdot\left[I_{n}\right]_{ij}\cdot\left|\left(I_{n}\right)_{ij}\right|\right)=\left(-1\right)^{i+i}\cdot\left|\left(I_{n}\right)_{ii}\right|=1\cdot1=1
\]


\end_inset
עד כאן הוכחנו את הנכונות של פיתוח הדטרמיננטה לפי שורה, הנכונות של הפיתוח לפי עמודה נובע מהעובדה ש-
\begin_inset Formula
$\det A=\det A^{t}$
\end_inset
.
\end_layout

\begin_layout Corollary
הדטרמיננטה של מטריצת סיבוב היא 
\begin_inset Formula
$1$
\end_inset
.
\end_layout

\begin_layout Proof
מהנוסחה המפורשת של הדטרמיננטה נובע שלכל 
\begin_inset Formula
$a,b,c,d\in\MKfield$
\end_inset
 מתקיים 
\begin_inset Formula
$\begin{alignedat}{1}\det\left(\left[\begin{array}{cc}
a & c\\
b & d
\end{array}\right]\right)=a\cdot d-b\cdot c\end{alignedat}
$

\end_inset
, ובפרט לכל 
\begin_inset Formula
$\theta\in\MKreal$
\end_inset
 מתקיים:
\begin_inset Formula
\[
\left|R\left(\theta\right)\right|=\det\left(\left[\begin{array}{cc}
\cos\theta & -\sin\theta\\
\sin\theta & \cos\theta
\end{array}\right]\right)=\cos^{2}\theta-\sin\theta\cdot\left(-\sin\theta\right)=\cos^{2}\theta+\sin^{2}\theta=1
\]


\end_inset

\end_layout

