\det\left(\underset{\text{k פעמים}}{\underbrace{\MKadj\left(\MKadj\left(\ldots\left(\MKadj A\right)\right)\right)}}\right)=\left(\det A\right)^{\left(n-1\right)^{k}}
\]


\end_inset

\end_layout

