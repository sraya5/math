\begin_layout Subsection
מטריצת ונדרמונד
\end_layout

\begin_layout Theorem
תהא 
\begin_inset Formula
$V\in M_{n}\left(\MKfield\right)$
\end_inset
 מטריצת ונדרמונד עבור ערכים 
\begin_inset Formula
$x_{1},x_{2},\ldots,x_{n}\in\MKfield$
\end_inset
, כלומר:
\begin_inset Formula
\[
V:=\begin{bmatrix}1 & x_{1} & \left(x_{1}\right)^{2} & \dots & \left(x_{1}\right)^{n-1}\\
1 & x_{2} & \left(x_{2}\right)^{2} & \dots & \left(x_{2}\right)^{n-1}\\
1 & x_{3} & \left(x_{3}\right)^{2} & \dots & \left(x_{3}\right)^{n-1}\\
\vdots & \vdots & \vdots & \ddots & \vdots\\
1 & x_{n} & \left(x_{n}\right)^{2} & \dots & \left(x_{n}\right)^{n-1}
\end{bmatrix}
\]


\end_inset
מתקיים:
\begin_inset Formula
\[
\det V=\prod_{n\geq i,j\in\MKnatural\ i<j}\left(x_{j}-x_{i}\right)
\]


\end_inset

\end_layout

\begin_layout Proof
נוכיח את הטענה באינדוקציה, עבור 
\begin_inset Formula
$n=1$
\end_inset
 הטענה טריוויאלית
\begin_inset Foot
status collapsed
\begin_layout Plain Layout
אם 
\begin_inset Formula
$n=1$
\end_inset
 אז 
\begin_inset Formula
$V=I_{1}$
\end_inset
 ולכן 
\begin_inset Formula
$\det V=1$
\end_inset
, כמו כן אם 
\begin_inset Formula
$n=1$
\end_inset
 אז המכפלה הנ"ל ריקה ולכן גם היא שווה ל-
\begin_inset Formula
$1$
\end_inset
 מהגדרה.
\end_layout

\end_inset
 ולכן נעבור ישירות לצעד האינדוקציה, א"כ נניח שהטענה מתקיימת עבור 
\begin_inset Formula
$n-1$
\end_inset
.
\begin_inset Newline newline
\end_inset
נוסיף לעמודה ה-
\begin_inset Formula
$n$
\end_inset
 את העמודה ה-
\begin_inset Formula
$n-1$
\end_inset
 כשהיא מוכפלת ב-
\begin_inset Formula
$-x_{1}$
\end_inset
, לאחר מכן נוסיף את העמודה ה-
\begin_inset Formula
$n-2$
\end_inset
 לעמודה ה-
\begin_inset Formula
$n-1$
\end_inset
 כשהיא מוכפלת ב-
\begin_inset Formula
$-x_{1}$
\end_inset
 וכן הלאה עד שנוסיף לעמודה השנייה את העמודה הראשונה כשהיא מוכפלת ב-
\begin_inset Formula
$-x_{1}$
\end_inset
; מהתכונה השנייה של פונקציות נפח נובע שלא שינינו את הדטרמיננטה של המטריצה ולכן:
\begin_inset Formula
\begin{align*}
\det V & =\left|\begin{array}{ccccc}
1 & x_{1} & \left(x_{1}\right)^{2} & \dots & \left(x_{1}\right)^{n-1}\\
1 & x_{2} & \left(x_{2}\right)^{2} & \dots & \left(x_{2}\right)^{n-1}\\
1 & x_{3} & \left(x_{3}\right)^{2} & \dots & \left(x_{3}\right)^{n-1}\\
\vdots & \vdots & \vdots & \ddots & \vdots\\
1 & x_{n} & \left(x_{n}\right)^{2} & \dots & \left(x_{n}\right)^{n-1}
\end{array}\right|=\left|\begin{array}{ccccc}
1 & x_{1}-x_{1} & \left(x_{1}\right)^{2}-x_{1}\cdot x_{1} & \dots & \left(x_{1}\right)^{n-1}-\left(x_{1}\right)^{n-2}\cdot x_{1}\\
1 & x_{2}-x_{1} & \left(x_{2}\right)^{2}-x_{2}\cdot x_{1} & \dots & \left(x_{2}\right)^{n-1}-\left(x_{2}\right)^{n-2}\cdot x_{1}\\
1 & x_{3}-x_{1} & \left(x_{3}\right)^{2}-x_{3}\cdot x_{1} & \dots & \left(x_{3}\right)^{n-1}-\left(x_{3}\right)^{n-2}\cdot x_{1}\\
\vdots & \vdots & \vdots & \ddots & \vdots\\
1 & x_{n}-x_{1} & \left(x_{n}\right)^{2}-x_{n}\cdot x_{1} & \dots & \left(x_{n}\right)^{n-1}-\left(x_{n}\right)^{n-2}\cdot x_{1}
\end{array}\right|\\
 & =\left|\begin{array}{ccccc}
1 & 0 & 0 & \dots & 0\\
1 & x_{2}-x_{1} & x_{2}\cdot\left(x_{2}-x_{1}\right) & \dots & \left(x_{2}\right)^{n-2}\cdot\left(x_{2}-x_{1}\right)\\
1 & x_{3}-x_{1} & x_{3}\cdot\left(x_{3}-x_{1}\right) & \dots & \left(x_{3}\right)^{n-2}\cdot\left(x_{3}-x_{1}\right)\\
\vdots & \vdots & \vdots & \ddots & \vdots\\
1 & x_{n}-x_{1} & x_{n}\cdot\left(x_{n}-x_{1}\right) & \dots & \left(x_{n}\right)^{n-2}\cdot\left(x_{n}-x_{1}\right)
\end{array}\right|
\end{align*}


\end_inset
מפיתוח הדטרמיננטה לפי השורה הראשונה נובע שמתקיים:
\begin_inset Formula
\[
\det V=1\cdot\left|\begin{array}{cccc}
x_{2}-x_{1} & x_{2}\cdot\left(x_{2}-x_{1}\right) & \dots & \left(x_{2}\right)^{n-2}\cdot\left(x_{2}-x_{1}\right)\\
x_{3}-x_{1} & x_{3}\cdot\left(x_{3}-x_{1}\right) & \dots & \left(x_{3}\right)^{n-2}\cdot\left(x_{3}-x_{1}\right)\\
\vdots & \vdots & \ddots & \vdots\\
x_{n}-x_{1} & x_{n}\cdot\left(x_{n}-x_{1}\right) & \dots & \left(x_{n}\right)^{n-2}\cdot\left(x_{n}-x_{1}\right)
\end{array}\right|
\]


\end_inset
ומהעובדה שהדטרמיננטה מולטי-ליניארית לפי שורות נובע כי:
\begin_inset Formula
\[
\det V=\left|\begin{array}{cccc}
x_{2}-x_{1} & x_{2}\cdot\left(x_{2}-x_{1}\right) & \dots & \left(x_{2}\right)^{n-2}\cdot\left(x_{2}-x_{1}\right)\\
x_{3}-x_{1} & x_{3}\cdot\left(x_{3}-x_{1}\right) & \dots & \left(x_{3}\right)^{n-2}\cdot\left(x_{3}-x_{1}\right)\\
\vdots & \vdots & \ddots & \vdots\\
x_{n}-x_{1} & x_{n}\cdot\left(x_{n}-x_{1}\right) & \dots & \left(x_{n}\right)^{n-2}\cdot\left(x_{n}-x_{1}\right)
\end{array}\right|=\prod_{i=2}^{n}\left(x_{i}-x_{1}\right)\cdot\left|\begin{array}{cccc}
1 & x_{2} & \dots & \left(x_{2}\right)^{n-2}\\
1 & x_{3} & \dots & \left(x_{3}\right)^{n-2}\\
\vdots & \vdots & \ddots & \vdots\\
1 & x_{n} & \dots & \left(x_{n}\right)^{n-2}
\end{array}\right|
\]


\end_inset
המטריצה שבאגף ימין היא מטריצת ונדרמונד עבור הערכים 
\begin_inset Formula
$x_{2},x_{3},\ldots,x_{n}$
\end_inset
 ולכן ע"פ הנחת האינדוקציה מתקיים:
\begin_inset Formula
\[
\det V=\prod_{i=2}^{n}\left(x_{i}-x_{1}\right)\cdot\prod_{n\geq i,j\in\MKnatural\ 1<i<j}\left(x_{j}-x_{i}\right)=\prod_{n\geq i,j\in\MKnatural\ i<j}\left(x_{j}-x_{i}\right)
\]


\end_inset

\end_layout

\begin_layout Corollary
\begin_inset CommandInset label
LatexCommand label
name "corollary 3.12"
\end_inset
מטריצת ונדרמונד 
\begin_inset Formula
$V\in M_{n}\left(\MKfield\right)$
\end_inset
 עבור ערכים 
\begin_inset Formula
$x_{1},x_{2},\ldots,x_{n}\in\MKfield$
\end_inset
 היא הפיכה אם"ם 
\begin_inset Formula
$x_{i}\neq x_{j}$
\end_inset
 לכל 
\begin_inset Formula
$n\geq i,j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$i\neq j$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 אנחנו יודעים ששתי נקודות מגדירות ישר יחיד (כלומר פולינום ממעלה 
\begin_inset Formula
$1$
\end_inset
) ואילו שלוש נקודות מגדירות פרבולה יחידה (כלומר פולינום ממעלה 
\begin_inset Formula
$2$
\end_inset
), מה לגבי פולינומים ממעלה גבוהה יותר?
\end_layout

\begin_layout Corollary
לכל 
\begin_inset Formula
$x_{1},x_{2},\ldots,x_{n}\in\MKfield$
\end_inset
 כך שלכל 
\begin_inset Formula
$n\geq i,j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$i\neq j$
\end_inset
 ולכל 
\begin_inset Formula
$y_{1},y_{2}.\ldots,y_{n}\in\MKfield$
\end_inset
 קיים פולינום יחיד 
\begin_inset Formula
$P\in\MKfield_{\leq n-1}\left[x\right]$
\end_inset
 כך ש-
\begin_inset Formula
$y_{i}=P\left(x_{i}\right)$
\end_inset
 לכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 כלומר 
\begin_inset Formula
$n+1$
\end_inset
 נקודות במישור שערכי ה-
\begin_inset Formula
$x$
\end_inset
 שלהן שונים מגדירות פולינום יחיד ממעלה 
\begin_inset Formula
$n$
\end_inset
 שעובר בכולן.
\end_layout

\begin_layout Proof
יהיו 
\begin_inset Formula
$x_{1},x_{2},\ldots,x_{n}\in\MKfield$
\end_inset
 כך שלכל 
\begin_inset Formula
$n\geq i,j\in\MKnatural$
\end_inset
 כך ש-
\begin_inset Formula
$i\neq j$
\end_inset
, ויהיו 
\begin_inset Formula
$y_{1},y_{2}.\ldots,y_{n}\in\MKfield$
\end_inset
. נסמן:
\begin_inset Formula
\[
V:=\begin{bmatrix}1 & x_{1} & \left(x_{1}\right)^{2} & \dots & \left(x_{1}\right)^{n-1}\\
1 & x_{2} & \left(x_{2}\right)^{2} & \dots & \left(x_{2}\right)^{n-1}\\
1 & x_{3} & \left(x_{3}\right)^{2} & \dots & \left(x_{3}\right)^{n-1}\\
\vdots & \vdots & \vdots & \ddots & \vdots\\
1 & x_{n} & \left(x_{n}\right)^{2} & \dots & \left(x_{n}\right)^{n-1}
\end{bmatrix},\ y=\begin{bmatrix}y_{1}\\
y_{2}\\
y_{3}\\
\vdots\\
y_{n}
\end{bmatrix}
\]


\end_inset
ממסקנה 
\begin_inset CommandInset ref
LatexCommand ref
reference "corollary 3.12"
plural false
caps false
noprefix false
nolink false
\end_inset
 נובע ש-
\begin_inset Formula
$V$
\end_inset
 הפיכה ומכאן שקיים 
\begin_inset Formula
$a\in\MKfield^{n}$
\end_inset
 יחיד כך ש-
\begin_inset Formula
$V\cdot a=y$
\end_inset
, כלומר קיימים 
\begin_inset Formula
$a_{0},a_{1},a_{2},\ldots,a_{n-1}\in\MKfield$
\end_inset
 יחידים המקיימים:
\begin_inset Formula
\[
\begin{bmatrix}1 & x_{1} & \left(x_{1}\right)^{2} & \dots & \left(x_{1}\right)^{n-1}\\
1 & x_{2} & \left(x_{2}\right)^{2} & \dots & \left(x_{2}\right)^{n-1}\\
1 & x_{3} & \left(x_{3}\right)^{2} & \dots & \left(x_{3}\right)^{n-1}\\
\vdots & \vdots & \vdots & \ddots & \vdots\\
1 & x_{n} & \left(x_{n}\right)^{2} & \dots & \left(x_{n}\right)^{n-1}
\end{bmatrix}\cdot\begin{bmatrix}a_{0}\\
a_{1}\\
a_{2}\\
\vdots\\
a_{n-1}
\end{bmatrix}=\begin{bmatrix}y_{1}\\
y_{2}\\
y_{3}\\
\vdots\\
y_{n}
\end{bmatrix}
\]


\end_inset
מהגדרת כפל מטריצה בווקטור נקבל שקיימים 
\begin_inset Formula
$a_{0},a_{1},a_{2},\ldots,a_{n-1}\in\MKfield$
\end_inset
 יחידים המקיימים:
\begin_inset Formula
\begin{align*}
y_{1} & =a_{0}+a_{1}\cdot x_{1}+a_{2}\cdot\left(x_{1}\right)^{2}+\ldots+a_{n-1}\cdot\left(x_{1}\right)^{n-1}\\
y_{2} & =a_{0}+a_{1}\cdot x_{2}+a_{2}\cdot\left(x_{2}\right)^{2}+\ldots+a_{n-1}\cdot\left(x_{2}\right)^{n-1}\\
y_{3} & =a_{0}+a_{1}\cdot x_{3}+a_{2}\cdot\left(x_{3}\right)^{2}+\ldots+a_{n-1}\cdot\left(x_{3}\right)^{n-1}\\
\vdots & \vdots\\
y_{n} & =a_{0}+a_{1}\cdot x_{n}+a_{2}\cdot\left(x_{n}\right)^{2}+\ldots+a_{n-1}\cdot\left(x_{n}\right)^{n-1}
\end{align*}


\end_inset
כלומר קיים פולינום יחיד 
\begin_inset Formula
$P\in\MKfield_{\leq n-1}\left[x\right]$
\end_inset
 כך ש-
\begin_inset Formula
$y_{i}=P\left(x_{i}\right)$
\end_inset
 לכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
.
\end_layout

