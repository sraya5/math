 ואז התכונה הראשונה אומרת שהכפלת אחת העמודות בסקלר מכפילה את התמונה באותו סקלר, ואילו התכונה השנייה אומרת שהוספת כפולה של עמודה אחת לאחרת אינה משנה את התמונה.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 שימו לב לדמיון שבין התכונות הללו לשתי פעולות השורה האלמנטריות האחרונות (הכפלת שורה בסקלר והוספת כפולה של שורה אחת לשורה אחרת).
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 ניתן היה להחליף את התכונה השנייה בכך שמתקיים 
\begin_inset Formula
$D\left(v_{1},v_{2},\ldots,v_{i}+v_{j},\ldots,v_{n}\right)=D\left(v_{1},v_{2},\ldots,v_{n}\right)$
\end_inset
 (ללא כפל בסקלר) משום שיחד עם התכונה הראשונה יתקיים (נניח בהג"כ ש-
\begin_inset Formula
$i<j$
\end_inset
 וש-
\begin_inset Formula
$c\neq0$
\end_inset
):
\begin_inset Formula
\begin{align*}
D\left(v_{1},v_{2},\ldots,v_{i}+c\cdot v_{j},\ldots,v_{j}\ldots,v_{n}\right) & =D\left(v_{1},v_{2},\ldots,v_{i}+c\cdot v_{j},\ldots,c^{-1}\cdot c\cdot v_{j}\ldots,v_{n}\right)\\
 & =c^{-1}\cdot D\left(v_{1},v_{2},\ldots,v_{i}+c\cdot v_{j},\ldots,c\cdot v_{j}\ldots,v_{n}\right)\\
 & =c^{-1}\cdot D\left(v_{1},v_{2},\ldots,v_{i},\ldots,c\cdot v_{j}\ldots,v_{n}\right)\\
 & =c^{-1}\cdot c\cdot D\left(v_{1},v_{2},\ldots,v_{i},\ldots,v_{j}\ldots,v_{n}\right)=D\left(v_{1},v_{2},\ldots,v_{n}\right)
\end{align*}


\end_inset
למרות זאת בחרתי להגדיר את התכונה השנייה משום שאינני מחזיק בשיטה האומרת "נניח כמה שפחות כל עוד נרוויח את אותו הדבר", לדעתי המהות (האינטואיטיבית) של פונקציית נפח אינה מבדילה בין הוספה של וקטור לבין הוספה של כפולה שלו (כפי שהסברתי לעיל) ולכן גם ההגדרה הפורמלית לא צריכה להבדיל ביניהן.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 גם פונקציית האפס היא פונקציית נפח ע"פ הגדרה זו.
\end_layout

\begin_layout Labeling
\labelwidthstring 00.00.0000

\begin_inset Formula
$\clubsuit$
\end_inset
 במקומות אחרים מגדירים פונקציית נפח ע"י מולטי-ליניאריות והתחלפות ו/או מגדירים פונקציות נפח על מטריצות ריבועיות בלבד (ולא על סדרות וקטורים), אנחנו נראה שההגדרה ע"י מולטי-ליניאריות והתחלפות שקולה לזו שהגדרנו ושהיא מהווה הכללה של ההגדרה עבור מטריצות.
\end_layout

