\begin_inset Formula
$A_{\left(j\right)}$
\end_inset
 לפי השורה ה-
\begin_inset Formula
$j$
\end_inset
 (לכל 
\begin_inset Formula
$n\geq j\in\MKnatural$
\end_inset
).
\end_layout

\begin_layout Corollary
תהא 
\begin_inset Formula
$A\in M_{n}\left(\MKfield\right)$
\end_inset
 ויהי 
\begin_inset Formula
$b\in\MKfield^{n}$
\end_inset
,
\end_layout

\begin_deeper
\begin_layout Itemize
אם קיים 
\begin_inset Formula
$x\in\MKfield^{n}$
\end_inset
 כך ש-
