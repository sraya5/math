\begin_layout Proof
נניח שקיים 
\begin_inset Formula
$x\in\MKfield^{n}$
\end_inset
 כך ש-
\begin_inset Formula
$A\cdot x=b$
\end_inset
 ויהי 
\begin_inset Formula
$x$
\end_inset
 כנ"ל.
\begin_inset Newline newline
\end_inset
נסמן ב-
\begin_inset Formula
$c_{i}$
\end_inset
 את העמודה ה-
\begin_inset Formula
$i$
\end_inset
 של 
\begin_inset Formula
$A$
\end_inset
 (לכל 
\begin_inset Formula
$n\geq i\in\MKnatural$
\end_inset
), א"כ מתקיים (לכל 
\begin_inset Formula
$n\geq k\in\MKnatural$
\end_inset
):
\begin_inset Formula
\[
A^{\left(k\right)}=\left[\begin{array}{c|c|c|c|c|c|c|c}
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid\\
c_{1} & c_{2} & \cdots & c_{k-1} & b & c_{k+1} & \cdots & c_{n}\\
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid
\end{array}\right]=A\cdot\left[\begin{array}{c|c|c|c|c|c|c|c}
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid\\
e_{1} & e_{2} & \cdots & e_{k-1} & x & e_{k+1} & \cdots & e_{n}\\
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid
\end{array}\right]
\]


\end_inset
ומתכונות הדטרמיננטה נובע כי (לכל 
\begin_inset Formula
$n\geq k\in\MKnatural$
\end_inset
):
\begin_inset Formula
\begin{align*}
\det A^{\left(k\right)} & =\det\left(A\cdot\left[\begin{array}{c|c|c|c|c|c|c|c}
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid\\
e_{1} & e_{2} & \cdots & e_{k-1} & x & e_{k+1} & \cdots & e_{n}\\
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid
\end{array}\right]\right)\\
 & =\left(\det A\right)\cdot\det\left(\left[\begin{array}{c|c|c|c|c|c|c|c}
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid\\
e_{1} & e_{2} & \cdots & e_{k-1} & x & e_{k+1} & \cdots & e_{n}\\
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid
\end{array}\right]\right)\\
 & =\left(\det A\right)\cdot\det\left(\left[\begin{array}{c|c|c|c|c|c|c|c}
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid\\
e_{1} & e_{2} & \cdots & e_{k-1} & \sum_{i=1}^{n}x_{i}\cdot e_{i} & e_{k+1} & \cdots & e_{n}\\
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid
\end{array}\right]\right)\\
 & =\left(\det A\right)\cdot\det\left(\left[\begin{array}{c|c|c|c|c|c|c|c}
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid\\
e_{1} & e_{2} & \cdots & e_{k-1} & x_{k}\cdot e_{k} & e_{k+1} & \cdots & e_{n}\\
\mid & \mid & \mid & \mid & \mid & \mid & \mid & \mid
\end{array}\right]\right)\\
 & =\left(\det A\right)\cdot x_{k}\cdot\det I_{n}=\left(\det A\right)\cdot x_{k}
\end{align*}


\end_inset

\end_layout

